{
 "start-selling-online/s01-n1": "One handbag style is everywhere online.|en|1|1|1|false",
 "start-selling-online/s01-a1": "I'll spend all my savings on a big lot. The wholesale price is better!|en|1|1|1|false",
 "start-selling-online/s01-b1": "I'll order five bags, post them, and count the real orders.|en|1|1|1|false",
 "start-selling-online/s01-n2": "Two weeks later, the style is out. Which Lan is better off?|en|1|1|1|false",
 "start-selling-online/s02-l1": "Where do you start, without losing money? Here is the short answer.|en|1|1|1|false",
 "start-selling-online/s02-l2": "Test with a few items first.|en|1|1|1|false",
 "start-selling-online/s02-l3": "Count every cost before you set a price.|en|1|1|1|false",
 "start-selling-online/s02-l4": "Use real photos, sample replies, and careful packing.|en|1|1|1|false",
 "start-selling-online/s02-l5": "And write down every order.|en|1|1|1|false",
 "start-selling-online/s03-l1": "Six stops, in the order you will live them.|en|1|1|1|false",
 "start-selling-online/s04-l1": "Part one: before you buy any stock.|en|1|1|1|false",
 "start-selling-online/s05-l2": "Start with three questions. Who do you sell to?|en|1|1|1|false",
 "start-selling-online/s05-l3": "What do you sell?|en|1|1|1|false",
 "start-selling-online/s05-l4": "And how many hours do you have each week?|en|1|1|1|false",
 "start-selling-online/s05-l5": "Then you choose wisely, not just the hot item.|en|1|1|1|false",
 "start-selling-online/s06-l1": "An easy first product is one you understand well,|en|1|1|1|false",
 "start-selling-online/s06-l2": "one you can test yourself,|en|1|1|1|false",
 "start-selling-online/s06-l3": "one that doesn't break easily,|en|1|1|1|false",
 "start-selling-online/s06-l4": "and one that needs no special licence.|en|1|1|1|false",
 "start-selling-online/s07-l1": "Tick four boxes. You know it well enough to answer buyers.|en|1|1|1|false",
 "start-selling-online/s07-l2": "It has a clear origin, with receipts or import papers.|en|1|1|1|false",
 "start-selling-online/s07-l3": "It isn't too hard to pack and send.|en|1|1|1|false",
 "start-selling-online/s07-l4": "And if it sells slowly, it won't go bad.|en|1|1|1|false",
 "start-selling-online/s08-l1": "For a beginner, a big lot at a wholesale price is smartest. True or false?|en|1|1|1|false",
 "start-selling-online/s08-l2": "False. Buy a little. You earn less per item, but if it doesn't sell, you lose only a little.|en|1|1|1|false",
 "start-selling-online/s09-l1": "Big lot: shops dump the bag below her cost.|en|1|1|1|false",
 "start-selling-online/s09-l2": "Bags fill her room. Her money is stuck.|en|1|1|1|false",
 "start-selling-online/s09-l3": "Five bags: a bit less profit, only a few to sell cheap.|en|1|1|1|false",
 "start-selling-online/s10-l1": "So: sell a little first to test, and buy a lot later.|en|1|1|1|false",
 "start-selling-online/s11-l1": "Part two: what price keeps you from losing money?|en|1|1|1|false",
 "start-selling-online/s12-l1": "Your price must carry more than the product cost.|en|1|1|1|false",
 "start-selling-online/s12-l2": "Packaging, tape and labels.|en|1|1|1|false",
 "start-selling-online/s12-l3": "Platform fees, or ad fees if you have them.|en|1|1|1|false",
 "start-selling-online/s12b-l4": "Shipping that you pay, and some damaged or returned goods.|en|1|1|1|false",
 "start-selling-online/s12b-l5": "Add it all up to know what one item really costs.|en|1|1|1|false",
 "start-selling-online/s13-l1": "Many beginners copy another shop and go a little cheaper.|en|1|1|1|false",
 "start-selling-online/s13-l2": "But that shop may buy cheaper, or survive losses longer than you.|en|1|1|1|false",
 "start-selling-online/s13-l3": "So the more you sell, the more you lose. Price from your own costs.|en|1|1|1|false",
 "start-selling-online/s14-l1": "About tax. From twenty twenty-six, there is no fixed tax. You declare it yourself.|en|1|1|1|false",
 "start-selling-online/s14-l2": "Up to five hundred million dong a year: no VAT or personal income tax.|en|1|1|1|false",
 "start-selling-online/s14-l3": "But you still report your real income.|en|1|1|1|false",
 "start-selling-online/s14-l4": "On platforms with ordering and payment, the platform takes the tax for you.|en|1|1|1|false",
 "start-selling-online/s14-l5": "Rules may change. Ask your local tax office, and read the official guidance.|en|1|1|1|false",
 "start-selling-online/s15-l1": "Part three: a shop page that buyers trust.|en|1|1|1|false",
 "start-selling-online/s16-l1": "Online buyers can't hold the product.|en|1|1|1|false",
 "start-selling-online/s16-l2": "So they trust your photos, your words, and your replies.|en|1|1|1|false",
 "start-selling-online/s16-l3": "Real photos, from every side, with clear sizes, do a shop assistant's job.|en|1|1|1|false",
 "start-selling-online/s17-l1": "Take photos with your phone, next to a window.|en|1|1|1|false",
 "start-selling-online/s17-l2": "Nice photos make buyers stop. Honest words stop returns.|en|1|1|1|false",
 "start-selling-online/s18-l1": "Your page needs an easy shop name and a clear profile photo.|en|1|1|1|false",
 "start-selling-online/s18-l2": "How to order, the shipping fee, and the delivery time.|en|1|1|1|false",
 "start-selling-online/s18-l3": "A short return policy, and your reply hours.|en|1|1|1|false",
 "start-selling-online/s19-l1": "Before: the supplier's photo, 'thick, elegant cream'.|en|1|1|1|false",
 "start-selling-online/s19-l2": "Paler, thinner in real life. Sent back.|en|1|1|1|false",
 "start-selling-online/s19-l3": "After: her own photo. 'Medium-thin, light cream.'|en|1|1|1|false",
 "start-selling-online/s19-l4": "Plus: 'colour may differ a bit on screen.'|en|1|1|1|false",
 "start-selling-online/s20-l1": "Less shiny, but buyers get what they saw. Nice photos bring them in. Real photos keep them.|en|1|1|1|false",
 "start-selling-online/s21-l1": "Part four: how to answer buyer messages.|en|1|1|1|false",
 "start-selling-online/s22-l1": "Most orders are won or lost in messages.|en|1|1|1|false",
 "start-selling-online/s22-l2": "Do you still have this in size M?|en|1|1|1|false",
 "start-selling-online/s22-l3": "Yes, we have size M. Could you send your address, so I can tell you the shipping fee?|en|1|1|1|false",
 "start-selling-online/s22-l4": "Answer the exact question, then suggest the next step.|en|1|1|1|false",
 "start-selling-online/s23-l1": "Prepare a few sample replies: price, size, material, shipping, returns.|en|1|1|1|false",
 "start-selling-online/s23-l2": "Then adjust each one to the buyer in front of you.|en|1|1|1|false",
 "start-selling-online/s23-l3": "When a buyer says 'too expensive', don't rush to cut the price.|en|1|1|1|false",
 "start-selling-online/s23-l4": "Ask back, explain the value, and keep your profit.|en|1|1|1|false",
 "start-selling-online/s24-l1": "Some messages aren't from real buyers.|en|1|1|1|false",
 "start-selling-online/s24-l2": "They ask you to click a strange link, or to give a verification code.|en|1|1|1|false",
 "start-selling-online/s24-l3": "Or they say they paid too much, and ask you to send it back.|en|1|1|1|false",
 "start-selling-online/s24-l4": "Never read a code to anyone. Money is real only when you check your own account.|en|1|1|1|false",
 "start-selling-online/s25-l1": "Part five: you have an order. How do you ship it safely?|en|1|1|1|false",
 "start-selling-online/s26-l1": "Check the item before you pack it.|en|1|1|1|false",
 "start-selling-online/s26-l2": "Pick a box that fits, and fill every empty space.|en|1|1|1|false",
 "start-selling-online/s26-l3": "Write the name, phone number and address clearly.|en|1|1|1|false",
 "start-selling-online/s26-l4": "Record a video while packing.|en|1|1|1|false",
 "start-selling-online/s26-l5": "Save the tracking code and send it to the buyer.|en|1|1|1|false",
 "start-selling-online/s27-l1": "A packing video costs nothing.|en|1|1|1|false",
 "start-selling-online/s27-l2": "But it helps a lot when a buyer says something is missing or broken.|en|1|1|1|false",
 "start-selling-online/s28-l1": "A fake order is when a buyer orders, then doesn't accept it.|en|1|1|1|false",
 "start-selling-online/s28-l2": "You pay shipping both ways, and lose time and packaging.|en|1|1|1|false",
 "start-selling-online/s28-l3": "Call or message to confirm first, above all for big orders or new buyers.|en|1|1|1|false",
 "start-selling-online/s29-l1": "Dũng gets an order for ten watches.|en|1|1|1|false",
 "start-selling-online/s29-l2": "Ten watches from a new account! They want it today.|en|1|1|1|false",
 "start-selling-online/s29-l3": "No need to call. I'll pack it and send it now!|en|1|1|1|false",
 "start-selling-online/s29-l4": "Wait a second!|en|1|1|1|false",
 "start-selling-online/s29-l5": "A week later it comes back. Nobody answers. You pay both ways.|en|1|1|1|false",
 "start-selling-online/s29-l6": "Let's rewind and try again.|en|1|1|1|false",
 "start-selling-online/s29-l7": "Big order, new account. I'll call to confirm before I pack.|en|1|1|1|false",
 "start-selling-online/s29-l8": "The bigger the order, the more you must call before packing.|en|1|1|1|false",
 "start-selling-online/s30-l1": "Part six: unhappy buyers, and a slow first month.|en|1|1|1|false",
 "start-selling-online/s31-l1": "Returns are normal in selling. They don't mean you failed.|en|1|1|1|false",
 "start-selling-online/s31-l2": "Write a clear policy: how long, what conditions, and who pays shipping.|en|1|1|1|false",
 "start-selling-online/s31-l3": "Then you can answer calmly, instead of arguing.|en|1|1|1|false",
 "start-selling-online/s32-l1": "After work, Thảo sees a low rating: 'Like cheap market goods.'|en|1|1|1|false",
 "start-selling-online/s32-l2": "I'm so tired. I'll answer right now.|en|1|1|1|false",
 "start-selling-online/s32-l3": "If you don't know how to use it, don't complain.|en|1|1|1|false",
 "start-selling-online/s32-l4": "Wait a second!|en|1|1|1|false",
 "start-selling-online/s32-l5": "People screenshot it. Soon they only talk about the shop's reply.|en|1|1|1|false",
 "start-selling-online/s32-l6": "Let's rewind and try another way.|en|1|1|1|false",
 "start-selling-online/s32-l7": "I'll wait until I'm calm.|en|1|1|1|false",
 "start-selling-online/s32-l8": "Thank you for telling us. What happened? Please message us privately.|en|1|1|1|false",
 "start-selling-online/s33-l1": "Readers watch your reply more than the complaint.|en|1|1|1|false",
 "start-selling-online/s33-l2": "When you're hot, wait. Reply after you cool down.|en|1|1|1|false",
 "start-selling-online/s34-l1": "Few orders in the first month is normal for a new shop.|en|1|1|1|false",
 "start-selling-online/s34-l2": "Don't compare yourself with shops that sold for years.|en|1|1|1|false",
 "start-selling-online/s34-l3": "Measure what you learned about buyers this week.|en|1|1|1|false",
 "start-selling-online/s35-l1": "For each order, write the date, item, price, fees and profit.|en|1|1|1|false",
 "start-selling-online/s35-l2": "Write down common questions, and add the answers to your descriptions.|en|1|1|1|false",
 "start-selling-online/s35-l3": "Note returns and why.|en|1|1|1|false",
 "start-selling-online/s35-l4": "And look back once a week.|en|1|1|1|false",
 "start-selling-online/s36-l1": "Selling after your main job?|en|1|1|1|false",
 "start-selling-online/s36-l2": "I'll set fixed times: one for replying, one for packing.|en|1|1|1|false",
 "start-selling-online/s36-l3": "And I'll show those times on my page.|en|1|1|1|false",
 "start-selling-online/s36-l4": "Buyers will wait if they know. And you're not stuck on your phone all day.|en|1|1|1|false",
 "start-selling-online/s37-l1": "The series follows a new shop's journey. First, choosing products and suppliers.|en|1|1|1|false",
 "start-selling-online/s37-l2b": "Right after that, work out the real profit of each order, before you post anything.|en|1|1|1|false",
 "start-selling-online/s37-l3b": "Then photos, replying to messages, buyers who say 'too expensive', packing, returns and fake orders.|en|1|1|1|false",
 "start-selling-online/s37-l4b": "Then bad reviews, and last, the scams that target sellers.|en|1|1|1|false",
 "start-selling-online/s38-l1": "No perfect start needed. Test first, call before big orders, and wait when you're angry.|en|1|1|1|false",
 "start-selling-online/s39-l1": "Someone posts a public complaint about your shop, what should you do first?|en|1|1|1|false",
 "start-selling-online/s39-l2": "Wait until you are calm, thank them, ask what happened, and move to private messages.|en|1|1|1|false",
 "start-selling-online/s39-l3": "People watch your reply more than the complaint. Deleting or arguing makes it bigger.|en|1|1|1|false",
 "start-selling-online/s40-l1": "Write your answers: who, what, how many hours. Then try the forty questions below!|en|1|1|1|false",
 "a-day-within-a-day/s01-l1": "Dinner's done. Just ten minutes on my phone.|en|1|1|1|false",
 "a-day-within-a-day/s01-l2": "She looks up. It's almost eleven, and she can't remember what she watched.|en|1|1|1|false",
 "a-day-within-a-day/s01-l3": "And that book is still on the table.|en|1|1|1|false",
 "a-day-within-a-day/s01-l4": "Where did her evening go?|en|1|1|1|false",
 "a-day-within-a-day/s02-l1": "Arnold Bennett says the problem is how we see it. Work hours are not the whole day.|en|1|1|1|false",
 "a-day-within-a-day/s02-l2": "From leaving work to the next morning is a day of its own. It belongs to you.|en|1|1|1|false",
 "a-day-within-a-day/s03-l1": "Six stops today.|en|1|1|1|false",
 "a-day-within-a-day/s03-l2": "The forgotten part. A day within a day. Too tired?|en|1|1|1|false",
 "a-day-within-a-day/s03-l3": "The morning ride. Drawing your day. And this week's plan.|en|1|1|1|false",
 "a-day-within-a-day/s04-l1": "Part one: the part of the day we forget.|en|1|1|1|false",
 "a-day-within-a-day/s05-l1": "How was your day yesterday?|en|1|1|1|false",
 "a-day-within-a-day/s05-l2": "Two meetings, a new client, and the boss wanted a report.|en|1|1|1|false",
 "a-day-within-a-day/s05-l3": "And after work?|en|1|1|1|false",
 "a-day-within-a-day/s05-l4": "Oh, I just went home to rest.|en|1|1|1|false",
 "a-day-within-a-day/s05-l5": "We tell the office part in detail. The rest of the day fits in one short sentence.|en|1|1|1|false",
 "a-day-within-a-day/s06-l1": "Many of us treat work hours as the whole day. The other sixteen are leftovers.|en|1|1|1|false",
 "a-day-within-a-day/s06-l2": "Bennett calls this the biggest mistake. It is in our attitude, not in our schedule.|en|1|1|1|false",
 "a-day-within-a-day/s06b-l3": "And nobody plans the leftovers. So they just drift away.|en|1|1|1|false",
 "a-day-within-a-day/s07-l1": "Think about it. Bennett's office worker works from ten to six. Eight hours.|en|1|1|1|false",
 "a-day-within-a-day/s07-l2": "If those eight are the real day, which part serves which?|en|1|1|1|false",
 "a-day-within-a-day/s07b-l3": "Two thirds of life is placed under one third.|en|1|1|1|false",
 "a-day-within-a-day/s07b-l4": "So the bigger part of your day should not be the leftover.|en|1|1|1|false",
 "a-day-within-a-day/s08-l1": "Part two: a day within a day.|en|1|1|1|false",
 "a-day-within-a-day/s09a-l1": "Bennett's idea is a day within a day.|en|1|1|1|false",
 "a-day-within-a-day/s09-l2": "For his worker, that is sixteen hours, from six in the evening to ten the next morning.|en|1|1|1|false",
 "a-day-within-a-day/s09-l3": "In those hours you are nobody's employee. You are the boss.|en|1|1|1|false",
 "a-day-within-a-day/s09-l4": "Work eight to five or six in Vietnam, with a lunch break? Maybe fourteen or fifteen hours.|en|1|1|1|false",
 "a-day-within-a-day/s09b-l5": "The number matters less than the view. Your day starts when your motorbike leaves the office gate.|en|1|1|1|false",
 "a-day-within-a-day/s10-l1": "Seeing the evening as your own day means filling it with more tasks. True or false?|en|1|1|1|false",
 "a-day-within-a-day/s10-l2": "False. Sleep, family meals and playing with your kids are still in it. You just know it's yours, and you choose.|en|1|1|1|false",
 "a-day-within-a-day/s11-l1": "Six thirty. Home at last.|en|1|1|1|false",
 "a-day-within-a-day/s11-l2": "Dinner was nice. I'm full.|en|1|1|1|false",
 "a-day-within-a-day/s11-l3": "Today is done. Nothing left but my phone.|en|1|1|1|false",
 "a-day-within-a-day/s11-l4": "Wait a second!|en|1|1|1|false",
 "a-day-within-a-day/s11-l5": "An evening treated as the tail of the day gets cut off. It's wasted before you notice.|en|1|1|1|false",
 "a-day-within-a-day/s11-l6": "Let's rewind and try again.|en|1|1|1|false",
 "a-day-within-a-day/s11-l7": "My second day starts now.|en|1|1|1|false",
 "a-day-within-a-day/s11-l8": "Dinner, enough sleep. And eight to nine tonight is mine.|en|1|1|1|false",
 "a-day-within-a-day/s12-l1": "Part three: too tired for anything?|en|1|1|1|false",
 "a-day-within-a-day/s13-l1": "A common belief: study after work, and you'll do worse at your job tomorrow.|en|1|1|1|false",
 "a-day-within-a-day/s13-l2": "Bennett disagrees. Using your mind in the evening does not reduce your work by day.|en|1|1|1|false",
 "a-day-within-a-day/s14-l1": "Look at what you still do after work.|en|1|1|1|false",
 "a-day-within-a-day/s14-l2": "You read the news. You argue in a group chat for an hour.|en|1|1|1|false",
 "a-day-within-a-day/s14-l3": "You watch a long football analysis.|en|1|1|1|false",
 "a-day-within-a-day/s14-l4": "Your mind still has energy. It just hasn't been given a job you chose.|en|1|1|1|false",
 "a-day-within-a-day/s14-l5": "So tired after work doesn't always mean no strength left.|en|1|1|1|false",
 "a-day-within-a-day/s15-l1": "Of course, some days you really are exhausted.|en|1|1|1|false",
 "a-day-within-a-day/s15-l2": "A sick child, an urgent project, little sleep. On those days, rest is right.|en|1|1|1|false",
 "a-day-within-a-day/s15-l3": "Energy differs from person to person. Watch yourself for a few weeks, don't trust one rule.|en|1|1|1|false",
 "a-day-within-a-day/s16-l1": "Part four: the morning ride to work.|en|1|1|1|false",
 "a-day-within-a-day/s17-l1": "Your own day also has a morning.|en|1|1|1|false",
 "a-day-within-a-day/s17-l2": "Bennett saw the ride to work pass in a dull, half awake state, as if the day hadn't started.|en|1|1|1|false",
 "a-day-within-a-day/s17b-l3": "Today: scrolling on the bus, or riding a motorbike with a sleepy mind.|en|1|1|1|false",
 "a-day-within-a-day/s17b-l4": "Thirty minutes to an hour each way. Over a week, that's a lot of time.|en|1|1|1|false",
 "a-day-within-a-day/s18-l1": "Two people, the same forty minute bus ride every morning.|en|1|1|1|false",
 "a-day-within-a-day/s18-a1": "This ride doesn't count. Videos until my stop.|en|1|1|1|false",
 "a-day-within-a-day/s18-a2": "At work already, and I still feel sluggish.|en|1|1|1|false",
 "a-day-within-a-day/s18-b1": "I picked this podcast last night.|en|1|1|1|false",
 "a-day-within-a-day/s18-b2": "Or I look out and think: what do I want tonight?|en|1|1|1|false",
 "a-day-within-a-day/s18-l2": "Both arrive. But the second one walks in with her own day already started.|en|1|1|1|false",
 "a-day-within-a-day/s18-l3": "The morning before work is still your day, not waiting time.|en|1|1|1|false",
 "a-day-within-a-day/s19-l1": "Part five: draw your own day.|en|1|1|1|false",
 "a-day-within-a-day/s20-l1": "Take a sheet of paper. Draw a column from half past five in the evening to eight in the morning.|en|1|1|1|false",
 "a-day-within-a-day/s20-l2": "Step one: shade the fixed parts. The ride home, cooking and dinner, bathing the kids, enough sleep.|en|1|1|1|false",
 "a-day-within-a-day/s20-l3": "Step two: look at the empty parts. After dinner, before bed, a few morning minutes.|en|1|1|1|false",
 "a-day-within-a-day/s20-l4": "Step three: on one slot, write: mine. Eight to nine tonight, for example.|en|1|1|1|false",
 "a-day-within-a-day/s20-l5": "In the first week, one slot is enough. You can only protect free time you can see.|en|1|1|1|false",
 "a-day-within-a-day/s21-l1": "Many people are surprised. Their own day is longer than they thought, even with young kids.|en|1|1|1|false",
 "a-day-within-a-day/s21-l2": "Others find almost no free slot.|en|1|1|1|false",
 "a-day-within-a-day/s21-l3": "Then first, find one fixed task you can shorten. Don't blame yourself.|en|1|1|1|false",
 "a-day-within-a-day/s22-l1": "Last part: what to do this week.|en|1|1|1|false",
 "a-day-within-a-day/s23-l1": "Start with one sentence when you leave the office: My second day starts now.|en|1|1|1|false",
 "a-day-within-a-day/s23-l2": "It sounds small. But it turns the evening from the rest of the day into your part.|en|1|1|1|false",
 "a-day-within-a-day/s24-l1": "Your checklist. See leaving work as the start of a new day.|en|1|1|1|false",
 "a-day-within-a-day/s24-l2": "Choose one slot in your own day.|en|1|1|1|false",
 "a-day-within-a-day/s24-l3": "Protect sleep and family meals. They are important parts of that day.|en|1|1|1|false",
 "a-day-within-a-day/s24-l4": "At the weekend, look back at where your own day went.|en|1|1|1|false",
 "a-day-within-a-day/s25-l1": "Leaving right at five again? Caring about evenings sounds a bit lazy.|en|1|1|1|false",
 "a-day-within-a-day/s25-l2": "I still give my full working hours.|en|1|1|1|false",
 "a-day-within-a-day/s25-l3": "I just choose how my free hours go.|en|1|1|1|false",
 "a-day-within-a-day/s25-l4": "Valuing your own day doesn't mean taking your job lightly. Those hours just don't decide everything.|en|1|1|1|false",
 "a-day-within-a-day/s26-l1": "Three things to remember. Work hours are not the whole day.|en|1|1|1|false",
 "a-day-within-a-day/s26-l2": "From leaving work to the next morning is your own day.|en|1|1|1|false",
 "a-day-within-a-day/s26-l3": "Draw your column, and circle one slot that is yours.|en|1|1|1|false",
 "a-day-within-a-day/s27-l1": "After a long workday you still argue in a group chat for an hour, what does that show?|en|1|1|1|false",
 "a-day-within-a-day/s27-l2": "Your mind still has energy, it just has not been given a job you chose.|en|1|1|1|false",
 "a-day-within-a-day/s27-l3": "Your mind isn't empty. It just needs a job you chose.|en|1|1|1|false",
 "a-day-within-a-day/s28-l1": "Tonight, draw your column and circle one slot. Then try the forty questions!|en|1|1|1|false",
 "active-listening-skills-at-work/s01-l1": "Thảo is on a call with a partner, Sam, about a packaging order.|en|1|1|1|false",
 "active-listening-skills-at-work/s01-l2": "So we'll order five hundred boxes, delivered on Thursday. Okay?|en|1|1|1|false",
 "active-listening-skills-at-work/s01-l3": "On the other end, a second of silence…|en|1|1|1|false",
 "active-listening-skills-at-work/s02-l1": "We'll come back to that silence. Most misunderstandings come from how we listen. So how do you really listen?|en|1|1|1|false",
 "active-listening-skills-at-work/s02-l2": "Put other work aside.|en|1|1|1|false",
 "active-listening-skills-at-work/s02-l3": "Hear the whole sentence.|en|1|1|1|false",
 "active-listening-skills-at-work/s02-l4": "Ask to make things clear.|en|1|1|1|false",
 "active-listening-skills-at-work/s02-l5": "Then repeat and sum up.|en|1|1|1|false",
 "active-listening-skills-at-work/s03-l1": "Six parts: what active listening is, showing you listen, asking,|en|1|1|1|false",
 "active-listening-skills-at-work/s03-l2": "repeating and summing up, feelings, and calls or online meetings.|en|1|1|1|false",
 "active-listening-skills-at-work/s04-l1": "Part one: active listening, and why we miss things.|en|1|1|1|false",
 "active-listening-skills-at-work/s05-l1": "Hearing is letting sound into your ears.|en|1|1|1|false",
 "active-listening-skills-at-work/s05-l2": "Active listening checks you've understood: you ask, you repeat, you sum up.|en|1|1|1|false",
 "active-listening-skills-at-work/s05-l3": "The speaker feels the difference at once.|en|1|1|1|false",
 "active-listening-skills-at-work/s06-l1": "Good listeners redo less work and misunderstand clients less.|en|1|1|1|false",
 "active-listening-skills-at-work/s06-l2": "And colleagues trust them more. Everyone likes talking to someone who really hears them.|en|1|1|1|false",
 "active-listening-skills-at-work/s07-l1": "Looking at your phone or screen while listening.|en|1|1|1|false",
 "active-listening-skills-at-work/s07-l2": "Planning your answer before they finish. Guessing what they'll say.|en|1|1|1|false",
 "active-listening-skills-at-work/s07-l3": "Giving advice when they only need to be understood.|en|1|1|1|false",
 "active-listening-skills-at-work/s07-l4": "And bias, like thinking a new person can't have a good idea.|en|1|1|1|false",
 "active-listening-skills-at-work/s08-l1": "I'm a bit worried about the shipping cost of this plan…|en|1|1|1|false",
 "active-listening-skills-at-work/s08-l2": "The product price is perfectly reasonable!|en|1|1|1|false",
 "active-listening-skills-at-work/s08-l3": "Wait a second!|en|1|1|1|false",
 "active-listening-skills-at-work/s08-l4": "She was talking about shipping, not price. He planned his reply while she was still talking.|en|1|1|1|false",
 "active-listening-skills-at-work/s08-l5": "Let's rewind and try again.|en|1|1|1|false",
 "active-listening-skills-at-work/s08-l6": "I'm a bit worried about the shipping cost of this plan.|en|1|1|1|false",
 "active-listening-skills-at-work/s08-l7": "So your concern is shipping. Could you tell me more about it?|en|1|1|1|false",
 "active-listening-skills-at-work/s08-l8": "Hear the whole sentence, then answer.|en|1|1|1|false",
 "active-listening-skills-at-work/s09-l1": "Noticing these habits in yourself is the first step.|en|1|1|1|false",
 "active-listening-skills-at-work/s09-l2": "Count how many times you interrupt someone in a day.|en|1|1|1|false",
 "active-listening-skills-at-work/s10-l1": "Part two: show the speaker you're really listening.|en|1|1|1|false",
 "active-listening-skills-at-work/s11-l1": "Someone comes to talk about something important. Turn your phone over, turn from the screen, look at them.|en|1|1|1|false",
 "active-listening-skills-at-work/s11-l2": "Yes. I see. And then what?|en|1|1|1|false",
 "active-listening-skills-at-work/s11-l3": "Short words like these help people keep talking.|en|1|1|1|false",
 "active-listening-skills-at-work/s11-l4": "Or, if I'm really busy: I'm in the middle of something urgent. Can I come over in fifteen minutes?|en|1|1|1|false",
 "active-listening-skills-at-work/s11-l5": "Far better than listening while typing. You'd miss details, and they'd feel ignored.|en|1|1|1|false",
 "active-listening-skills-at-work/s12-a1": "A client calls with order details, just as Thảo is typing an email.|en|1|1|1|false",
 "active-listening-skills-at-work/s12-a2": "Yes, yes… mm-hm…|en|1|1|1|false",
 "active-listening-skills-at-work/s12-a3": "“This week, deliver to the new warehouse” slips past. The goods may go to the old one.|en|1|1|1|false",
 "active-listening-skills-at-work/s12-b1": "Or: stop typing, pick up a pen, take notes.|en|1|1|1|false",
 "active-listening-skills-at-work/s12-b2": "Let me repeat the delivery address to check.|en|1|1|1|false",
 "active-listening-skills-at-work/s12-b3": "The email is a few minutes late, but if she misheard, the client fixes it right away.|en|1|1|1|false",
 "active-listening-skills-at-work/s12-b4": "On the phone, take your hands off the keyboard.|en|1|1|1|false",
 "active-listening-skills-at-work/s13-l1": "Part three: asking questions to understand.|en|1|1|1|false",
 "active-listening-skills-at-work/s14-l1": "Open questions get people to say more.|en|1|1|1|false",
 "active-listening-skills-at-work/s14-l2": "“Could you tell me more about the problem the client is facing?”|en|1|1|1|false",
 "active-listening-skills-at-work/s14-l3": "“How do you picture the final result?”|en|1|1|1|false",
 "active-listening-skills-at-work/s14-l4": "Clarifying questions pin down details.|en|1|1|1|false",
 "active-listening-skills-at-work/s14-l5": "“Is the deadline the end of Friday, or Monday morning?” “Do I send the report to you, or straight to the client?”|en|1|1|1|false",
 "active-listening-skills-at-work/s15-l1": "Asking about details when you get a task wastes time. True or false?|en|1|1|1|false",
 "active-listening-skills-at-work/s15-l2": "False. Ten seconds of asking can save two days of work in the wrong direction.|en|1|1|1|false",
 "active-listening-skills-at-work/s16-l1": "Part four: repeating and summing up.|en|1|1|1|false",
 "active-listening-skills-at-work/s17-l1": "Repeating means saying the main point in your own words, then asking if it's right.|en|1|1|1|false",
 "active-listening-skills-at-work/s17-l2": "As I understand it, you need a price comparison of three suppliers, focused on shipping,|en|1|1|1|false",
 "active-listening-skills-at-work/s17-l3": "for the director on Wednesday. Is that right?|en|1|1|1|false",
 "active-listening-skills-at-work/s17-l4": "If it's wrong, she corrects you at once. If it's right, she relaxes.|en|1|1|1|false",
 "active-listening-skills-at-work/s18-l1": "A summary goes at the end of a talk or a meeting: who does what, by when.|en|1|1|1|false",
 "active-listening-skills-at-work/s18-l2": "“So we agree on three things: I do the comparison, Hùng contacts suppliers, you approve by Wednesday.”|en|1|1|1|false",
 "active-listening-skills-at-work/s19-l1": "Back to Thảo's call, and that second of silence.|en|1|1|1|false",
 "active-listening-skills-at-work/s19-l2": "No, five hundred cartons. Fifty boxes in each.|en|1|1|1|false",
 "active-listening-skills-at-work/s19-l3": "Five hundred cartons. Thank you! I'll fix it now.|en|1|1|1|false",
 "active-listening-skills-at-work/s19-l4": "They fixed it while still on the phone. Now Thảo always confirms numbers and dates before hanging up.|en|1|1|1|false",
 "active-listening-skills-at-work/s19-l5": "One summary sentence can save a whole order.|en|1|1|1|false",
 "active-listening-skills-at-work/s20-l1": "Part five: listening for feelings, not just facts.|en|1|1|1|false",
 "active-listening-skills-at-work/s21-l1": "A client complains about a late delivery. He needs the goods, and he needs respect.|en|1|1|1|false",
 "active-listening-skills-at-work/s21-l2": "Notice his voice, his face, and what he stresses. Then gently name the feeling.|en|1|1|1|false",
 "active-listening-skills-at-work/s21-l3": "I understand you're very upset, because you promised your own client last week.|en|1|1|1|false",
 "active-listening-skills-at-work/s21-l4": "Alright. Let's talk calmly about what to do.|en|1|1|1|false",
 "active-listening-skills-at-work/s21-l5": "Naming a feeling isn't agreeing with everything. It shows you understand, so you can solve it together.|en|1|1|1|false",
 "active-listening-skills-at-work/s22-l1": "A difficult client just yelled at me on the phone…|en|1|1|1|false",
 "active-listening-skills-at-work/s22-l2": "You should do this, and this. That's the right way.|en|1|1|1|false",
 "active-listening-skills-at-work/s22-l3": "Wait a second!|en|1|1|1|false",
 "active-listening-skills-at-work/s22-l4": "Advice too soon can feel like blame. He may stop telling you.|en|1|1|1|false",
 "active-listening-skills-at-work/s22-l5": "Let's rewind and try again.|en|1|1|1|false",
 "active-listening-skills-at-work/s22-l6": "That sounds tiring. Do you want me to just listen, or would you like my advice?|en|1|1|1|false",
 "active-listening-skills-at-work/s22-l7": "People need to feel understood before they need advice.|en|1|1|1|false",
 "active-listening-skills-at-work/s23-l1": "Part six: listening on the phone and online.|en|1|1|1|false",
 "active-listening-skills-at-work/s24-l1": "Without faces, it's harder to focus.|en|1|1|1|false",
 "active-listening-skills-at-work/s24-l2": "Close unrelated tabs. Take notes by hand.|en|1|1|1|false",
 "active-listening-skills-at-work/s24-l3": "At the end, repeat the key numbers and dates.|en|1|1|1|false",
 "active-listening-skills-at-work/s25-l1": "Practise daily. One meeting with no interrupting. Note each person's main idea.|en|1|1|1|false",
 "active-listening-skills-at-work/s25-l2": "Repeat every task back before you start it.|en|1|1|1|false",
 "active-listening-skills-at-work/s25-l3": "When a colleague talks, ask one more question before giving your view.|en|1|1|1|false",
 "active-listening-skills-at-work/s25-l4": "At the weekend: when did I misunderstand, and why?|en|1|1|1|false",
 "active-listening-skills-at-work/s26-l1": "So what you are saying is…|en|1|1|1|false",
 "active-listening-skills-at-work/s26-l2": "Could you tell me more about that?|en|1|1|1|false",
 "active-listening-skills-at-work/s26-l3": "Just to confirm, the deadline is Friday, right?|en|1|1|1|false",
 "active-listening-skills-at-work/s26-l4": "That sounds really stressful.|en|1|1|1|false",
 "active-listening-skills-at-work/s27-l1": "Hear it all, then answer.|en|1|1|1|false",
 "active-listening-skills-at-work/s27-l2": "On the phone, hands off the keyboard.|en|1|1|1|false",
 "active-listening-skills-at-work/s27-l3": "One summary can save a whole order.|en|1|1|1|false",
 "active-listening-skills-at-work/s27-l4": "Understanding first, advice later.|en|1|1|1|false",
 "active-listening-skills-at-work/s28-l1": "What risk comes with typing an email while a client explains an order?|en|1|1|1|false",
 "active-listening-skills-at-work/s28-l2": "You may miss a detail like the new warehouse and deliver to the old one.|en|1|1|1|false",
 "active-listening-skills-at-work/s28-l3": "On the phone, take your hands off the keyboard and take notes.|en|1|1|1|false",
 "active-listening-skills-at-work/s29-l1": "In your next work talk, say: let me sum up. Then confirm three main points.|en|1|1|1|false",
 "active-listening-skills-at-work/s29-l2": "Then try the forty questions below.|en|1|1|1|false",
 "active-recall-vs-rereading/s01-l1": "Exam day. For months, Thao reread her textbook every night and highlighted almost everything.|en|1|1|1|false",
 "active-recall-vs-rereading/s01-l2": "This looks familiar. But is it A, or B?|en|1|1|1|false",
 "active-recall-vs-rereading/s01-l3": "She failed by a few points. Why does so much reading still leave us forgetting?|en|1|1|1|false",
 "active-recall-vs-rereading/s02-l1": "Rereading only makes the page look familiar. What helps you remember is this.|en|1|1|1|false",
 "active-recall-vs-rereading/s02-l2": "Close the book.|en|1|1|1|false",
 "active-recall-vs-rereading/s02-l3": "Pull the ideas out of your own head.|en|1|1|1|false",
 "active-recall-vs-rereading/s02-l4": "Then open it and check. This is called active recall.|en|1|1|1|false",
 "active-recall-vs-rereading/s03-l1": "Here is our route today, in six stops.|en|1|1|1|false",
 "active-recall-vs-rereading/s04-l1": "Part one: why do we forget after reading so many times?|en|1|1|1|false",
 "active-recall-vs-rereading/s05-l1": "By the third reading, Thao's eyes fly over the page. Every word looks familiar.|en|1|1|1|false",
 "active-recall-vs-rereading/s05-l2": "Easy. I already know all of this.|en|1|1|1|false",
 "active-recall-vs-rereading/s05-l3": "That smooth feeling is easy to mistake for understanding, or remembering.|en|1|1|1|false",
 "active-recall-vs-rereading/s06-l1": "Recognising an idea on the page is one skill. Saying it from memory is another.|en|1|1|1|false",
 "active-recall-vs-rereading/s06-l2": "In an exam or a meeting, there is no page to look at.|en|1|1|1|false",
 "active-recall-vs-rereading/s07-l1": "Work almost always needs the second kind: recall.|en|1|1|1|false",
 "active-recall-vs-rereading/s07-l2": "At an exam.|en|1|1|1|false",
 "active-recall-vs-rereading/s07-l3": "When a customer asks.|en|1|1|1|false",
 "active-recall-vs-rereading/s07-l4": "In a meeting. You only get good at recall by practising recall.|en|1|1|1|false",
 "active-recall-vs-rereading/s08-l1": "Every question looks familiar, so you know the material. True or false?|en|1|1|1|false",
 "active-recall-vs-rereading/s08-l2": "False. In months of study, Thao never once closed the book to answer a question.|en|1|1|1|false",
 "active-recall-vs-rereading/s08-l3": "Familiar words are not memory yet.|en|1|1|1|false",
 "active-recall-vs-rereading/s09-l1": "Part two: so how do you study by recalling?|en|1|1|1|false",
 "active-recall-vs-rereading/s10-l1": "Read one short part, with full focus.|en|1|1|1|false",
 "active-recall-vs-rereading/s10-l2": "Close it, and write three main points in your own words.|en|1|1|1|false",
 "active-recall-vs-rereading/s10-l3": "Open it, compare, and mark what you missed or got wrong.|en|1|1|1|false",
 "active-recall-vs-rereading/s11-l1": "I missed one point. Let me turn it into a question.|en|1|1|1|false",
 "active-recall-vs-rereading/s11-l2": "After how many days does a customer need a receipt to exchange goods?|en|1|1|1|false",
 "active-recall-vs-rereading/s11-l3": "Tomorrow, she answers these questions again before she starts anything new.|en|1|1|1|false",
 "active-recall-vs-rereading/s12-l1": "For skills, recall means doing it without the guide, then checking to fix it.|en|1|1|1|false",
 "active-recall-vs-rereading/s12-l2": "Rebuild the spreadsheet formula yourself.|en|1|1|1|false",
 "active-recall-vs-rereading/s12-l3": "Say your English introduction again from memory.|en|1|1|1|false",
 "active-recall-vs-rereading/s12-l4": "For new words, cover the meaning and say an example sentence before you turn it over.|en|1|1|1|false",
 "active-recall-vs-rereading/s13-l1": "Not a whole list from top to bottom. Studying alone, tell yourself:|en|1|1|1|false",
 "active-recall-vs-rereading/s13-l2": "Let me try without looking.|en|1|1|1|false",
 "active-recall-vs-rereading/s14-l1": "Part three: recall feels hard. Am I doing it wrong?|en|1|1|1|false",
 "active-recall-vs-rereading/s15-l1": "Needing a moment to think is a good sign.|en|1|1|1|false",
 "active-recall-vs-rereading/s15-l2": "The effort of pulling it out makes the memory stronger.|en|1|1|1|false",
 "active-recall-vs-rereading/s15-l3": "It looks slower than rereading, but more stays in your head.|en|1|1|1|false",
 "active-recall-vs-rereading/s16-l1": "I closed the book, and I remember nothing at all.|en|1|1|1|false",
 "active-recall-vs-rereading/s16-l2": "The difficulty only needs to match your level.|en|1|1|1|false",
 "active-recall-vs-rereading/s16-l3": "Read that part once more, then try again. Don't stare at a blank page until you give up.|en|1|1|1|false",
 "active-recall-vs-rereading/s17-l1": "Many people think: so many wrong answers, this method is not for me.|en|1|1|1|false",
 "active-recall-vs-rereading/s17-l2": "In fact, many mistakes in the first weeks are normal.|en|1|1|1|false",
 "active-recall-vs-rereading/s18-l1": "Rereading feels good because every word is familiar. Self-testing shows at once what you don't remember yet.|en|1|1|1|false",
 "active-recall-vs-rereading/s18-l2": "Memory research says trying and failing, then seeing the answer, still beats just rereading.|en|1|1|1|false",
 "active-recall-vs-rereading/s18-l3": "So write down the questions you got wrong.|en|1|1|1|false",
 "active-recall-vs-rereading/s18-l4": "And ask them again tomorrow. If it feels a little hard, you are really learning.|en|1|1|1|false",
 "active-recall-vs-rereading/s19-l1": "Part four: where do beginners slip when they test themselves?|en|1|1|1|false",
 "active-recall-vs-rereading/s20-l1": "Right after reading, the answer is still in front of your eyes. Wait a few minutes.|en|1|1|1|false",
 "active-recall-vs-rereading/s20-l2": "Checking after two seconds is just recognising. Think for half a minute.|en|1|1|1|false",
 "active-recall-vs-rereading/s20-l3": "Write a guess, even if you are not sure. Then look.|en|1|1|1|false",
 "active-recall-vs-rereading/s20-l4": "Questions you already know feel nice, but teach you nothing new.|en|1|1|1|false",
 "active-recall-vs-rereading/s20-l5": "Spend more time on the ones you often miss.|en|1|1|1|false",
 "active-recall-vs-rereading/s21-l1": "Dung sells home appliances. He has a set of product cards.|en|1|1|1|false",
 "active-recall-vs-rereading/s21-l2": "How does the warranty on this washing machine work?|en|1|1|1|false",
 "active-recall-vs-rereading/s21-l3": "Let me just flip it. Ah, right, I knew that.|en|1|1|1|false",
 "active-recall-vs-rereading/s21-l4": "Wait a second!|en|1|1|1|false",
 "active-recall-vs-rereading/s21-l5": "Flipping before you try is just rereading in another form.|en|1|1|1|false",
 "active-recall-vs-rereading/s21-l6": "Let's rewind and try again.|en|1|1|1|false",
 "active-recall-vs-rereading/s21-l7": "Read the question. Cover the back. Say my answer out loud, even if I'm not sure.|en|1|1|1|false",
 "active-recall-vs-rereading/s21-l8": "Flip, and compare each point I said with the back.|en|1|1|1|false",
 "active-recall-vs-rereading/s21-l9": "I hesitated, so this one goes in tomorrow's pile.|en|1|1|1|false",
 "active-recall-vs-rereading/s22-l1": "Right and quick? Review it in a few days.|en|1|1|1|false",
 "active-recall-vs-rereading/s22-l2": "Wrong or slow? See it again tomorrow.|en|1|1|1|false",
 "active-recall-vs-rereading/s22-l3": "Say the answer first. Turn the card after.|en|1|1|1|false",
 "active-recall-vs-rereading/s23-l1": "Part five: using recall with work documents and training.|en|1|1|1|false",
 "active-recall-vs-rereading/s24-l1": "Before the next training, write everything you remember, for five minutes.|en|1|1|1|false",
 "active-recall-vs-rereading/s24-l2": "Then open the slides, and read carefully only what you forgot.|en|1|1|1|false",
 "active-recall-vs-rereading/s24-l3": "Same fifteen minutes, but now you know exactly what is missing.|en|1|1|1|false",
 "active-recall-vs-rereading/s24-l4": "Going through the slides only makes you feel calm.|en|1|1|1|false",
 "active-recall-vs-rereading/s25-l1": "Could you ask me three questions about this process? I want to see how much I remember.|en|1|1|1|false",
 "active-recall-vs-rereading/s25-l2": "Sure. Close your notes first.|en|1|1|1|false",
 "active-recall-vs-rereading/s25-l3": "Very close to real work: someone asks, you answer from memory.|en|1|1|1|false",
 "active-recall-vs-rereading/s26-l1": "New staff in customer care have one week to learn the complaint process.|en|1|1|1|false",
 "active-recall-vs-rereading/s26-l2": "I read it four times and highlighted the key lines. It all feels so familiar!|en|1|1|1|false",
 "active-recall-vs-rereading/s26-l3": "But a situation question... I need a long time to think.|en|1|1|1|false",
 "active-recall-vs-rereading/s26-l4": "I read each step once, then make questions.|en|1|1|1|false",
 "active-recall-vs-rereading/s26-l5": "A customer calls a third time about the same fault. Who gets it? I ask my family to test me.|en|1|1|1|false",
 "active-recall-vs-rereading/s26-l6": "The Friday test used exactly that kind of question. Option B answered almost all of them.|en|1|1|1|false",
 "active-recall-vs-rereading/s27-l1": "Uncle Dung, question three! A customer calls a third time about one fault.|en|1|1|1|false",
 "active-recall-vs-rereading/s27-l2": "Don't show me the paper. Let me answer from memory.|en|1|1|1|false",
 "active-recall-vs-rereading/s27-l3": "Practise the way you will be asked.|en|1|1|1|false",
 "active-recall-vs-rereading/s28-l1": "Part six: should you stop rereading and highlighting?|en|1|1|1|false",
 "active-recall-vs-rereading/s29-l1": "To remember for longer, stop rereading completely. True or false?|en|1|1|1|false",
 "active-recall-vs-rereading/s29-l2": "False. One careful reading is still needed to understand. Just don't make rereading your main review.|en|1|1|1|false",
 "active-recall-vs-rereading/s29-l3": "Reread with a purpose: only the parts you just recalled wrongly.|en|1|1|1|false",
 "active-recall-vs-rereading/s30-l1": "Highlighting too: finish a part, close it, write the key idea in the margin.|en|1|1|1|false",
 "active-recall-vs-rereading/s30-l2": "Highlight only what you could not remember.|en|1|1|1|false",
 "active-recall-vs-rereading/s30-l3": "When everything stands out, nothing stands out.|en|1|1|1|false",
 "active-recall-vs-rereading/s31-l1": "Rereading trains recognising. Real life asks you to recall.|en|1|1|1|false",
 "active-recall-vs-rereading/s31-l2": "Familiar words are not memory yet.|en|1|1|1|false",
 "active-recall-vs-rereading/s31-l3": "Say the answer first, turn the card after.|en|1|1|1|false",
 "active-recall-vs-rereading/s31-l4": "Practise the way you will be asked.|en|1|1|1|false",
 "active-recall-vs-rereading/s32-l1": "Do it now: before your next session, take five minutes to write everything you remember.|en|1|1|1|false",
 "active-recall-vs-rereading/s33-l1": "Why did option B fit the final test so well?|en|1|1|1|false",
 "active-recall-vs-rereading/s33-l2": "The test used situation questions, and they had practised answering exactly that kind.|en|1|1|1|false",
 "active-recall-vs-rereading/s33-l3": "The answers still came from their own memory.|en|1|1|1|false",
 "active-recall-vs-rereading/s34-l1": "Now close the book. Forty questions are waiting below.|en|1|1|1|false",
 "after-the-business-trip/s01-l1": "Dũng is back from his trip. Tired, inbox full, old work piling up.|en|1|1|1|false",
 "after-the-business-trip/s01-l2": "I'll write the thank-you email next week, when I'm less busy.|en|1|1|1|false",
 "after-the-business-trip/s01-l3": "One week passed. Then two. What happened? We'll see soon.|en|1|1|1|false",
 "after-the-business-trip/s02-l1": "What should you do after a business trip? The results are only starting. Four things:|en|1|1|1|false",
 "after-the-business-trip/s02-l2": "thanks and a summary within a day or two,|en|1|1|1|false",
 "after-the-business-trip/s02-l3": "a report with the result first,|en|1|1|1|false",
 "after-the-business-trip/s02-l4": "follow every promise,|en|1|1|1|false",
 "after-the-business-trip/s02-l5": "and share what you learned.|en|1|1|1|false",
 "after-the-business-trip/s03-l1": "We go in order: the first days back, the report, the promises,|en|1|1|1|false",
 "after-the-business-trip/s03-l2": "sharing, paperwork, and one month later.|en|1|1|1|false",
 "after-the-business-trip/s04-l1": "Part one: what to do first.|en|1|1|1|false",
 "after-the-business-trip/s05-l1": "Within a day or two, email the partner: thanks, a summary of what was agreed, and the next steps. Then both sides have the same record.|en|1|1|1|false",
 "after-the-business-trip/s05-l2": "Thank you for your time last week.|en|1|1|1|false",
 "after-the-business-trip/s05-l3": "As agreed, we will send the updated quote by Friday, and your team will share the test results.|en|1|1|1|false",
 "after-the-business-trip/s05-l4": "Please let me know if I missed anything.|en|1|1|1|false",
 "after-the-business-trip/s06-l1": "Put your notes, photos of business cards and documents into one clearly named shared folder.|en|1|1|1|false",
 "after-the-business-trip/s06-l2": "Do it in the first week. Leave notes in your bag for weeks, and they get lost, or you forget what they mean.|en|1|1|1|false",
 "after-the-business-trip/s06b-l3": "Jet lag is normal. On day one, do light tasks like sorting email. Big decisions can wait a day.|en|1|1|1|false",
 "after-the-business-trip/s07-l1": "Back to Dũng. When he finally wrote, the partner had already met another supplier.|en|1|1|1|false",
 "after-the-business-trip/s07-l2": "Their reply is polite, but cool. No word about meeting again…|en|1|1|1|false",
 "after-the-business-trip/s08-l1": "Say thanks while it's still warm, so the chance doesn't go cold.|en|1|1|1|false",
 "after-the-business-trip/s09-l1": "Part two: a report your manager can use.|en|1|1|1|false",
 "after-the-business-trip/s10-l1": "First, ask your manager: what format, and by when? One page, slides, or an email? One question saves a rewrite.|en|1|1|1|false",
 "after-the-business-trip/s10-l2": "Then a one-page frame. The goal, who you met, and what you did.|en|1|1|1|false",
 "after-the-business-trip/s10-l3": "Main results, compared with the goal.|en|1|1|1|false",
 "after-the-business-trip/s10-l4": "What you learned about the partner and the market.|en|1|1|1|false",
 "after-the-business-trip/s10-l5": "Next steps with owners and deadlines, and decisions your manager must make.|en|1|1|1|false",
 "after-the-business-trip/s11-l0": "So, how was the trip?|en|1|1|1|false",
 "after-the-business-trip/s11-l1": "Day one, we arrived at nine, visited the factory, then had lunch…|en|1|1|1|false",
 "after-the-business-trip/s11-l2": "Wait a second!|en|1|1|1|false",
 "after-the-business-trip/s11-l3": "Busy people read only the first lines. Start with the result.|en|1|1|1|false",
 "after-the-business-trip/s11-l4": "Let's rewind and try again.|en|1|1|1|false",
 "after-the-business-trip/s11-l5": "Result: the partner agreed to a trial order. They're waiting for our quote by month end.|en|1|1|1|false",
 "after-the-business-trip/s11-l6": "I need your approval on the discount by Friday.|en|1|1|1|false",
 "after-the-business-trip/s11-l7": "What we got, what to decide, by when. The daily story goes in an appendix.|en|1|1|1|false",
 "after-the-business-trip/s12-l1": "A trip report should share only good news. True or false?|en|1|1|1|false",
 "after-the-business-trip/s12-l2": "False. Say honestly what wasn't reached, why, and what you suggest. Otherwise your boss decides wrongly, and the truth comes out later.|en|1|1|1|false",
 "after-the-business-trip/s13-l1": "Results first. The daily story later.|en|1|1|1|false",
 "after-the-business-trip/s14-l1": "Part three: tracking every promise.|en|1|1|1|false",
 "after-the-business-trip/s15-l1": "Make a next-steps table: the task, who does it, our side or theirs, the deadline, and the status.|en|1|1|1|false",
 "after-the-business-trip/s15-l2": "Share it with everyone involved. Each person knows their part, and work goes on even when you're busy.|en|1|1|1|false",
 "after-the-business-trip/s16-l1": "Your promise is late? Tell them early, with a clear new date.|en|1|1|1|false",
 "after-the-business-trip/s16-l2": "We need two more days for the quote. You will have it by Wednesday.|en|1|1|1|false",
 "after-the-business-trip/s16-l3": "Their promise hasn't arrived? A few days after the deadline, send a friendly reminder. Offer help, don't blame.|en|1|1|1|false",
 "after-the-business-trip/s16-l4": "I'm following up on the test results we discussed. Is there anything you need from us?|en|1|1|1|false",
 "after-the-business-trip/s16-l5": "A reminder moves work forward. A complaint creates tension.|en|1|1|1|false",
 "after-the-business-trip/s17-l1": "Nhung promised the partner product materials within the week.|en|1|1|1|false",
 "after-the-business-trip/s17-l2": "Back home, meetings and old work pulled her away. The promise slipped.|en|1|1|1|false",
 "after-the-business-trip/s17-l3": "The partner reminded her twice by email. No answer, so they messaged her manager directly.|en|1|1|1|false",
 "after-the-business-trip/s17-l4": "Set a calendar reminder for every deadline, as soon as you make the table. Memory isn't enough.|en|1|1|1|false",
 "after-the-business-trip/s18-l1": "Every promise has a deadline. Every deadline has a reminder.|en|1|1|1|false",
 "after-the-business-trip/s19-l1": "Part four: share what you learned.|en|1|1|1|false",
 "after-the-business-trip/s20-l1": "Hold a short session or send notes: the partner's work habits, who decides, what to avoid, and what tech or accounting need to know.|en|1|1|1|false",
 "after-the-business-trip/s20-l2": "Update the company system: names, titles, how they like to be contacted. Work details only. No private stories from dinner.|en|1|1|1|false",
 "after-the-business-trip/s20-l3": "And lessons for next time: what to bring, which days were too busy, which questions to prepare. The next traveller may be you.|en|1|1|1|false",
 "after-the-business-trip/s21-l1": "On his last night at the hotel, Quân spent twenty minutes. Who is who: Ms Lee decides prices; Mr Park handles technical things and likes data by email.|en|1|1|1|false",
 "after-the-business-trip/s21-l2": "What was agreed, what is open: samples yes, payment terms not yet.|en|1|1|1|false",
 "after-the-business-trip/s21-l3": "He put it in the shared system, with the client's name and date. Months later he changed teams, and a colleague carried on at once.|en|1|1|1|false",
 "after-the-business-trip/s22-l1": "What stays in your head is easily lost. What you write becomes shared value.|en|1|1|1|false",
 "after-the-business-trip/s23-l1": "Part five: paperwork.|en|1|1|1|false",
 "after-the-business-trip/s24-l1": "Submit your expense claim and settle any advance within the deadline. Do it alongside the report, not at month end.|en|1|1|1|false",
 "after-the-business-trip/s24-l2": "Return what was lent for the trip: laptop, SIM card, company card. Tell the person in charge, and note the date.|en|1|1|1|false",
 "after-the-business-trip/s25-l1": "Last part: one month later.|en|1|1|1|false",
 "after-the-business-trip/s26-l1": "About a month later, open the table again. How many tasks are done? Is the partner moving forward?|en|1|1|1|false",
 "after-the-business-trip/s26-l2": "Here is a short update: what is done, and how the partner is moving.|en|1|1|1|false",
 "after-the-business-trip/s26-l3": "Thank you. That helps.|en|1|1|1|false",
 "after-the-business-trip/s26-l4": "Trip results usually come after the trip: quotes, tests and replies take weeks.|en|1|1|1|false",
 "after-the-business-trip/s27-l1": "Ask yourself three questions. Look for lessons, not people to blame.|en|1|1|1|false",
 "after-the-business-trip/s27-l2": "What went well, and should stay?|en|1|1|1|false",
 "after-the-business-trip/s27-l3": "What will you do differently next time?|en|1|1|1|false",
 "after-the-business-trip/s27-l4": "What do you need to learn? Three short answers: your clearest step forward.|en|1|1|1|false",
 "after-the-business-trip/s28-l1": "Thanks and a summary within two days. File the materials. Report, result first.|en|1|1|1|false",
 "after-the-business-trip/s28-l2": "A task table with reminders. Share. Submit expenses. And look back after a month.|en|1|1|1|false",
 "after-the-business-trip/s29-l1": "Dũng waited two weeks, and the chance went cold. Say thanks while it's warm.|en|1|1|1|false",
 "after-the-business-trip/s29-l2": "Results first, the story later.|en|1|1|1|false",
 "after-the-business-trip/s29-l3": "Every promise has a deadline and a reminder.|en|1|1|1|false",
 "after-the-business-trip/s30-l1": "Where should you put the main conclusion in your trip report?|en|1|1|1|false",
 "after-the-business-trip/s30-l2": "At the very top, because busy readers often read only the first lines.|en|1|1|1|false",
 "after-the-business-trip/s30-l3": "At the end, it is easy to miss.|en|1|1|1|false",
 "after-the-business-trip/s31-l1": "Your turn. Forty questions are waiting below.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s01-l1": "The shop is quiet today, Lan. You can go home early.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s01-l2": "Oh. Okay.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s01-l3": "Half a shift gone, for being a few minutes late?|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s01-l4": "And you? Two weeks of unpaid trial, then: not suitable.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s01-l5": "Three people. One common mistake.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s02-l1": "None of them asked first. So before day one, what should you ask?|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s02-l2": "Pay and the trial.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s02-l3": "Shifts, swaps, and cuts.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s02-l4": "Any fines.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s02-l5": "Papers. Then put it all in one message.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s03-l1": "Six stops: prepare, pay, shifts,|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s03-l2": "fines, papers, and a check after week one.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s04-l1": "Part one: before the meeting.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s05-l1": "Tomorrow I meet the manager. What if I forget everything?|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s05-l2": "Many people get nervous and forget, or feel shy to ask.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s05-l3": "I'll write my questions in my phone.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s05-l4": "With a list, you just look and ask.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s05-l5": "Done. Now I'm ready.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s06-l1": "Do you know someone who works there, or used to?|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s06-l2": "Dũng, you worked there. Is the pay on time?|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s06-l3": "And does the manager change shifts suddenly?|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s06-l4": "Good questions. They never come up in the interview.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s06-l5": "People inside often know what the interview does not say.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s07-l1": "Part two: pay, and the trial.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s08-l1": "By the hour, the shift, or by sales? Each way gives a different income.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s08-l2": "Which day is payday? Cash or bank transfer?|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s08-l3": "Is overtime, or a holiday, paid differently?|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s08-l4": "Any bonus, or money for meals and parking?|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s09-l1": "Here is a sample question.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s09-l2": "Could you tell me whether pay is hourly or by shift, and which day it comes?|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s10-l1": "Asking about pay makes the manager dislike you. True or false?|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s10-l2": "False. Ask calmly, like asking about opening hours. Fair managers expect it.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s10-l3": "Asking clearly shows you take the job seriously.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s11-l1": "Hourly pay also has a floor.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s11-l2": "From January 2026, it is seventeen thousand eight hundred to twenty-five thousand five hundred dong an hour.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s12-l1": "Ask about the trial on its own. How long is it?|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s12-l2": "Is it paid?|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s12-l3": "How is the pay counted?|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s12-l4": "And who tells you the result at the end?|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s13-l1": "By law, trial pay is at least eighty-five percent.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s13-l2": "Eighty-five percent of the pay for that job.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s14-l1": "For jobs like serving or sales, the trial is six working days at most.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s14-l2": "A job under one month has no trial.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s14-l3": "A long unpaid trial? Think carefully, and ask an official source.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s15-l1": "Think about this. A drink shop offers you two weeks of unpaid trial.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s15-l2": "You work every shift. You wash glasses and clean tables.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s15-l3": "Then the manager says: you are not suitable. What do you get?|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s16-l1": "Nothing at all. Two weeks of work, for free.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s16-l2": "Some shops always have someone on trial, because new people keep coming and going.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s16-l3": "So ask: is it paid, and how?|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s16-l4": "If it is free work, you can say no.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s17-l1": "Real work means real pay, even in a trial.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s18-l1": "Part three: shifts, swaps, and cuts.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s19-l1": "How many shifts a week, at least? When do you sign up?|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s19-l2": "To swap a shift: how early, and who do you tell?|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s19-l3": "Know the rules early, and swaps go smoothly.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s20-l1": "You will be paid by the hour.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s20-l2": "How much per hour? That's all I need. Thank you!|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s20-l3": "Wait a second!|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s20-l4": "On quiet days, Lan goes home early. Those hours are not paid.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s20-l5": "Let's rewind and try again.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s20-l6": "If the shop is quiet and I go home early, how is my pay counted?|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s20-l7": "Ask about busy days, and quiet days too.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s21-l1": "Lan signed up for six shifts of four hours. That is twenty-four hours a week.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s21-l2": "She planned on ninety-six hours a month.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s21-l3": "But about seven hours a week were cut. She was paid for about sixty-eight.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s21-l4": "Almost a third less. She had to ask her parents for rent money.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s22-l1": "Part four: fines and pay cuts.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s23-l1": "Ask to see the rules. Clear rules protect both sides.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s23-l2": "A new decision each time? That is the worry.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s24-l1": "Every fine a shop sets is valid. True or false?|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s24-l2": "False. The law bans fines and pay cuts as discipline.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s24-l3": "Pay can only be cut to cover broken tools or equipment, by the rules.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s24-l4": "A fine sounds too heavy? Ask again, think first, and check an official source.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s25-l1": "Half a shift for a few minutes late?|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s25-l2": "And one broken glass costs many times its price?|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s25-l3": "The fine list is on the wall in the storeroom.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s25-l4": "Dũng never asked about fines. And nobody showed him the list.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s26-l1": "Know the fine rules first, avoid unfair cuts later.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s27-l1": "Part five: papers. What to give, what to keep.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s28-l1": "Under one month: an agreement by word is possible.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s28-l2": "One month or more: a written contract.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s29-l1": "From July 2025, you also join social insurance, if your monthly pay is high enough.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s29-l2": "Either way, keep at least one message with the main points.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s29-l3": "A contract on day one? Read it all before you sign, and keep a copy.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s30-l1": "Let me write down what we agreed.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s30-l2": "Pay by the hour, a paid one-week trial, paid on the fifth.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s30-l3": "Evening shifts on Tuesday, Thursday, and Saturday. Two days notice to swap.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s30-l4": "If I got anything wrong, please correct me.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s30-l5": "Yes, that is right.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s30-l6": "Asking her to correct you is polite. And mistakes are fixed before day one.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s31-a1": "Leave your ID card with me, just to be safe.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s31-a2": "Sure, here is the original.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s31-n1": "When he leaves, he may hear: come back tomorrow. Again and again.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s31-n2": "Meanwhile, no bank paperwork, nothing that needs the ID.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s31-b1": "Leave your ID card with me, just to be safe.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s31-b2": "Here is a copy for your file. I need the original for paperwork.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s31-n3": "The shop's file is complete. The important paper stays with you.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s32-l1": "An employer may not keep the original ID card of a worker.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s32-l2": "Leave the copy, take the original home.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s33-l1": "Last part: check after your first week.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s34-l1": "End of week one: compare your notes with the shop's timesheet, if you can see it.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s34-l2": "A small gap? Ask now, while everyone still remembers the shift.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s34-l3": "First payday: compare the money with your message.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s35-l1": "If it is different, ask gently.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s35-l2": "My pay this month seems different from what we agreed. Could you check it?|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s35-l3b": "Still not right? The lesson on late or unfair pay has the next steps.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s36-l1": "Your checklist: pay and payday, a paid trial, shifts,|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s36-l2": "fine rules, a confirmation message, and only copies of papers.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s36-l3": "Open it before every new job.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s37-l1": "Real work, real pay, even in a trial.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s37-l2": "Ask about busy days, and quiet days.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s37-l3": "Leave the copy, take the original home.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s38-l1": "If a cafe says you are not suitable after an unpaid trial, what do you receive?|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s38-l2": "Nothing at all, because your two weeks of real work become free work.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s38-l3": "So ask if the trial is paid. Real work means real pay.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s40-l1": "A few questions take a few minutes, and save you a whole month of guessing.|en|1|1|1|false",
 "agree-pay-shifts-before-starting/s40-l2": "Your turn. Forty questions are waiting below.|en|1|1|1|false",
 "airport-check-in-first-time/s01-l1": "I'm early, and this is the gate on my pass. Time for a film!|en|1|1|1|false",
 "airport-check-in-first-time/s01-l2": "Thảo puts headphones in both ears and stops looking at the screens.|en|1|1|1|false",
 "airport-check-in-first-time/s01-l3": "Meanwhile, on the screen, her gate starts to change...|en|1|1|1|false",
 "airport-check-in-first-time/s02-l1": "Will Thảo make it? First: what are the airport steps?|en|1|1|1|false",
 "airport-check-in-first-time/s02-l2": "Check in and drop your bags.|en|1|1|1|false",
 "airport-check-in-first-time/s02-l3": "Exit immigration, then security.|en|1|1|1|false",
 "airport-check-in-first-time/s02-l4": "Walk to the gate and board.|en|1|1|1|false",
 "airport-check-in-first-time/s02-l5": "Then immigration, your suitcase, and customs.|en|1|1|1|false",
 "airport-check-in-first-time/s03-l1": "Six stops, from your front door to the arrivals hall.|en|1|1|1|false",
 "airport-check-in-first-time/s03-l2": "With the short English lines you'll hear, and need to say.|en|1|1|1|false",
 "airport-check-in-first-time/s04-l1": "Part one: before you leave home.|en|1|1|1|false",
 "airport-check-in-first-time/s05-l1": "Many airlines let you check in online. Your boarding pass is on your phone.|en|1|1|1|false",
 "airport-check-in-first-time/s05-l2": "Then you only drop your bags at the desk.|en|1|1|1|false",
 "airport-check-in-first-time/s05-l3": "But some international flights still need a desk check of your papers. Read the airline's email.|en|1|1|1|false",
 "airport-check-in-first-time/s06-l1": "Passport, ticket, and visa together in one small pouch.|en|1|1|1|false",
 "airport-check-in-first-time/s06-l2": "Weigh your suitcase at home. Put cabin liquids in a clear bag.|en|1|1|1|false",
 "airport-check-in-first-time/s06-l3": "And check your terminal. Big airports often split international and domestic.|en|1|1|1|false",
 "airport-check-in-first-time/s07-l1": "To the airport, please.|en|1|1|1|false",
 "airport-check-in-first-time/s07-l2": "Wait a second!|en|1|1|1|false",
 "airport-check-in-first-time/s07-l3": "The car may stop at the domestic terminal. Then it's a long walk with your bags, asking the way.|en|1|1|1|false",
 "airport-check-in-first-time/s07-l4": "Let's rewind and try again.|en|1|1|1|false",
 "airport-check-in-first-time/s07-l5": "The international terminal, please. It's on my ticket.|en|1|1|1|false",
 "airport-check-in-first-time/s07-l6": "Okay, international terminal.|en|1|1|1|false",
 "airport-check-in-first-time/s07-l7": "The terminal on your ticket is where the car stops.|en|1|1|1|false",
 "airport-check-in-first-time/s08-l1": "Go to the airport late, so you don't wait around. Good idea?|en|1|1|1|false",
 "airport-check-in-first-time/s08-l2": "No. Plan for traffic and leave extra time. Late means running, forgetting things, and getting upset.|en|1|1|1|false",
 "airport-check-in-first-time/s09-l1": "Part two: at the check-in counter.|en|1|1|1|false",
 "airport-check-in-first-time/s10-l1": "Where are you flying to?|en|1|1|1|false",
 "airport-check-in-first-time/s10-l2": "On this flight. Here is my passport and ticket.|en|1|1|1|false",
 "airport-check-in-first-time/s10-l3": "How many bags are you checking in? Did you pack your bags yourself?|en|1|1|1|false",
 "airport-check-in-first-time/s10-l4": "One bag. Yes, I packed it myself.|en|1|1|1|false",
 "airport-check-in-first-time/s10-l5": "Every passenger hears these. Short, true answers are fine.|en|1|1|1|false",
 "airport-check-in-first-time/s10-l6": "Your bag is over the limit.|en|1|1|1|false",
 "airport-check-in-first-time/s10-l7": "How much is the extra fee?|en|1|1|1|false",
 "airport-check-in-first-time/s10-l8": "Don't argue. Move things to your cabin bag if it's allowed, or pay the fee.|en|1|1|1|false",
 "airport-check-in-first-time/s11-l1": "You get your boarding pass and a small baggage sticker, often on the pass or passport.|en|1|1|1|false",
 "airport-check-in-first-time/s11-l2": "Keep it until you have your suitcase. It proves the bag is yours.|en|1|1|1|false",
 "airport-check-in-first-time/s12-l1": "Read your boarding pass at the desk. Your name, the flight number.|en|1|1|1|false",
 "airport-check-in-first-time/s12-l2": "The gate, if it's there yet. The boarding time, your seat.|en|1|1|1|false",
 "airport-check-in-first-time/s12-l3": "Then take a photo of it, just in case.|en|1|1|1|false",
 "airport-check-in-first-time/s13-l1": "A polite stranger asks you to carry a bag. That's okay. True or false?|en|1|1|1|false",
 "airport-check-in-first-time/s13-l2": "False. You are responsible for everything in luggage under your name.|en|1|1|1|false",
 "airport-check-in-first-time/s14-l1": "Part three: exit immigration.|en|1|1|1|false",
 "airport-check-in-first-time/s15-l1": "Join the line for Vietnamese citizens.|en|1|1|1|false",
 "airport-check-in-first-time/s15-l2": "Show your passport and boarding pass.|en|1|1|1|false",
 "airport-check-in-first-time/s15-l3": "Take off your hat and sunglasses if asked.|en|1|1|1|false",
 "airport-check-in-first-time/s15-l4": "Look at the camera. No photos in this area.|en|1|1|1|false",
 "airport-check-in-first-time/s15-l5": "Automatic gates? Not sure, go to an officer's desk. A few minutes slower, no stress.|en|1|1|1|false",
 "airport-check-in-first-time/s16-l1": "Part four: the security check.|en|1|1|1|false",
 "airport-check-in-first-time/s17-l1": "Take a tray. In go your bag and jacket.|en|1|1|1|false",
 "airport-check-in-first-time/s17-l2": "Phone, wallet, keys, and your belt if asked.|en|1|1|1|false",
 "airport-check-in-first-time/s17-l3": "Laptops and liquids often go in a separate tray. Follow the sign or the staff.|en|1|1|1|false",
 "airport-check-in-first-time/s18-l1": "Here's a big jar of honey, and some chilli sauce. Gifts!|en|1|1|1|false",
 "airport-check-in-first-time/s18-l2": "They're precious. I'll carry them in my cabin bag.|en|1|1|1|false",
 "airport-check-in-first-time/s18-l3": "Wait a second!|en|1|1|1|false",
 "airport-check-in-first-time/s18-l4": "Honey and sauces count as liquids. Often about one hundred millilitres each, in a clear bag.|en|1|1|1|false",
 "airport-check-in-first-time/s18-l5": "A big jar is kept at security, and your suitcase is already gone. Let's rewind.|en|1|1|1|false",
 "airport-check-in-first-time/s18-l6": "I'll wrap them well, in plastic bags, in my checked suitcase.|en|1|1|1|false",
 "airport-check-in-first-time/s18-l7": "After I check the airline and customs rules of where I'm going.|en|1|1|1|false",
 "airport-check-in-first-time/s18-l8": "Good. Some places ban some foods.|en|1|1|1|false",
 "airport-check-in-first-time/s19-l1": "Liquids go in checked bags. Keep cabin bags simple.|en|1|1|1|false",
 "airport-check-in-first-time/s19-l2": "Even a water bottle from outside usually has to stay behind.|en|1|1|1|false",
 "airport-check-in-first-time/s20-l1": "We need to check your bag. Can you open it, please?|en|1|1|1|false",
 "airport-check-in-first-time/s20-l2": "Sure.|en|1|1|1|false",
 "airport-check-in-first-time/s20-l3": "Stay calm. Staff are just doing their job. Open it when asked, and answer clearly.|en|1|1|1|false",
 "airport-check-in-first-time/s20-l4": "Passport, phone, wallet, jacket. All here.|en|1|1|1|false",
 "airport-check-in-first-time/s20-l5": "Look over the tray before you leave. People forget things here when rushing.|en|1|1|1|false",
 "airport-check-in-first-time/s21-l1": "Part five: the gate, and boarding.|en|1|1|1|false",
 "airport-check-in-first-time/s22-l1": "Check the screens for your gate. It can change after your pass was printed.|en|1|1|1|false",
 "airport-check-in-first-time/s22-l2": "Sit near the gate. Listen for announcements.|en|1|1|1|false",
 "airport-check-in-first-time/s22-l3": "Hear your name? Go to the gate desk right away.|en|1|1|1|false",
 "airport-check-in-first-time/s22-l4": "Boarding goes by group or row. Wait for yours, then show your pass and passport.|en|1|1|1|false",
 "airport-check-in-first-time/s23-l1": "Back to Thảo. Her gate changed, and her name was called twice. She didn't hear.|en|1|1|1|false",
 "airport-check-in-first-time/s23-l2": "Excuse me, you're on my flight. The gate has changed!|en|1|1|1|false",
 "airport-check-in-first-time/s23-l3": "Oh no! Thank you!|en|1|1|1|false",
 "airport-check-in-first-time/s23-l4": "She runs, and reaches the new gate just before it closes.|en|1|1|1|false",
 "airport-check-in-first-time/s24-l1": "At the airport: one ear for music, one ear for announcements. And look at the screens now and then.|en|1|1|1|false",
 "airport-check-in-first-time/s25-l1": "Part six: you've landed.|en|1|1|1|false",
 "airport-check-in-first-time/s26-l1": "Follow the signs for Arrivals or Immigration. Join the line for foreign passports.|en|1|1|1|false",
 "airport-check-in-first-time/s26-l2": "Some places want an arrival form, on the plane or online. Follow the crew or the official site.|en|1|1|1|false",
 "airport-check-in-first-time/s26-l3": "Connecting? Follow Transfer signs. Not sure? Show your next boarding pass and ask.|en|1|1|1|false",
 "airport-check-in-first-time/s27-l1": "The screen shows the belt for your flight number.|en|1|1|1|false",
 "airport-check-in-first-time/s27-l2": "Many suitcases look the same. A ribbon or name tag helps.|en|1|1|1|false",
 "airport-check-in-first-time/s27-l3": "Check the label before you take it.|en|1|1|1|false",
 "airport-check-in-first-time/s28-l1": "The belt has stopped. Dũng's suitcase isn't there. He doesn't leave the hall.|en|1|1|1|false",
 "airport-check-in-first-time/s28-l2": "My suitcase didn't come out. Here's my baggage sticker and boarding pass.|en|1|1|1|false",
 "airport-check-in-first-time/s28-l3": "What does it look like?|en|1|1|1|false",
 "airport-check-in-first-time/s28-l4": "Medium size, with a ribbon on the handle.|en|1|1|1|false",
 "airport-check-in-first-time/s28-l5": "The desk is in the baggage hall: Baggage Services, or Lost and Found. Once outside, it's hard to go back.|en|1|1|1|false",
 "airport-check-in-first-time/s29-l1": "Dũng leaves his hotel address and phone number.|en|1|1|1|false",
 "airport-check-in-first-time/s29-l2": "He gets a file number and takes a photo of the form.|en|1|1|1|false",
 "airport-check-in-first-time/s29-l3": "He asks if the airline helps with basic items, and keeps the receipts.|en|1|1|1|false",
 "airport-check-in-first-time/s30-l1": "No suitcase yet? Then you don't leave yet.|en|1|1|1|false",
 "airport-check-in-first-time/s31-l1": "Nothing to declare? Use the nothing-to-declare lane.|en|1|1|1|false",
 "airport-check-in-first-time/s31-l2": "Lots of cash, valuable goods, or restricted food? Use the declare lane.|en|1|1|1|false",
 "airport-check-in-first-time/s31-l3": "Rules differ by country. Check the official customs website.|en|1|1|1|false",
 "airport-check-in-first-time/s32-l1": "Airports look messy, but it's just lines, papers, and screens.|en|1|1|1|false",
 "airport-check-in-first-time/s32-l2": "Thảo made it, just. Next time, one ear stays free.|en|1|1|1|false",
 "airport-check-in-first-time/s32-l3": "Keep your papers in one pouch, keep the sticker, and don't be shy to ask.|en|1|1|1|false",
 "airport-check-in-first-time/s33-l1": "Your suitcase does not come out on the belt, what should you do?|en|1|1|1|false",
 "airport-check-in-first-time/s33-l2": "Report it at the baggage desk right there, showing your baggage sticker and pass.|en|1|1|1|false",
 "airport-check-in-first-time/s33-l3": "The desk is inside the baggage hall. Once you leave, it is hard to go back.|en|1|1|1|false",
 "airport-check-in-first-time/s34-l1": "Check which terminal your flight leaves from, and write it down for the driver.|en|1|1|1|false",
 "airport-check-in-first-time/s34-l2": "Then try the forty questions below.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s01-l1": "Thao, why is this month so slow?|en|1|1|1|false",
 "answer-hard-questions-from-boss/s01-l2": "Well, about our delivery schedule…|en|1|1|1|false",
 "answer-hard-questions-from-boss/s01-l3": "Five minutes later, Thao is still explaining deliveries.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s01-l4": "But was her boss really asking about deliveries?|en|1|1|1|false",
 "answer-hard-questions-from-boss/s02-l1": "Your boss doesn't expect you to know everything. They want to see you|en|1|1|1|false",
 "answer-hard-questions-from-boss/s02-l2": "listen carefully,|en|1|1|1|false",
 "answer-hard-questions-from-boss/s02-l3": "answer directly,|en|1|1|1|false",
 "answer-hard-questions-from-boss/s02-l4": "be honest about what you don't know,|en|1|1|1|false",
 "answer-hard-questions-from-boss/s02-l5": "and set a time to answer.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s03-l1": "Six stops. First, guess the questions. Then, listen before you answer.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s03-l2": "Answer short. Handle what you don't know, and tough challenges.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s03-l3": "Last, questions outside your part, and what to do after.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s04-l1": "Part one: can you guess what your boss will ask?|en|1|1|1|false",
 "answer-hard-questions-from-boss/s05-l0": "Most questions are about cost, time, risk, who is responsible, and what if we do nothing.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s05-l1": "Write a short answer for each. Add “why not another way?”|en|1|1|1|false",
 "answer-hard-questions-from-boss/s05-l2": "Add the question that hits your weakest point, and the questions from last time.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s06-l1": "Ask a colleague to play your boss and grill you for ten minutes.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s06-l2": "Where you stumble, prepare more.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s06-l3": "Keep detailed numbers in an appendix. Don't present them, but open them when asked.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s07-l1": "Dung will propose buying stock software. The night before, he writes five likely questions.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s07-l2": "Like: if we don't buy it, what do we lose? One short answer, with a number.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s07-l3": "He practises out loud, with a colleague asking surprise questions.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s07-l4": "Long answers become one clear opening line. Next morning, the first question is one he practised.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s08-l1": "Practise the questions, not only the talk.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s09-l1": "Part two: what to do before you answer.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s10-l1": "Hear the whole question. The second half is often what your boss really wants.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s10-l2": "A short pause is normal. You can say: let me think about this one for a moment.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s10-l3": "Unclear? Ask back in your own words: do you mean the whole year, or just this quarter?|en|1|1|1|false",
 "answer-hard-questions-from-boss/s11-l1": "Why is this month so slow?|en|1|1|1|false",
 "answer-hard-questions-from-boss/s11-l2": "Our deliveries? Let me explain the whole schedule…|en|1|1|1|false",
 "answer-hard-questions-from-boss/s11-l3": "Wait a second!|en|1|1|1|false",
 "answer-hard-questions-from-boss/s11-l4": "Her boss meant hiring. Five minutes, and they're back to the first question.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s11-l5": "Let's rewind and try again.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s11-l6": "Do you mean deliveries, or hiring?|en|1|1|1|false",
 "answer-hard-questions-from-boss/s11-l7": "Hiring.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s11-l8": "One question back saves ten wrong answers.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s12-l1": "Part three: short answers that still say enough.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s13-l1": "Say the answer first: yes, no, about two weeks. Then explain briefly.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s14-a1": "When will it be finished?|en|1|1|1|false",
 "answer-hard-questions-from-boss/s14-a2": "Well, when we started this project back in March…|en|1|1|1|false",
 "answer-hard-questions-from-boss/s14-a3": "Her boss asked for a date, not the history of the project.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s14-b1": "When will it be finished?|en|1|1|1|false",
 "answer-hard-questions-from-boss/s14-b2": "I estimate about two weeks, based on our speed in the last three weeks.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s14-b3": "Would you like more detail on any part?|en|1|1|1|false",
 "answer-hard-questions-from-boss/s14-b4": "A few sentences, then let the boss choose how deep to go. An estimate says what it's based on.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s15-l1": "The longer your answer, the more you seem to know. True or false?|en|1|1|1|false",
 "answer-hard-questions-from-boss/s15-l2": "False. Your boss loses focus, and the key point gets lost in details.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s16-l1": "Part four: what if you don't know the answer?|en|1|1|1|false",
 "answer-hard-questions-from-boss/s17-l1": "Be honest, and give a clear time: I don't have this number yet. I'll send it before five today.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s17-l2": "That shows you are honest and responsible.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s17-l3": "Never invent a number. One wrong guess makes your boss doubt all your other numbers.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s17-l4": "Know part of it? I have the staff cost. For equipment, I'm waiting for a quote.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s18-a0": "What was the shipping cost last month?|en|1|1|1|false",
 "answer-hard-questions-from-boss/s18-a1": "About eighty million dong.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s18-a2": "Smooth. But if it's wrong, it may follow her boss to the director, and accounting may point it out.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s18-b0": "What was the shipping cost last month?|en|1|1|1|false",
 "answer-hard-questions-from-boss/s18-b1": "I don't remember exactly. I'll check and send it in fifteen minutes.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s18-b2": "A few awkward seconds, for a correct number and a clear time.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s19-l1": "Don't know? Set a time. Don't just guess.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s20-l1": "Part five: when your boss challenges your numbers.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s21-l1": "A tough question doesn't mean your boss doubts you.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s21-l2": "Your boss is testing how solid the plan is. It's your chance to show you did the work.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s22-l1": "Are you sure the customer will accept this price?|en|1|1|1|false",
 "answer-hard-questions-from-boss/s22-l2": "I've worked with this customer for a long time!|en|1|1|1|false",
 "answer-hard-questions-from-boss/s22-l3": "Wait a second!|en|1|1|1|false",
 "answer-hard-questions-from-boss/s22-l4": "That was a question about the plan, not an attack. Bring evidence, not feelings.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s22-l5": "Let's rewind and try again.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s22-l6": "This number comes from the last three months of sales reports.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s22-l7": "I'll send you the original table right after the meeting.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s22-l8": "Calm voice, no need to defend yourself.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s23-l1": "If your boss finds a real weak spot, admit it and say how you'll fix it:|en|1|1|1|false",
 "answer-hard-questions-from-boss/s23-l2": "You're right. I haven't included maintenance costs. I'll add them and resend.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s23-l3": "Admitting it at the right time makes the rest of your plan more believable.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s24-l1": "Last part: questions outside your area, and what happens after.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s25-l1": "Another team's area? The tech team knows this better. I'll set up a talk with them this week.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s25-l2": "Don't answer for other people. Connect your boss with them.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s25-l3": "A broad question, like what do you think of this project? Pick one or two key points.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s25-l4": "Pulling the meeting off track? This needs more time. Can we discuss it after the meeting?|en|1|1|1|false",
 "answer-hard-questions-from-boss/s26-l1": "Right after the meeting, I write down every answer I promised.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s26-l2": "Here is the answer about the shipping cost you asked this morning.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s26-l3": "I've attached the original table for you.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s26-l4": "Send it on time, and repeat the question first, so your boss remembers the context.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s27-l1": "Write down every promise. Send each answer on time.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s27-l2": "Repeat the question at the top.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s27-l3": "And keep today's questions in one place. They're your best list for next time.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s28-l1": "Questions are not a test of knowing everything. They show how you handle not being sure.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s28-l2": "Today: write five questions your boss may ask. Practise each answer in three sentences.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s29-l1": "Why is guessing a number in front of your boss a bad idea?|en|1|1|1|false",
 "answer-hard-questions-from-boss/s29-l2": "If the guess is wrong, your boss may doubt every other number you gave.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s29-l3": "Your boss may already have used it to decide, or passed it up.|en|1|1|1|false",
 "answer-hard-questions-from-boss/s30-l1": "Your turn. Forty hard questions are waiting below.|en|1|1|1|false",
 "avoid-tourist-scams/s01-l1": "You are Thảo. In a square, two young people chat with you in great English.|en|1|1|1|false",
 "avoid-tourist-scams/s01-l2": "They invite you for traditional tea at their favourite place. Inside, the menu has no prices.|en|1|1|1|false",
 "avoid-tourist-scams/s01-l3": "Hmm. What should worry me most here?|en|1|1|1|false",
 "avoid-tourist-scams/s02-l1": "How do you avoid tourist scams? Most repeat a few patterns.|en|1|1|1|false",
 "avoid-tourist-scams/s02-l2": "Ask the price before using a service.|en|1|1|1|false",
 "avoid-tourist-scams/s02-l3": "Take rides only from official places.|en|1|1|1|false",
 "avoid-tourist-scams/s02-l4": "Be careful with strangers who are too friendly.|en|1|1|1|false",
 "avoid-tourist-scams/s02-l5": "And keep valuables close in crowds.|en|1|1|1|false",
 "avoid-tourist-scams/s03-l1": "From research at home, to the taxi, friendly strangers, and crowds.|en|1|1|1|false",
 "avoid-tourist-scams/s03-l2": "Then food and shopping, and what to do if it happens anyway.|en|1|1|1|false",
 "avoid-tourist-scams/s04-l1": "Part one: what to learn before you go.|en|1|1|1|false",
 "avoid-tourist-scams/s05-l1": "Read official travel advice, or the Vietnamese embassy's pages. Many list common scams.|en|1|1|1|false",
 "avoid-tourist-scams/s05-l2": "Look up normal prices: the airport ride, a simple meal, the main tickets.|en|1|1|1|false",
 "avoid-tourist-scams/s05-l3": "With a price in mind, you notice at once when someone asks for many times more.|en|1|1|1|false",
 "avoid-tourist-scams/s06-l1": "Any stranger who talks to you is up to something. True or false?|en|1|1|1|false",
 "avoid-tourist-scams/s06-l2": "False. Most people are kind. The goal is to know a few signs, and stop at the right time.|en|1|1|1|false",
 "avoid-tourist-scams/s07-l1": "Part two: from the airport to your hotel.|en|1|1|1|false",
 "avoid-tourist-scams/s08-l1": "Midnight. A man walks up to Dũng: “Taxi, cheap.”|en|1|1|1|false",
 "avoid-tourist-scams/s08-l2": "I'm so tired. Okay, I'll just go with him.|en|1|1|1|false",
 "avoid-tourist-scams/s08-l3": "Wait a second!|en|1|1|1|false",
 "avoid-tourist-scams/s08-l4": "No meter, a long way round, and a price many times higher. Too tired to argue, he pays.|en|1|1|1|false",
 "avoid-tourist-scams/s08-l5": "Let's rewind and try again.|en|1|1|1|false",
 "avoid-tourist-scams/s08-l6": "I'll go to the official taxi line.|en|1|1|1|false",
 "avoid-tourist-scams/s08-l7": "Do you use the meter? About how much to this address?|en|1|1|1|false",
 "avoid-tourist-scams/s08-l8": "Yes, I use the meter.|en|1|1|1|false",
 "avoid-tourist-scams/s08-l9": "Ask the price before you get in, not when you arrive.|en|1|1|1|false",
 "avoid-tourist-scams/s09-l1": "Use the official taxi line or counter, or an app you installed before.|en|1|1|1|false",
 "avoid-tourist-scams/s09-l2": "No meter, or a vague price? Say thank you politely, and pick another car.|en|1|1|1|false",
 "avoid-tourist-scams/s09-l3": "Photo the plate. Follow the map. Share your location. Have small notes ready.|en|1|1|1|false",
 "avoid-tourist-scams/s10-l1": "Part three: very friendly strangers. Three common tricks.|en|1|1|1|false",
 "avoid-tourist-scams/s11-l1": "Trick one: a kind man says the place you want is closed today, and offers a friend's car.|en|1|1|1|false",
 "avoid-tourist-scams/s11-l2": "You end up in an expensive gem or souvenir shop. The helper gets a share.|en|1|1|1|false",
 "avoid-tourist-scams/s11-l3": "Check it yourself, at the main gate or on the official website.|en|1|1|1|false",
 "avoid-tourist-scams/s12-l1": "Trick two: tea or drinks. Friendly people bring you to their favourite place.|en|1|1|1|false",
 "avoid-tourist-scams/s12-l2": "At the end, a huge bill, sometimes with people standing at the door.|en|1|1|1|false",
 "avoid-tourist-scams/s12-l3": "Say no gently. Or go only to a place you choose, and check prices first.|en|1|1|1|false",
 "avoid-tourist-scams/s13-l1": "So, Thảo's square. Friendly people are not the problem.|en|1|1|1|false",
 "avoid-tourist-scams/s13-l2": "The red flag: they chose the place, and the menu has no prices. She can't control the bill.|en|1|1|1|false",
 "avoid-tourist-scams/s13-l3": "It could cost as much as several hotel nights. Suggest your own place, or ask the price first.|en|1|1|1|false",
 "avoid-tourist-scams/s14-a0": "Trick three: a “gift”. A bracelet, a flower, a bird on your shoulder. Then they want money.|en|1|1|1|false",
 "avoid-tourist-scams/s14-a1": "A smiling man says “Free, free, friendship” and reaches for Bác Bình's wrist.|en|1|1|1|false",
 "avoid-tourist-scams/s14-a2": "Oh, for me? Thank you!|en|1|1|1|false",
 "avoid-tourist-scams/s14-a3": "Once it's tied, he holds out his hand. Others crowd round. Bác Bình pays.|en|1|1|1|false",
 "avoid-tourist-scams/s14-b1": "No, thank you.|en|1|1|1|false",
 "avoid-tourist-scams/s14-b2": "Don't hold out your hand, don't take things from strangers. Say no clearly, and walk on.|en|1|1|1|false",
 "avoid-tourist-scams/s15-l1": "No hand out, nothing tied. Say no at the very start.|en|1|1|1|false",
 "avoid-tourist-scams/s16-l1": "Part four: keeping your things safe in crowds.|en|1|1|1|false",
 "avoid-tourist-scams/s17-l1": "Pickpockets work in groups. One distracts you: asks the way, wants a signature, drops something, bumps you.|en|1|1|1|false",
 "avoid-tourist-scams/s17-l2": "On a busy train, coins drop and everyone looks down. A phone in a back pocket is gone.|en|1|1|1|false",
 "avoid-tourist-scams/s17-l3": "Suddenly pushed, or asked lots of questions? Hold your bag first, then answer.|en|1|1|1|false",
 "avoid-tourist-scams/s18-l1": "The more pushing and noise, the tighter you hold your bag.|en|1|1|1|false",
 "avoid-tourist-scams/s19-l1": "Wear your bag in front, zip facing you. No phone on outdoor cafe tables.|en|1|1|1|false",
 "avoid-tourist-scams/s19-l2": "Split money into two or three places. Don't hold your phone loosely by the road.|en|1|1|1|false",
 "avoid-tourist-scams/s19-l3": "Some places want the original passport on you. If not, keep it in the safe and carry a copy.|en|1|1|1|false",
 "avoid-tourist-scams/s20-l1": "A man in normal clothes says he's police. He wants to check your wallet for fake money.|en|1|1|1|false",
 "avoid-tourist-scams/s20-l2": "Real police rarely do that to tourists in the street.|en|1|1|1|false",
 "avoid-tourist-scams/s20-l3": "Can I see your badge? Let's go to the police station together.|en|1|1|1|false",
 "avoid-tourist-scams/s21-l1": "Part five: food, shopping, and photos.|en|1|1|1|false",
 "avoid-tourist-scams/s22-l1": "Today's special is the seafood.|en|1|1|1|false",
 "avoid-tourist-scams/s22-l2": "How much is this, please? Is it per person or per kilo?|en|1|1|1|false",
 "avoid-tourist-scams/s22-l3": "Per kilo. Here's the price list.|en|1|1|1|false",
 "avoid-tourist-scams/s22-l4": "No prices on the menu, or a “special” with no price? Ask for each dish, especially seafood by weight.|en|1|1|1|false",
 "avoid-tourist-scams/s23-l1": "Paying with a big note? Say its value out loud.|en|1|1|1|false",
 "avoid-tourist-scams/s23-l2": "Keep it in sight until you get your change, and count it at the counter.|en|1|1|1|false",
 "avoid-tourist-scams/s23-l3": "One trick swaps your big note for a small one, then says you paid too little.|en|1|1|1|false",
 "avoid-tourist-scams/s24-l1": "Photos with costumed people or street artists usually cost money. Ask before you raise the camera.|en|1|1|1|false",
 "avoid-tourist-scams/s24-l2": "Buying gems or antiques? Choose shops with clear receipts. Ignore “special price, today only”.|en|1|1|1|false",
 "avoid-tourist-scams/s25-l1": "Part six: if it happens anyway.|en|1|1|1|false",
 "avoid-tourist-scams/s26-l1": "Safety first, money second.|en|1|1|1|false",
 "avoid-tourist-scams/s26-l2": "Pressured, blocked, or threatened? Don't argue. Pay a small amount to reach a crowded place, then deal with it.|en|1|1|1|false",
 "avoid-tourist-scams/s27-l1": "Note the time and place. Photo the bill, and the number plate if there is one.|en|1|1|1|false",
 "avoid-tourist-scams/s27-l2": "Tell hotel reception and the local police. Get a report for your insurance or bank.|en|1|1|1|false",
 "avoid-tourist-scams/s27-l3": "Lost a card? Call your bank to block it right away.|en|1|1|1|false",
 "avoid-tourist-scams/s28-l1": "Lost your passport, or something serious? After the police, contact the Vietnamese embassy or consulate.|en|1|1|1|false",
 "avoid-tourist-scams/s28-l2": "Save their address and number before you leave.|en|1|1|1|false",
 "avoid-tourist-scams/s28-l3": "And don't blame yourself. Scammers do this every day. Tell your group, and enjoy the trip.|en|1|1|1|false",
 "avoid-tourist-scams/s29-l1": "Most scams need you to do one of three things.|en|1|1|1|false",
 "avoid-tourist-scams/s29-l2": "Get in a car without asking the price. Follow a stranger. Or forget your things in a crowd.|en|1|1|1|false",
 "avoid-tourist-scams/s29-l3": "Keep the three opposite habits, and you're safe on most trips.|en|1|1|1|false",
 "avoid-tourist-scams/s30-l1": "In the tea house example, which sign should make you most careful?|en|1|1|1|false",
 "avoid-tourist-scams/s30-l2": "Strangers choosing the place, and a menu that shows no prices at all.|en|1|1|1|false",
 "avoid-tourist-scams/s30-l3": "Choose your own place and ask the price first.|en|1|1|1|false",
 "avoid-tourist-scams/s31-l1": "Look up the fare from the airport to your hotel, and save the four rules in your notes.|en|1|1|1|false",
 "avoid-tourist-scams/s31-l2": "Then try the forty questions below.|en|1|1|1|false",
 "balance-study-and-part-time-work/s01-l1": "Lan works two evening shifts a week at a bakery.|en|1|1|1|false",
 "balance-study-and-part-time-work/s01-l2": "We're short of staff. Can you take Saturday morning too?|en|1|1|1|false",
 "balance-study-and-part-time-work/s01-l3": "Okay. Just this week.|en|1|1|1|false",
 "balance-study-and-part-time-work/s01-l4": "Then all of Sunday. Every time: just this week. Where does that lead?|en|1|1|1|false",
 "balance-study-and-part-time-work/s02-l1": "Can you work and still keep your grades? Yes. Set a limit.|en|1|1|1|false",
 "balance-study-and-part-time-work/s02-l2": "Plan by the week.|en|1|1|1|false",
 "balance-study-and-part-time-work/s02-l3": "Warn your manager before exams.|en|1|1|1|false",
 "balance-study-and-part-time-work/s02-l4": "Protect your sleep.|en|1|1|1|false",
 "balance-study-and-part-time-work/s02-l5": "And cut hours as soon as your grades slip.|en|1|1|1|false",
 "balance-study-and-part-time-work/s03-l1": "Six stops: start of term, each week, exam season,|en|1|1|1|false",
 "balance-study-and-part-time-work/s03-l2": "health, falling grades, and family.|en|1|1|1|false",
 "balance-study-and-part-time-work/s04-l1": "Part one: a limit. Let's replay Lan's answer.|en|1|1|1|false",
 "balance-study-and-part-time-work/s05-l1": "Can you take all of Sunday too?|en|1|1|1|false",
 "balance-study-and-part-time-work/s05-l2": "Okay. Just this week.|en|1|1|1|false",
 "balance-study-and-part-time-work/s05-l3": "Wait a second!|en|1|1|1|false",
 "balance-study-and-part-time-work/s05-l4": "By the end of term, Lan has no free day to revise. She must retake two subjects.|en|1|1|1|false",
 "balance-study-and-part-time-work/s05-l5": "Let's rewind and try again.|en|1|1|1|false",
 "balance-study-and-part-time-work/s05-l6": "Thank you, but this week I have reached my limit. Maybe next time.|en|1|1|1|false",
 "balance-study-and-part-time-work/s05-l7": "Set your own limit, or the shifts will set it for you.|en|1|1|1|false",
 "balance-study-and-part-time-work/s06-l1": "Write down a number: the most hours you work each week.|en|1|1|1|false",
 "balance-study-and-part-time-work/s06-l2": "When asked for more, just check it. No need to decide again each time.|en|1|1|1|false",
 "balance-study-and-part-time-work/s07-l1": "In week one, open your course outlines. Mark test dates,|en|1|1|1|false",
 "balance-study-and-part-time-work/s07-l2": "big deadlines, and exam weeks.|en|1|1|1|false",
 "balance-study-and-part-time-work/s07-l3": "Send those weeks to your manager early, while the shop has time to plan.|en|1|1|1|false",
 "balance-study-and-part-time-work/s08-l1": "Part two: fifteen minutes every Sunday evening.|en|1|1|1|false",
 "balance-study-and-part-time-work/s09-l1": "Look at the whole week. Your shifts.|en|1|1|1|false",
 "balance-study-and-part-time-work/s09-l2": "Deadlines and tests.|en|1|1|1|false",
 "balance-study-and-part-time-work/s09-l3": "The three most important study tasks.|en|1|1|1|false",
 "balance-study-and-part-time-work/s09-l4": "A fixed time slot for each one.|en|1|1|1|false",
 "balance-study-and-part-time-work/s09-l5": "And one evening off.|en|1|1|1|false",
 "balance-study-and-part-time-work/s10-l1": "Use short gaps: on the bus, on a break, before class. Review words, read your notes.|en|1|1|1|false",
 "balance-study-and-part-time-work/s10-l2": "Save essays and hard exercises for long blocks, when your mind is fresh.|en|1|1|1|false",
 "balance-study-and-part-time-work/s11-l1": "A shift right before a big test is fine. Just study after work. True or false?|en|1|1|1|false",
 "balance-study-and-part-time-work/s11-l2": "False. Keep shifts away from tests and big deadlines.|en|1|1|1|false",
 "balance-study-and-part-time-work/s11-l3": "Already booked? Ask to swap a few days early. The closer it gets, the harder it is.|en|1|1|1|false",
 "balance-study-and-part-time-work/s12-l1": "Part three: exams are coming. Ask weeks ahead.|en|1|1|1|false",
 "balance-study-and-part-time-work/s13-l1": "Say which weeks, how many shifts, and offer to make up.|en|1|1|1|false",
 "balance-study-and-part-time-work/s13-l2": "I have finals in the last two weeks of the month. Could I work one shift a week?|en|1|1|1|false",
 "balance-study-and-part-time-work/s13-l3": "After the exams, I'll take extra shifts to make up.|en|1|1|1|false",
 "balance-study-and-part-time-work/s13-l4": "Offering to make up shows you care about the shop too.|en|1|1|1|false",
 "balance-study-and-part-time-work/s14-l1": "Lan and Dũng work at the same shop, but study different subjects.|en|1|1|1|false",
 "balance-study-and-part-time-work/s14-l2": "Can you cover my exam week? I'll cover yours.|en|1|1|1|false",
 "balance-study-and-part-time-work/s14-l3": "Deal. But we tell the manager first.|en|1|1|1|false",
 "balance-study-and-part-time-work/s15-l1": "A bookshop cashier did three steps. Early: exam dates at the start of term.|en|1|1|1|false",
 "balance-study-and-part-time-work/s15-l2": "Clear: two weeks before, one shift a week during exams.|en|1|1|1|false",
 "balance-study-and-part-time-work/s15-l3": "An offer: extra weekend shifts after the exams.|en|1|1|1|false",
 "balance-study-and-part-time-work/s15-l4": "She did well, got her full shifts back, and was trusted with more work.|en|1|1|1|false",
 "balance-study-and-part-time-work/s16-l1": "Tell early, be clear, offer to make up. Easy to say yes to.|en|1|1|1|false",
 "balance-study-and-part-time-work/s17-l1": "Part four: your health.|en|1|1|1|false",
 "balance-study-and-part-time-work/s18-l1": "Sleep is the first thing to go, and the hardest to make up.|en|1|1|1|false",
 "balance-study-and-part-time-work/s18-l2": "Too little sleep for long: you can't focus, you forget lessons, you get irritated.|en|1|1|1|false",
 "balance-study-and-part-time-work/s18-l3": "Keep a steady bedtime, even after an evening shift.|en|1|1|1|false",
 "balance-study-and-part-time-work/s19-l1": "Eat proper meals, especially before a shift.|en|1|1|1|false",
 "balance-study-and-part-time-work/s19-l2": "Bring a light snack and a bottle of water.|en|1|1|1|false",
 "balance-study-and-part-time-work/s19-l3": "Don't use energy drinks or coffee in place of sleep.|en|1|1|1|false",
 "balance-study-and-part-time-work/s20-l1": "A common belief: with coffee, you can work late shifts and still study well.|en|1|1|1|false",
 "balance-study-and-part-time-work/s20-l2": "In fact, coffee only makes you feel less sleepy for a few hours. Your body is still short of sleep.|en|1|1|1|false",
 "balance-study-and-part-time-work/s21-l1": "Late shifts three nights a week? Many people fall asleep in class.|en|1|1|1|false",
 "balance-study-and-part-time-work/s21-l2": "They forget to hand in work.|en|1|1|1|false",
 "balance-study-and-part-time-work/s21-l3": "Most dangerous: feeling sleepy while riding home at midnight.|en|1|1|1|false",
 "balance-study-and-part-time-work/s21-l4": "Better: earlier shifts, and protect your sleep before school days.|en|1|1|1|false",
 "balance-study-and-part-time-work/s22-l1": "Coffee only borrows energy. Sleep gives it back.|en|1|1|1|false",
 "balance-study-and-part-time-work/s23-l1": "Tired for weeks, headaches, weight loss, poor sleep even after rest?|en|1|1|1|false",
 "balance-study-and-part-time-work/s23-l2": "Cut your hours, and see a doctor if it does not get better.|en|1|1|1|false",
 "balance-study-and-part-time-work/s24-l1": "Part five: when your grades slip. Don't wait for the end of term.|en|1|1|1|false",
 "balance-study-and-part-time-work/s25-l1": "A low first test? Look back at that week. Little review?|en|1|1|1|false",
 "balance-study-and-part-time-work/s25-l2": "Little sleep? Missed classes?|en|1|1|1|false",
 "balance-study-and-part-time-work/s25-l3": "Find the real cause, then fix that exact thing.|en|1|1|1|false",
 "balance-study-and-part-time-work/s26-l1": "Cut shifts for a few weeks to catch up. Your income drops a little.|en|1|1|1|false",
 "balance-study-and-part-time-work/s26-l2": "But retaking a subject usually costs much more, in money and time.|en|1|1|1|false",
 "balance-study-and-part-time-work/s27-l1": "Ask your lecturer or academic advisor.|en|1|1|1|false",
 "balance-study-and-part-time-work/s27-l2": "I'm working part-time and I'm behind on this part. Where should I start reviewing?|en|1|1|1|false",
 "balance-study-and-part-time-work/s27-l3": "Teachers are usually happy to help students who ask.|en|1|1|1|false",
 "balance-study-and-part-time-work/s28-n0": "Low midterm marks. Lan is afraid her parents will worry.|en|1|1|1|false",
 "balance-study-and-part-time-work/s28-a1": "I'll keep it quiet and take more shifts. I'll pay for extra classes myself.|en|1|1|1|false",
 "balance-study-and-part-time-work/s28-n1": "More work, less time to review. She may fail a subject.|en|1|1|1|false",
 "balance-study-and-part-time-work/s28-n1b": "The family finds out anyway, from her results. Just too late to help.|en|1|1|1|false",
 "balance-study-and-part-time-work/s28-b1": "Dad, my midterm marks are low. I'll cut shifts and ask my teacher how to review.|en|1|1|1|false",
 "balance-study-and-part-time-work/s28-b2": "Thank you for telling me now. We still have time before finals.|en|1|1|1|false",
 "balance-study-and-part-time-work/s28-n2": "More time, more help, and still time to fix it.|en|1|1|1|false",
 "balance-study-and-part-time-work/s29-l1": "Tell early and get help. Hide long and carry it alone.|en|1|1|1|false",
 "balance-study-and-part-time-work/s30-l1": "Last part: family, and a life of your own.|en|1|1|1|false",
 "balance-study-and-part-time-work/s31-l1": "Here is my work schedule, and my study plan for the week.|en|1|1|1|false",
 "balance-study-and-part-time-work/s31-l2": "Parents feel calmer when they see a plan. And you have someone to talk to when you're tired.|en|1|1|1|false",
 "balance-study-and-part-time-work/s31-l3": "I'm a bit tired these weeks.|en|1|1|1|false",
 "balance-study-and-part-time-work/s31-l4": "What do you need?|en|1|1|1|false",
 "balance-study-and-part-time-work/s31-l5": "If you are a parent, ask what your child needs before giving advice.|en|1|1|1|false",
 "balance-study-and-part-time-work/s31-l6": "Cut a shift. This month we'll send you a bit more.|en|1|1|1|false",
 "balance-study-and-part-time-work/s32-l1": "Friends, sport, and rest are not wasted time.|en|1|1|1|false",
 "balance-study-and-part-time-work/s32-l2": "They help you finish the term without burning out.|en|1|1|1|false",
 "balance-study-and-part-time-work/s33-l1": "Balance does not mean equal parts. Study gets its place on the calendar first.|en|1|1|1|false",
 "balance-study-and-part-time-work/s33-l2": "Set your limit. Tell early, be clear, offer to make up.|en|1|1|1|false",
 "balance-study-and-part-time-work/s33-l3": "And sleep, not coffee, gives your energy back.|en|1|1|1|false",
 "balance-study-and-part-time-work/s34-l1": "What does the saying coffee only borrows energy, sleep gives it back mean?|en|1|1|1|false",
 "balance-study-and-part-time-work/s34-l2": "Coffee hides tiredness for a while, but only real sleep restores your energy.|en|1|1|1|false",
 "balance-study-and-part-time-work/s34-l3": "Coffee wakes you up for now, but it does not give back lost energy.|en|1|1|1|false",
 "balance-study-and-part-time-work/s35-l1": "Your manager asks you to take an extra shift that goes over your limit, what should you say?|en|1|1|1|false",
 "balance-study-and-part-time-work/s35-l2": "Thank you, but this week I have reached my limit, maybe next time.|en|1|1|1|false",
 "balance-study-and-part-time-work/s35-l3": "A clear, kind no protects your study time. Silence is worse.|en|1|1|1|false",
 "balance-study-and-part-time-work/s36-l1": "Do it now: write your weekly hour limit, and mark your exam weeks.|en|1|1|1|false",
 "balance-study-and-part-time-work/s36-l2": "Then, forty questions are waiting below.|en|1|1|1|false",
 "balance-thesis-and-job-search/s01-l1": "Could you explain this result for us?|en|1|1|1|false",
 "balance-thesis-and-job-search/s01-l2": "Um… I… I am sorry.|en|1|1|1|false",
 "balance-thesis-and-job-search/s01-l3": "Lan's score is lower than she hoped. Three weeks earlier, she got a job. Let's rewind.|en|1|1|1|false",
 "balance-thesis-and-job-search/s02-l1": "Thesis and job hunting at the same time. How do you fit both?|en|1|1|1|false",
 "balance-thesis-and-job-search/s02-l2": "Fixed deadlines first.|en|1|1|1|false",
 "balance-thesis-and-job-search/s02-l3": "Fixed blocks of time.|en|1|1|1|false",
 "balance-thesis-and-job-search/s02-l4": "Apply to fewer, better places.|en|1|1|1|false",
 "balance-thesis-and-job-search/s02-l5": "And tell people your schedule.|en|1|1|1|false",
 "balance-thesis-and-job-search/s03-l1": "What comes first.|en|1|1|1|false",
 "balance-thesis-and-job-search/s03-l2": "Planning your week.|en|1|1|1|false",
 "balance-thesis-and-job-search/s03-l3": "Job hunting that does not eat your time.|en|1|1|1|false",
 "balance-thesis-and-job-search/s03-l4": "When it clashes with your defence.|en|1|1|1|false",
 "balance-thesis-and-job-search/s03-l5": "Keeping your strength.|en|1|1|1|false",
 "balance-thesis-and-job-search/s04-l1": "Part one: thesis first, or job hunting first?|en|1|1|1|false",
 "balance-thesis-and-job-search/s05-l1": "Your thesis has fixed dates. They will not move for you. Job hunting can bend.|en|1|1|1|false",
 "balance-thesis-and-job-search/s05-l2": "Near a thesis deadline, the thesis comes first. Other weeks, keep a small job slot, so you keep the rhythm.|en|1|1|1|false",
 "balance-thesis-and-job-search/s06-l1": "Put every date on one calendar: outline, mid-term report, final copy, defence, and application deadlines.|en|1|1|1|false",
 "balance-thesis-and-job-search/s06-l2": "One look shows which weeks will be tight, so you can prepare early.|en|1|1|1|false",
 "balance-thesis-and-job-search/s07-l1": "I am job hunting at the same time. May I keep our meetings on Wednesday mornings?|en|1|1|1|false",
 "balance-thesis-and-job-search/s07-l2": "If an interview clashes, I will tell you early.|en|1|1|1|false",
 "balance-thesis-and-job-search/s07-l3": "Thank you for telling me early.|en|1|1|1|false",
 "balance-thesis-and-job-search/s07-l4": "Told early, teachers understand. A surprise absence, much less.|en|1|1|1|false",
 "balance-thesis-and-job-search/s08-l1": "Dung panics, applies everywhere, and has three interviews in one week. He misses two supervisor meetings.|en|1|1|1|false",
 "balance-thesis-and-job-search/s08-l2": "His data analysis piles up, and he must ask for a later deadline.|en|1|1|1|false",
 "balance-thesis-and-job-search/s08-l3": "Fixed deadlines first. Flexible tasks fit around them.|en|1|1|1|false",
 "balance-thesis-and-job-search/s09-l1": "Part two: split your week so both get time.|en|1|1|1|false",
 "balance-thesis-and-job-search/s10-l1": "Split the week into fixed blocks. For example, fresh mornings for the thesis.|en|1|1|1|false",
 "balance-thesis-and-job-search/s10-l2": "Two afternoons for jobs: your CV, applications, interview practice. No need to decide again every day.|en|1|1|1|false",
 "balance-thesis-and-job-search/s11-l1": "Break the thesis into tasks you can finish in one session.|en|1|1|1|false",
 "balance-thesis-and-job-search/s11-l2": "“Do chapter three” is big and vague. “Rerun the data for table three” is easy to start.|en|1|1|1|false",
 "balance-thesis-and-job-search/s12-l1": "Each weekend, fifteen minutes: next thesis goals, applications to send, interview dates.|en|1|1|1|false",
 "balance-thesis-and-job-search/s12-l2": "And one real break: no thesis, no job search. Rest keeps you going.|en|1|1|1|false",
 "balance-thesis-and-job-search/s13-l1": "Dung tries again. For two days, he notes when he feels sharpest: the morning.|en|1|1|1|false",
 "balance-thesis-and-job-search/s13-l2": "Monday, Wednesday, Friday mornings: thesis in the library, one task each. Tuesday, Thursday afternoons: CV and applications.|en|1|1|1|false",
 "balance-thesis-and-job-search/s13-l3": "Set time, set place, one clear task. Less scrolling. Your freshest hours, for your hardest work.|en|1|1|1|false",
 "balance-thesis-and-job-search/s14-l1": "Part three: job hunting that does not eat all your time.|en|1|1|1|false",
 "balance-thesis-and-job-search/s15-l1": "Choose a few places that really fit, instead of one CV for dozens.|en|1|1|1|false",
 "balance-thesis-and-job-search/s15-l2": "Adjust a few lines for each role. You get more replies, and prepare better.|en|1|1|1|false",
 "balance-thesis-and-job-search/s16-l1": "Keep one table: company, role, date, status, next step.|en|1|1|1|false",
 "balance-thesis-and-job-search/s16-l2": "A few minutes to update. No forgotten interviews, no double applications, and you know when to follow up.|en|1|1|1|false",
 "balance-thesis-and-job-search/s17-l1": "Tell me about a challenge you solved.|en|1|1|1|false",
 "balance-thesis-and-job-search/s17-l2": "In my thesis, I worked on one real problem. Here is my method, and the hardest part.|en|1|1|1|false",
 "balance-thesis-and-job-search/s17-l3": "Your thesis is great interview material. Prepare a short story about it.|en|1|1|1|false",
 "balance-thesis-and-job-search/s18-l1": "Part four: an interview or a job, right at defence time.|en|1|1|1|false",
 "balance-thesis-and-job-search/s19-l1": "The interview is in my defence week. I will ask to move it, honestly.|en|1|1|1|false",
 "balance-thesis-and-job-search/s19-l2": "That week I defend my thesis. Could we meet next week, or Monday afternoon if it suits you?|en|1|1|1|false",
 "balance-thesis-and-job-search/s19-l3": "Sure, Monday afternoon.|en|1|1|1|false",
 "balance-thesis-and-job-search/s19-l4": "Places hiring graduates expect defence dates. They usually understand.|en|1|1|1|false",
 "balance-thesis-and-job-search/s21-l0": "Now back to Lan, three weeks before her defence.|en|1|1|1|false",
 "balance-thesis-and-job-search/s21-l1": "You are hired! When can you start?|en|1|1|1|false",
 "balance-thesis-and-job-search/s21-l2": "Next Monday!|en|1|1|1|false",
 "balance-thesis-and-job-search/s21-l3": "Wait a second!|en|1|1|1|false",
 "balance-thesis-and-job-search/s21-l4": "Work by day, slides by night, for three weeks. A start date can be arranged. A defence day cannot.|en|1|1|1|false",
 "balance-thesis-and-job-search/s21-l5": "Let's rewind and try again.|en|1|1|1|false",
 "balance-thesis-and-job-search/s21-l6": "My defence is in three weeks. Could I start after that, or work fewer days at first?|en|1|1|1|false",
 "balance-thesis-and-job-search/s21-l7": "That is fine.|en|1|1|1|false",
 "balance-thesis-and-job-search/s22-l1": "The company asks for your diploma, but you do not have it yet?|en|1|1|1|false",
 "balance-thesis-and-job-search/s22-l2": "Ask the training office about a temporary certificate or a letter, by your school's rules, and give the expected date.|en|1|1|1|false",
 "balance-thesis-and-job-search/s22-l3": "Never say you have it when you do not. It is untrue, and easy to check.|en|1|1|1|false",
 "balance-thesis-and-job-search/s23-l1": "Last part: tired, and comparing yourself with friends?|en|1|1|1|false",
 "balance-thesis-and-job-search/s24-l1": "Sleep, regular meals, light exercise. Too little sleep slows down both jobs.|en|1|1|1|false",
 "balance-thesis-and-job-search/s24-l2": "Poor sleep or anxiety for weeks? Tell your family, and go to the school counselling office or a clinic.|en|1|1|1|false",
 "balance-thesis-and-job-search/s25-l1": "Friends posting new jobs show the best part they chose to share. Everyone has their own pace.|en|1|1|1|false",
 "balance-thesis-and-job-search/s25-l2": "A better measure: your own plan from last week.|en|1|1|1|false",
 "balance-thesis-and-job-search/s26-l1": "Fewer questions every weekend. I will tell my family my plan.|en|1|1|1|false",
 "balance-thesis-and-job-search/s26-l2": "For two months, my thesis comes first, with two job sessions a week. After the defence, I will push harder.|en|1|1|1|false",
 "balance-thesis-and-job-search/s27-l1": "Ten p.m. Lan is halfway through a chapter. A friend posts a new job.|en|1|1|1|false",
 "balance-thesis-and-job-search/s27-l2": "I will close this and send a few quick applications.|en|1|1|1|false",
 "balance-thesis-and-job-search/s27-l3": "Wait a second!|en|1|1|1|false",
 "balance-thesis-and-job-search/s27-l4": "Midnight applications are often careless. And tomorrow you must make up this session.|en|1|1|1|false",
 "balance-thesis-and-job-search/s27-l5": "Let's rewind and try again.|en|1|1|1|false",
 "balance-thesis-and-job-search/s27-l6": "I will keep working, and switch off notifications at night.|en|1|1|1|false",
 "balance-thesis-and-job-search/s27-l7": "Today I finished one section, and sent one good application. I am moving.|en|1|1|1|false",
 "balance-thesis-and-job-search/s27-l8": "Compare yourself with yesterday, not with a friend today.|en|1|1|1|false",
 "balance-thesis-and-job-search/s28-l1": "Parents: “Got a job yet?” every weekend becomes pressure.|en|1|1|1|false",
 "balance-thesis-and-job-search/s28-l2": "Try: “How is your thesis this week? Can we help with anything?”|en|1|1|1|false",
 "balance-thesis-and-job-search/s29-l1": "The last months do not need to be perfect. They need a rhythm.|en|1|1|1|false",
 "balance-thesis-and-job-search/s29-l2": "Open your calendar. Mark every thesis date and application deadline, then block your hours.|en|1|1|1|false",
 "balance-thesis-and-job-search/s30-l1": "A company invites you to an interview during your thesis defense week, what should you do?|en|1|1|1|false",
 "balance-thesis-and-job-search/s30-l2": "Explain honestly that you are defending your thesis and suggest another time.|en|1|1|1|false",
 "balance-thesis-and-job-search/s30-l3": "Skipping your defence is far too big a price.|en|1|1|1|false",
 "balance-thesis-and-job-search/s31-l1": "Your turn. Forty questions are waiting below.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s01-l1": "Mid-afternoon at Cô Hoa's street tea stall. The clean ice has run out.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s01-l2": "One iced tea, please!|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s01-l3": "Hmm. There's still ice in the box with the beer bottles...|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s01-l4": "Quick and easy. But should she use it?|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s02-l0": "One stomach ache, and the whole street knows. So how do you keep food safe?|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s02-l1": "You don't need a big kitchen. Buy from clear sources,|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s02-l2": "keep food cold,|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s02-l3": "keep raw and cooked apart,|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s02-l4": "and wash hands and clean up every day.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s03-l1": "Six stops today: buying, storing, cooking, clean hands,|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s03-l2": "closing time, and what to do if a customer feels sick.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s04-l1": "Part one: buying ingredients.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s05-l1": "When goods arrive, check them. Meat and fish: fresh colour, not slimy, no strange smell.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s05-l2": "Vegetables not bruised or soggy.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s05-l3": "Packed food in date, with the packaging whole.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s05-l4": "And frozen food still hard. If not, send it back right then. Don't be shy.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s06-l1": "Here's your frozen fish, Cô Hoa.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s06-l2": "It's soft and wet. Please take it back and bring a properly frozen batch.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s06-l3": "And the receipt, please. I keep one for every delivery.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s06-l4": "No problem. Same shop, same address as always.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s06-l5": "Buy from a regular seller with a clear address. If there's ever a problem, she knows where that batch came from.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s07-l1": "Meat much cheaper than usual? Ask carefully where it comes from before you buy.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s07-l2": "Saving a little money never pays for one case of food poisoning.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s08-l1": "The shop is busy, so the fresh meat can wait on the floor. True or false?|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s08-l2": "False. Put it in the fridge right away. Heat spoils food faster than you think.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s09-l1": "Part two: the fridge and the storeroom.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s10-l1": "Top shelves: cooked food and food that is eaten straight away.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s10-l2": "Bottom shelves: raw meat and fish. Cover everything.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s10-l3": "Then juice from raw food can't drip onto cooked food.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s11-l1": "Put a date label on every box, and use older food first.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s11-l2": "Don't pack the fridge too full. Cold air needs space to flow.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s12-l1": "Dish soap, insect spray and other chemicals go in their own place, far from food, clearly labelled.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s12-l2": "And never in an old drinking bottle.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s13-l1": "Cô Hoa used to cook one huge pot of soup every morning. Now she cooks in batches.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s13-l2": "Her notebook says about thirty bowls sell at lunch, so the first pot is about that size.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s13-l3": "More customers near noon? A small extra pot takes under twenty minutes.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s13-l4": "After lunch, leftovers go into small boxes, cool a little, get a date label, then the fridge.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s13-l5": "In the evening, she reheats only the part she will sell, until it boils.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s14-l1": "Cook just enough to sell, and chill whatever is left right away.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s14-l2": "Don't leave leftovers on the stove all afternoon. Let them cool a little, then into the fridge.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s14-l3": "When you reheat, make it boiling hot all through. Never reheat the whole pot again and again.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s15-l1": "Part three: preparing and cooking.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s16-l1": "Lunch rush at Cô Hoa's broken rice shop. She uses one cutting board for everything.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s16-l2": "Raw pork ribs, done. A quick wipe, and now the cucumbers and tomatoes.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s16-l3": "Wait a second!|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s16-l4": "That afternoon, two regulars had stomach aches. The side vegetables were the only thing never cooked.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s16-l5": "Let's rewind. Two boards this time.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s16-l6": "Raw meat on the red board. Cucumbers on the green one.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s16-l7": "Two sets of boards and knives. Small kitchen? Mark them with colour or tape.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s16-l8": "One board for raw, one board for cooked.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s17-l1": "Wash vegetables under running water. Herbs eaten raw: leaf by leaf.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s17-l2": "Cook chicken and minced meat all the way through, with no pink or red juice inside.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s18-l0": "Now, back to the ice. Ice for drinks has its own rules.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s18-l1": "It must be clean ice,|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s18-l2": "kept in its own box with a lid,|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s18-l3": "taken with a scoop, never by hand.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s18-l4": "Ice for chilling beer, soft drinks or fresh food goes in another box.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s19-a1": "I'll just use the ice from the beer box.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s19-a2": "That ice touched dusty bottles. One photo in the neighbourhood group, and the shop's name suffers for a month.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s19-b1": "Iced tea is out for ten minutes. Some hot tea while you wait?|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s19-b2": "Someone goes to buy clean ice. A few glasses lost, but trust kept.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s19-b3": "Ice for drinking never shares a box with ice for chilling.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s20-l1": "Part four: clean hands, in the kitchen and at the counter.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s21-l1": "Wash your hands with soap before you prepare food.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s21-l2": "Wash again after the toilet, raw meat, rubbish, or money.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s21-l3": "Tie your hair back and wear a clean apron.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s21-l4": "A cut on your finger? Cover it with a bandage and wear a glove.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s22-l1": "I've had diarrhoea since this morning. But we're so busy today...|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s22-l2": "Then stay away from the stove today. I'll ask someone else to cook.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s22-l3": "Diarrhoea, vomiting or fever? Don't cook, even if it's you, the owner.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s22-l4": "A day or two of rest is much safer than passing illness into customers' food.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s23-l1": "Morning sticky rice. Cô Hoa sells alone: scooping rice, taking money, giving change.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s23-l2": "Twenty thousand. Here's your change.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s23-l3": "One sticky rice for me, please.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s23-l4": "Coming up! I'll just scoop it with this hand.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s23-l5": "Wait a second!|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s23-l6": "That hand just counted a stack of notes. The new customer says nothing, and quietly goes next door.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s23-l7": "Let's rewind and try another way.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s23-l8": "Tongs for the rice. This other hand is for money.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s23-l9": "Good. I'll come back tomorrow.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s23-l10": "Use tongs, a glove or paper. A hand that holds money should not touch the food.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s24-l1": "Part five: closing time.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s25-l1": "At the end of the day, wash the boards, knives and pots.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s25-l2": "Wipe the stove and the tables.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s25-l3": "Let the dishes dry on a rack. A clean kitchen tonight is a safe kitchen tomorrow.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s26-l1": "Bins with lids, emptied every day. No leftover food overnight.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s26-l2": "Seal the gaps under doors and around pipes. That's how rats and cockroaches get in.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s27-l1": "Customers see more than you think: chopsticks, tables, sauce bottles, the toilet.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s27-l2": "Clean table, clean chopsticks. Then the kitchen must be clean too.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s27-l3": "This cloth is only for tables. The kitchen has its own.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s27-l4": "Wash and dry cloths every day. A damp cloth used all day grows germs.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s27-l5": "When the places customers can see are clean, they trust the places they can't.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s28-l1": "Last part: papers, and when a customer feels sick.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s29-l1": "Food safety papers depend on the type and size of your shop.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s29-l2": "They may include a signed commitment, a knowledge certificate, or health checks for cooks.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s29b-l3": "Not sure? Ask the ward office or the local food safety authority.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s30-l1": "I ate at your shop at lunch, and now my stomach hurts.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s30-l2": "I'm sorry. What did you eat, and what time? I'll write it down.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s30-l3": "Rice with ribs, around twelve.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s30-l4": "If you get a high fever, vomit a lot, or feel dehydrated, please see a doctor soon.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s30-l5": "Stay calm, ask, write it down. Don't argue. And blood in the stool also means: see a doctor.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s31-l1": "Then check the batch of ingredients,|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s31-l2": "the fridge, and how that dish was made.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s31-l3": "Found a problem? Stop selling that dish until you know the cause.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s31-l4": "Several people sick after the same meal? Contact the local health office.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s32-l1": "Hygiene isn't a one-time job. It's small habits, every day.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s32-l2": "This afternoon, label your two boards: raw and cooked. That's how customers eat well and feel safe.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s33-l1": "What is wrong with keeping raw chicken above a tray of cooked rice?|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s33-l2": "Juice from the raw chicken can drip down onto the rice that is eaten directly.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s33-l3": "Cold air can't stop drips. Cooked food on top, raw food below, all covered.|en|1|1|1|false",
 "basic-food-hygiene-small-shop/s35-l1": "Your turn. Forty questions are waiting below.|en|1|1|1|false",
 "book-flights-and-hotels/s01-l1": "Half-price return tickets, only two seats left! Send the money to this account.|en|1|1|1|false",
 "book-flights-and-hotels/s01-l3": "Done! I sent it.|en|1|1|1|false",
 "book-flights-and-hotels/s01-l4": "She gets a photo of a code. The airline site has no such booking.|en|1|1|1|false",
 "book-flights-and-hotels/s01-l5": "And the seller has blocked me!|en|1|1|1|false",
 "book-flights-and-hotels/s02-l1": "So how do you book a first flight and hotel safely?|en|1|1|1|false",
 "book-flights-and-hotels/s02-l2": "Buy from official places.|en|1|1|1|false",
 "book-flights-and-hotels/s02-l3": "Read the ticket rules before paying.|en|1|1|1|false",
 "book-flights-and-hotels/s02-l4": "Put each name in the right box.|en|1|1|1|false",
 "book-flights-and-hotels/s02-l5": "Check the hotel on a map.|en|1|1|1|false",
 "book-flights-and-hotels/s02-l6": "And check the confirmation right after booking.|en|1|1|1|false",
 "book-flights-and-hotels/s03-l1": "Six steps, in the order you'll do them.|en|1|1|1|false",
 "book-flights-and-hotels/s03-l2": "From where to book, to booking for your whole group.|en|1|1|1|false",
 "book-flights-and-hotels/s04-l1": "Part one: where to book.|en|1|1|1|false",
 "book-flights-and-hotels/s05-l1": "Book on the airline's or hotel's official site.|en|1|1|1|false",
 "book-flights-and-hotels/s05-l2": "Or with a well-known agent that friends have used.|en|1|1|1|false",
 "book-flights-and-hotels/s05-l3": "Type the address yourself. Don't click strange links in messages or ads.|en|1|1|1|false",
 "book-flights-and-hotels/s06-l1": "Stop if it's far cheaper than everywhere else.|en|1|1|1|false",
 "book-flights-and-hotels/s06-l2": "If it only takes transfers to a personal account. If it rushes you.|en|1|1|1|false",
 "book-flights-and-hotels/s06-l3": "Real sites take cards, and email a confirmation right after you pay.|en|1|1|1|false",
 "book-flights-and-hotels/s07-l1": "Buy at the main door. Check at the main door.|en|1|1|1|false",
 "book-flights-and-hotels/s07-l2": "Check your booking code on the airline's own website.|en|1|1|1|false",
 "book-flights-and-hotels/s08-l1": "Part two: direct or connecting flights?|en|1|1|1|false",
 "book-flights-and-hotels/s09-l1": "Direct flights cost more, but they're simple. Get on, get off, you're there.|en|1|1|1|false",
 "book-flights-and-hotels/s09-l2": "Connections are cheaper. But you find gates in a strange airport, and a delay can cost the next flight.|en|1|1|1|false",
 "book-flights-and-hotels/s10-a1": "Two separate tickets, under two hours to connect. Cheaper!|en|1|1|1|false",
 "book-flights-and-hotels/s10-a2": "First flight late? The second airline sees a no-show. He buys a new ticket at the desk.|en|1|1|1|false",
 "book-flights-and-hotels/s10-b1": "One booking code for both flights. A bit more expensive.|en|1|1|1|false",
 "book-flights-and-hotels/s10-b2": "First flight late? The airline usually finds him the next one.|en|1|1|1|false",
 "book-flights-and-hotels/s10-c1": "Must buy separate tickets? Leave a very wide gap between flights.|en|1|1|1|false",
 "book-flights-and-hotels/s11-l1": "Separate tickets mean you carry the risk yourself.|en|1|1|1|false",
 "book-flights-and-hotels/s12-l1": "Look at the landing time in local time.|en|1|1|1|false",
 "book-flights-and-hotels/s12-l2": "At midnight, buses and trains may have stopped. Tell the hotel if you check in late.|en|1|1|1|false",
 "book-flights-and-hotels/s13-l1": "Part three: the ticket price, and your name.|en|1|1|1|false",
 "book-flights-and-hotels/s14-l1": "Before paying, open the ticket rules. How many kilos for cabin and checked bags?|en|1|1|1|false",
 "book-flights-and-hotels/s14-l2": "What does changing the date or name cost? Can you get a refund?|en|1|1|1|false",
 "book-flights-and-hotels/s14-l3": "Do seats and meals cost extra?|en|1|1|1|false",
 "book-flights-and-hotels/s15-l1": "The price on the search page is what you'll pay. True or false?|en|1|1|1|false",
 "book-flights-and-hotels/s15-l2": "False. Taxes, fees, bags, and seats get added. Look at the total on the last page.|en|1|1|1|false",
 "book-flights-and-hotels/s15-l3": "Two tickets that looked far apart can end up almost the same.|en|1|1|1|false",
 "book-flights-and-hotels/s16-l1": "The cheapest tickets often have strict rules: no changes, no refunds.|en|1|1|1|false",
 "book-flights-and-hotels/s16-l2": "Plans not sure, or waiting for a visa? A flexible ticket can be cheaper in the end.|en|1|1|1|false",
 "book-flights-and-hotels/s17-l1": "Surname, or last name, is your family name.|en|1|1|1|false",
 "book-flights-and-hotels/s17-l2": "Given name, or first name, is your middle and first name. No accents.|en|1|1|1|false",
 "book-flights-and-hotels/s17-l3": "Send yourself a photo of your passport page, and look at it while you type.|en|1|1|1|false",
 "book-flights-and-hotels/s18-l1": "My passport says NGUYEN THI LAN.|en|1|1|1|false",
 "book-flights-and-hotels/s18-l2": "Surname, THI LAN. Given name, NGUYEN. Done!|en|1|1|1|false",
 "book-flights-and-hotels/s18-l3": "Wait a second!|en|1|1|1|false",
 "book-flights-and-hotels/s18-l4": "Surname is the family name. Now the ticket name is the wrong way round.|en|1|1|1|false",
 "book-flights-and-hotels/s18-l5": "Let's rewind and try again.|en|1|1|1|false",
 "book-flights-and-hotels/s18-l6": "Surname, NGUYEN. Given name, THI LAN. No accents.|en|1|1|1|false",
 "book-flights-and-hotels/s18-l7": "Each name in its box, copied from the passport. Booking for family? Keep each passport beside you.|en|1|1|1|false",
 "book-flights-and-hotels/s19-l1": "Part four: choosing a hotel. Beyond the price.|en|1|1|1|false",
 "book-flights-and-hotels/s20-l1": "Read reviews for four things. Read the bad ones too: does that problem matter to you?|en|1|1|1|false",
 "book-flights-and-hotels/s20-l2": "Is it clean?|en|1|1|1|false",
 "book-flights-and-hotels/s20-l3": "Is it noisy?|en|1|1|1|false",
 "book-flights-and-hotels/s20-l4": "Is the area safe?|en|1|1|1|false",
 "book-flights-and-hotels/s20-l5": "Do staff help foreign guests?|en|1|1|1|false",
 "book-flights-and-hotels/s21-l1": "How many beds? Is there a window?|en|1|1|1|false",
 "book-flights-and-hotels/s21-l2": "Private or shared bathroom? Is breakfast included?|en|1|1|1|false",
 "book-flights-and-hotels/s21-l3": "The best photo is often the lobby or a better room, not the one you booked.|en|1|1|1|false",
 "book-flights-and-hotels/s22-l1": "The nightly price may not include taxes, service fees, or local tourist fees.|en|1|1|1|false",
 "book-flights-and-hotels/s22-l2": "Some are paid at check-in. Look at the final total, and the line “pay at the hotel”.|en|1|1|1|false",
 "book-flights-and-hotels/s23-l1": "Free cancellation costs a bit more, but lets you change plans.|en|1|1|1|false",
 "book-flights-and-hotels/s23-l2": "Non-refundable is cheaper, but you lose it all if you miss the trip.|en|1|1|1|false",
 "book-flights-and-hotels/s23-l3": "On a first trip, free cancellation is usually worth it.|en|1|1|1|false",
 "book-flights-and-hotels/s24-l1": "Bác Bình booked the cheapest room. It said “central”, non-refundable.|en|1|1|1|false",
 "book-flights-and-hotels/s24-l2": "“Central”? No window, a quiet alley, half an hour to the station.|en|1|1|1|false",
 "book-flights-and-hotels/s24-l3": "If I move, I lose all the money.|en|1|1|1|false",
 "book-flights-and-hotels/s24-l4": "“Central” was just the district name. Check the map first, the photos later.|en|1|1|1|false",
 "book-flights-and-hotels/s25-l1": "Part five: you've booked. Now what?|en|1|1|1|false",
 "book-flights-and-hotels/s26-l1": "Check the email: names, dates, number of guests, booking code.|en|1|1|1|false",
 "book-flights-and-hotels/s26-l2": "Check the code on the airline's site. Save and print the confirmation.|en|1|1|1|false",
 "book-flights-and-hotels/s26-l3": "Put the free cancellation deadline in your phone calendar.|en|1|1|1|false",
 "book-flights-and-hotels/s27-l1": "A few days before, I'll confirm and tell them my arrival time.|en|1|1|1|false",
 "book-flights-and-hotels/s27-l2": "Hello, I have a booking from the twelfth to the fifteenth. I will arrive around eleven at night. Is that okay?|en|1|1|1|false",
 "book-flights-and-hotels/s27-l3": "Yes, that is okay. See you then!|en|1|1|1|false",
 "book-flights-and-hotels/s28-l1": "Check-in is usually in the afternoon. Check-out, in the morning.|en|1|1|1|false",
 "book-flights-and-hotels/s28-l2": "I'm early. Can I leave my bags here until check-in?|en|1|1|1|false",
 "book-flights-and-hotels/s28-l3": "Of course. Enjoy your morning.|en|1|1|1|false",
 "book-flights-and-hotels/s28-l4": "Late flight after check-out? Ask the same, and go out hands-free.|en|1|1|1|false",
 "book-flights-and-hotels/s29-l1": "Once you've booked, the flight time won't change. True or false?|en|1|1|1|false",
 "book-flights-and-hotels/s29-l2": "False. Times sometimes change. Check again a few days before, and on the day.|en|1|1|1|false",
 "book-flights-and-hotels/s29-l3": "Airlines tell you by email or text, so use the ones you really check.|en|1|1|1|false",
 "book-flights-and-hotels/s30-l1": "Part six: booking for a group.|en|1|1|1|false",
 "book-flights-and-hotels/s31-l1": "Send me clear photos of your passport pages.|en|1|1|1|false",
 "book-flights-and-hotels/s31-l2": "Sent. Let's all check the names before you pay.|en|1|1|1|false",
 "book-flights-and-hotels/s31-l3": "And let's split the money right after booking.|en|1|1|1|false",
 "book-flights-and-hotels/s31-l4": "I'll write down who paid what.|en|1|1|1|false",
 "book-flights-and-hotels/s31-l5": "Then nobody feels awkward asking after the trip.|en|1|1|1|false",
 "book-flights-and-hotels/s32-l1": "One booking code for the whole group? Ask the airline or agent first.|en|1|1|1|false",
 "book-flights-and-hotels/s32-l2": "If one person cancels or changes dates, are the others affected?|en|1|1|1|false",
 "book-flights-and-hotels/s33-l1": "Buy at the right place, read the rules, fill each box right.|en|1|1|1|false",
 "book-flights-and-hotels/s33-l2": "Check the map, then check the confirmation. A few minutes each.|en|1|1|1|false",
 "book-flights-and-hotels/s33-l3": "And they keep you from losing everything.|en|1|1|1|false",
 "book-flights-and-hotels/s34-l1": "On a booking form, what do surname and given name mean for a Vietnamese passport?|en|1|1|1|false",
 "book-flights-and-hotels/s34-l2": "Surname is your family name, and given name is your middle and first name.|en|1|1|1|false",
 "book-flights-and-hotels/s34-l3": "Mix up the boxes, and the ticket will not match your passport.|en|1|1|1|false",
 "book-flights-and-hotels/s35-l1": "Send a photo of your passport page to yourself. Then try the forty questions.|en|1|1|1|false",
 "business-meals-and-gifts/s01-l1": "If we order a lot, can you give us a bigger discount?|en|1|1|1|false",
 "business-meals-and-gifts/s01-l2": "Hmm…|en|1|1|1|false",
 "business-meals-and-gifts/s01-l3": "After a few toasts, the mood is great. But Dũng's manager hasn't approved any price. What would you say?|en|1|1|1|false",
 "business-meals-and-gifts/s02-l1": "Hold that question. How do you stay professional at the table? It's not an exam. The host only hopes you are|en|1|1|1|false",
 "business-meals-and-gifts/s02-l2": "polite and open,|en|1|1|1|false",
 "business-meals-and-gifts/s02-l3": "ready to ask when unsure,|en|1|1|1|false",
 "business-meals-and-gifts/s02-l4": "careful with drinks,|en|1|1|1|false",
 "business-meals-and-gifts/s02-l5": "and respectful of their habits.|en|1|1|1|false",
 "business-meals-and-gifts/s03-l1": "We follow the meal in order: before you arrive, at the table, drinks,|en|1|1|1|false",
 "business-meals-and-gifts/s03-l2": "money, gifts, and after the meal.|en|1|1|1|false",
 "business-meals-and-gifts/s04-l1": "Part one: before you arrive.|en|1|1|1|false",
 "business-meals-and-gifts/s05-l1": "When you accept, ask the time, the place, and who else will come.|en|1|1|1|false",
 "business-meals-and-gifts/s05-l2": "A senior manager coming? Dress more formally, and prepare a few topics.|en|1|1|1|false",
 "business-meals-and-gifts/s05-l3": "Ask colleagues who know them: lunch or dinner? Do they drink? Do they give gifts?|en|1|1|1|false",
 "business-meals-and-gifts/s06-l1": "Welcome! This is the best seafood restaurant in town.|en|1|1|1|false",
 "business-meals-and-gifts/s06-l2": "Oh… how lovely.|en|1|1|1|false",
 "business-meals-and-gifts/s06-l3": "Wait a second!|en|1|1|1|false",
 "business-meals-and-gifts/s06-l4": "Thảo is allergic to seafood. She barely ate, the host ordered more and more, and the mood grew awkward.|en|1|1|1|false",
 "business-meals-and-gifts/s06-l5": "Let's rewind to the invitation.|en|1|1|1|false",
 "business-meals-and-gifts/s06-l6": "Thank you for the invitation. Just so you know, I'm allergic to seafood.|en|1|1|1|false",
 "business-meals-and-gifts/s06-l7": "Thank you for telling me. I'll choose another place.|en|1|1|1|false",
 "business-meals-and-gifts/s07-l1": "Vegetarian, or avoiding a food for health or religion? Say so when you accept: “Just so you know, I don't eat seafood.”|en|1|1|1|false",
 "business-meals-and-gifts/s07-l2": "But for an allergy, say the word allergic. “I don't eat” sounds like a preference, and the kitchen may not check carefully.|en|1|1|1|false",
 "business-meals-and-gifts/s08-l1": "Arrive on time, or a few minutes early. Stuck in traffic? Message the host now, don't arrive late in silence.|en|1|1|1|false",
 "business-meals-and-gifts/s08-l2": "I'm so sorry, I'm stuck in traffic and will be about ten minutes late.|en|1|1|1|false",
 "business-meals-and-gifts/s09-l1": "One sentence early saves a whole awkward meal.|en|1|1|1|false",
 "business-meals-and-gifts/s10-l1": "Part two: at the table.|en|1|1|1|false",
 "business-meals-and-gifts/s11-l1": "Wait for the host to invite you to sit. In many places, seats show rank.|en|1|1|1|false",
 "business-meals-and-gifts/s11-l2": "Where would you like me to sit?|en|1|1|1|false",
 "business-meals-and-gifts/s11-l3": "And what do you recommend here?|en|1|1|1|false",
 "business-meals-and-gifts/s11-l4": "Oh, you must try our local soup!|en|1|1|1|false",
 "business-meals-and-gifts/s11-l5": "Hosts usually enjoy sharing local food. And when you are invited, avoid the most expensive dish.|en|1|1|1|false",
 "business-meals-and-gifts/s12-l1": "Watch the host: who starts eating, which tools, shared dishes or not? Unsure? Ask quietly.|en|1|1|1|false",
 "business-meals-and-gifts/s12-l2": "Safe topics: food, travel, their city and culture.|en|1|1|1|false",
 "business-meals-and-gifts/s12-l3": "Avoid politics, religion, and income.|en|1|1|1|false",
 "business-meals-and-gifts/s12-l4": "Work? Let the host bring it up first.|en|1|1|1|false",
 "business-meals-and-gifts/s13-a0": "The first dinner with the partner. You've just sat down.|en|1|1|1|false",
 "business-meals-and-gifts/s13-a1": "So, about our prices. Here's the price list on my phone.|en|1|1|1|false",
 "business-meals-and-gifts/s13-a2": "Maybe later. How was your flight?|en|1|1|1|false",
 "business-meals-and-gifts/s13-a3": "Short answers, the subject keeps changing. Next day, the host hints to your boss: dinner was for getting to know each other.|en|1|1|1|false",
 "business-meals-and-gifts/s13-b1": "What do you love most about your city?|en|1|1|1|false",
 "business-meals-and-gifts/s13-b2": "Oh, the food! Let me tell you…|en|1|1|1|false",
 "business-meals-and-gifts/s13-b3": "Numbers wait for tomorrow's meeting room. The meal is relaxed, and the meeting starts more easily.|en|1|1|1|false",
 "business-meals-and-gifts/s14-l1": "Meeting rooms are for numbers. Dinner tables are for people.|en|1|1|1|false",
 "business-meals-and-gifts/s15-l1": "Part three: do you have to drink?|en|1|1|1|false",
 "business-meals-and-gifts/s16-l1": "You don't have to drink. Raise water or juice, and join the toast.|en|1|1|1|false",
 "business-meals-and-gifts/s16-l2": "I don't drink alcohol, but I'm happy to join the toast with juice.|en|1|1|1|false",
 "business-meals-and-gifts/s17-l1": "If you drink, know your limit, and stop earlier than you think.|en|1|1|1|false",
 "business-meals-and-gifts/s17-l2": "You represent your company until you are back in your hotel room, not only in meetings.|en|1|1|1|false",
 "business-meals-and-gifts/s17-l3": "In some places, an empty glass is filled at once. Leave a little, or cover it with your hand and smile.|en|1|1|1|false",
 "business-meals-and-gifts/s18-l1": "Back to Dũng and the discount. Nodding now means a correction email tomorrow, and a call from his boss.|en|1|1|1|false",
 "business-meals-and-gifts/s18-l2": "Let me check with my team and get back to you.|en|1|1|1|false",
 "business-meals-and-gifts/s18-l3": "Switching to water after the first glass kept his head clear enough to say it.|en|1|1|1|false",
 "business-meals-and-gifts/s19-l1": "Your glass can be empty. Your mind must stay clear.|en|1|1|1|false",
 "business-meals-and-gifts/s20-l1": "Part four: who pays?|en|1|1|1|false",
 "business-meals-and-gifts/s21-l1": "Usually, whoever invites pays. Thank them sincerely and don't fight for the bill. Invite them back another time.|en|1|1|1|false",
 "business-meals-and-gifts/s21-l2": "When you host, ask how much the company allows first. Book a table ahead.|en|1|1|1|false",
 "business-meals-and-gifts/s21-l3": "Pay quietly, away from the guests. And get a receipt with the right company details.|en|1|1|1|false",
 "business-meals-and-gifts/s22-l1": "Tips depend on the country. In some, almost required; in others, not a habit.|en|1|1|1|false",
 "business-meals-and-gifts/s22-l2": "Ask local people, and check whether the bill already includes service.|en|1|1|1|false",
 "business-meals-and-gifts/s23-l1": "Mai was asked to host a dinner. To show respect, she picked a fancy restaurant from an online tip.|en|1|1|1|false",
 "business-meals-and-gifts/s23-l2": "She never asked about the limit. The dinner went well.|en|1|1|1|false",
 "business-meals-and-gifts/s23-l3": "But the bill was far above the approved amount, and she paid the difference herself.|en|1|1|1|false",
 "business-meals-and-gifts/s24-l1": "Check the spending limit first. Order after.|en|1|1|1|false",
 "business-meals-and-gifts/s25-l1": "Part five: gifts.|en|1|1|1|false",
 "business-meals-and-gifts/s26-l1": "Ask about gift rules: does the company prepare it, or do you? Many companies, the partner's too, limit gift value.|en|1|1|1|false",
 "business-meals-and-gifts/s26-l2": "A very expensive gift may make them uncomfortable, or force them to refuse.|en|1|1|1|false",
 "business-meals-and-gifts/s26-l3": "Best: small, nicely wrapped, and Vietnamese, like tea, coffee, or handicrafts. Ask before giving logo items.|en|1|1|1|false",
 "business-meals-and-gifts/s26b-l4": "Bringing food? Check the customs rules before you pack. And some numbers, colours or objects carry bad meanings. Unsure? Choose something neutral.|en|1|1|1|false",
 "business-meals-and-gifts/s27-l1": "Dried meat from home! The most meaningful gift, and the safest.|en|1|1|1|false",
 "business-meals-and-gifts/s27-l2": "Wait a second!|en|1|1|1|false",
 "business-meals-and-gifts/s27-l3": "Customs may keep it, some places fine you, and you rush to buy a gift before the meeting.|en|1|1|1|false",
 "business-meals-and-gifts/s27-l4": "Let's rewind and try again.|en|1|1|1|false",
 "business-meals-and-gifts/s27-l5": "Is this gift all right for them? Any bad meanings I should avoid?|en|1|1|1|false",
 "business-meals-and-gifts/s27-l6": "Sealed tea is safer. But check their customs rules first.|en|1|1|1|false",
 "business-meals-and-gifts/s28-l1": "Give gifts at the end of the first meeting, or when saying goodbye, with both hands.|en|1|1|1|false",
 "business-meals-and-gifts/s28-l2": "This is a small gift from Vietnam. We hope you enjoy it.|en|1|1|1|false",
 "business-meals-and-gifts/s28-l3": "Thank you so much.|en|1|1|1|false",
 "business-meals-and-gifts/s28-l4": "Some people don't open gifts at once. Don't be hurt.|en|1|1|1|false",
 "business-meals-and-gifts/s28-l5": "Given a gift? Thank them, ask if you should open it now. If it looks too valuable, accept politely, then tell your manager.|en|1|1|1|false",
 "business-meals-and-gifts/s29-l1": "A small gift that fits beats a big gift that causes trouble.|en|1|1|1|false",
 "business-meals-and-gifts/s30-l1": "Last part: after the meal.|en|1|1|1|false",
 "business-meals-and-gifts/s31-l1": "That night or the next morning, say thank you, with one specific detail.|en|1|1|1|false",
 "business-meals-and-gifts/s31-l2": "Thank you for dinner last night. The local soup you recommended was wonderful.|en|1|1|1|false",
 "business-meals-and-gifts/s31-l3": "Then note what you heard: their hobbies, their plans. It opens the next talk, and helps when you hand over to colleagues.|en|1|1|1|false",
 "business-meals-and-gifts/s32-l1": "Your checklist: food limits shared, and who pays is clear.|en|1|1|1|false",
 "business-meals-and-gifts/s32-l2": "Budget checked, gift rules checked, both sides and customs.|en|1|1|1|false",
 "business-meals-and-gifts/s32-l3": "And a thank-you within a day.|en|1|1|1|false",
 "business-meals-and-gifts/s33-l1": "What is the difference between a meeting room and a dinner table on a business trip?|en|1|1|1|false",
 "business-meals-and-gifts/s33-l2": "Meetings are for numbers and deals, while dinners are for building a good relationship.|en|1|1|1|false",
 "business-meals-and-gifts/s33-l3": "Trust built at dinner makes the next meetings easier.|en|1|1|1|false",
 "business-meals-and-gifts/s34-l1": "Now, forty questions to help you remember.|en|1|1|1|false",
 "business-trip-expenses-receipts/s01-l1": "I kept every dinner receipt! Why do I pay part of it myself?|en|1|1|1|false",
 "business-trip-expenses-receipts/s01-l2": "Meals are a fixed daily allowance, not paid by receipt.|en|1|1|1|false",
 "business-trip-expenses-receipts/s01-l3": "Thảo ate at the hotel restaurant every night. Everything above the allowance came from her pocket.|en|1|1|1|false",
 "business-trip-expenses-receipts/s02-l1": "How do you avoid paying company costs yourself? Ask about the rules before you go,|en|1|1|1|false",
 "business-trip-expenses-receipts/s02-l2": "photograph each receipt when you pay,|en|1|1|1|false",
 "business-trip-expenses-receipts/s02-l3": "log your costs every evening,|en|1|1|1|false",
 "business-trip-expenses-receipts/s02-l4": "keep personal spending separate, and submit early.|en|1|1|1|false",
 "business-trip-expenses-receipts/s03-l1": "Six steps: what to ask, keeping receipts, company or personal,|en|1|1|1|false",
 "business-trip-expenses-receipts/s03-l2": "currency and cards, lost receipts, and the claim.|en|1|1|1|false",
 "business-trip-expenses-receipts/s04-l1": "Part one: let's rewind to before Thảo's trip.|en|1|1|1|false",
 "business-trip-expenses-receipts/s05-l1": "Get the company's expense rules, or ask accounting. Which costs are covered: tickets, hotel, transport, meals, guests, phone?|en|1|1|1|false",
 "business-trip-expenses-receipts/s05-l2": "What is the limit for each?|en|1|1|1|false",
 "business-trip-expenses-receipts/s05-l3": "And which are a daily allowance, a fixed amount per day, and which are paid back by real receipts?|en|1|1|1|false",
 "business-trip-expenses-receipts/s06-l1": "Any questions before your trip?|en|1|1|1|false",
 "business-trip-expenses-receipts/s06-l2": "No. I'll just keep all my receipts.|en|1|1|1|false",
 "business-trip-expenses-receipts/s06-l3": "Wait a second!|en|1|1|1|false",
 "business-trip-expenses-receipts/s06-l4": "Some costs are a fixed daily amount. Receipts won't help there.|en|1|1|1|false",
 "business-trip-expenses-receipts/s06-l5": "Let's rewind and try again.|en|1|1|1|false",
 "business-trip-expenses-receipts/s06-l6": "Are meals a daily allowance, or paid by receipt? What papers do taxis abroad need?|en|1|1|1|false",
 "business-trip-expenses-receipts/s06-l7": "Do foreign receipts need a translation? And how soon must I submit my claim?|en|1|1|1|false",
 "business-trip-expenses-receipts/s06-l8": "Good questions. Let me explain each one.|en|1|1|1|false",
 "business-trip-expenses-receipts/s07-l1": "Cash advance? Request it early, so the money arrives before you leave.|en|1|1|1|false",
 "business-trip-expenses-receipts/s07-l2": "Back home you settle it: receipts for what you spent, and return what's left.|en|1|1|1|false",
 "business-trip-expenses-receipts/s07-l3": "Using your own card? Ask the bank if it works abroad and about foreign fees. Ask accounting which rate they use to repay.|en|1|1|1|false",
 "business-trip-expenses-receipts/s08-l1": "Ask about the rules before you spend, so you don't pay it back later.|en|1|1|1|false",
 "business-trip-expenses-receipts/s09-l1": "Part two: keeping receipts during the trip.|en|1|1|1|false",
 "business-trip-expenses-receipts/s10-l1": "Every work cost needs a receipt, even a short taxi, parking, or drinks with a guest.|en|1|1|1|false",
 "business-trip-expenses-receipts/s10-l2": "A useful receipt shows the seller's name, the date, what you bought, the amount and the currency.|en|1|1|1|false",
 "business-trip-expenses-receipts/s11-l1": "Đạt took a big envelope on his four-day trip. He photographed the airport taxi receipt before putting it away.|en|1|1|1|false",
 "business-trip-expenses-receipts/s11-l2": "The original went straight into the envelope, never into a wallet or pocket. Thermal paper fades easily.|en|1|1|1|false",
 "business-trip-expenses-receipts/s11-l3": "Each evening, five minutes on his expense list.|en|1|1|1|false",
 "business-trip-expenses-receipts/s11-l4": "Back home, one receipt had faded, but the photo was clear, and the list was almost done.|en|1|1|1|false",
 "business-trip-expenses-receipts/s12-l1": "Each line: date, item, amount, currency, cash or card, and a short note, like where you went and who you met.|en|1|1|1|false",
 "business-trip-expenses-receipts/s12-l2": "For a business meal, write who you invited, which company, and why. In a few weeks you won't remember.|en|1|1|1|false",
 "business-trip-expenses-receipts/s12-l3": "Need the hotel invoice in the company name? Give the details at check-in, not in a rush at check-out.|en|1|1|1|false",
 "business-trip-expenses-receipts/s13-l1": "Get a receipt, take a photo. Update your list every night.|en|1|1|1|false",
 "business-trip-expenses-receipts/s14-l1": "Part three: company cost, or personal?|en|1|1|1|false",
 "business-trip-expenses-receipts/s15-l1": "Gifts for family, snacks, the minibar, paid movies: usually personal. Pay them separately.|en|1|1|1|false",
 "business-trip-expenses-receipts/s15-l2": "One receipt with both? Ask the seller to split it. If not, mark the personal part clearly.|en|1|1|1|false",
 "business-trip-expenses-receipts/s16-l1": "An unplanned cost? Ask your approver before you spend, and save the reply.|en|1|1|1|false",
 "business-trip-expenses-receipts/s16-l2": "My flight changed, and I need one more night. May I book a hotel near the airport, within the limit?|en|1|1|1|false",
 "business-trip-expenses-receipts/s16-l3": "Yes, within the limit.|en|1|1|1|false",
 "business-trip-expenses-receipts/s16-l4": "That message proves the cost was approved.|en|1|1|1|false",
 "business-trip-expenses-receipts/s17-a1": "Please charge everything to this card.|en|1|1|1|false",
 "business-trip-expenses-receipts/s17-a2": "The company card pays for the minibar and laundry too. Accounting asks about every line, and he spends a morning paying back.|en|1|1|1|false",
 "business-trip-expenses-receipts/s17-b1": "Could I pay the minibar and laundry separately with my own card?|en|1|1|1|false",
 "business-trip-expenses-receipts/s17-b2": "Of course. Here are two receipts.|en|1|1|1|false",
 "business-trip-expenses-receipts/s18-l1": "Company money and your money: split them right at the counter.|en|1|1|1|false",
 "business-trip-expenses-receipts/s19-l1": "Part four: currency, rates and cards.|en|1|1|1|false",
 "business-trip-expenses-receipts/s20-l1": "Write the currency on every line. Two countries? Numbers look alike, and a mistake changes the total.|en|1|1|1|false",
 "business-trip-expenses-receipts/s20-l2": "Don't convert to dong yourself if the company has its own way. Ask which rate.|en|1|1|1|false",
 "business-trip-expenses-receipts/s20-l3": "The card machine asks: local money or Vietnamese? Local is usually easier to check, and avoids a poor rate.|en|1|1|1|false",
 "business-trip-expenses-receipts/s20-l4": "Keep card statements and exchange slips. They prove the real rate when amounts don't match.|en|1|1|1|false",
 "business-trip-expenses-receipts/s21-l1": "The little exchange slip from the airport? Throw it away to keep your wallet tidy. True or false?|en|1|1|1|false",
 "business-trip-expenses-receipts/s21-l2": "False. Without it, the company may use a lower rate, and you pay the gap. Ask before you go how they convert.|en|1|1|1|false",
 "business-trip-expenses-receipts/s22-l1": "Keep the slip when you change money, and there's no argument about rates.|en|1|1|1|false",
 "business-trip-expenses-receipts/s23-l1": "Part five: no receipt, or a lost one.|en|1|1|1|false",
 "business-trip-expenses-receipts/s24-l1": "Buses, markets, small stalls may give no receipt. Photograph the ticket or price board, and note it that day.|en|1|1|1|false",
 "business-trip-expenses-receipts/s24-l2": "Ask accounting if there's a form to fill in, or an explanation to write.|en|1|1|1|false",
 "business-trip-expenses-receipts/s24b-l3": "Lost one? Ask the seller for a copy. Hotels can often email it. Use your card statement too, and tell accounting early, don't hide it.|en|1|1|1|false",
 "business-trip-expenses-receipts/s25-l0": "Dũng lost his airport taxi receipt. What a pity.|en|1|1|1|false",
 "business-trip-expenses-receipts/s25-l1": "Maybe a friend there can get me another receipt with the same amount.|en|1|1|1|false",
 "business-trip-expenses-receipts/s25-l2": "Wait a second!|en|1|1|1|false",
 "business-trip-expenses-receipts/s25-l3": "Never fix, fake, or inflate a receipt, even if a seller suggests it.|en|1|1|1|false",
 "business-trip-expenses-receipts/s25-l4": "Let's rewind and ask accounting first.|en|1|1|1|false",
 "business-trip-expenses-receipts/s25-l5": "I lost my taxi receipt. What should I do?|en|1|1|1|false",
 "business-trip-expenses-receipts/s25-l6": "Use your card statement, with a short note to explain.|en|1|1|1|false",
 "business-trip-expenses-receipts/s25-l7": "The cost was approved as normal.|en|1|1|1|false",
 "business-trip-expenses-receipts/s26-l1": "Lose a paper? Report it. Never patch it with a fake.|en|1|1|1|false",
 "business-trip-expenses-receipts/s27-l1": "Last part: submitting your claim.|en|1|1|1|false",
 "business-trip-expenses-receipts/s28-l1": "Submit as soon as you can, within the deadline, while details are fresh.|en|1|1|1|false",
 "business-trip-expenses-receipts/s28-l2": "Sort receipts by date or type, and number each one to match a line in your list.|en|1|1|1|false",
 "business-trip-expenses-receipts/s28-l3": "Usually: the list, original receipts, photos, card statements, exchange slips, and approval messages. Ask what else.|en|1|1|1|false",
 "business-trip-expenses-receipts/s29-l1": "Your checklist: rules and limits asked. Receipts photographed. A list every night.|en|1|1|1|false",
 "business-trip-expenses-receipts/s29-l2": "Personal costs paid apart, slips and statements kept, and the claim in on time.|en|1|1|1|false",
 "business-trip-expenses-receipts/s30-l1": "One question before the trip, and Thảo would not have paid herself. Ask before you spend.|en|1|1|1|false",
 "business-trip-expenses-receipts/s30-l2": "Photo every receipt, log every night.|en|1|1|1|false",
 "business-trip-expenses-receipts/s30-l3": "And split company and personal at the counter.|en|1|1|1|false",
 "business-trip-expenses-receipts/s31-l1": "Why should you keep the small exchange slip from the airport counter?|en|1|1|1|false",
 "business-trip-expenses-receipts/s31-l2": "Without it, the company may use a lower rate and you cover the difference.|en|1|1|1|false",
 "business-trip-expenses-receipts/s31-l3": "The slip proves the real rate you paid.|en|1|1|1|false",
 "business-trip-expenses-receipts/s32-l1": "Your turn. Forty questions are waiting below.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s01-l1": "The invitation letter is here. Looks fine. I'll submit it now!|en|1|1|1|false",
 "business-trip-schedule-and-documents/s01-l2": "A few days later, the visa application came back.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s01-l3": "The name in the letter was missing one middle name, unlike his passport.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s01-l4": "Another week of waiting… and I have to move my flight.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s02-l1": "How do you avoid document trouble? Check official sources early, plan in local time with gaps, and keep two copies.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s02-l2": "One: passport, visa, invitation letter.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s02-l3": "Two: tickets and hotels.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s02-l4": "Three: a realistic schedule.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s02-l5": "Four: papers to carry.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s02-l6": "Five: insurance and small things people forget.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s03-l1": "Part one: passport, visa, and invitation letter.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s04-l1": "Open your passport. Check the expiry date first.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s04-l2": "Many countries want it valid for some time after you arrive or leave. Some need empty pages for stamps.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s04-l3": "Expiring soon? Check that country's rules now, and renew early. It takes time.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s05-l1": "A friend says a tourist visa is fine for business meetings. True or false?|en|1|1|1|false",
 "business-trip-schedule-and-documents/s05-l2": "False, in many countries. Use the visa that matches your purpose. Check the embassy website, and ask your admin team.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s06-l1": "Often needed: an invitation letter from the partner, and a letter from your company.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s06-l2": "Photos in the right format. Proof of money or a hotel booking, if asked.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s06-l3": "The real list depends on the country. A friend's list from another trip won't do. Check official sources.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s07-l1": "The partner usually writes the letter. So tell them early what it must say.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s07-l2": "Could you please send an invitation letter with my full name as shown in my passport?|en|1|1|1|false",
 "business-trip-schedule-and-documents/s07-l3": "I arrive on Monday, for a meeting with your company.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s07-l4": "Your full name as in the passport, your travel dates, and the purpose of the trip.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s08-l1": "Looks fine. I'll submit it now!|en|1|1|1|false",
 "business-trip-schedule-and-documents/s08-l2": "Wait a second!|en|1|1|1|false",
 "business-trip-schedule-and-documents/s08-l3": "One missing middle name sent it back. Every name must match your passport, letter by letter.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s08-l4": "Let's rewind and try again.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s08-l5": "Wait. Let me check every letter of my name, and every date, against my passport and tickets.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s08-l6": "All correct. Now I can submit it.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s09-l1": "Part two: flights and hotels. Who books, and how?|en|1|1|1|false",
 "business-trip-schedule-and-documents/s10-l1": "Ask first: does the company book for you, or do you book and claim later?|en|1|1|1|false",
 "business-trip-schedule-and-documents/s10-l2": "If you book, ask about ticket class, room level, and the receipts accounting needs. Or you pay the extra.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s11-l1": "Check your ticket: your name matches your passport, and the airports are right.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s11-l2": "Dates and times are in local time. An overnight flight may land on the next calendar day.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s11-l3": "That changes your hotel and meeting dates.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s12-l1": "Choose a hotel near the meeting, or near easy transport, even if a far one is a bit cheaper.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s12-l2": "Two bus changes in the morning, and your day starts tired.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s13-l1": "Read the change and cancellation rules for tickets and rooms. Business plans often change.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s13-l2": "A cheap ticket you can't change may become the most expensive one when the partner moves the meeting.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s14-l1": "Part three: a realistic schedule.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s15-l1": "Before: Tuesday, seven o'clock, meeting with the partner. Written in Vietnam time, to remember easily.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s15-l3": "After: Tuesday, nine o'clock Seoul time, seven o'clock Vietnam time, room twelve A.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s15b-l2": "With the first line, the writer forgot to convert in Seoul: a locked room, and two hours waiting in an empty lobby.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s15b-l4": "Write local time, mark it clearly, and add home time beside it for the office.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s16-l1": "Write each time in the local time of the place where it happens.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s17-l1": "A packed schedule looks efficient on paper. One long meeting, and the whole day falls apart.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s17-l2": "Leave gaps: travel time, waiting for lifts, signing in at reception, and a short rest.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s17-l3": "After a long flight, don't put the most important meeting on day one. Jet lag hurts focus. Do light tasks first.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s18-l2": "Way A: half an hour apart. One runs long, and the third is missed.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s18-l3": "Way B: ask the real travel time, and double the gap. You make all three.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s19-l1": "A schedule with breathing room lets the day run smoothly.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s20-l1": "Part four: papers to carry, and how to keep them.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s21-l1": "Passport, visa, tickets, and hotel booking.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s21-l2": "The invitation letter and your company letter.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s21-l3": "A schedule with addresses and contacts for the partner and hotel.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s21-l4": "Insurance details. And a valid driving licence, if you plan to drive and it is allowed there.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s22-l1": "Keep each important paper in two places: printed in your hand bag, and photographed on your phone or online.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s22-l2": "Keep a passport copy separate from the real one, in case it is lost.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s22-l3": "Phone lost? The printed schedule still has the hotel and partner contacts.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s23-l0": "Thảo thought her phone was enough. Everything was in her email.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s23-l1": "Why are you here, and where are you staying?|en|1|1|1|false",
 "business-trip-schedule-and-documents/s23-l2": "It's all in my email… but my phone battery is dead.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s23-l3": "Wait a second!|en|1|1|1|false",
 "business-trip-schedule-and-documents/s23-l4": "She had to stand aside and wait a long time. One copy in your bag, one on your phone.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s23-l5": "Let's rewind and try again.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s23-l6": "I am here for a business meeting with my partner company. I will stay for five days.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s23-l7": "Thank you. Enjoy your stay.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s24-l1": "At the border, you may be asked why you came, where you stay, and how long.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s24-l2": "Answer briefly and truthfully, matching your papers.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s24-l3": "Keep the invitation letter and booking in your hand luggage, not deep in your checked bag.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s24-l4": "One copy in your bag, one copy on your phone.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s25-l1": "Bringing samples, lots of printed papers, or equipment? Ask the responsible team about customs rules first.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s25-l2": "Keep medicine in its original box, with the prescription. Some medicines are controlled in some countries.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s26-l1": "Last part: insurance, and small things people forget.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s27-l1": "Ask: does the company buy travel insurance? What does it cover? Who do you call?|en|1|1|1|false",
 "business-trip-schedule-and-documents/s27-l2": "Save the policy number and contacts on your phone and on paper. If the phone dies, you can still call.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s28-l1": "Ask your bank whether your card works abroad.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s28-l2": "Carry a little local cash for the first small costs, and find out how mobile data works there.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s29-l1": "Here is my schedule: flight, hotel, and meeting places.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s29-l2": "Thank you. Send it to your family too.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s29-l3": "Send it to your manager, the person in charge at the office, and your family. If something happens, they know where to start.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s29-l4": "Managers: give a list of the usual papers for that country, and say who handles the letter and who books tickets.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s30-l1": "Dũng lost a week to one missing name. Every name must match your passport, letter by letter.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s30-l2": "A schedule with breathing room.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s30-l3": "One copy in your bag, one on your phone.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s31-l1": "An immigration officer asks why you are visiting, how should you answer?|en|1|1|1|false",
 "business-trip-schedule-and-documents/s31-l2": "Briefly and truthfully, matching your documents, with your invitation letter easy to reach.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s31-l3": "A short, true answer that matches your papers keeps things quick.|en|1|1|1|false",
 "business-trip-schedule-and-documents/s32-l1": "Your turn. Forty questions are waiting below.|en|1|1|1|false",
 "calculate-costs-fees-profit/s01-l1": "Orders every day. Packing till late every night…|en|1|1|1|false",
 "calculate-costs-fees-profit/s01-l2": "So why is there almost no money in my account?|en|1|1|1|false",
 "calculate-costs-fees-profit/s01-l3": "Many new sellers feel this. Let's see where the money went.|en|1|1|1|false",
 "calculate-costs-fees-profit/s02-l1": "Money from sales is not profit. So how do you find your real profit?|en|1|1|1|false",
 "calculate-costs-fees-profit/s02-l2": "Count the full cost.|en|1|1|1|false",
 "calculate-costs-fees-profit/s02-l3": "Add every fee per order.|en|1|1|1|false",
 "calculate-costs-fees-profit/s02-l4": "Set prices and sales from those numbers.|en|1|1|1|false",
 "calculate-costs-fees-profit/s02-l5": "And keep notes, regularly.|en|1|1|1|false",
 "calculate-costs-fees-profit/s03-l1": "Seven short parts, from cost to keeping notes.|en|1|1|1|false",
 "calculate-costs-fees-profit/s04-l1": "Part one: lots of sales, but no money?|en|1|1|1|false",
 "calculate-costs-fees-profit/s05-l1": "Revenue is all the money buyers pay.|en|1|1|1|false",
 "calculate-costs-fees-profit/s05-l2": "Profit is what's left after the goods and every cost.|en|1|1|1|false",
 "calculate-costs-fees-profit/s05-l3": "They can be very far apart. Beginners often only look at the first.|en|1|1|1|false",
 "calculate-costs-fees-profit/s06-l1": "Three usual reasons. The cost is counted short.|en|1|1|1|false",
 "calculate-costs-fees-profit/s06-l2": "Fees on each order are forgotten. Or discounts go too far.|en|1|1|1|false",
 "calculate-costs-fees-profit/s06-l3": "Good news: a sheet of paper and a few sums fix all three.|en|1|1|1|false",
 "calculate-costs-fees-profit/s07-l1": "The cosmetics shop next door has a sale and free shipping. I'll do the same, now!|en|1|1|1|false",
 "calculate-costs-fees-profit/s07-l2": "Wait a second!|en|1|1|1|false",
 "calculate-costs-fees-profit/s07-l3": "Every shop has different costs. Their sale may not suit you. Test one order first.|en|1|1|1|false",
 "calculate-costs-fees-profit/s07-l4": "Let's rewind and try again.|en|1|1|1|false",
 "calculate-costs-fees-profit/s07-l5": "One lipstick: sale price, minus the goods, shipping I pay, and platform fees…|en|1|1|1|false",
 "calculate-costs-fees-profit/s07-l6": "If almost nothing is left, more orders just mean more work.|en|1|1|1|false",
 "calculate-costs-fees-profit/s07-l7": "Selling fast doesn't always mean profit.|en|1|1|1|false",
 "calculate-costs-fees-profit/s08-l1": "Part two: what's in your cost?|en|1|1|1|false",
 "calculate-costs-fees-profit/s09-l1": "Cost isn't just the buying price. It's everything spent to get one item ready to send.|en|1|1|1|false",
 "calculate-costs-fees-profit/s09-l2": "The buying price, and shipping for your stock, divided by the number of items.|en|1|1|1|false",
 "calculate-costs-fees-profit/s09-l3": "Boxes, bags, tape, labels, thank-you cards.|en|1|1|1|false",
 "calculate-costs-fees-profit/s09-l4": "And the share of items in each batch that are faulty or can't be sold.|en|1|1|1|false",
 "calculate-costs-fees-profit/s10-l1": "A few items in a batch are faulty? You still paid for them.|en|1|1|1|false",
 "calculate-costs-fees-profit/s10-l2": "Spread that money over the good ones. Skip it, and you think you profit, but you break even.|en|1|1|1|false",
 "calculate-costs-fees-profit/s11-l1": "Work out your cost once, and use it forever. True or false?|en|1|1|1|false",
 "calculate-costs-fees-profit/s11-l2": "False. Write it down, and recalculate whenever the buying price or stock shipping changes.|en|1|1|1|false",
 "calculate-costs-fees-profit/s12-l1": "Part three: what fees does each order cost you?|en|1|1|1|false",
 "calculate-costs-fees-profit/s13-l1": "On a platform, each order loses some fees: fixed, payment, service, or campaign fees.|en|1|1|1|false",
 "calculate-costs-fees-profit/s13-l2": "Each platform has its own fee list, and it can change. Read the seller fee page, and check the payout of your first few orders.|en|1|1|1|false",
 "calculate-costs-fees-profit/s13b-l3": "Then add: shipping you cover, shop vouchers you pay for,|en|1|1|1|false",
 "calculate-costs-fees-profit/s13b-l4": "ad money per order, and two-way shipping on returns.|en|1|1|1|false",
 "calculate-costs-fees-profit/s14-l1": "Selling on social media costs nothing. True or false?|en|1|1|1|false",
 "calculate-costs-fees-profit/s14-l2": "False. No platform fee, but usually shipping, ads, and more returns.|en|1|1|1|false",
 "calculate-costs-fees-profit/s15-l1": "Try one order before you post it. A motorbike accessory.|en|1|1|1|false",
 "calculate-costs-fees-profit/s15-l2": "Step one: the cost, with buying, stock shipping and packaging. Say sixty thousand dong.|en|1|1|1|false",
 "calculate-costs-fees-profit/s15-l3": "Step two: open the seller fee page. At ninety thousand, fees are, say, about twelve thousand.|en|1|1|1|false",
 "calculate-costs-fees-profit/s15-l4": "Step three: minus the shipping you support, say eight thousand.|en|1|1|1|false",
 "calculate-costs-fees-profit/s15-l5": "Step four: ten thousand left. Too thin for the work? Change the price, or the product, from the start.|en|1|1|1|false",
 "calculate-costs-fees-profit/s16-l1": "Your selling price must carry every fee.|en|1|1|1|false",
 "calculate-costs-fees-profit/s17-l1": "Part four: the real profit of one order.|en|1|1|1|false",
 "calculate-costs-fees-profit/s18-l1": "Profit per order equals what the buyer pays, minus the cost,|en|1|1|1|false",
 "calculate-costs-fees-profit/s18-l2": "minus platform fees, the shipping you cover,|en|1|1|1|false",
 "calculate-costs-fees-profit/s18-l3": "the discount the shop pays, and that order's share of ads.|en|1|1|1|false",
 "calculate-costs-fees-profit/s18-l4": "Do this for each of your main products.|en|1|1|1|false",
 "calculate-costs-fees-profit/s19-l1": "Split ad money by order: the week's ad spending, divided by the orders the ads brought.|en|1|1|1|false",
 "calculate-costs-fees-profit/s19-l2": "Dũng sells night lamps. Ads bring many more messages, so he keeps raising the budget for weeks.|en|1|1|1|false",
 "calculate-costs-fees-profit/s19-l3": "Month end, he does that division. Each order costs more in ads than it earns.|en|1|1|1|false",
 "calculate-costs-fees-profit/s20-l1": "How should you count advertising cost when checking profit?|en|1|1|1|false",
 "calculate-costs-fees-profit/s20-l2": "Divide the weekly ad spending by the number of orders the ads brought in.|en|1|1|1|false",
 "calculate-costs-fees-profit/s20-l3": "If that's more than the profit per order, ads are making you lose money.|en|1|1|1|false",
 "calculate-costs-fees-profit/s21-l1": "Ads bring orders, so orders must pay for the ads.|en|1|1|1|false",
 "calculate-costs-fees-profit/s21-l2": "And profit on paper isn't cash in your pocket.|en|1|1|1|false",
 "calculate-costs-fees-profit/s21-l3": "Platform money arrives later. Stock is money sitting on a shelf. Watch your real cash, too.|en|1|1|1|false",
 "calculate-costs-fees-profit/s22-l1": "Part five: costs people forget.|en|1|1|1|false",
 "calculate-costs-fees-profit/s23-l1": "Internet, electricity, and phone used for selling. Storage rent, if any.|en|1|1|1|false",
 "calculate-costs-fees-profit/s23-l2": "Photo tools: lights and backgrounds. And your own time and effort.|en|1|1|1|false",
 "calculate-costs-fees-profit/s23-l3": "If your evening hours earn less than a normal part-time job, rethink the product, price, or method.|en|1|1|1|false",
 "calculate-costs-fees-profit/s24-l1": "Selling income may need to be declared and taxed, depending on current rules and your size.|en|1|1|1|false",
 "calculate-costs-fees-profit/s24-l2": "From twenty twenty-six, sellers declare it themselves, instead of a fixed tax.|en|1|1|1|false",
 "calculate-costs-fees-profit/s24-l3": "Up to five hundred million dong a year: no VAT and no personal income tax.|en|1|1|1|false",
 "calculate-costs-fees-profit/s24-l4": "Platforms with ordering and payment deduct tax on each sale. Find that line in your payout details.|en|1|1|1|false",
 "calculate-costs-fees-profit/s24-l5": "Under five hundred million? Ask your local tax office about it. And count tax as a cost from the start.|en|1|1|1|false",
 "calculate-costs-fees-profit/s25-l1": "Part six: setting prices and sales without losing money.|en|1|1|1|false",
 "calculate-costs-fees-profit/s26-l1": "Build the price from the bottom: cost, plus fees per order, plus the profit you want.|en|1|1|1|false",
 "calculate-costs-fees-profit/s26-l2": "That's your lowest price. Then look at the market to decide how much higher to go.|en|1|1|1|false",
 "calculate-costs-fees-profit/s26-l3": "Your lowest price is already above the market? Don't just cut it.|en|1|1|1|false",
 "calculate-costs-fees-profit/s26-l4": "Find a better supplier, sell bundles, or choose another product. Don't sell at a loss forever.|en|1|1|1|false",
 "calculate-costs-fees-profit/s27-l1": "Before any sale, redo the profit per order at that discount. Ask yourself:|en|1|1|1|false",
 "calculate-costs-fees-profit/s27-l2": "After this discount, how much profit is left per order, and how many more orders do I need to make up for it?|en|1|1|1|false",
 "calculate-costs-fees-profit/s28-l1": "Deep discounts for everyone: easy orders, but thin profit.|en|1|1|1|false",
 "calculate-costs-fees-profit/s28-l2": "Small rewards for returning buyers, or a small gift: cheaper, and you keep buyers.|en|1|1|1|false",
 "calculate-costs-fees-profit/s28-l3": "Any sale needs an end date and a clear goal.|en|1|1|1|false",
 "calculate-costs-fees-profit/s29-l1": "Part seven: simple, regular notes.|en|1|1|1|false",
 "calculate-costs-fees-profit/s30-l1": "A sheet or notebook with a few columns is enough.|en|1|1|1|false",
 "calculate-costs-fees-profit/s30-l2": "Date, item, what the buyer paid, cost, fees, shipping, discount, profit.|en|1|1|1|false",
 "calculate-costs-fees-profit/s30-l3": "Fifteen minutes at the end of each week. Don't let a month pile up.|en|1|1|1|false",
 "calculate-costs-fees-profit/s31-l1": "Thảo sells handmade goods. Shop money and her salary go into one account.|en|1|1|1|false",
 "calculate-costs-fees-profit/s31-l2": "Look at that balance! I must be making a profit. Let's spend a bit.|en|1|1|1|false",
 "calculate-costs-fees-profit/s31-l3": "Wait a second!|en|1|1|1|false",
 "calculate-costs-fees-profit/s31-l4": "In the busy season, there isn't enough left for one batch of materials.|en|1|1|1|false",
 "calculate-costs-fees-profit/s31-l5": "Let's rewind and try again.|en|1|1|1|false",
 "calculate-costs-fees-profit/s31-l6": "I'll open a separate shop account. When I take shop money out, I'll note it.|en|1|1|1|false",
 "calculate-costs-fees-profit/s31-l7": "Shop money in one pocket, family money in another.|en|1|1|1|false",
 "calculate-costs-fees-profit/s32-l1": "Each month, look at your sheet.|en|1|1|1|false",
 "calculate-costs-fees-profit/s32-l2": "Which items earn well? Put your energy there.|en|1|1|1|false",
 "calculate-costs-fees-profit/s32-l3": "Which sell fast, but earn little? Fix the price.|en|1|1|1|false",
 "calculate-costs-fees-profit/s32-l4": "Which lose money? Fix them, or stop.|en|1|1|1|false",
 "calculate-costs-fees-profit/s32-l5": "Selling with a partner or family? Look together. Clear numbers make money talks calmer than guesses.|en|1|1|1|false",
 "calculate-costs-fees-profit/s33-l1": "Back to Lan. Now she knows where the money goes.|en|1|1|1|false",
 "calculate-costs-fees-profit/s33-l2": "Tonight: take your best seller, and work out the real profit of one order.|en|1|1|1|false",
 "calculate-costs-fees-profit/s34-l1": "Your turn. Forty questions are waiting below.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s01-l1": "Dũng never tested the link. Just click and go, he thought.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s01-l2": "Nine a.m. The software wants an update. The bar runs on and on.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s01-l3": "I'm so sorry I'm late...|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s01-l4": "Nearly fifteen minutes late, he never finds his rhythm.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s02-l1": "What should you do the day before an interview? Organise, don't cram.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s02-l2": "Confirm the appointment.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s02-l3": "Prepare papers and clothes.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s02-l4": "Test the route or the device.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s02-l5": "Light review, then early sleep.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s03-l1": "Six parts: the appointment, your bag, your clothes,|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s03-l2": "route or device, light review, and the evening.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s04-l1": "Part one, the morning: is the appointment sure?|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s05-l1": "Reread the invitation. Note the time, address, building, floor, room, and who you'll meet.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s05-l2": "Save the contact's number, in case something goes wrong on the way.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s05-l3": "And reply to confirm, if you haven't.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s06-l1": "I confirm I'll be at your office on the fifth floor at nine tomorrow morning.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s06-l2": "Should I bring my original certificates? Is there a test? How long will it take?|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s06-l3": "Asking the day before is polite. On the morning itself, they may be too busy to reply.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s07-l1": "The email says: room 802, eighth floor, building B. Copy the whole line, not just the street.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s07-l2": "Open the map. Which gate is nearest to building B?|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s07-l3": "Save the contact with a clear name, so you can call if you get lost.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s07-l4": "Next morning, go straight up to the eighth floor.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s08-l1": "Copy it down to the floor and room. Save the contact's number.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s09-l1": "Part two: papers and things to bring.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s10-l1": "Pack everything in one bag, by the front door.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s10-l2": "Two or three printed CVs. For a panel, one per interviewer plus one extra.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s10-l3": "Keep them in a folder, so they stay flat.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s10-l4": "Certificate copies, originals if asked, and ID for parking or the building.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s10-l5": "A notebook with questions, a charged phone, tissues, water, an umbrella.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s11-l1": "Reread the phone and email on your CV. The company uses them to give results.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s11-l2": "Before: one extra digit, and gmail spelt wrong. You miss it when skimming.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s11-l3": "After: each digit read aloud, checked with the phone, and a test email sent.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s12-l1": "Read each number aloud. Send one test email.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s13-l1": "Part three, the afternoon: are your clothes ready?|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s14-l1": "Try the whole outfit on. A missing button? You still have time to sew it.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s14-l2": "Iron it and hang it up. Don't iron in the morning.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s14-l3": "Clean your shoes, and get clean socks.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s14-l4": "By motorbike? Put a jacket or raincoat under the seat.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s15-l1": "Part four: have you tested the route, or the device?|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s16-l1": "In person: check the map for the exact time you'll travel. Rush hour is slower.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s16-l2": "Find parking nearby. Many lots are full early.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s16-l3": "Taking a ride app? Add waiting time.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s17-l1": "Aim to arrive ten to fifteen minutes early. Not much more.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s17-l2": "Too early, and you just wait and get more nervous.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s18-l1": "Online: open the link, install and update the software, and log in early.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s18-l2": "Test the camera, microphone, speakers and internet.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s18-l3": "Have a backup, like your phone's mobile data.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s18-l4": "A quiet place, light from the front, a tidy background. Tell your family.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s19-l1": "Back to Dũng, the night before.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s19-l2": "The link? I'll just click it tomorrow at nine.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s19-l3": "Wait a second!|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s19-l4": "At nine, the software asked for an update. He was almost fifteen minutes late.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s19-l5": "Let's rewind and try again.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s19-l6": "Let me open the link tonight, update the app, and test my camera.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s19-l7": "Test the link in the evening. In the morning, just click.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s20-l1": "Part five: how much review is enough?|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s21-l1": "Review, don't learn new things. One or two hours.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s21-l2": "Reread the job description and your company notes.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s21-l3": "Say your self-introduction aloud: one to two minutes.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s21-l4": "Go over three or four main stories. Just the ideas.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s22-l1": "Let me interview you. What salary do you expect, and when can you start?|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s22-l2": "Good questions. I'll answer out loud, in English too.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s22-l3": "Have answers ready on salary and start date. Practise English aloud, not silently.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s22-l4": "A friend asking helps: you get used to answering while someone watches.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s23-l1": "Last part, the evening: rest the right way.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s24-l1": "Stop reviewing about an hour before bed.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s24-l2": "A light, familiar dinner.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s24-l3": "Little coffee or alcohol in the evening.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s24-l4": "Two alarms, ten minutes apart, in case you switch one off asleep.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s24-l5": "And a simple breakfast, ready.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s25-l1": "What if they ask something I don't know?|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s25-l2": "I'll study until two a.m. and read every article about them. One alarm is fine.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s25-l3": "Wait a second!|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s25-l4": "She may wake late, skip breakfast, and freeze at: tell me about yourself.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s25-l5": "Late reading adds worry, not memory. A clear head answers better.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s25-l6": "Let's rewind and try again.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s25-l7": "I'll stop an hour before bed, set two alarms, and eat a light breakfast.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s25-l8": "Almost the same knowledge, a much clearer head. One more hour of sleep beats one more hour of study.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s26-l1": "Still nervous? Write three strengths you want them to remember.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s26-l2": "Focus on what you can do, not on what could go wrong.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s27-l1": "Copy the address fully. Check every digit. Test the link at night.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s27-l2": "And sleep early. Tomorrow, you just go and answer.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s28-l1": "Which short rule fits an online interview starting at nine in the morning?|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s28-l2": "Test the link in the evening, so in the morning you only click.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s28-l3": "The evening gives you time for updates.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s29-l1": "How early should you aim to arrive for an in person interview?|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s29-l2": "About ten to fifteen minutes early, not much earlier than that.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s29-l3": "Enough to calm down. Too early only adds nerves.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s30-l1": "Copy these lists onto paper and tick them today.|en|1|1|1|false",
 "checklist-for-the-day-before-an-interview/s30-l2": "Then, forty questions are waiting below.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s01-l1": "Ten p.m.: the job ad said the closing shift ends.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s01-l2": "Nearly midnight: cleaning and stock checks are finally done.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s01-l3": "The street is so empty. And I have an early class tomorrow.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s01-l4": "Lan forgot to ask one question.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s02-l1": "How do you choose a job that fits your classes? Draw your week first.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s02-l2": "Pick a job type that fits the gaps.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s02-l3": "Count the travel time.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s02-l4": "Ask about exam season.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s02-l5": "Then try it for a few weeks, and adjust.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s03-l1": "Five stops: your free time, job types, distance,|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s03-l2": "interview questions, and checking after you start.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s04-l1": "Part one: how much of your week is really free?|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s05-l1": "Take your timetable. First, fill the fixed boxes: classes, travel, meals, sleep.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s05-l2": "Then add self-study blocks, like a second timetable.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s05-l3": "Keep one session free.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s05-l4": "Only what is left is for work.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s06-l1": "Every free evening should be filled with a shift. True or false?|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s06-l2": "False. Keep at least one session with no study and no work.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s06-l3": "For laundry, shopping, and rest. Every week brings surprises.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s07-l1": "A student nearly took four evening shifts. First, she wrote in her classes.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s07-l2": "Then self-study and group meetings. Most were in the evening.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s07-l3": "She looked again: only two evenings were really free.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s07-l4": "She took two shifts, and never missed a group meeting all term.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s08-l1": "Write self-study in first. Shifts go in after.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s09-l1": "Part two: which job type fits your timetable?|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s10-l1": "Fixed shifts: the same hours every week. Easy if your timetable stays the same all term.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s10-l2": "The weak point: a new term, a new timetable, and the old shift may not fit.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s10-l3": "Weekly sign-up: you choose shifts each week. Good for a changing timetable.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s10-l4": "But income goes up and down, and some weeks you miss the shift you want.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s11-l1": "Tutoring: short lessons, evenings or weekends. Add travel and planning time.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s11-l2": "Weekend events: paid by the day, but irregular. Not for fixed living money.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s11-l3": "Online work: your own hours, but it runs late. And check for scams.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s12-l1": "Think about this. Three fixed afternoon shifts at a convenience store. Term one goes well.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s12-l2": "In term two, your main classes move onto those afternoons.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s12-l3": "The store has no other shifts. What should you have asked?|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s13-l1": "If my timetable changes next semester, can I move my shifts?|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s13-l2": "The answer tells you if the job can bend with your classes.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s13-l3": "If not, you know early, instead of quitting in a hurry.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s14-l1": "Timetables change each term. Your job must be able to change too.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s15-l1": "Part three: does distance matter?|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s16-l1": "Count the travel time as work time. A four-hour shift,|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s16-l2": "plus an hour on the road, is really five hours of your day.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s16-l3": "A job between school and your room usually costs the least.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s17-l1": "A shift that ends late? Ask: is the road home lit?|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s17-l2": "Are buses still running?|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s17-l3": "Is there a coworker to go home with?|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s18-l1": "The closing shift ends at ten p.m.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s18-l2": "Ten o'clock? Perfect. I'll take it!|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s18-l3": "Wait a second!|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s18-l4": "After two weeks, Lan fears the dark road and falls asleep in class.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s18-l5": "Let's rewind and try again.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s18-l6": "What time does the evening shift really end? Do we often stay late to clean?|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s18-l7": "That's the one question! Finishing time on paper is not real life.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s19-l1": "Part four: what to ask at the interview.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s20-l1": "How many shifts a week do I need to work at minimum?|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s20-l2": "Do I sign up each week, or are shifts fixed all term?|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s20-l3": "If I tell you early, can I work fewer shifts in exam weeks?|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s20-l4": "Here is my timetable, with my exam months.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s20-l5": "Tell your real timetable from the start. Then the manager can plan shifts early.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s21-l1": "At his interview, Dũng said nothing about exams. He was afraid he wouldn't be hired.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s21-l2": "My finals start in two days. Can I skip all three shifts?|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s21-l3": "We're short of staff. I can't agree to that.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s21-l4": "Dũng worked and revised at the same time, tired. His results were much lower.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s22-l1": "Hiding your exam weeks until shifts clash is safer. True or false?|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s22-l2": "False. Telling late makes you look like someone who always asks for days off.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s22-l3": "Share exam dates early, and you never ask at the last minute.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s23-l1": "More shifts than your free hours? Even with good pay, not for now.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s23-l2": "Take it and try to cope,|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s23-l3": "and you often drop your studies, or quit halfway.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s24-l1": "Last part: after you start, did you choose right?|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s25-l1": "Treat the first weeks as your own trial. Each weekend, check.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s25-l2": "Enough sleep?|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s25-l3": "No missed classes?|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s25-l4": "Homework on time?|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s25-l5": "Still one evening off? A box missing two weeks running: cut shifts, or change jobs.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s26-l1": "New term? Put the new timetable next to your old shifts. Do they still fit?|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s26-l2": "Tell your manager as soon as you have it. Don't wait for the first week of class.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s26-l3": "First job? Start with fewer shifts than you think you can do.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s26-l4": "Adding shifts is easy. Dropping shifts you promised is much harder.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s27-l1": "The best job is not the highest paid. It fits your week, and changes with your term.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s27-l2": "Self-study first. Ask the real finishing time.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s27-l3": "And share your exam dates early.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s28-l1": "What question at hiring helps you avoid losing a fixed shift job next semester?|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s28-l2": "If my timetable changes next semester, can I move my shifts to other days?|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s28-l3": "The answer tells you if the job can bend with your timetable.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s29-l1": "Do it now: colour your fixed boxes and study blocks, then count the gaps left.|en|1|1|1|false",
 "choose-part-time-job-fits-schedule/s29-l2": "Then, forty questions are waiting below.|en|1|1|1|false",
 "choose-products-and-suppliers/s01-l1": "Wrong colours… and some are past their date!|en|1|1|1|false",
 "choose-products-and-suppliers/s01-l2": "I asked to swap them, and the seller blocked me.|en|1|1|1|false",
 "choose-products-and-suppliers/s01-l3": "Lan's first lipstick order went wrong. How did it happen? Let's rewind.|en|1|1|1|false",
 "choose-products-and-suppliers/s02-l1": "What should you sell, and which supplier can you trust?|en|1|1|1|false",
 "choose-products-and-suppliers/s02-l2": "Start with something you know.|en|1|1|1|false",
 "choose-products-and-suppliers/s02-l3": "Test whether real people want to buy it.|en|1|1|1|false",
 "choose-products-and-suppliers/s02-l4": "Order samples before a wholesale order.|en|1|1|1|false",
 "choose-products-and-suppliers/s02-l5": "Check every batch, and pay in a way that leaves a record.|en|1|1|1|false",
 "choose-products-and-suppliers/s03-l1": "Six stops, from 'not sure' to 'buying more stock'.|en|1|1|1|false",
 "choose-products-and-suppliers/s04-l1": "Part one: what to sell with no experience.|en|1|1|1|false",
 "choose-products-and-suppliers/s05-l1": "Write down five things you know best.|en|1|1|1|false",
 "choose-products-and-suppliers/s05-l2": "Things you use every day.|en|1|1|1|false",
 "choose-products-and-suppliers/s05-l3": "Things friends ask about: 'Where did you buy that?'|en|1|1|1|false",
 "choose-products-and-suppliers/s05-l4": "If you know it, you can advise. If you can advise, buyers trust you.|en|1|1|1|false",
 "choose-products-and-suppliers/s06-l1": "Pick a small, clear group, not 'everyone'.|en|1|1|1|false",
 "choose-products-and-suppliers/s06-l2": "'Healthy snacks for office workers' finds buyers more easily than 'snacks'.|en|1|1|1|false",
 "choose-products-and-suppliers/s06-l3": "Then you know where to post, how to shoot photos, and what to write.|en|1|1|1|false",
 "choose-products-and-suppliers/s07-l1": "Have real people asked to buy it?|en|1|1|1|false",
 "choose-products-and-suppliers/s07-l2": "Does it sell all year, or only in one season?|en|1|1|1|false",
 "choose-products-and-suppliers/s07-l3": "Does it expire? Goods with dates must sell in time.|en|1|1|1|false",
 "choose-products-and-suppliers/s07-l4": "Are there many suppliers, or only one?|en|1|1|1|false",
 "choose-products-and-suppliers/s08-l1": "Food, cosmetics, medicine, baby goods and electrical goods have stricter rules.|en|1|1|1|false",
 "choose-products-and-suppliers/s08-l2": "Rules on origin, labels and papers. Learn them from official sources before you buy.|en|1|1|1|false",
 "choose-products-and-suppliers/s09-l1": "Say you want to sell scented candles.|en|1|1|1|false",
 "choose-products-and-suppliers/s09-l2": "Step one: burn one to the end, and note how many hours.|en|1|1|1|false",
 "choose-products-and-suppliers/s09-l3": "Step two: is the smoke black? Is the smell strong? After an hour, is the room stuffy?|en|1|1|1|false",
 "choose-products-and-suppliers/s09-l4": "Step three: write ready answers. 'It burns this long, light smell, no black smoke.'|en|1|1|1|false",
 "choose-products-and-suppliers/s09-l5": "You answer at once, from your own use. No waiting for the supplier.|en|1|1|1|false",
 "choose-products-and-suppliers/s10-l1": "Try it yourself first. Then buyers trust you.|en|1|1|1|false",
 "choose-products-and-suppliers/s11-l1": "Part two: are there real buyers?|en|1|1|1|false",
 "choose-products-and-suppliers/s12-l1": "Order a few samples, post them, and write 'limited stock'.|en|1|1|1|false",
 "choose-products-and-suppliers/s12-l2": "'How do I order? How much is shipping? Which sizes are left?' Those are real buying signals.|en|1|1|1|false",
 "choose-products-and-suppliers/s12-l3": "Likes are not, yet.|en|1|1|1|false",
 "choose-products-and-suppliers/s13-l1": "Ask your target buyers directly.|en|1|1|1|false",
 "choose-products-and-suppliers/s13-l2": "If it cost about this much, would you buy it, and why?|en|1|1|1|false",
 "choose-products-and-suppliers/s13-l3": "Their answers show what they need, so your descriptions hit the mark.|en|1|1|1|false",
 "choose-products-and-suppliers/s14-l1": "Seasonal goods, like warm jackets, Tết goods or beach items, sell fast in season.|en|1|1|1|false",
 "choose-products-and-suppliers/s14-l2": "Then they almost stop.|en|1|1|1|false",
 "choose-products-and-suppliers/s14-l3": "Plan how long you have to sell out, and what to do if sales are slow.|en|1|1|1|false",
 "choose-products-and-suppliers/s15-n1": "A phone case gets lots of likes, and comments: 'So cute!'|en|1|1|1|false",
 "choose-products-and-suppliers/s15-a1": "So many likes! I'll order a hundred right now!|en|1|1|1|false",
 "choose-products-and-suppliers/s15-n2": "A month later, only a handful ordered. The rest sit in a box.|en|1|1|1|false",
 "choose-products-and-suppliers/s15-b1": "I'll order a few, write 'limited stock', and count who orders and pays.|en|1|1|1|false",
 "choose-products-and-suppliers/s15-n3": "Twenty orders? Buy about twenty more. A few days slower, almost no leftovers.|en|1|1|1|false",
 "choose-products-and-suppliers/s16-l1": "Likes are compliments. Questions about ordering are orders. Count orders, not hearts.|en|1|1|1|false",
 "choose-products-and-suppliers/s17-l1": "Part three: finding a supplier you can trust.|en|1|1|1|false",
 "choose-products-and-suppliers/s18-l1": "Common sources: wholesale markets, small workshops, official distributors, and handmade makers.|en|1|1|1|false",
 "choose-products-and-suppliers/s18-l2": "At a market, you see and touch the goods.|en|1|1|1|false",
 "choose-products-and-suppliers/s18-l3": "Workshops often give good prices for big orders. Distributors have clear papers.|en|1|1|1|false",
 "choose-products-and-suppliers/s19-l1": "Online sources are easy, but hard to check.|en|1|1|1|false",
 "choose-products-and-suppliers/s19-l2": "Ask for the warehouse or shop address.|en|1|1|1|false",
 "choose-products-and-suppliers/s19-l3": "Make a video call to see the real goods.|en|1|1|1|false",
 "choose-products-and-suppliers/s19-l4": "Ask people who bought from them. A nice profile is easy to fake.|en|1|1|1|false",
 "choose-products-and-suppliers/s20-l1": "Four questions for a new supplier.|en|1|1|1|false",
 "choose-products-and-suppliers/s20-l2": "What is the minimum order?|en|1|1|1|false",
 "choose-products-and-suppliers/s20-l3": "How do you exchange faulty goods?|en|1|1|1|false",
 "choose-products-and-suppliers/s20-l4": "Do you have invoices, or papers showing origin?|en|1|1|1|false",
 "choose-products-and-suppliers/s20-l5": "For a wholesale order, how long until delivery?|en|1|1|1|false",
 "choose-products-and-suppliers/s21-l1": "A good supplier has an address and a phone number that work,|en|1|1|1|false",
 "choose-products-and-suppliers/s21-l2": "a clear answer about faulty goods, import papers,|en|1|1|1|false",
 "choose-products-and-suppliers/s21-l3": "and lets you order samples first.|en|1|1|1|false",
 "choose-products-and-suppliers/s22-l1": "A price far below everyone else is a deal to grab now. True or false?|en|1|1|1|false",
 "choose-products-and-suppliers/s22-l2": "False. There's usually a reason: faulty, old stock, fakes, or a fake supplier.|en|1|1|1|false",
 "choose-products-and-suppliers/s22-l3": "Copies of famous brands can bring legal trouble, and your shop may be locked.|en|1|1|1|false",
 "choose-products-and-suppliers/s23-l1": "Back to Lan. Cheap lipsticks in an online group, lots of nice photos.|en|1|1|1|false",
 "choose-products-and-suppliers/s23-l2": "The seller pushes: 'This price is only for today!'|en|1|1|1|false",
 "choose-products-and-suppliers/s23-l3": "Only today? Okay, I'll send the full amount now!|en|1|1|1|false",
 "choose-products-and-suppliers/s23-l4": "Wait a second!|en|1|1|1|false",
 "choose-products-and-suppliers/s23-l5": "A stranger, a very low price, and 'only today'. Slow down.|en|1|1|1|false",
 "choose-products-and-suppliers/s23-l6": "Let's rewind and try again.|en|1|1|1|false",
 "choose-products-and-suppliers/s23-l7": "Where is your shop? Can I order a few samples first?|en|1|1|1|false",
 "choose-products-and-suppliers/s23-l8": "If the samples are good, I'll order wholesale next time.|en|1|1|1|false",
 "choose-products-and-suppliers/s24-l1": "Samples the first time. Wholesale only next time. Samples are the cheapest lesson.|en|1|1|1|false",
 "choose-products-and-suppliers/s25-l1": "Part four: the samples arrive. What do you check?|en|1|1|1|false",
 "choose-products-and-suppliers/s26-l1": "Test it like a picky buyer: wear it, wash it, use it for days.|en|1|1|1|false",
 "choose-products-and-suppliers/s26-l2": "Some problems only show after days of use.|en|1|1|1|false",
 "choose-products-and-suppliers/s26-l3": "Note the good and bad points. That's your honest description later.|en|1|1|1|false",
 "choose-products-and-suppliers/s27-l1": "Right colour, size and material, as the supplier said.|en|1|1|1|false",
 "choose-products-and-suppliers/s27-l2": "Labels, expiry dates and instructions are there.|en|1|1|1|false",
 "choose-products-and-suppliers/s27-l3": "Strong seams and glue, no strange smell.|en|1|1|1|false",
 "choose-products-and-suppliers/s27-l4": "And packaging that survives delivery.|en|1|1|1|false",
 "choose-products-and-suppliers/s28-l1": "Dũng's first batch of T-shirts was thick. Buyers loved it.|en|1|1|1|false",
 "choose-products-and-suppliers/s28-l2": "The second batch is here, and I'm so busy this week.|en|1|1|1|false",
 "choose-products-and-suppliers/s28-l3": "Same workshop, same shirts. I'll ship them straight away!|en|1|1|1|false",
 "choose-products-and-suppliers/s28-l4": "Wait a second!|en|1|1|1|false",
 "choose-products-and-suppliers/s28-l5": "A good sample doesn't mean the next batch is good. These are thinner.|en|1|1|1|false",
 "choose-products-and-suppliers/s28-l6": "Let's rewind and try again.|en|1|1|1|false",
 "choose-products-and-suppliers/s28-l7": "Let me open the box and check a few random shirts first.|en|1|1|1|false",
 "choose-products-and-suppliers/s29-l1": "Every batch that arrives is a batch you check. Don't let buyers check for you.|en|1|1|1|false",
 "choose-products-and-suppliers/s30-l1": "Part five: paying suppliers with a record.|en|1|1|1|false",
 "choose-products-and-suppliers/s31-l1": "Pay by bank transfer, to an account in the seller's or shop's name, with a clear note.|en|1|1|1|false",
 "choose-products-and-suppliers/s31-l2": "Save the messages about price, quantity and faulty goods.|en|1|1|1|false",
 "choose-products-and-suppliers/s31-l3": "Cash with no paper? If goods are missing, you have no proof.|en|1|1|1|false",
 "choose-products-and-suppliers/s31-l4": "Get an invoice or delivery note every time.|en|1|1|1|false",
 "choose-products-and-suppliers/s31-l5": "It answers buyers about origin, checks missing goods, and keeps your records.|en|1|1|1|false",
 "choose-products-and-suppliers/s32-l1": "Part six: it's selling. How do you buy more, safely?|en|1|1|1|false",
 "choose-products-and-suppliers/s33-l1": "When something sells steadily, increase your order step by step.|en|1|1|1|false",
 "choose-products-and-suppliers/s33-l2": "Each time, check if sales keep up.|en|1|1|1|false",
 "choose-products-and-suppliers/s33-l3": "Then increase again. Don't jump. Demand can slow down suddenly.|en|1|1|1|false",
 "choose-products-and-suppliers/s34-l1": "Keep at least one backup supplier for your best seller.|en|1|1|1|false",
 "choose-products-and-suppliers/s34-l2": "If the main one runs out, raises prices or stops, you won't say 'sold out' for long.|en|1|1|1|false",
 "choose-products-and-suppliers/s35-l1": "Selling after work? Choose a source that delivers, or is near your work.|en|1|1|1|false",
 "choose-products-and-suppliers/s35-l2": "A bit cheaper, but two hours of pickup every night? Usually not worth it.|en|1|1|1|false",
 "choose-products-and-suppliers/s36-l1": "This time, Lan orders samples first. No guessing needed.|en|1|1|1|false",
 "choose-products-and-suppliers/s36-l2": "Know your product, let real buyers answer, test with little money, and check every batch.|en|1|1|1|false",
 "choose-products-and-suppliers/s37-l1": "The first sample was great, what should you do when the next batch arrives?|en|1|1|1|false",
 "choose-products-and-suppliers/s37-l2": "Open and check a few random items before you post them for sale.|en|1|1|1|false",
 "choose-products-and-suppliers/s37-l3": "A good sample does not promise a good next batch. Check early, before buyers do.|en|1|1|1|false",
 "choose-products-and-suppliers/s38-l1": "List five things you know well. Then try the forty questions below!|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s01-l1": "Dũng once had his work taken by a colleague.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s01-l2": "Months later, someone claims his report again.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s01-l3": "I remember Dũng did the data part.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s01-l4": "Dũng said nothing. What had he done?|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s02-l1": "A colleague takes credit for your work. What do you do?|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s02-l2": "In the meeting, add one detail.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s02-l3": "After it, talk in private about the facts.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s02-l4": "In the long run, put your work in writing.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s03-l1": "Six parts. First, on purpose or by accident?|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s03-l2": "Then the meeting, the private talk, and your habits.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s03-l3": "Last, the manager, and when the boss takes the credit.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s04-l1": "Part one: did they mean it?|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s05-l1": "Before you decide, think of three possibilities.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s05-l2": "One: an accident. They said “I” instead of “we”, or forgot your name because they were nervous.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s05-l3": "Two: a different view of roles. They edited the final version, so they think they did more.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s05-l4": "Three: on purpose. They know it was your work, and it happens again.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s06-l1": "Knowing the type helps you choose how strongly to react.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s06-l2": "For the first two types, a light talk is usually enough.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s06-l3": "For the third type, be clearer, and keep records.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s07-l1": "Part two: what to say in the meeting.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s08-l1": "Add a detail naturally, with your expert knowledge.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s08-l2": "When I wrote this part last week, I also added shipping costs. May I explain a little?|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s08-l3": "You show your role without blaming anyone.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s09-l1": "Don't accuse them right there in the meeting.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s09-l2": "Even if you're right, people remember the harsh tone more than the facts.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s09-l3": "And the colleague will almost surely defend themselves in front of everyone.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s10-l1": "A colleague presents the customer analysis Thảo worked on for two weeks.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s10-l2": "I made this! Why do you say it's yours?|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s10-l3": "Wait a second!|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s10-l4": "Now it's about temper. People will only remember you were angry.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s10-l5": "Let's rewind and try again.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s10-l6": "Let me add one thing. For the central region, I removed returned orders.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s10-l7": "So the real number is a bit lower than the first version.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s10-l8": "Only the real author knows that detail. Credit can wait for the private talk.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s11-l1": "Add with details. Don't accuse with a loud voice.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s12-l1": "Part three: the private talk.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s13-l1": "First, let your feelings settle. A few hours or one evening is fine.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s13-l2": "Don't message while you're angry. That message is often harsher than you want.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s13-l3": "Then open with facts and a question, listen, and agree on next time.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s14-l1": "In this morning's meeting, the plan was presented as yours.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s14-l2": "But I wrote the first draft. How do you see that?|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s14-l3": "Then she listens. Maybe they apologise. Maybe it was a misunderstanding.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s14-l4": "Next time, let's write who does which part on the first page.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s14-l5": "The goal is not to make them admit fault. It's to stop it happening again.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s15-l1": "You write a plan to improve the warehouse. Your team leader presents it and gets praised, without your name.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s15-l2": "Option A: stay silent, keep your ideas to yourself, and complain to colleagues.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s15-l3": "The director never sees your ability. You lose motivation, and the story turns into gossip.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s15b-l1": "Option B: meet the leader in private. Say you're glad it was used, and ask to be named as the writer.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s15b-l2": "The leader can fix it without losing face. You keep the credit and the relationship.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s16-l1": "Silence won't protect your credit. Gossip hurts your own reputation.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s17-l1": "Part four: make your work easy to see.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s18-l1": "Send a short update after each stage: what's done, who did which part, what's next.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s18-l2": "Put the names of who is responsible on the first page.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s18-l3": "Ask to present your own part.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s18-l4": "And credit others generously, so the team learns to do the same for you.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s19-l1": "Your credit was taken once, so stop sharing ideas. True or false?|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s19-l2": "False. Hiding ideas makes you closed and hard to work with. That hurts your career more.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s20-l1": "Every Friday, Dũng emailed the team and the manager three short lines.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s20-l2": "Done this week, who did which part, and next week's plan.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s20-l3": "So when someone claimed his report, the manager already knew.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s20-l4": "I remember Dũng did the data part.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s20-l5": "Your work, in writing.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s21-l1": "Part five: when should you tell your manager?|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s22-l1": "You talked to the colleague directly, but it keeps happening. Now tell your manager.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s22-l2": "I'd like to share something about how contributions are credited in the project.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s22-l3": "Here are the emails and drafts I sent.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s22-l4": "Use facts and documents, not feelings. Ask for clear roles next time, not punishment.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s23-l1": "Don't post it in the team group chat, and don't complain to lots of people.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s23-l2": "The story will reach them in its worst version, and they can only defend themselves.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s24-l1": "Part six: what if it's your own boss?|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s25-l1": "Still talk in private, gently.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s25-l2": "Focus on being credited, and on a chance to present.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s25-l3": "Don't demand that your boss admits being wrong.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s25-l4": "And keep your email updates, so your work leaves a trail.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s26-l1": "Thảo's boss used her slides to report to the directors, with no names.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s26-l2": "I'm glad the proposal was valued.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s26-l3": "I'd really like to be credited as the author. I put in a lot of work.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s26-l4": "Next time, may I present the detailed part with you?|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s26-l5": "The next month, her boss invited her to the meeting to present the numbers.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s27-l1": "Asking for a chance to stand beside them beats demanding the credit back.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s28-l1": "Add calmly in the meeting. Talk in private with facts. Let writing be your witness.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s28-l2": "This week, send a short update. Say clearly who did which part.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s29-l1": "What is the main goal of your private talk with the colleague?|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s29-l2": "Make sure it does not happen again, not force them to admit they were wrong.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s29-l3": "Asking them to admit fault starts a fight. A plan for next time protects your work.|en|1|1|1|false",
 "colleague-takes-credit-for-your-work/s30-l1": "Your turn. Forty questions are waiting below.|en|1|1|1|false",
 "comets-vs-meteors/s01-l1": "Look, Grandpa! A comet!|en|1|1|1|false",
 "comets-vs-meteors/s01-l2": "A streak of light, gone in a second. Was it really a comet?|en|1|1|1|false",
 "comets-vs-meteors/s02-l1": "So what did Bin see? Let's learn to tell them apart, in five parts.|en|1|1|1|false",
 "comets-vs-meteors/s02-l2": "The right names.|en|1|1|1|false",
 "comets-vs-meteors/s02-l3": "Comets and their tails.|en|1|1|1|false",
 "comets-vs-meteors/s02-l4": "Are shooting stars dangerous?|en|1|1|1|false",
 "comets-vs-meteors/s02-l5": "Watching a meteor shower.|en|1|1|1|false",
 "comets-vs-meteors/s02-l6": "And what to do with a strange stone.|en|1|1|1|false",
 "comets-vs-meteors/s03-l1": "Part one: the right names.|en|1|1|1|false",
 "comets-vs-meteors/s04-l1": "Did you see that streak of light?|en|1|1|1|false",
 "comets-vs-meteors/s04-l2": "Yes! It was a comet!|en|1|1|1|false",
 "comets-vs-meteors/s04-l3": "Wait a second!|en|1|1|1|false",
 "comets-vs-meteors/s04-l4": "It was gone in a second. That is a shooting star, a tiny rock burning up.|en|1|1|1|false",
 "comets-vs-meteors/s04-l5": "Let's rewind and try again.|en|1|1|1|false",
 "comets-vs-meteors/s04-l6": "It zipped past, so it was a shooting star!|en|1|1|1|false",
 "comets-vs-meteors/s04-l7": "Right. A comet is a fuzzy spot with a tail. It stays almost still for many nights, even weeks.|en|1|1|1|false",
 "comets-vs-meteors/s04-l9": "So when the news says a comet is visible, look for that fuzzy spot. Don't wait for a streak.|en|1|1|1|false",
 "comets-vs-meteors/s05-l1": "A comet is a ball of ice and dust. It circles the Sun on a very long path.|en|1|1|1|false",
 "comets-vs-meteors/s05-l2": "A small rock burns up in the air. The streak of light is a meteor, a shooting star.|en|1|1|1|false",
 "comets-vs-meteors/s05-l3": "If a piece survives and lands on the ground, it is a meteorite.|en|1|1|1|false",
 "comets-vs-meteors/s05-l4": "An asteroid is a larger rocky body. Most circle between Mars and Jupiter.|en|1|1|1|false",
 "comets-vs-meteors/s07-l2": "Remember: if it zips past, it is a meteor. If it stays with a tail, it is a comet.|en|1|1|1|false",
 "comets-vs-meteors/s08-l1": "Part two: what is a comet made of, and why does it have a tail?|en|1|1|1|false",
 "comets-vs-meteors/s09-l1": "A comet's core is a few to a few dozen kilometres wide: ice mixed with dust and rock.|en|1|1|1|false",
 "comets-vs-meteors/s09-l2": "People call it a dirty snowball.|en|1|1|1|false",
 "comets-vs-meteors/s09-l3": "Far from the Sun, it is frozen and dark, so we can hardly see it.|en|1|1|1|false",
 "comets-vs-meteors/s09-l4": "Near the Sun, the ice warms up, turns to gas, and carries dust away.|en|1|1|1|false",
 "comets-vs-meteors/s09-l5": "A bright cloud grows around the core, hundreds of thousands of kilometres wide, with even longer tails.|en|1|1|1|false",
 "comets-vs-meteors/s09-l6": "Sunlight and solar wind push the tail, so it always points away from the Sun.|en|1|1|1|false",
 "comets-vs-meteors/s10-l1": "Think about it. A comet has passed the Sun and is flying away.|en|1|1|1|false",
 "comets-vs-meteors/s10-l1b": "Is its tail behind it, or in front?|en|1|1|1|false",
 "comets-vs-meteors/s11-l1": "Grandpa, I am drawing a comet for school.|en|1|1|1|false",
 "comets-vs-meteors/s11-l3": "Away from the Sun. So the tail goes behind, like a kite!|en|1|1|1|false",
 "comets-vs-meteors/s11-l4": "Hold on!|en|1|1|1|false",
 "comets-vs-meteors/s11-l5": "A comet's tail is pushed by sunlight and solar wind. It always points away from the Sun.|en|1|1|1|false",
 "comets-vs-meteors/s11-l6": "Let's rewind and draw it again.|en|1|1|1|false",
 "comets-vs-meteors/s11-l7": "Draw the Sun first. Then make the tail point away from it.|en|1|1|1|false",
 "comets-vs-meteors/s11-l8": "Oh! It is flying away, so the tail is in front, leading the way!|en|1|1|1|false",
 "comets-vs-meteors/s11-l9": "Yes. A comet's tail always turns its back to the Sun.|en|1|1|1|false",
 "comets-vs-meteors/s12-l1": "Where do comets come from? Many come from the Kuiper belt, beyond Neptune.|en|1|1|1|false",
 "comets-vs-meteors/s12-l2": "Others come from the Oort cloud, even farther away.|en|1|1|1|false",
 "comets-vs-meteors/s13-l1": "Halley's Comet last came near in nineteen eighty six.|en|1|1|1|false",
 "comets-vs-meteors/s13-l2": "It returns about every seventy six years.|en|1|1|1|false",
 "comets-vs-meteors/s13-l3": "So the next visit is around twenty sixty one. Make a date with your child!|en|1|1|1|false",
 "comets-vs-meteors/s14-l1": "Part three: are shooting stars dangerous?|en|1|1|1|false",
 "comets-vs-meteors/s15-l1": "Most shooting stars come from pieces as small as a grain of sand or a pea.|en|1|1|1|false",
 "comets-vs-meteors/s15-l2": "They burn up completely, tens of kilometres above us.|en|1|1|1|false",
 "comets-vs-meteors/s15-l3": "A few larger pieces survive and land as meteorites.|en|1|1|1|false",
 "comets-vs-meteors/s15-l4": "Injuries from them are extremely rare. Watching shooting stars is safe.|en|1|1|1|false",
 "comets-vs-meteors/s16-l1": "Big impacts are very rare. They come tens of millions of years apart.|en|1|1|1|false",
 "comets-vs-meteors/s16-l2": "One about sixty six million years ago may have helped end the dinosaurs.|en|1|1|1|false",
 "comets-vs-meteors/s16-l3": "In twenty twenty two, a spacecraft crashed into a small asteroid and changed its path.|en|1|1|1|false",
 "comets-vs-meteors/s16-l4": "And today, scientists watch the objects that fly near Earth.|en|1|1|1|false",
 "comets-vs-meteors/s17-l1": "Grandpa, could a comet crash into Earth?|en|1|1|1|false",
 "comets-vs-meteors/s17-l2": "The shooting stars you see are just grains of sand burning high up. They hit no one.|en|1|1|1|false",
 "comets-vs-meteors/s17-l3": "Big ones are very rare. Scientists watch the sky, and they have tested a way to push them away.|en|1|1|1|false",
 "comets-vs-meteors/s17-l4": "A calm answer with a reason helps a child much more than just “don't worry”.|en|1|1|1|false",
 "comets-vs-meteors/s19-l1": "Part four: watching a meteor shower.|en|1|1|1|false",
 "comets-vs-meteors/s20-l1": "A comet, and sometimes an asteroid, leaves dust along its path.|en|1|1|1|false",
 "comets-vs-meteors/s20-l2": "Each year, Earth passes through that dust. Many pieces enter the air at once. That is a meteor shower.|en|1|1|1|false",
 "comets-vs-meteors/s20b-l3": "Two are easy to watch: the Perseids in mid August, and the Geminids in mid December.|en|1|1|1|false",
 "comets-vs-meteors/s22-l1": "Look up the peak date from an official astronomy source.|en|1|1|1|false",
 "comets-vs-meteors/s22-l2": "Pick a dark place, far from street lights.|en|1|1|1|false",
 "comets-vs-meteors/s22-l3": "Watch after midnight. Lie on your back and look at the whole sky.|en|1|1|1|false",
 "comets-vs-meteors/s22-l4": "Put your phone away for about half an hour, so your eyes get used to the dark.|en|1|1|1|false",
 "comets-vs-meteors/s22-l5": "You don't need a telescope or binoculars. Your eyes are enough.|en|1|1|1|false",
 "comets-vs-meteors/s24-l0": "A plan for the Geminids. First, Grandpa looked up the peak date: mid December.|en|1|1|1|false",
 "comets-vs-meteors/s24-l0b": "The family went to an open field out of town, with a mat and warm clothes.|en|1|1|1|false",
 "comets-vs-meteors/s24-l1": "Grandma, can I play on your phone while we wait?|en|1|1|1|false",
 "comets-vs-meteors/s24-l2": "Let's put the phone away for half an hour. Our eyes need time for the dark.|en|1|1|1|false",
 "comets-vs-meteors/s24-l3": "It is after midnight now. Lie back and look at the whole sky.|en|1|1|1|false",
 "comets-vs-meteors/s24-l4": "One! Two! I can see them!|en|1|1|1|false",
 "comets-vs-meteors/s24-l5": "Dark sky, eyes used to the dark, after midnight.|en|1|1|1|false",
 "comets-vs-meteors/s25-l1": "Part five: you found a strange stone. Is it from space?|en|1|1|1|false",
 "comets-vs-meteors/s26-l1": "Real meteorites are rare. Most odd, heavy, black stones are ordinary rocks or metal slag.|en|1|1|1|false",
 "comets-vs-meteors/s26-l2": "To be sure, ask experts at a museum or a geology institute.|en|1|1|1|false",
 "comets-vs-meteors/s26-l3": "Can you keep or sell one? The rules differ from place to place, so ask official sources.|en|1|1|1|false",
 "comets-vs-meteors/s27-a1": "Grandpa, the seller says it sticks to a magnet, so it is real!|en|1|1|1|false",
 "comets-vs-meteors/s27-a2": "Then it must be from space. Let's buy it.|en|1|1|1|false",
 "comets-vs-meteors/s27-b1": "Grandpa, the seller says it sticks to a magnet, so it is real!|en|1|1|1|false",
 "comets-vs-meteors/s27-b2": "A magnet is only one sign. Iron slag and many Earth rocks stick too.|en|1|1|1|false",
 "comets-vs-meteors/s27-b3": "Let's ask the experts at the museum first. They can check much more.|en|1|1|1|false",
 "comets-vs-meteors/s29-l1": "A strange stone may not be from the sky. Ask an expert.|en|1|1|1|false",
 "comets-vs-meteors/s29-l2": "Then your child does not learn something wrong, and you do not waste money.|en|1|1|1|false",
 "comets-vs-meteors/s30-l1": "Let's sum up. A streak that zips past is a meteor. A fuzzy spot with a tail is a comet.|en|1|1|1|false",
 "comets-vs-meteors/s30-l2": "A comet's tail always points away from the Sun.|en|1|1|1|false",
 "comets-vs-meteors/s30-l3": "And for a meteor shower: dark sky, eyes used to the dark, after midnight.|en|1|1|1|false",
 "comets-vs-meteors/s31-l1": "A comet has passed the Sun and is moving away, where does its tail point?|en|1|1|1|false",
 "comets-vs-meteors/s31-l2": "Forward, ahead of the comet, because the tail always points away from the Sun.|en|1|1|1|false",
 "comets-vs-meteors/s31-l3": "Sunlight and solar wind push the tail. It does not trail behind like a kite.|en|1|1|1|false",
 "comets-vs-meteors/s32-l1": "Now, look up the next meteor shower and pick a dark place for the whole family.|en|1|1|1|false",
 "comets-vs-meteors/s32-l2": "Your turn. Forty questions are waiting below.|en|1|1|1|false",
 "common-decision-making-mistakes/s01-l1": "Peak delivery week. The warehouse is short of staff, and many orders are late.|en|1|1|1|false",
 "common-decision-making-mistakes/s01-l2": "Customers keep calling to complain. Why did we choose this?|en|1|1|1|false",
 "common-decision-making-mistakes/s02-l1": "Why did we choose that? Usually, one of five mistakes.|en|1|1|1|false",
 "common-decision-making-mistakes/s02-l2": "Deciding in a hurry.|en|1|1|1|false",
 "common-decision-making-mistakes/s02-l3": "Trusting one source.|en|1|1|1|false",
 "common-decision-making-mistakes/s02-l4": "Following the crowd.|en|1|1|1|false",
 "common-decision-making-mistakes/s02-l5": "Hearing only what you like.|en|1|1|1|false",
 "common-decision-making-mistakes/s02-l6": "Deciding in strong emotion. Each one has a small habit to stop it.|en|1|1|1|false",
 "common-decision-making-mistakes/s03-l1": "One habit per mistake, then a checklist to use before big decisions.|en|1|1|1|false",
 "common-decision-making-mistakes/s03-l2": "Let's start with hurry.|en|1|1|1|false",
 "common-decision-making-mistakes/s04-l1": "Part one: was it a rushed decision?|en|1|1|1|false",
 "common-decision-making-mistakes/s05-l1": "Rushed decisions often come from pressure to do something right now.|en|1|1|1|false",
 "common-decision-making-mistakes/s05-l2": "The sign: nobody can explain the problem, the options, or why this one.|en|1|1|1|false",
 "common-decision-making-mistakes/s06-l1": "Before you decide, say three sentences out loud. The problem is...|en|1|1|1|false",
 "common-decision-making-mistakes/s06-l2": "We considered... We chose this because...|en|1|1|1|false",
 "common-decision-making-mistakes/s06-l3": "Can't finish them? Take more time, even fifteen minutes.|en|1|1|1|false",
 "common-decision-making-mistakes/s07-l1": "These three sentences are also what you need when your manager asks later.|en|1|1|1|false",
 "common-decision-making-mistakes/s07-l2": "Even if the result disappoints, you can show how you thought.|en|1|1|1|false",
 "common-decision-making-mistakes/s08-l1": "Part two: is one source enough?|en|1|1|1|false",
 "common-decision-making-mistakes/s09-l1": "One review, then you buy. One story, then you judge a whole department.|en|1|1|1|false",
 "common-decision-making-mistakes/s09-l2": "One video, then you change how you work.|en|1|1|1|false",
 "common-decision-making-mistakes/s09-l3": "One source may be biased, old, or wrong. The speaker may have their own interest.|en|1|1|1|false",
 "common-decision-making-mistakes/s09-l4": "Or their situation is very different from yours.|en|1|1|1|false",
 "common-decision-making-mistakes/s10-l0": "The factory needs time-tracking software that plans rotating night shifts.|en|1|1|1|false",
 "common-decision-making-mistakes/s10-a1": "The vendor's video is great. Let's sign for one year.|en|1|1|1|false",
 "common-decision-making-mistakes/s10-a2": "Month one: it can't plan the rotating night shifts. The video only showed what it can do.|en|1|1|1|false",
 "common-decision-making-mistakes/s10-b1": "Let's ask a company that uses it, and let a shift leader try it for a week.|en|1|1|1|false",
 "common-decision-making-mistakes/s10-b2": "The gap shows before signing. There's still time to change vendors.|en|1|1|1|false",
 "common-decision-making-mistakes/s11-l1": "For important decisions, check at least three independent sources.|en|1|1|1|false",
 "common-decision-making-mistakes/s11-l2": "For software: reviews from many places, a trial with real users,|en|1|1|1|false",
 "common-decision-making-mistakes/s11-l3": "and a company that already uses it.|en|1|1|1|false",
 "common-decision-making-mistakes/s12-l1": "One source is one view. Three sources make a picture.|en|1|1|1|false",
 "common-decision-making-mistakes/s13-l1": "Part three: everyone agrees. Should you speak up?|en|1|1|1|false",
 "common-decision-making-mistakes/s14-l1": "When everyone nods, it's hard to be the one with doubts.|en|1|1|1|false",
 "common-decision-making-mistakes/s14-l2": "Clear risks go unsaid, and the group walks into a choice many doubt.|en|1|1|1|false",
 "common-decision-making-mistakes/s14-l3": "That's agreeing with the crowd.|en|1|1|1|false",
 "common-decision-making-mistakes/s15-l1": "Let's join the trade fair! What do you think?|en|1|1|1|false",
 "common-decision-making-mistakes/s15-l2": "Great idea!|en|1|1|1|false",
 "common-decision-making-mistakes/s15-l3": "Thảo sees the fair is in peak delivery week. But everyone looks happy.|en|1|1|1|false",
 "common-decision-making-mistakes/s15-l4": "Um... okay.|en|1|1|1|false",
 "common-decision-making-mistakes/s15-l5": "Wait a second!|en|1|1|1|false",
 "common-decision-making-mistakes/s15-l6": "Staying quiet lets a clear risk slip by. That week, orders were late.|en|1|1|1|false",
 "common-decision-making-mistakes/s15-l7": "Let's rewind and ask gently.|en|1|1|1|false",
 "common-decision-making-mistakes/s15-l8": "I like this idea. But if it's in peak week, how will we plan our staff?|en|1|1|1|false",
 "common-decision-making-mistakes/s16-l1": "As a member, ask a question instead of saying no. Like Thảo did.|en|1|1|1|false",
 "common-decision-making-mistakes/s16-l2": "As the leader, ask: is there anything that could make this plan fail?|en|1|1|1|false",
 "common-decision-making-mistakes/s17-l1": "See it differently? Ask gently. Don't stay quiet to keep the peace.|en|1|1|1|false",
 "common-decision-making-mistakes/s18-l1": "Part four: why do you only see reasons for what you like?|en|1|1|1|false",
 "common-decision-making-mistakes/s19-l1": "Once you like an option, you notice what supports it and skip what doesn't.|en|1|1|1|false",
 "common-decision-making-mistakes/s19-l2": "It's called confirmation bias. Everyone has it, so it feels natural.|en|1|1|1|false",
 "common-decision-making-mistakes/s20-l1": "The fix: look for the strongest reason not to choose it.|en|1|1|1|false",
 "common-decision-making-mistakes/s20-l2": "Write three things that could go wrong.|en|1|1|1|false",
 "common-decision-making-mistakes/s20-l3": "Or ask a critical colleague to argue against it for ten minutes.|en|1|1|1|false",
 "common-decision-making-mistakes/s21-l1": "Thảo interviews Dũng, from her old school. By minute five, she likes him.|en|1|1|1|false",
 "common-decision-making-mistakes/s21-l2": "I loved that school. Great teachers!|en|1|1|1|false",
 "common-decision-making-mistakes/s21-l3": "Me too! Let's keep it easy. Tell me about your hobbies.|en|1|1|1|false",
 "common-decision-making-mistakes/s21-l4": "Wait a second!|en|1|1|1|false",
 "common-decision-making-mistakes/s21-l5": "Liking him is the signal. Ask the hardest question, and check one more source.|en|1|1|1|false",
 "common-decision-making-mistakes/s21-l6": "Let's rewind and try again.|en|1|1|1|false",
 "common-decision-making-mistakes/s21-l7": "Now the hardest one, about the main job. Here's a real situation.|en|1|1|1|false",
 "common-decision-making-mistakes/s21-l8": "I'd also like to call your former manager.|en|1|1|1|false",
 "common-decision-making-mistakes/s21-l9": "Of course.|en|1|1|1|false",
 "common-decision-making-mistakes/s22-l1": "The more you like an option, the harder you look for reasons against it.|en|1|1|1|false",
 "common-decision-making-mistakes/s23-l1": "Part five: angry or excited? Should you decide now?|en|1|1|1|false",
 "common-decision-making-mistakes/s24-l1": "An angry email. A big yes when excited. An expensive buy when sad.|en|1|1|1|false",
 "common-decision-making-mistakes/s24-l2": "Strong feelings narrow your view.|en|1|1|1|false",
 "common-decision-making-mistakes/s24-l3": "They push you to the fastest reaction, not the best.|en|1|1|1|false",
 "common-decision-making-mistakes/s25-l1": "Set waiting rules. Angry email: write a draft, wait at least an hour.|en|1|1|1|false",
 "common-decision-making-mistakes/s25-l2": "The heavier it is, the more it should wait overnight.|en|1|1|1|false",
 "common-decision-making-mistakes/s25-l3": "Big spending: wait one night. Big promise: sleep on it first.|en|1|1|1|false",
 "common-decision-making-mistakes/s26-l1": "Before, sent at once, copying both bosses: You sent the request late, and now you blame us?|en|1|1|1|false",
 "common-decision-making-mistakes/s26-l2": "After, saved as a draft for an hour: Noted. Your request came on the twelfth.|en|1|1|1|false",
 "common-decision-making-mistakes/s26b-l3": "We delivered on the fifteenth. Next time, let's set the deadline right away.|en|1|1|1|false",
 "common-decision-making-mistakes/s26b-l4": "Short, dates instead of feelings, a fix, and nobody loses face.|en|1|1|1|false",
 "common-decision-making-mistakes/s27-l1": "Write while you're hot. Send when you're cool.|en|1|1|1|false",
 "common-decision-making-mistakes/s28-l1": "Must you answer right now? Use a sentence that buys time.|en|1|1|1|false",
 "common-decision-making-mistakes/s28-l2": "Why was your document so late?|en|1|1|1|false",
 "common-decision-making-mistakes/s28-l3": "Thanks for letting me know. I'll check and reply this afternoon.|en|1|1|1|false",
 "common-decision-making-mistakes/s28-l4": "Polite, and I don't decide while I'm angry.|en|1|1|1|false",
 "common-decision-making-mistakes/s29-l1": "Part six: your checklist before an important decision.|en|1|1|1|false",
 "common-decision-making-mistakes/s30-l1": "Can I explain it in three sentences? Did I check three sources?|en|1|1|1|false",
 "common-decision-making-mistakes/s30-l2": "Has anyone raised a risk, or a reason against it?|en|1|1|1|false",
 "common-decision-making-mistakes/s30-l3": "Did I look for the strongest reason not to choose it?|en|1|1|1|false",
 "common-decision-making-mistakes/s30-l4": "Am I calm? Anger or excitement can push me to a choice I wouldn't make calmly.|en|1|1|1|false",
 "common-decision-making-mistakes/s31-l1": "One last question: if this is wrong, how easy is it to fix?|en|1|1|1|false",
 "common-decision-making-mistakes/s31-l2": "A trial, a short contract, a small test group.|en|1|1|1|false",
 "common-decision-making-mistakes/s31-l3": "Then a mistake, if any, stays a small one.|en|1|1|1|false",
 "common-decision-making-mistakes/s32-l1": "Nobody avoids every mistake. Five small habits stop most of them.|en|1|1|1|false",
 "common-decision-making-mistakes/s32-l2": "Three sentences, three sources, a gentle question,|en|1|1|1|false",
 "common-decision-making-mistakes/s32-l3": "a reason not to choose, and time to cool down.|en|1|1|1|false",
 "common-decision-making-mistakes/s33-l1": "Back to Thảo: one gentle question in that meeting could have saved peak week.|en|1|1|1|false",
 "common-decision-making-mistakes/s33-l2": "Save the checklist, and use it for your next big decision.|en|1|1|1|false",
 "common-decision-making-mistakes/s34-l1": "What is a sensible waiting rule for an angry email?|en|1|1|1|false",
 "common-decision-making-mistakes/s34-l2": "Write a draft, but wait at least an hour before you send it.|en|1|1|1|false",
 "common-decision-making-mistakes/s34-l3": "The draft lets the anger out. The hour lets you reread it calmly.|en|1|1|1|false",
 "common-decision-making-mistakes/s35-l1": "Stay calm, then choose. Forty questions are below.|en|1|1|1|false",
 "common-logical-fallacies/s01-l1": "It's too dark in the parking area. Could we add more lights?|en|1|1|1|false",
 "common-logical-fallacies/s01-l2": "You've just moved in, what do you know? We've lived here for decades, no problem.|en|1|1|1|false",
 "common-logical-fallacies/s01-l3": "It feels wrong, but where exactly is the mistake?|en|1|1|1|false",
 "common-logical-fallacies/s02-l1": "That's a fallacy. It sounds convincing but proves nothing. It swaps reasons for:|en|1|1|1|false",
 "common-logical-fallacies/s02-l2": "The person speaking.|en|1|1|1|false",
 "common-logical-fallacies/s02-l3": "A twisted version of your idea.|en|1|1|1|false",
 "common-logical-fallacies/s02-l4": "Only two choices, or a scary future.|en|1|1|1|false",
 "common-logical-fallacies/s02-l5": "The crowd, or a job title. Today: six common ones, and calm replies.|en|1|1|1|false",
 "common-logical-fallacies/s03-l1": "Our stops: fallacy versus argument, attacking the person, twisting ideas…|en|1|1|1|false",
 "common-logical-fallacies/s03-l2": "…two doors and slippery slopes, crowds and titles, then how to reply.|en|1|1|1|false",
 "common-logical-fallacies/s04-l1": "Part one: how is a fallacy different from a normal argument?|en|1|1|1|false",
 "common-logical-fallacies/s05-l1": "A normal argument gives reasons and evidence for its conclusion.|en|1|1|1|false",
 "common-logical-fallacies/s05-l2": "A fallacy replaces reasons: attacking the speaker, twisting ideas, threats, the crowd, or titles.|en|1|1|1|false",
 "common-logical-fallacies/s05b-l1": "Ask: without the tone, the title and the feelings, what reason is left?|en|1|1|1|false",
 "common-logical-fallacies/s05b-l2": "Reasons with evidence: a strong argument, even from a shy speaker. Nothing left: just a loud one.|en|1|1|1|false",
 "common-logical-fallacies/s06-l1": "Part two: when they aim at you, not your idea.|en|1|1|1|false",
 "common-logical-fallacies/s07-l1": "Personal attack: rejecting an idea by criticising the speaker.|en|1|1|1|false",
 "common-logical-fallacies/s07-l2": "Their age, job, hometown, or how long they've lived there.|en|1|1|1|false",
 "common-logical-fallacies/s07-l3": "None of that tells you if the idea is right or wrong.|en|1|1|1|false",
 "common-logical-fallacies/s08-l1": "Dũng doesn't argue about new or old.|en|1|1|1|false",
 "common-logical-fallacies/s08-l2": "Yes, I'm new. Is there any part of the idea that doesn't work, so I can rethink it?|en|1|1|1|false",
 "common-logical-fallacies/s08-l3": "Well, the electricity bill.|en|1|1|1|false",
 "common-logical-fallacies/s08-l4": "And the group moves on to how to share the cost.|en|1|1|1|false",
 "common-logical-fallacies/s09-l1": "Don't ask who said it. Ask what was said.|en|1|1|1|false",
 "common-logical-fallacies/s10-l1": "Part three: when your idea gets twisted.|en|1|1|1|false",
 "common-logical-fallacies/s11-l1": "The straw man: turn your idea into an extreme version that's easy to knock down.|en|1|1|1|false",
 "common-logical-fallacies/s11-l2": "Then attack that version.|en|1|1|1|false",
 "common-logical-fallacies/s11-l3": "You say: we should cut down. They answer as if you said: ban it completely.|en|1|1|1|false",
 "common-logical-fallacies/s12-l1": "Maybe Bin could watch the phone less while eating.|en|1|1|1|false",
 "common-logical-fallacies/s12-l2": "So you're saying his mum doesn't know how to raise him?|en|1|1|1|false",
 "common-logical-fallacies/s12-l3": "You always read too much into things. I never said that!|en|1|1|1|false",
 "common-logical-fallacies/s12-l4": "Wait a second!|en|1|1|1|false",
 "common-logical-fallacies/s12-l5": "That fights the twisted version, and blames the person.|en|1|1|1|false",
 "common-logical-fallacies/s12-l6": "Let's rewind. Say your real idea again, then invite her view.|en|1|1|1|false",
 "common-logical-fallacies/s12-l7": "I just hope he can focus on eating. Do you have a good way to help him watch less?|en|1|1|1|false",
 "common-logical-fallacies/s13-l1": "The talk returns to the shared goal. Misunderstood? Restate your real idea. Don't fight the twisted one.|en|1|1|1|false",
 "common-logical-fallacies/s14-l1": "Part four: only two choices, or a scary chain of events.|en|1|1|1|false",
 "common-logical-fallacies/s15-l1": "Either share this, or you don't love your children. Only two choices? True or false?|en|1|1|1|false",
 "common-logical-fallacies/s15-l2": "False. A false choice hides other options. Gently ask: is there another way?|en|1|1|1|false",
 "common-logical-fallacies/s16-l1": "A post says: Not sharing makes you an accomplice. It's about a restaurant being accused.|en|1|1|1|false",
 "common-logical-fallacies/s16-l2": "You know nothing else. Share now, or ignore evil. Are those really your only two options?|en|1|1|1|false",
 "common-logical-fallacies/s17-l1": "No. The post hides a third door: wait for more information.|en|1|1|1|false",
 "common-logical-fallacies/s17-l2": "Hear what the restaurant says.|en|1|1|1|false",
 "common-logical-fallacies/s17-l3": "Then speak. Hasty posts like this are sometimes removed for blaming the wrong people.|en|1|1|1|false",
 "common-logical-fallacies/s17-l4": "Early sharers may have hurt innocent people. See only two doors? Look for the third.|en|1|1|1|false",
 "common-logical-fallacies/s18-l1": "The slippery slope: one small step must lead to disaster, with no proof of the steps between.|en|1|1|1|false",
 "common-logical-fallacies/s18-l2": "Let the child use a calculator, and they'll forget how to count.|en|1|1|1|false",
 "common-logical-fallacies/s18-l3": "Reply: What would make that happen? Let's try it for a while.|en|1|1|1|false",
 "common-logical-fallacies/s19-l1": "Part five: everyone says so, or the expert says so.|en|1|1|1|false",
 "common-logical-fallacies/s20-l1": "Appeal to the crowd: treating many believers or users as proof.|en|1|1|1|false",
 "common-logical-fallacies/s20-l2": "But many people can be fooled by the same ad, or the same rumour.|en|1|1|1|false",
 "common-logical-fallacies/s21-l1": "Under a small bakery's post, dozens of comments say scam, don't buy.|en|1|1|1|false",
 "common-logical-fallacies/s21-l2": "One reader sees so many, and joins in.|en|1|1|1|false",
 "common-logical-fallacies/s21-l3": "Next day, the owner posts the messages and receipt. A customer just got the wrong order.|en|1|1|1|false",
 "common-logical-fallacies/s21-l4": "Comments disappear one by one, including theirs. Many voices aren't always right.|en|1|1|1|false",
 "common-logical-fallacies/s22-l1": "Appeal to authority: a title instead of evidence. He's the director, so he must be right.|en|1|1|1|false",
 "common-logical-fallacies/s22-l2": "Expert opinions are worth hearing. But still ask: Are there any results that show this?|en|1|1|1|false",
 "common-logical-fallacies/s23-l1": "Part six: you spotted a fallacy. How do you reply?|en|1|1|1|false",
 "common-logical-fallacies/s24-l1": "No need to say: You're using a fallacy! That turns the talk into win or lose.|en|1|1|1|false",
 "common-logical-fallacies/s24-l2": "Just two things: restate your idea, then ask for reasons or evidence.|en|1|1|1|false",
 "common-logical-fallacies/s24-l3": "Don't answer a fallacy with another, like bringing up their old mistakes.|en|1|1|1|false",
 "common-logical-fallacies/s24-l4": "Stay calm on the content. People around will see who makes sense.|en|1|1|1|false",
 "common-logical-fallacies/s25-l1": "That's not what I meant. I'm only suggesting…|en|1|1|1|false",
 "common-logical-fallacies/s25-l2": "Do we have any other options?|en|1|1|1|false",
 "common-logical-fallacies/s25-l3": "Is there any data that shows that?|en|1|1|1|false",
 "common-logical-fallacies/s25-l4": "Which part of the idea doesn't work for you?|en|1|1|1|false",
 "common-logical-fallacies/s26-l1": "Part seven: mistakes people make when they first learn about fallacies.|en|1|1|1|false",
 "common-logical-fallacies/s27-l1": "Using fallacy names as weapons to label people. Fix: talk about the content, not the person.|en|1|1|1|false",
 "common-logical-fallacies/s27-l2": "Thinking a conclusion is wrong because the argument has a flaw.|en|1|1|1|false",
 "common-logical-fallacies/s27-l3": "A weak argument can still reach a true conclusion. Look for better reasons before you reject it.|en|1|1|1|false",
 "common-logical-fallacies/s27-l4": "Only seeing other people's fallacies. Before a sharp comment, check: am I using pressure or the crowd?|en|1|1|1|false",
 "common-logical-fallacies/s28-l1": "What is the third choice hidden by the post about the restaurant?|en|1|1|1|false",
 "common-logical-fallacies/s28-l2": "Waiting for more information and hearing the restaurant's side before speaking.|en|1|1|1|false",
 "common-logical-fallacies/s28-l3": "Posts like that are sometimes removed for blaming the wrong people.|en|1|1|1|false",
 "common-logical-fallacies/s29-l1": "Ask what was said, not who said it.|en|1|1|1|false",
 "common-logical-fallacies/s29-l2": "Restate your real idea.|en|1|1|1|false",
 "common-logical-fallacies/s29-l3": "Look for a third door. Save the four sample lines today.|en|1|1|1|false",
 "common-logical-fallacies/s30-l1": "No need to win. Just bring it back to reasons. Forty questions are waiting.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s01-l1": "A dinner for six. Dung's turn.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s01-a1": "Hello everybody. Today I will introduce myself. My name is Dũng... Thank you for listening.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s01-b1": "Hi, I'm Dũng. I work in logistics and just moved here last month. What about you guys?|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s01-l2": "Left: people clap. Right: the talk goes on. Why?|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s02-l1": "What goes wrong when we introduce ourselves in English? Three groups of mistakes.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s02-l2": "Translating word by word.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s02-l3": "Dropping sounds, or wrong stress.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s02-l4": "And speaking like a school presentation.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s03-l1": "Six parts. Why we make the same mistakes. Articles and \"to be\". Plurals, prepositions, verbs.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s03-l2": "Pronunciation. Sounding like a presentation. And fixing mistakes for good.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s04-l1": "Part one: why do Vietnamese speakers make the same mistakes?|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s05-l1": "Three sources. Word-by-word translation: Vietnamese has no articles, and verbs don't change.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s05-l2": "Dropped final sounds, because Vietnamese doesn't release them like English.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s05-l3": "And the school presentation style.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s05-l4": "People usually still understand you. But you can prepare an introduction, so it's worth fixing for a better first impression.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s06-l1": "Part two: articles and \"to be\".|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s07-l1": "Here's a common mistake. I am student.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s07-l2": "Correct: I'm a student. A job word needs a or an.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s07-l3": "I'm an engineer. I work as an accountant.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s07-l4": "Use an before a vowel sound.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s08-l1": "I from Vietnam. The am is missing. Say: I'm from Vietnam.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s08-l2": "The opposite: I'm work at a bank. Am is extra. Say: I work at a bank.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s08-l3": "Tip: I'm goes with a noun, an adjective, or a place phrase like from Vietnam.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s08-l4": "I goes straight to the main verb.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s09-l1": "Part three: plurals, prepositions, age, and verb forms.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s10-l1": "Wrong: I have three years experiences.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s10-l2": "Right: I have three years of experience.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s10-l3": "Work experience is uncountable, so no plural. And it needs of.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s11-l1": "I graduated Hanoi University. Add from: I graduated from Hanoi University.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s11-l2": "I'm majoring about marketing. Say: I'm majoring in marketing.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s11-l3": "I live at Ho Chi Minh City. Cities and countries take in: I live in Ho Chi Minh City.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s12-l1": "Age. Not I'm twenty-five years.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s12-l2": "Say I'm twenty-five, or I'm twenty-five years old.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s12-l3": "Don't stop at years.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s12-l4": "Anyway, at work you usually don't need to say your age.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s13-l1": "I have been worked here for two years. Two tenses mixed in one sentence.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s13-l2": "Say: I have worked here for two years. Or: I've been working here for two years.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s13-l3": "My hobby is play football. Say: my hobby is playing football.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s13-l4": "More natural: I play football every weekend. After enjoy, use -ing too: I enjoy cooking.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s14-l1": "Part four: pronunciation that causes confusion.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s15-l1": "The most common pronunciation mistake: dropping final sounds.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s15-l2": "Work becomes wor. Five becomes fai. Release k, t, s, v clearly.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s15-l3": "Missing s and ed endings make you sound ungrammatical, even when you wrote it right.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s15-l4": "I have two brothers. I worked there for a year.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s16-l1": "Wrong stress makes words hard to recognise.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s16-l2": "Engineer: stress on the last part. Accountant: the second. Marketing: the first.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s16-l3": "Numbers too. Fifteen: stress at the end. Fifty: stress at the start.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s17-l1": "Bac Binh presents his company to Sam, a foreign supplier.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s17-l2": "We have fifty staff.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s17-l3": "Wait a second!|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s17-l4": "He stressed the end, so Sam heard fifteen. Next week: a quote for very small businesses.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s17-l5": "Then several more emails to clear it up. Let's rewind and try again.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s17-l6": "We have fifty staff. Fifty.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s17-l7": "Fifty, got it.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s18-l1": "Teen numbers: stress at the end. Ty numbers: stress at the start.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s18-l2": "Your name is familiar to you, new to them. Say it slowly and clearly, and repeat it if they miss it.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s19-l1": "Part five: sounding like a school presentation.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s20-l1": "Hello everybody, today I will introduce myself. That's a school presentation opening.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s20-l2": "When you meet people, go straight in: Hi everyone, I'm Nam.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s20-l3": "Ending with thank you for listening sounds like you just gave a talk.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s20-l4": "End with nice to meet you, or ask: how about you?|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s21-l1": "If the grammar is right, sharing your age, weight and marital status is fine. True or false?|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s21-l2": "False. At a first meeting or an interview, too much personal detail is a style mistake.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s22-l1": "Back to Dung's dinner. The first version opened and closed like a talk. People clapped like an audience.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s22-l2": "The second sounded like a chat, and the last question passed the turn.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s22b-l1": "Meeting people is a conversation, not a presentation.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s23-l1": "Last part: fixing mistakes for good.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s24-l1": "Step one: write your introduction down. Underline every job word, and check the article.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s24-l2": "Then compare it with the mistakes in this lesson.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s24-l3": "Step two: say it aloud and record it, to catch final sounds and -s, -ed.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s24-l4": "Ask a friend to write down what you say. Missing letters show where you drop sounds.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s24-l5": "Step three: don't fix everything at once. Pick two or three common mistakes for one week.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s25-l1": "I always write the s, so I say I have two brothers right.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s25-l2": "She records it, and a friend writes down what he hears.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s25-l3": "I have two brother, I work at bank? No s, no a!|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s25-l4": "Her ears heard the meaning, not the sound. Now she records every practice.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s25-l5": "A few weeks later, I can hear my -s.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s26-l1": "Your ears hear the meaning. Only a recording hears the sound.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s27-l1": "Way A: copy twenty common mistakes, and fix them all in one week.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s27-l2": "You check the list every time you speak, get stuck, and many give up in days.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s27-l3": "Way B: just two, like articles and final sounds, for one week. Then the next two.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s27-l4": "Your speech still flows. After a month, about eight mistakes are fixed for good.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s27b-l1": "Two mistakes a week beats twenty at once.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s28-l1": "These mistakes don't mean you're bad. They show Vietnamese is translating for you.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s28-l2": "Check: a or an before jobs, no am with a main verb, experience, graduated from, live in, final sounds, and a question back.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s28-l3": "Record your introduction today, check it with this list, and pick two mistakes for this week.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s29-l1": "In the before and after example, why does the after version keep the talk going?|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s29-l2": "It ends with a question, so the next person gets a turn to speak.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s29-l3": "\"Thank you for listening\" makes people an audience. Meeting people is a chat.|en|1|1|1|false",
 "common-mistakes-when-introducing-yourself-in-english/s30-l1": "No presentation needed. What about you? Forty questions below!|en|1|1|1|false",
 "communicate-without-good-language/s01-a1": "I would like to buy two tickets to the old town for tomorrow morning if it is possible.|en|1|1|1|false",
 "communicate-without-good-language/s01-a2": "Sorry? Could you say that again?|en|1|1|1|false",
 "communicate-without-good-language/s01-b1": "Two tickets, Old Town, tomorrow morning, please.|en|1|1|1|false",
 "communicate-without-good-language/s01-b2": "Two tickets. Here you are.|en|1|1|1|false",
 "communicate-without-good-language/s01-l5": "Neither is wrong. Why is the short one faster?|en|1|1|1|false",
 "communicate-without-good-language/s02-l1": "Basic English? How do you get by? You don't need to speak well. Just be understood.|en|1|1|1|false",
 "communicate-without-good-language/s02-l2": "Prepare a few phrases, and things to point at.|en|1|1|1|false",
 "communicate-without-good-language/s02-l3": "Speak in short key words.|en|1|1|1|false",
 "communicate-without-good-language/s02-l4": "Repeat things back to check.|en|1|1|1|false",
 "communicate-without-good-language/s02-l5": "And use your phone at the right time.|en|1|1|1|false",
 "communicate-without-good-language/s03-l1": "From getting ready at home, to speaking and listening.|en|1|1|1|false",
 "communicate-without-good-language/s03-l2": "Then your phone, who to ask, and what to say in an emergency.|en|1|1|1|false",
 "communicate-without-good-language/s04-l1": "Part one: prepare, so you need to speak less.|en|1|1|1|false",
 "communicate-without-good-language/s05-l1": "Install a translation app, and download the offline pack. You may have no internet at first.|en|1|1|1|false",
 "communicate-without-good-language/s05-l2": "Try it at home: type, speak, and translate a photo of words.|en|1|1|1|false",
 "communicate-without-good-language/s05-l3": "Save the hotel address in local writing. After check-in, take the hotel's card.|en|1|1|1|false",
 "communicate-without-good-language/s05-l4": "Many drivers read local writing faster than they understand an English name.|en|1|1|1|false",
 "communicate-without-good-language/s06-l1": "Hello, thank you, sorry, in the local language. A few short English lines for prices, directions, food, and help.|en|1|1|1|false",
 "communicate-without-good-language/s06-l2": "A photo of the hotel address. An allergy and health note, in English and the local language.|en|1|1|1|false",
 "communicate-without-good-language/s06-l3": "And the calculator on your phone, for prices.|en|1|1|1|false",
 "communicate-without-good-language/s07-l1": "You'll speak English anyway, so why learn a local hello? Fair point?|en|1|1|1|false",
 "communicate-without-good-language/s07-l2": "No. Hello and thank you take little time, but people smile, and want to help more.|en|1|1|1|false",
 "communicate-without-good-language/s08-l1": "This hotel, please.|en|1|1|1|false",
 "communicate-without-good-language/s08-l2": "Dũng shows the hotel name in English.|en|1|1|1|false",
 "communicate-without-good-language/s08-l3": "Okay, I think I know it.|en|1|1|1|false",
 "communicate-without-good-language/s08-l4": "Wait a second!|en|1|1|1|false",
 "communicate-without-good-language/s08-l5": "A hotel with a similar name is across town. Almost an hour lost, and a second taxi.|en|1|1|1|false",
 "communicate-without-good-language/s08-l6": "Let's rewind and try again.|en|1|1|1|false",
 "communicate-without-good-language/s08-l7": "Here's the address, in local writing.|en|1|1|1|false",
 "communicate-without-good-language/s08-l8": "Ah, this one. No problem.|en|1|1|1|false",
 "communicate-without-good-language/s08-l9": "With the address in local writing, you can always get back.|en|1|1|1|false",
 "communicate-without-good-language/s09-l1": "Part two: how to speak with a little English.|en|1|1|1|false",
 "communicate-without-good-language/s10-l1": "First, accept feeling shy. Everyone makes mistakes at first, and people value the effort.|en|1|1|1|false",
 "communicate-without-good-language/s10-l2": "Speak in key words, with please and thank you.|en|1|1|1|false",
 "communicate-without-good-language/s10-l3": "Train station, please?|en|1|1|1|false",
 "communicate-without-good-language/s10-l4": "Easier than a long sentence. Nobody grades your grammar.|en|1|1|1|false",
 "communicate-without-good-language/s11-l1": "Speak slowly and clearly, not louder.|en|1|1|1|false",
 "communicate-without-good-language/s11-l2": "Not understood? Try a different word, or point at a picture. Don't repeat the same thing louder.|en|1|1|1|false",
 "communicate-without-good-language/s12-l1": "Ask yes or no questions, not open ones.|en|1|1|1|false",
 "communicate-without-good-language/s12-l2": "Is this the bus to the airport? That's easier than: which bus goes to the airport?|en|1|1|1|false",
 "communicate-without-good-language/s12-l3": "And a short answer is easier for you to understand.|en|1|1|1|false",
 "communicate-without-good-language/s13-l1": "So, Thảo at the ticket desk. The long sentence wasn't wrong, but she hesitated, and the staff missed parts.|en|1|1|1|false",
 "communicate-without-good-language/s13-l2": "The short one kept only key words: how many, where, when. The screen showed the station name.|en|1|1|1|false",
 "communicate-without-good-language/s13b-l3": "The shorter the sentence, the faster they understand.|en|1|1|1|false",
 "communicate-without-good-language/s14-l1": "Part three: when you don't understand.|en|1|1|1|false",
 "communicate-without-good-language/s15-l1": "Didn't understand? Say so, politely.|en|1|1|1|false",
 "communicate-without-good-language/s15-l2": "Sorry, could you say that again, slowly?|en|1|1|1|false",
 "communicate-without-good-language/s15-l3": "Could you write it down, please?|en|1|1|1|false",
 "communicate-without-good-language/s15-l4": "Numbers, times, and prices on paper or a screen can't be misheard.|en|1|1|1|false",
 "communicate-without-good-language/s16-l1": "Platform three, ten thirty, right?|en|1|1|1|false",
 "communicate-without-good-language/s16-l2": "Yes, that's right.|en|1|1|1|false",
 "communicate-without-good-language/s16-l3": "Repeating takes a few seconds, and stops the wrong train or the wrong time.|en|1|1|1|false",
 "communicate-without-good-language/s17-l1": "Would you like breakfast added for every day of your stay?|en|1|1|1|false",
 "communicate-without-good-language/s17-l2": "Yes, yes.|en|1|1|1|false",
 "communicate-without-good-language/s17-l3": "Wait a second!|en|1|1|1|false",
 "communicate-without-good-language/s17-l4": "He didn't understand, but nodded. At check-out, he pays for breakfasts he never ate.|en|1|1|1|false",
 "communicate-without-good-language/s17-l5": "Let's rewind and try again.|en|1|1|1|false",
 "communicate-without-good-language/s17-l6": "Sorry, could you say that again, slowly?|en|1|1|1|false",
 "communicate-without-good-language/s17-l7": "Breakfast. Every day. Would you like it?|en|1|1|1|false",
 "communicate-without-good-language/s17-l8": "No breakfast, thank you.|en|1|1|1|false",
 "communicate-without-good-language/s17-l9": "Not sure? Ask again. Don't just nod.|en|1|1|1|false",
 "communicate-without-good-language/s18-l1": "Part four: using your phone and pictures.|en|1|1|1|false",
 "communicate-without-good-language/s19-l1": "Point instead of talking. Point at a food photo.|en|1|1|1|false",
 "communicate-without-good-language/s19-l2": "Point at the map.|en|1|1|1|false",
 "communicate-without-good-language/s19-l3": "Hold up a screen with the station name.|en|1|1|1|false",
 "communicate-without-good-language/s19-l4": "Picture menus or food models? Point, and hold up fingers for how many.|en|1|1|1|false",
 "communicate-without-good-language/s20-l1": "In a translation app, type short, simple sentences. No slang, no sayings.|en|1|1|1|false",
 "communicate-without-good-language/s20-l2": "Show the screen, and let them type their answer if needed.|en|1|1|1|false",
 "communicate-without-good-language/s21-l1": "A week before, Thảo downloads the offline pack for that country.|en|1|1|1|false",
 "communicate-without-good-language/s21-l2": "She turns on airplane mode, types a few lines, and photographs a sign. It still works.|en|1|1|1|false",
 "communicate-without-good-language/s21-l3": "She saves the hotel address, and the station exit name near the hotel.|en|1|1|1|false",
 "communicate-without-good-language/s21-l4": "Underground, no signal. But she reads the signs and walks out the right exit.|en|1|1|1|false",
 "communicate-without-good-language/s21-l5": "The network can fail. Offline packs don't.|en|1|1|1|false",
 "communicate-without-good-language/s22-l1": "How much is this?|en|1|1|1|false",
 "communicate-without-good-language/s22-l2": "Fifteen.|en|1|1|1|false",
 "communicate-without-good-language/s22-l3": "Fifteen or fifty? Could you type it, please?|en|1|1|1|false",
 "communicate-without-good-language/s22-l4": "Sure. Here.|en|1|1|1|false",
 "communicate-without-good-language/s22-l5": "Use the phone calculator. You type, they type. Fast numbers like fifteen and fifty are easy to mix up.|en|1|1|1|false",
 "communicate-without-good-language/s23-l1": "Part five: who to ask, and how to ask politely.|en|1|1|1|false",
 "communicate-without-good-language/s24-l1": "Ask staff first: information desks, stations, hotels, shops. They know foreign visitors, and the facts.|en|1|1|1|false",
 "communicate-without-good-language/s24-l2": "No staff around? Young people who aren't in a hurry often know some English.|en|1|1|1|false",
 "communicate-without-good-language/s25-l1": "Start with “excuse me”, end with “thank you”. Every question sounds softer.|en|1|1|1|false",
 "communicate-without-good-language/s25-l2": "Excuse me, can you help me? I'm lost.|en|1|1|1|false",
 "communicate-without-good-language/s25-l3": "Of course. Where are you going?|en|1|1|1|false",
 "communicate-without-good-language/s25-l4": "And excuse me, where is the toilet, please?|en|1|1|1|false",
 "communicate-without-good-language/s25-l5": "Just over there.|en|1|1|1|false",
 "communicate-without-good-language/s25-l6": "Thank you!|en|1|1|1|false",
 "communicate-without-good-language/s26-l1": "Hand gestures mean the same everywhere. True or false?|en|1|1|1|false",
 "communicate-without-good-language/s26-l2": "False. Some normal gestures in Vietnam can be rude elsewhere. Not sure? Point with your whole hand.|en|1|1|1|false",
 "communicate-without-good-language/s27-l1": "Part six: what to say in an emergency.|en|1|1|1|false",
 "communicate-without-good-language/s28-l1": "Save a few emergency lines at the top of your notes. In a panic, reading is easier than thinking.|en|1|1|1|false",
 "communicate-without-good-language/s28-l2": "Help, please!|en|1|1|1|false",
 "communicate-without-good-language/s28-l3": "I need a doctor.|en|1|1|1|false",
 "communicate-without-good-language/s28-l4": "Please call the police.|en|1|1|1|false",
 "communicate-without-good-language/s28-l5": "I lost my passport.|en|1|1|1|false",
 "communicate-without-good-language/s29-l1": "Food allergy? Show a card in the local language before you order.|en|1|1|1|false",
 "communicate-without-good-language/s29-l2": "I am allergic to peanuts. Please, no peanuts in my food.|en|1|1|1|false",
 "communicate-without-good-language/s29-l3": "No peanuts. I'll show this card to the kitchen.|en|1|1|1|false",
 "communicate-without-good-language/s29-l4": "Said once, quickly, it can be misheard or forgotten on the way to the kitchen. A card stays clear.|en|1|1|1|false",
 "communicate-without-good-language/s30-l1": "Abroad, you don't need to speak well. You need to be understood.|en|1|1|1|false",
 "communicate-without-good-language/s30-l2": "Short sentences, key words, repeat to check.|en|1|1|1|false",
 "communicate-without-good-language/s30-l3": "Point at pictures, and use your phone at the right time.|en|1|1|1|false",
 "communicate-without-good-language/s31-l1": "You did not catch what the staff member said, what is a good response?|en|1|1|1|false",
 "communicate-without-good-language/s31-l2": "Ask politely, sorry, could you say that again slowly, or ask them to write it.|en|1|1|1|false",
 "communicate-without-good-language/s31-l3": "Numbers and prices on paper can't be misheard.|en|1|1|1|false",
 "communicate-without-good-language/s32-l1": "Download the offline pack, and save the hotel address in local writing.|en|1|1|1|false",
 "communicate-without-good-language/s32-l2": "Then try the forty questions below.|en|1|1|1|false",
 "comparatives-and-superlatives/s01-l1": "Sam's new design is less clear than the old one. What should Thao say?|en|1|1|1|false",
 "comparatives-and-superlatives/s01-a1": "Your design is worse than the old one.|en|1|1|1|false",
 "comparatives-and-superlatives/s01-b1": "I think this one is not as clear as the old design.|en|1|1|1|false",
 "comparatives-and-superlatives/s01-b2": "Maybe we can make the menu bigger?|en|1|1|1|false",
 "comparatives-and-superlatives/s02-l1": "Both are correct. So how do you compare correctly, and kindly?|en|1|1|1|false",
 "comparatives-and-superlatives/s02-l2": "First, get the form right.|en|1|1|1|false",
 "comparatives-and-superlatives/s02-l3": "Then, say how much more.|en|1|1|1|false",
 "comparatives-and-superlatives/s02-l4": "And use the best carefully, and criticise gently.|en|1|1|1|false",
 "comparatives-and-superlatives/s03-l1": "Six short parts. Each one helps with the forty questions below.|en|1|1|1|false",
 "comparatives-and-superlatives/s04-l1": "Part one: comparative or superlative? -er or more?|en|1|1|1|false",
 "comparatives-and-superlatives/s05-l1": "Two things? Use the comparative. Option B is cheaper than option A.|en|1|1|1|false",
 "comparatives-and-superlatives/s05-l2": "A group of three or more? Use the superlative. This is the cheapest option of the three.|en|1|1|1|false",
 "comparatives-and-superlatives/s06-l1": "Short adjectives, usually one syllable, add -er and -est. Cheap, cheaper, the cheapest.|en|1|1|1|false",
 "comparatives-and-superlatives/s06-l2": "Two syllables ending in y? Change y to i. Easy, easier, the easiest. Busy, busier, the busiest.|en|1|1|1|false",
 "comparatives-and-superlatives/s06-l3": "Long adjectives use more and the most. Expensive, more expensive, the most expensive.|en|1|1|1|false",
 "comparatives-and-superlatives/s06-l4": "Other two-syllable words, like modern and useful, usually take more and most too.|en|1|1|1|false",
 "comparatives-and-superlatives/s07-l1": "Part two: spelling rules, and words you must learn by heart.|en|1|1|1|false",
 "comparatives-and-superlatives/s08-l1": "Ends in e? Just add r or st. Nice, nicer.|en|1|1|1|false",
 "comparatives-and-superlatives/s08-l2": "One vowel plus one consonant? Double the consonant. Big, bigger. Hot, hotter.|en|1|1|1|false",
 "comparatives-and-superlatives/s08-l3": "Consonant plus y? Change y to i. Busy, busier.|en|1|1|1|false",
 "comparatives-and-superlatives/s09-l1": "Good, better, the best.|en|1|1|1|false",
 "comparatives-and-superlatives/s09-l2": "Bad, worse, the worst.|en|1|1|1|false",
 "comparatives-and-superlatives/s09-l3": "Far, farther or further, the farthest or the furthest.|en|1|1|1|false",
 "comparatives-and-superlatives/s09-l4": "Further also means more, as in further information.|en|1|1|1|false",
 "comparatives-and-superlatives/s10-l1": "I'm making a table for my boss. Two suppliers.|en|1|1|1|false",
 "comparatives-and-superlatives/s10-l2": "Supplier B is more cheaper than supplier A.|en|1|1|1|false",
 "comparatives-and-superlatives/s10-l3": "Wait a second!|en|1|1|1|false",
 "comparatives-and-superlatives/s10-l4": "Cheaper already has -er. Don't add more as well. The same goes for more better.|en|1|1|1|false",
 "comparatives-and-superlatives/s10-l5": "Let's rewind and try again.|en|1|1|1|false",
 "comparatives-and-superlatives/s10-l6": "Supplier B is cheaper than supplier A.|en|1|1|1|false",
 "comparatives-and-superlatives/s11-l1": "Part three: more, but how much more?|en|1|1|1|false",
 "comparatives-and-superlatives/s12-l1": "The pattern is the comparative plus than. The new system is faster than the old one.|en|1|1|1|false",
 "comparatives-and-superlatives/s12-l2": "In speech, than me is natural. In formal writing, you can say than I am, or than I do.|en|1|1|1|false",
 "comparatives-and-superlatives/s13-l1": "A big gap? Put much, a lot, or far before the adjective. This route is much faster.|en|1|1|1|false",
 "comparatives-and-superlatives/s13-l2": "A small gap? Use slightly, a bit, or a little. The cost is slightly higher.|en|1|1|1|false",
 "comparatives-and-superlatives/s14-l1": "Before: The new supplier's price is higher. A little higher, or a lot? The boss must ask.|en|1|1|1|false",
 "comparatives-and-superlatives/s14-l2": "After: The price is slightly higher, about five percent, but delivery is much faster.|en|1|1|1|false",
 "comparatives-and-superlatives/s14b-l3": "Slightly and much show each gap. The number stops the guessing. Pros and cons help the boss decide.|en|1|1|1|false",
 "comparatives-and-superlatives/s15-l1": "Saying the price is higher is enough for the boss. True or false?|en|1|1|1|false",
 "comparatives-and-superlatives/s15-l2": "False. When you compare, say how big the gap is: slightly, or much.|en|1|1|1|false",
 "comparatives-and-superlatives/s16-l1": "Part four: comparing with numbers.|en|1|1|1|false",
 "comparatives-and-superlatives/s17-l1": "With numbers, use as … as with times. Option A is twice as expensive as option B.|en|1|1|1|false",
 "comparatives-and-superlatives/s17-l2": "Or the other way round: Option B costs half as much as option A.|en|1|1|1|false",
 "comparatives-and-superlatives/s18-l1": "Many people think two times cheaper is the right way to say it.|en|1|1|1|false",
 "comparatives-and-superlatives/s18-l2": "In fact, even native speakers argue about times cheaper. Half the price? Readers have to guess.|en|1|1|1|false",
 "comparatives-and-superlatives/s18b-l3": "A number readers must guess helps no one decide. With numbers, say twice as, or half as.|en|1|1|1|false",
 "comparatives-and-superlatives/s19-l1": "Part five: saying the best, correctly and carefully.|en|1|1|1|false",
 "comparatives-and-superlatives/s20-l1": "The superlative needs the. The fastest. The most reliable.|en|1|1|1|false",
 "comparatives-and-superlatives/s20-l2": "After it, use in with a place or group: the biggest office in the city.|en|1|1|1|false",
 "comparatives-and-superlatives/s20-l3": "Or of with a number: the cheapest of the three options.|en|1|1|1|false",
 "comparatives-and-superlatives/s20-l4": "One of the needs a plural noun: one of the most popular products, not product.|en|1|1|1|false",
 "comparatives-and-superlatives/s21-l1": "Thao writes in a sales email: Our software is the best in Vietnam. What will the client ask next?|en|1|1|1|false",
 "comparatives-and-superlatives/s22-l1": "Our software is the best in Vietnam.|en|1|1|1|false",
 "comparatives-and-superlatives/s22-l2": "Could you share any data showing that?|en|1|1|1|false",
 "comparatives-and-superlatives/s22-l3": "The best in the whole country is a big claim. Big claims need proof.|en|1|1|1|false",
 "comparatives-and-superlatives/s22-l4": "It's one of the most reliable options for small offices, and here is what our clients say.|en|1|1|1|false",
 "comparatives-and-superlatives/s22-l5": "The praise stays, but no one can argue. Proof? Say the best. No proof yet? Say one of the.|en|1|1|1|false",
 "comparatives-and-superlatives/s23-l1": "Part six: as … as, and criticising gently.|en|1|1|1|false",
 "comparatives-and-superlatives/s24-l1": "Equal? Use as, the base adjective, then as. The new model is as fast as the old one.|en|1|1|1|false",
 "comparatives-and-superlatives/s24-l2": "Not as … as means less, and it sounds much softer than worse. This version is not as clear as the last one.|en|1|1|1|false",
 "comparatives-and-superlatives/s25-l1": "Less plus an adjective suits long adjectives: This plan is less risky.|en|1|1|1|false",
 "comparatives-and-superlatives/s25-l2": "With short ones, say not as cheap as. Few people say less cheap.|en|1|1|1|false",
 "comparatives-and-superlatives/s26-l1": "Your design is worse than the old one. Is that good feedback? True or false?|en|1|1|1|false",
 "comparatives-and-superlatives/s26-l2": "False. The grammar is fine, but it sounds personal, and Sam doesn't know what to fix.|en|1|1|1|false",
 "comparatives-and-superlatives/s27-l1": "I think this one is not as clear as the old design. Maybe we can make the menu bigger?|en|1|1|1|false",
 "comparatives-and-superlatives/s27-l2": "Good idea. I'll make it bigger.|en|1|1|1|false",
 "comparatives-and-superlatives/s27-l3": "Gentle criticism? Use not as … as, and add a suggestion.|en|1|1|1|false",
 "comparatives-and-superlatives/s28-l1": "Option B is cheaper, but option A is more reliable.|en|1|1|1|false",
 "comparatives-and-superlatives/s28-l2": "The cost is slightly higher, but delivery is much faster.|en|1|1|1|false",
 "comparatives-and-superlatives/s28-l3": "It's one of the most popular products in our range.|en|1|1|1|false",
 "comparatives-and-superlatives/s28-l4": "This version is not as clear as the last one.|en|1|1|1|false",
 "comparatives-and-superlatives/s28-l5": "It costs half as much as the old model.|en|1|1|1|false",
 "comparatives-and-superlatives/s29-l1": "Before you send a comparison, check five things.|en|1|1|1|false",
 "comparatives-and-superlatives/s29-l2": "No more with -er. The before superlatives. Slightly or much for the gap.|en|1|1|1|false",
 "comparatives-and-superlatives/s29-l3": "Twice as or half as for numbers. And the best only with proof.|en|1|1|1|false",
 "comparatives-and-superlatives/s30-l1": "After reading our software is the best in Vietnam, what is a client likely to ask?|en|1|1|1|false",
 "comparatives-and-superlatives/s30-l2": "Could you share any data showing that, because a big claim needs proof.|en|1|1|1|false",
 "comparatives-and-superlatives/s30-l3": "Big claims need proof. No data yet? Say one of the most reliable options.|en|1|1|1|false",
 "comparatives-and-superlatives/s31-l1": "Your turn. Write three comparisons at work today, then try the forty questions below.|en|1|1|1|false",
 "compare-two-job-offers/s01-l1": "Lan has two offers. A pays a little more, but it is three hours a day on the road.|en|1|1|1|false",
 "compare-two-job-offers/s01-l2": "Easy. Take the one that pays more.|en|1|1|1|false",
 "compare-two-job-offers/s01-l3": "But B is only fifteen minutes from home…|en|1|1|1|false",
 "compare-two-job-offers/s01-l4": "So which one really pays more?|en|1|1|1|false",
 "compare-two-job-offers/s02-l1": "Two offers. How do you choose, beyond the salary?|en|1|1|1|false",
 "compare-two-job-offers/s02-l2": "Take-home pay.|en|1|1|1|false",
 "compare-two-job-offers/s02-l3": "What you learn, and who guides you.|en|1|1|1|false",
 "compare-two-job-offers/s02-l4": "Your time and health.|en|1|1|1|false",
 "compare-two-job-offers/s02-l5": "And your own situation.|en|1|1|1|false",
 "compare-two-job-offers/s03-l1": "Must you answer at once?|en|1|1|1|false",
 "compare-two-job-offers/s03-l2": "Comparing pay correctly.|en|1|1|1|false",
 "compare-two-job-offers/s03-l3": "Beyond the salary.|en|1|1|1|false",
 "compare-two-job-offers/s03-l4": "Time and travel.|en|1|1|1|false",
 "compare-two-job-offers/s03-l5": "Choosing, asking for more, saying no.|en|1|1|1|false",
 "compare-two-job-offers/s04-l1": "Part one: do you have to answer right away?|en|1|1|1|false",
 "compare-two-job-offers/s05-l1": "No need to answer at once. Most companies accept a few days.|en|1|1|1|false",
 "compare-two-job-offers/s05-l2": "I am very happy to get this offer. May I answer you by this Friday?|en|1|1|1|false",
 "compare-two-job-offers/s05-l3": "Could you email the offer: role, salary, start date, and probation period?|en|1|1|1|false",
 "compare-two-job-offers/s05-l4": "Sure, I will send it this afternoon.|en|1|1|1|false",
 "compare-two-job-offers/s05-l5": "A phone promise is easy to remember differently. Get it in writing.|en|1|1|1|false",
 "compare-two-job-offers/s06-l1": "I just received another offer. Could you tell me roughly when you will decide?|en|1|1|1|false",
 "compare-two-job-offers/s06-l2": "Thank you for telling me. I will check and let you know.|en|1|1|1|false",
 "compare-two-job-offers/s06-l3": "Said honestly and politely, this is a normal question, not pressure.|en|1|1|1|false",
 "compare-two-job-offers/s07-l1": "Part two: how to compare pay correctly.|en|1|1|1|false",
 "compare-two-job-offers/s08-l1": "The number may be gross pay, before insurance and tax. Or take-home pay, after.|en|1|1|1|false",
 "compare-two-job-offers/s08-l2": "Ask first. Two similar numbers can be quite different in your hand.|en|1|1|1|false",
 "compare-two-job-offers/s09-l1": "Probation pay and length. Allowances for lunch, travel, phone. Fixed or results-based bonus.|en|1|1|1|false",
 "compare-two-job-offers/s09-l2": "Social and health insurance, and on which salary. It affects sick pay and maternity pay.|en|1|1|1|false",
 "compare-two-job-offers/s09-l3": "And how often pay rises are reviewed.|en|1|1|1|false",
 "compare-two-job-offers/s10-l1": "A bigger number in the offer means more money. True or false?|en|1|1|1|false",
 "compare-two-job-offers/s10-l2": "False. Fifteen million with only eight fixed can bring home less than twelve million fixed.|en|1|1|1|false",
 "compare-two-job-offers/s10-l3": "A bonus “up to” a big number is not sure money. Count the fixed part first.|en|1|1|1|false",
 "compare-two-job-offers/s10-l4": "Ask: how much is fixed, how is the bonus counted, gross or take-home? Compare the money in your hand.|en|1|1|1|false",
 "compare-two-job-offers/s11-l1": "Part three: what else does a first job give you?|en|1|1|1|false",
 "compare-two-job-offers/s12-l1": "In your first year, the skills and habits you build stay with you for your whole career.|en|1|1|1|false",
 "compare-two-job-offers/s12-l2": "Ask who will guide you, if there is training, and what your daily tasks are.|en|1|1|1|false",
 "compare-two-job-offers/s12-l3": "How do you usually give tasks and feedback to new people?|en|1|1|1|false",
 "compare-two-job-offers/s12-l4": "Good question. Let me explain.|en|1|1|1|false",
 "compare-two-job-offers/s12-l5": "Your direct manager shapes your first year. Try to talk with them before you accept.|en|1|1|1|false",
 "compare-two-job-offers/s13-l1": "Ask about stability: long-term or one project? How big is the team? How long did the last person stay?|en|1|1|1|false",
 "compare-two-job-offers/s13-l2": "A hesitant answer is also information.|en|1|1|1|false",
 "compare-two-job-offers/s14-l1": "A famous name, but nobody has time to guide him: six months of data entry.|en|1|1|1|false",
 "compare-two-job-offers/s14-l2": "A small company, real tasks, weekly feedback: she does the whole job in half a year.|en|1|1|1|false",
 "compare-two-job-offers/s14b-l1": "Choose the person who will guide you, not only the sign above the door.|en|1|1|1|false",
 "compare-two-job-offers/s15-l1": "Part four: time, travel, and health. Back to Lan's question.|en|1|1|1|false",
 "compare-two-job-offers/s16-l1": "Does the team often work overtime? And how is that time counted?|en|1|1|1|false",
 "compare-two-job-offers/s16-l2": "Good question. Let me explain our rules.|en|1|1|1|false",
 "compare-two-job-offers/s16-l3": "Ask about hours, Saturdays, and overtime. Clear answers are a good sign. “We will see” is not.|en|1|1|1|false",
 "compare-two-job-offers/s17-l1": "Divide the pay by all the hours you give, including the road.|en|1|1|1|false",
 "compare-two-job-offers/s17-l2": "About twenty work days. Three hours a day is sixty hours. Minus B's half hour: about fifty unpaid hours.|en|1|1|1|false",
 "compare-two-job-offers/s17-l3": "More than six working days, plus fuel and tiredness. Try the trip once at rush hour before you say yes.|en|1|1|1|false",
 "compare-two-job-offers/s17-l4": "Hours on the road are working hours nobody pays you for.|en|1|1|1|false",
 "compare-two-job-offers/s18-l1": "Last part: put it on the scale, ask, and say no nicely.|en|1|1|1|false",
 "compare-two-job-offers/s19-l1": "Make one table with the same criteria for both offers. Score each place.|en|1|1|1|false",
 "compare-two-job-offers/s19-l2": "Then circle the two criteria that matter most to you right now.|en|1|1|1|false",
 "compare-two-job-offers/s20-l1": "Here is my table. Pay, learning, manager, travel, stability.|en|1|1|1|false",
 "compare-two-job-offers/s20-l2": "No need. I choose A for you.|en|1|1|1|false",
 "compare-two-job-offers/s20-l3": "Wait a second!|en|1|1|1|false",
 "compare-two-job-offers/s20-l4": "No choice is right for everyone. If the family needs money, pay weighs more. To grow first, learning weighs more.|en|1|1|1|false",
 "compare-two-job-offers/s20-l5": "Let's rewind and try again.|en|1|1|1|false",
 "compare-two-job-offers/s20-l6": "Let's go through each line. What do you think about this one?|en|1|1|1|false",
 "compare-two-job-offers/s20-l7": "The travel time worries me most.|en|1|1|1|false",
 "compare-two-job-offers/s20-l8": "Parents ask. The child decides. Not by what friends chose.|en|1|1|1|false",
 "compare-two-job-offers/s21-l0": "I really want to work here.|en|1|1|1|false",
 "compare-two-job-offers/s21-l1": "With my data analysis experience from my thesis, could you consider a slightly higher salary?|en|1|1|1|false",
 "compare-two-job-offers/s21-l2": "Let me check and get back to you.|en|1|1|1|false",
 "compare-two-job-offers/s21-l3": "Have a reason: the market rate, a specific skill, or another offer. Ask gently, once.|en|1|1|1|false",
 "compare-two-job-offers/s21-l4": "Never invent another offer. The industry is small, and a lie can cost you this offer.|en|1|1|1|false",
 "compare-two-job-offers/s22-l1": "I chose. Now I tell the other place, soon and kindly.|en|1|1|1|false",
 "compare-two-job-offers/s22-l2": "Thank you very much for your time and your trust in me.|en|1|1|1|false",
 "compare-two-job-offers/s22-l3": "I have accepted a role closer to my direction. I hope we can work together one day.|en|1|1|1|false",
 "compare-two-job-offers/s22-l4": "Short, sincere, early. One honest reason is enough.|en|1|1|1|false",
 "compare-two-job-offers/s23-l1": "Do not accept both and go silent, or say yes and not show up. They held the place, and may have turned others away.|en|1|1|1|false",
 "compare-two-job-offers/s23-l2": "Dung withdraws two days before starting. A year later, his interviewer is that company's old team leader.|en|1|1|1|false",
 "compare-two-job-offers/s23-l3": "He recognises Dung at once. People move between companies.|en|1|1|1|false",
 "compare-two-job-offers/s24-l1": "If unsure, ask for time. Once you accept, keep your word.|en|1|1|1|false",
 "compare-two-job-offers/s24-l2": "Fill in the table for both offers. Unknown lines become questions to ask.|en|1|1|1|false",
 "compare-two-job-offers/s25-l1": "Which saying reminds you to count travel time in a job offer?|en|1|1|1|false",
 "compare-two-job-offers/s25-l2": "Hours on the road are working hours that nobody pays you for.|en|1|1|1|false",
 "compare-two-job-offers/s25-l3": "Divide the pay by all the hours you give, road included.|en|1|1|1|false",
 "compare-two-job-offers/s26-l1": "Your turn. Forty questions are waiting below.|en|1|1|1|false",
 "conditional-sentences-explained/s01-l1": "On Wednesday, Thao sends her bid to a partner. Then Sam calls.|en|1|1|1|false",
 "conditional-sentences-explained/s01-l2": "If you'd sent it on Monday, we'd have approved it.|en|1|1|1|false",
 "conditional-sentences-explained/s01-l3": "Approved? So it's approved?|en|1|1|1|false",
 "conditional-sentences-explained/s01-l4": "Was it approved? Keep this question until the end.|en|1|1|1|false",
 "conditional-sentences-explained/s02-l1": "How do you pick the right conditional? The less real it is, the further back the verb goes.|en|1|1|1|false",
 "conditional-sentences-explained/s02-l2": "Type one: it can really happen.|en|1|1|1|false",
 "conditional-sentences-explained/s02-l3": "Type two: it is not real, or unlikely.|en|1|1|1|false",
 "conditional-sentences-explained/s02-l4": "Type three: it did not happen in the past.|en|1|1|1|false",
 "conditional-sentences-explained/s03-l1": "Five short parts. Then a quick quiz.|en|1|1|1|false",
 "conditional-sentences-explained/s04-l1": "Part one: how are the three types different?|en|1|1|1|false",
 "conditional-sentences-explained/s05-l1": "Every conditional has an if part and a result part. They can swap places.|en|1|1|1|false",
 "conditional-sentences-explained/s05-l2": "If you need help, call me. Call me if you need help. Same meaning.|en|1|1|1|false",
 "conditional-sentences-explained/s05-l3": "If comes first? Use a comma. If comes second? Usually no comma.|en|1|1|1|false",
 "conditional-sentences-explained/s06-l1": "Really possible? Type one: if plus present simple, then will.|en|1|1|1|false",
 "conditional-sentences-explained/s06-l2": "Only imagined now? Type two: if plus past simple, then would.|en|1|1|1|false",
 "conditional-sentences-explained/s06-l3": "Already past and can't change? Type three: if plus had done, then would have done.|en|1|1|1|false",
 "conditional-sentences-explained/s06-l4": "There is also type zero, for rules and processes. That's next.|en|1|1|1|false",
 "conditional-sentences-explained/s07-l1": "Part two: rules, and things that can really happen.|en|1|1|1|false",
 "conditional-sentences-explained/s08-l1": "Type zero is for rules and processes: present simple in both parts.|en|1|1|1|false",
 "conditional-sentences-explained/s08-l2": "If the printer runs out of paper, the red light flashes. Here, if is close to when.|en|1|1|1|false",
 "conditional-sentences-explained/s09-l1": "Is the email to the client ready?|en|1|1|1|false",
 "conditional-sentences-explained/s09-l2": "Almost. If you will confirm today, we will deliver tomorrow.|en|1|1|1|false",
 "conditional-sentences-explained/s09-l3": "Wait a second!|en|1|1|1|false",
 "conditional-sentences-explained/s09-l4": "No will after if, even about the future. Write if the client approves, not if the client will approve.|en|1|1|1|false",
 "conditional-sentences-explained/s09-l5": "Let's rewind and try again.|en|1|1|1|false",
 "conditional-sentences-explained/s09-l6": "If you confirm today, we'll deliver tomorrow.|en|1|1|1|false",
 "conditional-sentences-explained/s10-l1": "The result part can also use can, may, should, or a command instead of will.|en|1|1|1|false",
 "conditional-sentences-explained/s10-l2": "The most common email ending is a type one: If you have any questions, feel free to ask.|en|1|1|1|false",
 "conditional-sentences-explained/s11-l1": "Unless means if not. Unless you hurry, you'll be late means if you don't hurry, you'll be late.|en|1|1|1|false",
 "conditional-sentences-explained/s11-l2": "Now read this: Unless we receive your payment by Friday, the order will be cancelled.|en|1|1|1|false",
 "conditional-sentences-explained/s11b-l3": "Skim it, and you may think: pay, and the order is cancelled. Then you just wait.|en|1|1|1|false",
 "conditional-sentences-explained/s11b-l4": "Swap in if not: If we don't receive your payment by Friday… Now the meaning is clear.|en|1|1|1|false",
 "conditional-sentences-explained/s12-l1": "Unless you pay means if you pay. True or false?|en|1|1|1|false",
 "conditional-sentences-explained/s12-l2": "False. When you see unless, slow down. It means if not.|en|1|1|1|false",
 "conditional-sentences-explained/s13-l1": "Part three: things we only imagine.|en|1|1|1|false",
 "conditional-sentences-explained/s14-l1": "Type two: if plus past simple, then would. If I had a bigger budget, I would hire two more people.|en|1|1|1|false",
 "conditional-sentences-explained/s14-l2": "The form is past, but it talks about now. The past form signals: this is imagined, not real.|en|1|1|1|false",
 "conditional-sentences-explained/s15-l1": "I got a job offer. Should I take it?|en|1|1|1|false",
 "conditional-sentences-explained/s15-l2": "If I were you, I would accept the offer.|en|1|1|1|false",
 "conditional-sentences-explained/s15-l3": "With be, standard writing uses were for every person: If I were you. A soft, clear way to advise.|en|1|1|1|false",
 "conditional-sentences-explained/s16-l1": "Would also makes a request softer. It would help if you could send the details.|en|1|1|1|false",
 "conditional-sentences-explained/s16-l2": "Even without if: Would it be possible to move the meeting to Thursday? Not a conditional, but polite.|en|1|1|1|false",
 "conditional-sentences-explained/s17-l1": "The budget will probably be approved. Before: If we had more budget, we would hire two people.|en|1|1|1|false",
 "conditional-sentences-explained/s17-l2": "That's type two. It sounds like: sadly, there is no money. The boss moves on.|en|1|1|1|false",
 "conditional-sentences-explained/s17b-l3": "After: If the budget is approved, we'll hire two people. Type one sounds like a plan waiting for a green light.|en|1|1|1|false",
 "conditional-sentences-explained/s18-l1": "If it can really happen, don't say it like a dream.|en|1|1|1|false",
 "conditional-sentences-explained/s19-l1": "Part four: things that did not happen.|en|1|1|1|false",
 "conditional-sentences-explained/s20-l1": "Type three: if plus had plus past participle, then would have plus past participle.|en|1|1|1|false",
 "conditional-sentences-explained/s20-l2": "If we had checked the figures, we wouldn't have made that mistake. In fact, they didn't check, and they made it.|en|1|1|1|false",
 "conditional-sentences-explained/s21-l1": "The most common mistake: would after if. Say: If I had known, I would have called you.|en|1|1|1|false",
 "conditional-sentences-explained/s22-l1": "In speech, people shorten it: If I'd known, I'd have called you.|en|1|1|1|false",
 "conditional-sentences-explained/s22-l2": "The first I'd is I had. The second is I would. They sound the same, so use the position.|en|1|1|1|false",
 "conditional-sentences-explained/s23-l1": "When you hear would have, it's something that didn't happen. True or false?|en|1|1|1|false",
 "conditional-sentences-explained/s23-l2": "True. Would have usually describes a result that never happened.|en|1|1|1|false",
 "conditional-sentences-explained/s24-l1": "Past condition, present result? People mix the two types.|en|1|1|1|false",
 "conditional-sentences-explained/s24-l2": "If I had studied accounting, I would be working at a bank now. You rarely need it, but learn to recognise it.|en|1|1|1|false",
 "conditional-sentences-explained/s25-l1": "Part five: using conditionals kindly at work.|en|1|1|1|false",
 "conditional-sentences-explained/s26-l1": "Type three about yourself is a lesson: If I had checked earlier, we wouldn't have missed it.|en|1|1|1|false",
 "conditional-sentences-explained/s26-l2": "The same pattern about others sounds like blame: If you had told us earlier…|en|1|1|1|false",
 "conditional-sentences-explained/s26-l3": "With clients, talk about the next step, not the past.|en|1|1|1|false",
 "conditional-sentences-explained/s27-l1": "A client complains about a late delivery. He wrote the wrong address.|en|1|1|1|false",
 "conditional-sentences-explained/s27-a1": "If you had given us the correct address, we would have delivered on time.|en|1|1|1|false",
 "conditional-sentences-explained/s27-b1": "Thanks for updating the address. If you confirm it today, we'll deliver tomorrow.|en|1|1|1|false",
 "conditional-sentences-explained/s27-l2": "A points at his past mistake, so he feels blamed. B points at the next step, so he feels helped.|en|1|1|1|false",
 "conditional-sentences-explained/s27-l3": "Type three about you is a lesson. About a client, it's blame.|en|1|1|1|false",
 "conditional-sentences-explained/s28-l1": "If you have any questions, let me know.|en|1|1|1|false",
 "conditional-sentences-explained/s28-l2": "If I were you, I'd take the offer.|en|1|1|1|false",
 "conditional-sentences-explained/s28-l3": "It would help if you could send the details.|en|1|1|1|false",
 "conditional-sentences-explained/s28-l4": "If we finish early, we'll call you.|en|1|1|1|false",
 "conditional-sentences-explained/s29-l1": "Practise with one topic. Still waiting: If I get the job, I'll move to Da Nang.|en|1|1|1|false",
 "conditional-sentences-explained/s29-l2": "Chances are low: If I got the job, I would move to Da Nang.|en|1|1|1|false",
 "conditional-sentences-explained/s29-l3": "Already failed: If I had got the job, I would have moved to Da Nang.|en|1|1|1|false",
 "conditional-sentences-explained/s30-l1": "Before you send, check: no will or would after if, and the right type for how real it is.|en|1|1|1|false",
 "conditional-sentences-explained/s30-l2": "Is a type three blaming the reader? And did you read unless as if not?|en|1|1|1|false",
 "conditional-sentences-explained/s31-l1": "Now, back to Thao's bid.|en|1|1|1|false",
 "conditional-sentences-explained/s32-l1": "A partner says if you'd sent it on Monday, we'd have approved it, was it approved?|en|1|1|1|false",
 "conditional-sentences-explained/s32-l2": "No, the third type describes a result that did not happen in the past.|en|1|1|1|false",
 "conditional-sentences-explained/s32-l3": "You'd sent is had sent. We'd have approved is would have approved. It was not sent on Monday, so it was not approved.|en|1|1|1|false",
 "conditional-sentences-explained/s33-l1": "Approved is only an imagined result. Ask about the next step.|en|1|1|1|false",
 "conditional-sentences-explained/s33-l2": "I see. Is there anything we can still do?|en|1|1|1|false",
 "conditional-sentences-explained/s34-l1": "Write three sentences, one for each type, and read them aloud. Then try the forty questions!|en|1|1|1|false",
 "confirmation-bias/s01-l1": "This bus is always late! I'll take a motorbike taxi every day.|en|1|1|1|false",
 "confirmation-bias/s01-l2": "Bác Bình feels completely sure. His wife suggests one thing: write down the bus times for a week.|en|1|1|1|false",
 "confirmation-bias/s02-l1": "What will the notes show? And why do we feel so sure? Meet confirmation bias.|en|1|1|1|false",
 "confirmation-bias/s02-l2": "We look for what fits our view.|en|1|1|1|false",
 "confirmation-bias/s02-l3": "We remember it.|en|1|1|1|false",
 "confirmation-bias/s02-l4": "We believe it.|en|1|1|1|false",
 "confirmation-bias/s02-l5": "And we skip what doesn't fit. Everyone has it, even smart, experienced people.|en|1|1|1|false",
 "confirmation-bias/s03-l1": "Four moments bias shows up: searching, remembering, scrolling, and asking others.|en|1|1|1|false",
 "confirmation-bias/s03-l2": "Then five small habits, and mistakes to avoid.|en|1|1|1|false",
 "confirmation-bias/s04-l1": "Part one: what is it, and do I have it?|en|1|1|1|false",
 "confirmation-bias/s05-l1": "Think of it as a brain shortcut.|en|1|1|1|false",
 "confirmation-bias/s05-l2": "Information that agrees gets in fast. Information that disagrees gets pushed away.|en|1|1|1|false",
 "confirmation-bias/s05-l3": "So you feel more and more sure, while the real evidence barely grows.|en|1|1|1|false",
 "confirmation-bias/s06-l1": "I'm careful, so I don't have this bias. True or false?|en|1|1|1|false",
 "confirmation-bias/s06-l2": "False. We see bias in others more easily than in ourselves.|en|1|1|1|false",
 "confirmation-bias/s06-l3": "Safer: assume everyone has it, including you, and build a few habits to check.|en|1|1|1|false",
 "confirmation-bias/s07-l1": "Part two: how it shows up when you search online.|en|1|1|1|false",
 "confirmation-bias/s08-l1": "We often type keywords that already contain the conclusion.|en|1|1|1|false",
 "confirmation-bias/s08-l2": "The harms of…, or why … is bad.|en|1|1|1|false",
 "confirmation-bias/s08-l3": "The search engine returns exactly those articles, and we think we did good research.|en|1|1|1|false",
 "confirmation-bias/s09-l1": "You heard milk at night is bad. Before: you search the harms of milk at night.|en|1|1|1|false",
 "confirmation-bias/s09-l2": "The top ten results all warn you.|en|1|1|1|false",
 "confirmation-bias/s09b-l1": "After: you search is milk at night good or not. You get all views, many say it depends.|en|1|1|1|false",
 "confirmation-bias/s09b-l2": "A neutral question doesn't pick the answer, so both sides come back.|en|1|1|1|false",
 "confirmation-bias/s10-l1": "Type a question. Don't type the answer.|en|1|1|1|false",
 "confirmation-bias/s11-l1": "Part three: does memory pick for you?|en|1|1|1|false",
 "confirmation-bias/s12-l1": "Yes. We remember the times that match our belief, and forget the ones that don't.|en|1|1|1|false",
 "confirmation-bias/s12-l2": "That's why someone can remember every mistake a colleague made, but not their good work.|en|1|1|1|false",
 "confirmation-bias/s13-l1": "Back to Bác Bình. One week of notes: only one bus was really late. The rest were almost on time.|en|1|1|1|false",
 "confirmation-bias/s13-l2": "I remembered the long waits, and forgot the easy days. I'll keep taking the bus.|en|1|1|1|false",
 "confirmation-bias/s13-l3": "Write it down first. Trust your memory later.|en|1|1|1|false",
 "confirmation-bias/s14-l1": "Part four: how social media feeds make it worse.|en|1|1|1|false",
 "confirmation-bias/s15-l1": "You watch or like something.|en|1|1|1|false",
 "confirmation-bias/s15-l2": "The feed shows you more of the same.|en|1|1|1|false",
 "confirmation-bias/s15-l3": "Over time, it seems everyone says so.|en|1|1|1|false",
 "confirmation-bias/s15-l4": "But it's only a small corner, chosen for you.|en|1|1|1|false",
 "confirmation-bias/s16-l1": "A woman watches a few videos about suburban land about to rise. Her feed fills with them.|en|1|1|1|false",
 "confirmation-bias/s16-l2": "She's sure everyone is buying, and plans to take out all her savings.|en|1|1|1|false",
 "confirmation-bias/s16-l3": "Her brother sends risk reports, and reminds her to ask the planning authority.|en|1|1|1|false",
 "confirmation-bias/s16-l4": "She stops, researches, and decides not to buy yet. A feed that agrees with you isn't the whole world.|en|1|1|1|false",
 "confirmation-bias/s17-l1": "A simple fix: for important topics, read a few different sources.|en|1|1|1|false",
 "confirmation-bias/s17-l2": "And don't use your social media feed as your only source.|en|1|1|1|false",
 "confirmation-bias/s18-l1": "Part five: when you ask other people.|en|1|1|1|false",
 "confirmation-bias/s19-l0": "We tend to ask people we know will agree. It feels reassuring, but it's our own view in someone else's mouth.|en|1|1|1|false",
 "confirmation-bias/s19-l1": "My friends all say go for it. I won't ask my cousin. I don't want sad stories.|en|1|1|1|false",
 "confirmation-bias/s19-l2": "Wait a second!|en|1|1|1|false",
 "confirmation-bias/s19-l3": "Your friends repeat what you want to hear. Your cousin knows the real problems.|en|1|1|1|false",
 "confirmation-bias/s19-l4": "Let's rewind and try again.|en|1|1|1|false",
 "confirmation-bias/s19-l5": "You ran a cafe before. What was hard about it?|en|1|1|1|false",
 "confirmation-bias/s19-l6": "The rent, the staff, and few customers in the rainy season.|en|1|1|1|false",
 "confirmation-bias/s20-l1": "Exactly the information she was missing. Ask the person who might say wait, too.|en|1|1|1|false",
 "confirmation-bias/s21-l1": "Part six: five small habits that reduce bias.|en|1|1|1|false",
 "confirmation-bias/s22-l1": "Find the other side's strongest argument, not its weakest.|en|1|1|1|false",
 "confirmation-bias/s22-l2": "Ask yourself: what would change my mind?|en|1|1|1|false",
 "confirmation-bias/s22-l3": "Use neutral search words. Ask someone who thinks differently, and listen to understand.|en|1|1|1|false",
 "confirmation-bias/s22-l4": "Write down your prediction before the result, then compare.|en|1|1|1|false",
 "confirmation-bias/s23-l1": "Can't answer What would change my mind? You may not really be open to evidence.|en|1|1|1|false",
 "confirmation-bias/s23-l2": "The difference is the goal: searching to confirm, or searching to test.|en|1|1|1|false",
 "confirmation-bias/s23-l3": "If your view still stands after you try to find evidence against it, it's truly stronger.|en|1|1|1|false",
 "confirmation-bias/s24-l1": "Part seven: mistakes when you try to be objective.|en|1|1|1|false",
 "confirmation-bias/s25-l1": "False balance: treating an opinion with no basis as equal to solid evidence, just to look fair.|en|1|1|1|false",
 "confirmation-bias/s25-l2": "Weigh by the quality of evidence, not by the number of sides.|en|1|1|1|false",
 "confirmation-bias/s25b-l1": "Changing your mind all the time: everyone you hear seems right.|en|1|1|1|false",
 "confirmation-bias/s25b-l2": "Change your mind for new evidence, not for whoever is louder or speaks last.|en|1|1|1|false",
 "confirmation-bias/s26-l1": "A small exercise before commenting on a hot topic: write the other side's three best reasons.|en|1|1|1|false",
 "confirmation-bias/s26-l2": "Can't write them? You probably haven't read enough to comment.|en|1|1|1|false",
 "confirmation-bias/s27-l1": "Which search words are more neutral?|en|1|1|1|false",
 "confirmation-bias/s27-l2": "Is drinking milk at night good or bad for health.|en|1|1|1|false",
 "confirmation-bias/s27-l3": "The other two already carry an answer, so they return only warnings.|en|1|1|1|false",
 "confirmation-bias/s28-l1": "Type a question, not an answer.|en|1|1|1|false",
 "confirmation-bias/s28-l2": "Write it down first, trust memory later.|en|1|1|1|false",
 "confirmation-bias/s28-l3": "Ask the person who might say wait. Today, write what would change one belief of yours.|en|1|1|1|false",
 "confirmation-bias/s29-l1": "Search to test, not to confirm. Forty questions are waiting.|en|1|1|1|false",
 "cook-simple-healthy-meals/s01-l1": "Nine p.m. You open the fridge: one pack of noodles and half a tomato.|en|1|1|1|false",
 "cook-simple-healthy-meals/s01-l2": "Again? Fine, I'll just order food…|en|1|1|1|false",
 "cook-simple-healthy-meals/s01-l3": "Third time this week. Is cooking really that hard?|en|1|1|1|false",
 "cook-simple-healthy-meals/s02-l1": "Cooking is easier than you think. How do you eat well without spending more?|en|1|1|1|false",
 "cook-simple-healthy-meals/s02-l2": "A few tools, a weekly list, a few dishes, a balanced plate, and clean habits.|en|1|1|1|false",
 "cook-simple-healthy-meals/s03-l1": "Six steps: what to buy, how to shop, a good plate,|en|1|1|1|false",
 "cook-simple-healthy-meals/s03-l2": "quick cooking, safe food, and cooking with friends.|en|1|1|1|false",
 "cook-simple-healthy-meals/s04-l1": "Part one: what do you need to start?|en|1|1|1|false",
 "cook-simple-healthy-meals/s05-l1": "Can I cook in my room? Which kind of cooker can I use?|en|1|1|1|false",
 "cook-simple-healthy-meals/s05-l2": "Good that you asked. Every building has its own rules.|en|1|1|1|false",
 "cook-simple-healthy-meals/s05-l3": "Ask first, so you don't buy things you can't use.|en|1|1|1|false",
 "cook-simple-healthy-meals/s06-l1": "A rice cooker. A small pan or pot.|en|1|1|1|false",
 "cook-simple-healthy-meals/s06-l2": "A knife, a board, chopsticks, bowls.|en|1|1|1|false",
 "cook-simple-healthy-meals/s06-l3": "A few boxes with lids, and basic seasonings.|en|1|1|1|false",
 "cook-simple-healthy-meals/s06-l4": "That's enough for most meals. With only a kettle, you mostly eat noodles.|en|1|1|1|false",
 "cook-simple-healthy-meals/s07-l1": "Cooking in your room? Keep the cooker away from curtains, paper and bedding.|en|1|1|1|false",
 "cook-simple-healthy-meals/s07-l2": "Never walk away while it's on. Unplug it when you finish.|en|1|1|1|false",
 "cook-simple-healthy-meals/s07-l3": "In a small room, fire spreads very fast.|en|1|1|1|false",
 "cook-simple-healthy-meals/s08-a1": "Week one! A full set of pots, a blender, a small oven!|en|1|1|1|false",
 "cook-simple-healthy-meals/s08-a2": "But big machines may not be allowed. They sit under the bed, and food money runs short.|en|1|1|1|false",
 "cook-simple-healthy-meals/s08-b1": "I asked first. Just a rice cooker and one pan.|en|1|1|1|false",
 "cook-simple-healthy-meals/s08-b2": "Cheap, small, and enough for most meals. Buy more only when you need it.|en|1|1|1|false",
 "cook-simple-healthy-meals/s08-b3": "Ask before you buy, and start small.|en|1|1|1|false",
 "cook-simple-healthy-meals/s09-l1": "Part two: shopping for the whole week.|en|1|1|1|false",
 "cook-simple-healthy-meals/s10-l1": "At the weekend, plan meals for the next five or six days.|en|1|1|1|false",
 "cook-simple-healthy-meals/s10-l2": "Then write a shopping list from that plan.|en|1|1|1|false",
 "cook-simple-healthy-meals/s10-l3": "You buy what you need, and fewer snacks. Less food goes to waste.|en|1|1|1|false",
 "cook-simple-healthy-meals/s11-l1": "Vegetables in season are usually cheaper and fresher.|en|1|1|1|false",
 "cook-simple-healthy-meals/s11-l2": "Leafy greens wilt fast, so eat them first.|en|1|1|1|false",
 "cook-simple-healthy-meals/s11-l3": "Eggs, pumpkin, carrots and potatoes keep longer. Save them for the weekend.|en|1|1|1|false",
 "cook-simple-healthy-meals/s12-l1": "Lan wants five dinners and no waste. On Sunday night, she writes a menu.|en|1|1|1|false",
 "cook-simple-healthy-meals/s12-l2": "Eggs with greens, tofu in tomato sauce, pumpkin and carrot soup with minced meat.|en|1|1|1|false",
 "cook-simple-healthy-meals/s12-l3": "From the menu, she writes the list: greens, pumpkin, carrots, eggs, tofu, tomatoes, meat.|en|1|1|1|false",
 "cook-simple-healthy-meals/s12-l4": "She splits the meat into two portions, one per meal, and freezes them.|en|1|1|1|false",
 "cook-simple-healthy-meals/s12-l5": "At mealtime, she thaws just one portion, not the whole block.|en|1|1|1|false",
 "cook-simple-healthy-meals/s13-l1": "Shopping on a whim feeds you all week. True or false?|en|1|1|1|false",
 "cook-simple-healthy-meals/s13-l2": "False. Shop with a list, and your fridge won't become a rubbish bin.|en|1|1|1|false",
 "cook-simple-healthy-meals/s14-l1": "Part three: what makes a good meal?|en|1|1|1|false",
 "cook-simple-healthy-meals/s15-l1": "Look at your plate. About half should be vegetables.|en|1|1|1|false",
 "cook-simple-healthy-meals/s15-l2": "The rest is rice, and protein like eggs, tofu, meat or fish.|en|1|1|1|false",
 "cook-simple-healthy-meals/s15-l3": "No need to weigh anything. Just have all three groups at every meal.|en|1|1|1|false",
 "cook-simple-healthy-meals/s16-l1": "Cheap, easy protein: eggs, tofu, small fish, minced meat.|en|1|1|1|false",
 "cook-simple-healthy-meals/s16-l2": "Change them during the week. Less boring, and more nutrients.|en|1|1|1|false",
 "cook-simple-healthy-meals/s17-l1": "First exam season. Dũng thinks cooking takes too much time.|en|1|1|1|false",
 "cook-simple-healthy-meals/s17-l2": "Noodles and soft drinks. More time to study!|en|1|1|1|false",
 "cook-simple-healthy-meals/s17-l3": "Exam week… why am I so tired and sleepy?|en|1|1|1|false",
 "cook-simple-healthy-meals/s17-l4": "Wait a second!|en|1|1|1|false",
 "cook-simple-healthy-meals/s17-l5": "Noodles lack greens and have lots of salt. As meals, they leave you tired and foggy.|en|1|1|1|false",
 "cook-simple-healthy-meals/s17-l6": "Let's rewind and try again.|en|1|1|1|false",
 "cook-simple-healthy-meals/s17-l7": "No time tonight? I'll add an egg and some greens to my noodles.|en|1|1|1|false",
 "cook-simple-healthy-meals/s17-l8": "Other days, simple rice, vegetables and eggs.|en|1|1|1|false",
 "cook-simple-healthy-meals/s18-l1": "Don't skip breakfast just because you're late.|en|1|1|1|false",
 "cook-simple-healthy-meals/s18-l2": "Fried rice with egg, bread with egg, or milk and a banana.|en|1|1|1|false",
 "cook-simple-healthy-meals/s18-l3": "Any of these is enough for a morning of classes.|en|1|1|1|false",
 "cook-simple-healthy-meals/s18-l4": "However busy, have greens. However rushed, have an egg.|en|1|1|1|false",
 "cook-simple-healthy-meals/s20-l1": "Part four: quick cooking for busy days.|en|1|1|1|false",
 "cook-simple-healthy-meals/s21-l1": "I'll cook one extra portion tonight, for lunch tomorrow.|en|1|1|1|false",
 "cook-simple-healthy-meals/s21-l2": "Into a box with a lid, and into the fridge right after dinner.|en|1|1|1|false",
 "cook-simple-healthy-meals/s21-l3": "Not on the desk overnight. Cooked food left out goes bad easily.|en|1|1|1|false",
 "cook-simple-healthy-meals/s22-l1": "A rice cooker does more than rice.|en|1|1|1|false",
 "cook-simple-healthy-meals/s22-l2": "Steam eggs, boil vegetables, make rice porridge.|en|1|1|1|false",
 "cook-simple-healthy-meals/s22-l3": "One pot, little washing up. Perfect for a small room.|en|1|1|1|false",
 "cook-simple-healthy-meals/s23-l1": "Learn three or four dishes really well.|en|1|1|1|false",
 "cook-simple-healthy-meals/s23-l2": "Fried egg or egg with meat. Tofu in tomato sauce.|en|1|1|1|false",
 "cook-simple-healthy-meals/s23-l3": "Boiled greens or greens with garlic. Vegetable soup with minced meat.|en|1|1|1|false",
 "cook-simple-healthy-meals/s23-l4": "Rotate them all week. Each meal takes just a few dozen minutes.|en|1|1|1|false",
 "cook-simple-healthy-meals/s24-l1": "Part five: food that won't upset your stomach.|en|1|1|1|false",
 "cook-simple-healthy-meals/s25-l1": "Wash your hands before cooking, and after touching raw meat or fish.|en|1|1|1|false",
 "cook-simple-healthy-meals/s25-l2": "Use separate boards for raw and cooked food, or wash the board well.|en|1|1|1|false",
 "cook-simple-healthy-meals/s25-l3": "Cook meat and eggs all the way through.|en|1|1|1|false",
 "cook-simple-healthy-meals/s25-l4": "And reheat leftovers properly.|en|1|1|1|false",
 "cook-simple-healthy-meals/s26-l1": "Lan makes a big pot of soup in the morning.|en|1|1|1|false",
 "cook-simple-healthy-meals/s26-l2": "It's cool today. I'll leave the soup on the table.|en|1|1|1|false",
 "cook-simple-healthy-meals/s26-l3": "Back from class! Just warm it a little and eat.|en|1|1|1|false",
 "cook-simple-healthy-meals/s26-l4": "Wait a second!|en|1|1|1|false",
 "cook-simple-healthy-meals/s26-l5": "Cooked food left out all day can go bad. That night, Lan had a stomach ache.|en|1|1|1|false",
 "cook-simple-healthy-meals/s26-l6": "Let's rewind and try again.|en|1|1|1|false",
 "cook-simple-healthy-meals/s26-l7": "Into the fridge, right after I eat.|en|1|1|1|false",
 "cook-simple-healthy-meals/s26-l8": "Tonight I'll heat it until it's really hot.|en|1|1|1|false",
 "cook-simple-healthy-meals/s27-l1": "Don't leave cooked food out too long, especially on hot days.|en|1|1|1|false",
 "cook-simple-healthy-meals/s27-l2": "Strange smell, sour or slimy? Throw it away. Don't feel sorry.|en|1|1|1|false",
 "cook-simple-healthy-meals/s27-l3": "Sharing a fridge? Write your name and the cooking date on the box.|en|1|1|1|false",
 "cook-simple-healthy-meals/s27-l4": "No one takes the wrong box, and you know which one is old.|en|1|1|1|false",
 "cook-simple-healthy-meals/s28-l1": "Remember three steps.|en|1|1|1|false",
 "cook-simple-healthy-meals/s28-l2": "Cook it through.|en|1|1|1|false",
 "cook-simple-healthy-meals/s28-l3": "Store it fast.|en|1|1|1|false",
 "cook-simple-healthy-meals/s28-l4": "Heat it well.|en|1|1|1|false",
 "cook-simple-healthy-meals/s29-l1": "Stomach pain with fever, heavy vomiting, or pain that lasts?|en|1|1|1|false",
 "cook-simple-healthy-meals/s29-l2": "See a doctor. Don't try to bear it alone.|en|1|1|1|false",
 "cook-simple-healthy-meals/s30-l1": "Part six: cooking with friends.|en|1|1|1|false",
 "cook-simple-healthy-meals/s31-l1": "Two or three people cooking together usually spend less.|en|1|1|1|false",
 "cook-simple-healthy-meals/s31-l2": "You buy bigger amounts and throw away less.|en|1|1|1|false",
 "cook-simple-healthy-meals/s31-l3": "Let's share grocery money weekly. Whoever cooks, the other washes the dishes?|en|1|1|1|false",
 "cook-simple-healthy-meals/s31-l4": "Deal. Agreed from the start.|en|1|1|1|false",
 "cook-simple-healthy-meals/s31-l5": "And a shared meal makes you miss home a little less.|en|1|1|1|false",
 "cook-simple-healthy-meals/s32-l1": "Before you leave, let me teach you a few of our family dishes.|en|1|1|1|false",
 "cook-simple-healthy-meals/s32-l2": "Parents can also send some dry food that keeps.|en|1|1|1|false",
 "cook-simple-healthy-meals/s32-l3": "Then just remind them to eat enough. Calling about every meal feels like being watched.|en|1|1|1|false",
 "cook-simple-healthy-meals/s33-l1": "Ask before you buy, and start small.|en|1|1|1|false",
 "cook-simple-healthy-meals/s33-l2": "Shop with a list. Half your plate is vegetables.|en|1|1|1|false",
 "cook-simple-healthy-meals/s33-l3": "Cook it through, store it fast, heat it well.|en|1|1|1|false",
 "cook-simple-healthy-meals/s34-l1": "You bought leafy greens, eggs and pumpkin on Sunday, what should you eat first?|en|1|1|1|false",
 "cook-simple-healthy-meals/s34-l2": "The leafy greens, because they wilt quickly while eggs and pumpkin keep longer.|en|1|1|1|false",
 "cook-simple-healthy-meals/s34-l3": "Eat them in the wrong order, and you throw away wilted greens at the weekend.|en|1|1|1|false",
 "cook-simple-healthy-meals/s35-l1": "Your leftover soup smells a little sour, what should you do?|en|1|1|1|false",
 "cook-simple-healthy-meals/s35-l2": "Throw it away, because a strange smell often means the food has gone bad.|en|1|1|1|false",
 "cook-simple-healthy-meals/s35-l3": "Boiling again may not make it safe. A bowl of soup costs less than a stomach ache.|en|1|1|1|false",
 "cook-simple-healthy-meals/s36-l1": "Tonight, write your menu for the next five days, and your shopping list.|en|1|1|1|false",
 "cook-simple-healthy-meals/s36-l2": "Then try the forty questions below.|en|1|1|1|false",
 "correlation-vs-causation/s01-l1": "Two orders went to the wrong customers this week, the week a new worker started.|en|1|1|1|false",
 "correlation-vs-causation/s01-l2": "It must be the new boy. I'll let him go.|en|1|1|1|false",
 "correlation-vs-causation/s02-l1": "The mistakes started when Dũng arrived. Does that make him the cause? Not necessarily. Maybe:|en|1|1|1|false",
 "correlation-vs-causation/s02-l2": "A third factor.|en|1|1|1|false",
 "correlation-vs-causation/s02-l3": "The cause runs the other way.|en|1|1|1|false",
 "correlation-vs-causation/s02-l4": "Or it's just a coincidence.|en|1|1|1|false",
 "correlation-vs-causation/s03-l1": "From a headline or a personal story, all the way to checking the cause yourself.|en|1|1|1|false",
 "correlation-vs-causation/s03-l2": "Seven stops, one simple habit: slow down before you conclude.|en|1|1|1|false",
 "correlation-vs-causation/s04-l1": "Part one: what's the difference?|en|1|1|1|false",
 "correlation-vs-causation/s05-l1": "Correlation: two things change together. Both rise, or one rises while the other falls.|en|1|1|1|false",
 "correlation-vs-causation/s05-l2": "Causation: one thing really causes the other.|en|1|1|1|false",
 "correlation-vs-causation/s05-l3": "Seeing two things together is a reason to look further. Not the final answer.|en|1|1|1|false",
 "correlation-vs-causation/s06-l1": "Part two: why things can go together without causing each other.|en|1|1|1|false",
 "correlation-vs-causation/s07-l1": "A third factor: in summer, ice cream sales and drownings both rise.|en|1|1|1|false",
 "correlation-vs-causation/s07-l2": "Ice cream doesn't cause drowning. Hot weather makes people eat ice cream and swim more.|en|1|1|1|false",
 "correlation-vs-causation/s07-l3": "Reverse cause: heavy coffee drinkers work long hours. Maybe the long hours make them drink coffee.|en|1|1|1|false",
 "correlation-vs-causation/s07-l4": "Coincidence: any two numbers can rise together for a few months. Less data, more chance of coincidence.|en|1|1|1|false",
 "correlation-vs-causation/s08-l1": "A headline: People who take long naps have worse health. So long naps are harmful?|en|1|1|1|false",
 "correlation-vs-causation/s08-l2": "Such articles usually just record two things together, not which causes which.|en|1|1|1|false",
 "correlation-vs-causation/s08b-l1": "The other way is just as likely: sick people get tired, so they nap longer.|en|1|1|1|false",
 "correlation-vs-causation/s08b-l2": "Drop your nap because of the headline, and you may just feel exhausted every afternoon.|en|1|1|1|false",
 "correlation-vs-causation/s09-l1": "See A causes B? Ask: or does B cause A?|en|1|1|1|false",
 "correlation-vs-causation/s10-l1": "Part three: I tried it, and I got better.|en|1|1|1|false",
 "correlation-vs-causation/s11-l1": "One person's story is easy to remember and easy to believe.|en|1|1|1|false",
 "correlation-vs-causation/s11-l2": "But it doesn't tell you what would happen without it.|en|1|1|1|false",
 "correlation-vs-causation/s11-l3": "Many mild illnesses get better on their own after a while, whatever you drink.|en|1|1|1|false",
 "correlation-vs-causation/s12-l1": "Thảo had a cold. She drank a herbal drink from a friend, and got better in about a week.|en|1|1|1|false",
 "correlation-vs-causation/s12-l2": "Drink this and your cold is gone! Just ask if you need some.|en|1|1|1|false",
 "correlation-vs-causation/s12-l3": "Wait a second!|en|1|1|1|false",
 "correlation-vs-causation/s12-l4": "Most common colds get better on their own in seven to ten days.|en|1|1|1|false",
 "correlation-vs-causation/s12-l5": "Let's rewind. Last time you didn't drink it, how long did it take?|en|1|1|1|false",
 "correlation-vs-causation/s12-l6": "Hmm… about the same number of days.|en|1|1|1|false",
 "correlation-vs-causation/s13-l1": "Getting better after drinking it doesn't mean getting better because of it.|en|1|1|1|false",
 "correlation-vs-causation/s13-l2": "Really worried about your health? Ask a doctor or pharmacist, not the group chat.|en|1|1|1|false",
 "correlation-vs-causation/s14-l1": "Part four: is one success story enough to copy?|en|1|1|1|false",
 "correlation-vs-causation/s15-l1": "Not enough. One case doesn't show what else happened at the same time.|en|1|1|1|false",
 "correlation-vs-causation/s15-l2": "Look wider: what about people who didn't do it? And what else changed?|en|1|1|1|false",
 "correlation-vs-causation/s16-l1": "The neighbour's child took extra classes at a centre, and their marks went up clearly.|en|1|1|1|false",
 "correlation-vs-causation/s16-l2": "Should you pay for a full course for your own child right away?|en|1|1|1|false",
 "correlation-vs-causation/s17-l1": "Not yet. That term, the child also got a new seat…|en|1|1|1|false",
 "correlation-vs-causation/s17-l2": "…extra help from the homeroom teacher, and motivation from coming exams.|en|1|1|1|false",
 "correlation-vs-causation/s17-l3": "At least three other changes, so nobody knows how much the centre helped.|en|1|1|1|false",
 "correlation-vs-causation/s17-l4": "Ask other parents, or try a short trial and compare marks. One success isn't evidence.|en|1|1|1|false",
 "correlation-vs-causation/s18-l1": "Part five: blaming whoever was there.|en|1|1|1|false",
 "correlation-vs-causation/s19-l1": "We often blame the person or thing right before a problem.|en|1|1|1|false",
 "correlation-vs-causation/s19-l2": "Ask: did it happen on other shifts, with other people, at other times?|en|1|1|1|false",
 "correlation-vs-causation/s20-l1": "Back to the shop. Bác Bình checks his records.|en|1|1|1|false",
 "correlation-vs-causation/s20-l2": "Last week there were wrong orders too. The labels were faded from a broken printer roll.|en|1|1|1|false",
 "correlation-vs-causation/s20-l3": "A new roll, no more wrong orders. And Dũng keeps his job.|en|1|1|1|false",
 "correlation-vs-causation/s20-l4": "Being there when it happened doesn't make you the cause.|en|1|1|1|false",
 "correlation-vs-causation/s21-l1": "Part six: checking a cause yourself.|en|1|1|1|false",
 "correlation-vs-causation/s22-l1": "Write the claim clearly: A causes B.|en|1|1|1|false",
 "correlation-vs-causation/s22-l2": "Did B change after A, or before it?|en|1|1|1|false",
 "correlation-vs-causation/s22-l3": "What else changed then: weather, holidays, a sale, a new person? Could B cause A?|en|1|1|1|false",
 "correlation-vs-causation/s22-l4": "Where there's no A, does B change the same way? Have you watched long enough?|en|1|1|1|false",
 "correlation-vs-causation/s23-l1": "The strongest way is a comparison group. Change one place, keep a similar place the same, then compare.|en|1|1|1|false",
 "correlation-vs-causation/s23-l2": "Without a comparison, it's hard to separate the real effect from other factors.|en|1|1|1|false",
 "correlation-vs-causation/s23-l3": "And be careful asking the side that benefits. A seller or a tutoring centre isn't neutral.|en|1|1|1|false",
 "correlation-vs-causation/s24-l1": "Part seven: stating a cause at the right strength.|en|1|1|1|false",
 "correlation-vs-causation/s25-l1": "When evidence isn't enough, use careful words: may be related, early results suggest, needs more follow-up.|en|1|1|1|false",
 "correlation-vs-causation/s25-l2": "Only say definitely caused by when you've ruled out the other possibilities.|en|1|1|1|false",
 "correlation-vs-causation/s26-l1": "Reading A helps B in a headline? Look inside for related, goes with, or causes.|en|1|1|1|false",
 "correlation-vs-causation/s26-l2": "Many articles only report a link, but the headline is written like a cause.|en|1|1|1|false",
 "correlation-vs-causation/s27-l1": "What might happen if you stop napping just because of that headline?|en|1|1|1|false",
 "correlation-vs-causation/s27-l2": "You may feel very tired every afternoon while your health does not improve.|en|1|1|1|false",
 "correlation-vs-causation/s27-l3": "That's the cost of trusting a headline without reading closely.|en|1|1|1|false",
 "correlation-vs-causation/s28-l1": "Or the other way around?|en|1|1|1|false",
 "correlation-vs-causation/s28-l2": "What else changed?|en|1|1|1|false",
 "correlation-vs-causation/s28-l3": "And what if we didn't do it? Today, find one A helps B headline, and look for a third factor.|en|1|1|1|false",
 "correlation-vs-causation/s29-l1": "Before you conclude, try the forty questions below.|en|1|1|1|false",
 "decide-when-team-disagrees/s01-l1": "I think we should go with way B.|en|1|1|1|false",
 "decide-when-team-disagrees/s01-l2": "No, way A is better.|en|1|1|1|false",
 "decide-when-team-disagrees/s01-l3": "Hmm. Let me think about it more.|en|1|1|1|false",
 "decide-when-team-disagrees/s01-l4": "One week passes. Then two. What happens next? You will see later.|en|1|1|1|false",
 "decide-when-team-disagrees/s02-l1": "The team disagrees, and everyone looks at you. How do you decide?|en|1|1|1|false",
 "decide-when-team-disagrees/s02-l2": "Say who decides, and how.|en|1|1|1|false",
 "decide-when-team-disagrees/s02-l3": "Hear every opinion.|en|1|1|1|false",
 "decide-when-team-disagrees/s02-l4": "Compare with shared criteria.|en|1|1|1|false",
 "decide-when-team-disagrees/s02-l5": "Decide clearly, and set a review date.|en|1|1|1|false",
 "decide-when-team-disagrees/s03-l1": "Who decides, and how.|en|1|1|1|false",
 "decide-when-team-disagrees/s03-l2": "Hearing real opinions.|en|1|1|1|false",
 "decide-when-team-disagrees/s03-l3": "Comparing fairly.|en|1|1|1|false",
 "decide-when-team-disagrees/s03-l4": "Deciding, and the person who lost.|en|1|1|1|false",
 "decide-when-team-disagrees/s03-l5": "And if you were wrong.|en|1|1|1|false",
 "decide-when-team-disagrees/s04-l1": "Part one: who decides, and how.|en|1|1|1|false",
 "decide-when-team-disagrees/s05-l1": "Before the talk, say how it will be decided: you listen and decide, the team votes, or the boss decides.|en|1|1|1|false",
 "decide-when-team-disagrees/s05-l2": "People accept the result more easily when they know the rules first.|en|1|1|1|false",
 "decide-when-team-disagrees/s06-l1": "I want to hear all views until Wednesday. Then I will decide, and explain why.|en|1|1|1|false",
 "decide-when-team-disagrees/s06-l2": "Okay, that is clear.|en|1|1|1|false",
 "decide-when-team-disagrees/s07-l1": "Not every choice needs the whole team. Ask: if we are wrong, is it easy to fix?|en|1|1|1|false",
 "decide-when-team-disagrees/s07-l2": "Folder names take minutes to change. Suggest one way: “Any problem, tell me before Friday.” Then use it.|en|1|1|1|false",
 "decide-when-team-disagrees/s07-l3": "Easy to fix, decide fast. Hard to fix, discuss carefully.|en|1|1|1|false",
 "decide-when-team-disagrees/s08-l1": "Part two: how to hear what people really think.|en|1|1|1|false",
 "decide-when-team-disagrees/s09-l1": "A leader opens with her own idea, very sure. Everyone nods. The meeting ends early.|en|1|1|1|false",
 "decide-when-team-disagrees/s09-l2": "A week later, the plan hits a problem. One member saw it: “But you had already said it.”|en|1|1|1|false",
 "decide-when-team-disagrees/s09-l3": "When the leader speaks last, the team dares to speak honestly.|en|1|1|1|false",
 "decide-when-team-disagrees/s10-l1": "Invite quiet people first, gently, by name. You speak last.|en|1|1|1|false",
 "decide-when-team-disagrees/s10-l2": "Or ask everyone to write views in a shared document first, so loud voices do not cover the rest.|en|1|1|1|false",
 "decide-when-team-disagrees/s11-l1": "What is the biggest risk of this option?|en|1|1|1|false",
 "decide-when-team-disagrees/s11-l2": "And what would change your mind?|en|1|1|1|false",
 "decide-when-team-disagrees/s11-l3": "Good question. Let me think.|en|1|1|1|false",
 "decide-when-team-disagrees/s11-l4": "These questions move the talk to reasons, not to who wins.|en|1|1|1|false",
 "decide-when-team-disagrees/s12-l1": "Separate the idea from the person. Not “Your idea is not good.”|en|1|1|1|false",
 "decide-when-team-disagrees/s12-l2": "But “Option A has a weak point in cost.” Attack people, and they stop sharing.|en|1|1|1|false",
 "decide-when-team-disagrees/s13-l1": "Part three: comparing options fairly.|en|1|1|1|false",
 "decide-when-team-disagrees/s14-l1": "Agree on criteria first: time, cost, risk, and the effect on the client.|en|1|1|1|false",
 "decide-when-team-disagrees/s14-l2": "The talk moves from “I like it” to “which one meets them better”. Even if your own idea loses.|en|1|1|1|false",
 "decide-when-team-disagrees/s15-l1": "For each option: strengths, weaknesses, the biggest risk, and can we go back if wrong?|en|1|1|1|false",
 "decide-when-team-disagrees/s16-l1": "Way A: a quick show of hands. The attractive option wins, then breaks the budget.|en|1|1|1|false",
 "decide-when-team-disagrees/s16-l2": "Way B: criteria on the board first. The over-budget option is out at once.|en|1|1|1|false",
 "decide-when-team-disagrees/s16b-l1": "Popular is not always right. Vote only when every option is acceptable.|en|1|1|1|false",
 "decide-when-team-disagrees/s16b-l2": "Set the criteria first, and count the hands after.|en|1|1|1|false",
 "decide-when-team-disagrees/s17-l1": "Part four: back to Thao. Two weeks later.|en|1|1|1|false",
 "decide-when-team-disagrees/s18-l1": "So, way A or way B?|en|1|1|1|false",
 "decide-when-team-disagrees/s18-l2": "Let me think about it a bit more.|en|1|1|1|false",
 "decide-when-team-disagrees/s18-l3": "Wait a second!|en|1|1|1|false",
 "decide-when-team-disagrees/s18-l4": "Near the deadline, the manager had to decide. Nobody was happy. Not choosing is also a choice, the latest one.|en|1|1|1|false",
 "decide-when-team-disagrees/s18-l5": "Let's rewind and try again.|en|1|1|1|false",
 "decide-when-team-disagrees/s18-l6": "We compared both with our criteria. We choose way B, because it costs less.|en|1|1|1|false",
 "decide-when-team-disagrees/s18-l7": "I will send who does what, and we review in two weeks.|en|1|1|1|false",
 "decide-when-team-disagrees/s18-l8": "Okay. Clear.|en|1|1|1|false",
 "decide-when-team-disagrees/s19-l1": "Decision: way B, because it costs less.|en|1|1|1|false",
 "decide-when-team-disagrees/s19-l2": "Lan leads the preparation, Dung handles logistics. We review in two weeks.|en|1|1|1|false",
 "decide-when-team-disagrees/s19-l3": "What was decided, why, who does what, when to review. In writing, so nobody understands it differently.|en|1|1|1|false",
 "decide-when-team-disagrees/s20-l1": "Then talk privately with the person whose idea was not chosen.|en|1|1|1|false",
 "decide-when-team-disagrees/s20-l2": "Your idea showed me the time risk. This time we chose way B because it costs less.|en|1|1|1|false",
 "decide-when-team-disagrees/s20-l3": "And I will watch the exact risk you raised.|en|1|1|1|false",
 "decide-when-team-disagrees/s20-l4": "Okay. I am in.|en|1|1|1|false",
 "decide-when-team-disagrees/s21-l1": "Disagree, and still commit. Once decided, everyone works fully on it.|en|1|1|1|false",
 "decide-when-team-disagrees/s21-l2": "Still worried? Say it to the leader directly, not behind backs. Hear a hallway complaint? Invite them to tell you.|en|1|1|1|false",
 "decide-when-team-disagrees/s22-l1": "Last part: what if you decided wrong?|en|1|1|1|false",
 "decide-when-team-disagrees/s23-l1": "Set the review date in advance, for example in two weeks.|en|1|1|1|false",
 "decide-when-team-disagrees/s23-l2": "See signs it is wrong? Change early, while the cost is small. It is planned work, not shame.|en|1|1|1|false",
 "decide-when-team-disagrees/s24-l1": "I chose this way, and it did not work as well as I thought. From next week, we switch.|en|1|1|1|false",
 "decide-when-team-disagrees/s24-l2": "Thanks for saying it clearly.|en|1|1|1|false",
 "decide-when-team-disagrees/s24-l3": "Take responsibility. Do not blame the person who suggested it. The team trusts you more.|en|1|1|1|false",
 "decide-when-team-disagrees/s25-l1": "A leader who changes a decision loses respect. True or false?|en|1|1|1|false",
 "decide-when-team-disagrees/s25-l2": "False. The team saw the problem early. They watch what you do about it.|en|1|1|1|false",
 "decide-when-team-disagrees/s25-l3": "Holding on to a failing plan slows the project and loses trust.|en|1|1|1|false",
 "decide-when-team-disagrees/s25-l4": "Admit a mistake early and you keep respect. Being stubborn loses it.|en|1|1|1|false",
 "decide-when-team-disagrees/s26-l1": "A big budget, or other teams affected? Take it to your manager, with the options and the team's suggestion.|en|1|1|1|false",
 "decide-when-team-disagrees/s26-l2": "Not avoiding: the right decision, to the right person.|en|1|1|1|false",
 "decide-when-team-disagrees/s27-l1": "Say who decides. Small things fast. Quiet voices first. Agree on criteria.|en|1|1|1|false",
 "decide-when-team-disagrees/s27-l2": "Decide with reasons. Talk privately with the one who lost. Review, and fix early.|en|1|1|1|false",
 "decide-when-team-disagrees/s28-l1": "A good decision is not one everyone likes. It is one everyone understands, and works on together.|en|1|1|1|false",
 "decide-when-team-disagrees/s28-l2": "For the choice your team is discussing now: say who decides, by which criteria, and by when.|en|1|1|1|false",
 "decide-when-team-disagrees/s29-l1": "Which saying sums up the right order for comparing options?|en|1|1|1|false",
 "decide-when-team-disagrees/s29-l2": "Set the criteria first, and only count the raised hands after that.|en|1|1|1|false",
 "decide-when-team-disagrees/s29-l3": "Votes cannot replace criteria.|en|1|1|1|false",
 "decide-when-team-disagrees/s30-l1": "You finished the series! Forty questions are waiting.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s01-l1": "Can you make the customer summary for me?|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s01-l2": "Sure!|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s01-l3": "Dung guesses. Three days later, he sends a very long table.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s01-l4": "Oh. This is not what I needed.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s01-l5": "Three days of work. Where did it go wrong?|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s02-l1": "How do you give work away, without doing it all or watching every hour?|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s02-l2": "Choose the right task.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s02-l3": "Make the goal clear.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s02-l4": "Set a day to check.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s02-l5": "And never redo it in silence.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s03-l1": "What to give away.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s03-l2": "How to give it clearly.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s03-l3": "Who should get it.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s03-l4": "How to follow up.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s03-l5": "And what to do after.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s04-l1": "Part one: what to give away.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s05-l1": "The first time, giving a task away is slower. You explain, you wait, you give feedback.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s05-l2": "But by the third or fourth time, they can do it. And you have time for leader work.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s06-l1": "Give away tasks that repeat, tasks others can learn, and tasks that help them grow.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s06-l2": "Keep the work that needs the leader, like reviewing members or a sensitive personal matter.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s06-l3": "For client work, make sure at least two people know where the files are, and what was promised.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s07-l1": "Lan handles every client contact alone, because she knows it best.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s07-l2": "Then she is sick for almost a week. Nobody knows where the files are, or what she promised.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s07-l3": "The client complains to the boss. One person holds everything, and the whole team hangs.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s09-l1": "Part two: how to make the goal clear.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s10-l1": "Can you make the customer summary for me?|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s10-l2": "Wait a second!|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s10-l3": "What does it look like? What is it for? When is it due? Dung has to guess.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s10-l4": "Let's rewind and try again.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s10-l5": "One page, three points: new customers, lost customers, and why.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s10-l6": "It is for the boss on Friday morning. Send it to me Thursday afternoon.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s10-l7": "Got it. One page by Thursday.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s10-l8": "Show the target clearly, and nobody runs down the wrong road.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s11-l1": "A clear task has five boxes: the result, the deadline, and why it matters.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s11-l2": "Then who can help, where the files are, and when you check together.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s11-l3": "Knowing why helps them choose well when something is unclear. Miss a box, and they guess.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s12-l1": "With an experienced person, give the result and let them choose the method.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s12-l2": "With a new person, show the steps more clearly, and share a sample from before.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s13-l1": "Can you sum it up in your own words? I want to check that I was clear.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s13-l2": "One page, three points, to you by Thursday afternoon.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s13-l3": "This checks your instructions, not their memory. And it is before any time is wasted.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s14-l1": "Words in the hallway are easy to forget.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s14-l2": "Dung: customer summary, one page, to me Thursday afternoon.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s14-l3": "Okay, I have got it.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s14-l4": "Who, what, by when, in the team chat. Now you both see the same words.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s15-l1": "Part three: who should get the task?|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s16-l1": "What tasks do you have this week? Can you fit this one in?|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s16-l2": "Thanks for asking. I can start it on Wednesday.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s16-l3": "Weigh two things: their skills now, and how much work they already have.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s17-l1": "Only easy tasks: a good person gets bored. Too big, no support: they lose confidence.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s17-l2": "Want to grow? A little above their level, with support.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s18-l1": "Every hard task to your most reliable person? They overload in silence, and others never grow.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s18-l2": "Silence does not mean fine. Ask about their load.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s19-l1": "Part four: follow up without hovering.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s20-l1": "Let's look at the draft on Tuesday.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s20-l2": "Great. Tuesday it is.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s20-l3": "Set the check date as you give the task. No more “done yet?” every day, and they know when it will be seen.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s21-l1": "When you ask about progress, ask about problems, not mistakes.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s21-l2": "Not “Why is this not done yet?” That sounds like blame, so people hide problems.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s21-l3": "Instead: “Is there anything I can help with?”|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s22-l2": "New person or new task: check earlier and more often. Experienced: let them report.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s22-l3": "Following closely is not bad. Following everyone the same way is the problem.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s23-a1": "Morning check: is it done yet? I fixed a few words in the file.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s23-a2": "You should just do it yourself, it will be faster.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s23-b1": "Let's check the draft twice: Tuesday and Thursday.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s23-b2": "Okay. I will ask if I get stuck.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s23-l1": "Between the dates, only answer when asked. You still give feedback, and they feel trusted.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s23-l2": "Set a clear day to check, and you will not need to ask hourly.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s25-l1": "Last part: when the result is weak, and when the work is done.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s26-l1": "The result is wrong, so the person is weak. True or false?|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s26-l2": "Often false. First ask: were my instructions clear? Fix that, and the mistake stops.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s27-l1": "Here is the design for the client.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s27-l2": "It is not good enough. I will fix it all myself tonight and send it.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s27-l3": "Wait a second!|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s27-l4": "Tomorrow he sees his work replaced, and nobody said a word. Next time, he will make the same mistake.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s27-l5": "Let's rewind and try again.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s27-l6": "Let's sit together. The colours miss what we agreed. Can you fix them?|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s27-l7": "I see it now. I will fix it before five.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s27-l8": "Redo it in silence, and the person will give up.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s28-l1": "No time at all tonight. I must change it myself, so I will tell him.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s28-l2": "It was urgent last night, so I changed the colours. Let's look at it together tomorrow.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s28-l3": "Okay, see you tomorrow.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s28-l4": "Say openly what you changed and why, then talk it through.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s29-l2": "Your summary was short and on point. The boss approved it right away.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s29-l3": "Thank you! I will keep it short next time too.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s29-l4": "Better than a quick “okay”: they know what to keep doing, and their effort was seen.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s30-l1": "Ask: “Next time, is there anything I should explain more clearly?”|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s30-l2": "Your instructions get better after every task.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s30-l3": "When you report to your manager, name the person who did the work.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s30-l4": "People who get credit are more willing to take harder tasks next time.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s31-l2": "Show the target, set a day to check, and let them fix their own work.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s31-l3": "This week, give away one task you are holding, with the five boxes.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s32-l1": "Which way of following up keeps the leader informed without hovering?|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s32-l2": "Set two clear check dates for drafts and trust the team between those dates.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s32-l3": "Two clear dates give you time for feedback, without standing behind anyone.|en|1|1|1|false",
 "delegate-clearly-and-follow-up/s33-l1": "Your turn. Forty questions are waiting below.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s01-l1": "Orders this month fell by almost half. Thao has to tell her boss.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s01-l2": "I don't want her to worry. I'll just say orders dropped a little.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s01-l3": "Next week, accounting sends the full report. What happens then? What would you do?|en|1|1|1|false",
 "deliver-bad-news-to-boss/s02-l1": "Bosses rarely lose trust over bad news. They lose trust when it comes|en|1|1|1|false",
 "deliver-bad-news-to-boss/s02-l2": "too late,|en|1|1|1|false",
 "deliver-bad-news-to-boss/s02-l3": "from someone else,|en|1|1|1|false",
 "deliver-bad-news-to-boss/s02-l4": "or with no plan to fix it.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s03-l1": "Seven stops: tell it early, prepare, and pick how to tell it.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s03-l2": "Open clearly. Own your mistakes. Bring options.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s03-l3": "Handle a heated boss, and follow up after.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s04-l1": "Part one: tell it now, or after you fix it?|en|1|1|1|false",
 "deliver-bad-news-to-boss/s05-l1": "Tell your boss as soon as you're sure the problem is real and will hit deadlines, costs, or customers.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s05-l2": "Don't wait until you have every answer. Bad news is like a crack.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s05-l3": "Early, your boss can move dates, add people, or warn the customer.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s05-l4": "Late, the only choice left is to live with the result.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s06-l1": "Not sure yet? You can still send an early signal.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s06-l2": "Testing looks a bit slow. I'm checking, and I'll update you this afternoon.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s06-l3": "Your boss isn't surprised, and doesn't panic.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s07-l0": "In the first week of the month, Dung finds a partner is late.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s07-a1": "I'll sort it out myself first, then tell my boss.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s07-a2": "Two weeks later, the boss hears it from the customer on a call, and can't answer anything.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s07-a3": "What upset her most: being surprised in front of the customer.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s07-b1": "The partner is about a week late on the design. I'm on it. I'll update you on Friday.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s07-b2": "When the customer calls, the boss already knows and answers at once.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s08-l1": "Bad news never shrinks by itself. Telling it late makes it bigger.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s09-l1": "Part two: what to prepare, and how to tell it.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s10-l1": "Prepare five things. What happened, in one sentence.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s10-l2": "The impact: deadline, cost, customers. And the cause you know so far.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s10-l3": "Two or three ways to fix it, and what you need your boss to decide or help with.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s11-l1": "Separate what is sure from what you are guessing.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s11-l2": "Two days late for sure. More delay is possible, and I'm checking.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s11-l4": "No perfect solution yet? Go anyway. Your boss wants to see your thinking.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s12-l0": "Thao finds that a price quote sent to a customer was wrong.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s12-l1": "Well, yesterday the software crashed, a colleague was on leave, and the customer changed the request…|en|1|1|1|false",
 "deliver-bad-news-to-boss/s12-l2": "Wait a second!|en|1|1|1|false",
 "deliver-bad-news-to-boss/s12-l3": "Ten minutes in, your boss still doesn't know what happened.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s12-l4": "Let's rewind and try again.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s12-l5": "Yesterday's quote to the customer was wrong. I suggest sending a corrected one this morning.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s12-l6": "I can explain the cause if you need.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s12-l7": "The problem and the fix in one breath. Reasons come after.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s13-l1": "Serious news: face to face, or call. Your boss can ask right away.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s13-l2": "Texts get read in a hurry, misread, or lost among other messages.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s13-l3": "Boss busy? One line: I need to report something about the customer contract.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s13-l4": "Could you give me five minutes today? Not the whole story yet.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s14-l1": "Share bad news for the first time in a big meeting. True or false?|en|1|1|1|false",
 "deliver-bad-news-to-boss/s14-l2": "False. Tell your boss in private first, so they're ready when others ask.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s15-l1": "Part three: open without going around in circles.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s16-l1": "Go straight in. Three sentences.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s16-l2": "I have some bad news about project A. The delivery will be three days late.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s16-l3": "I suggest two ways to fix it. Please help me choose.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s17-l1": "Avoid a long soft start: well, it's nothing very serious…|en|1|1|1|false",
 "deliver-bad-news-to-boss/s17-l2": "Your boss gets impatient, and the bad news sounds even worse.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s17-l3": "And don't call a week's delay “a little off”. When the truth comes out, you lose trust.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s18-l1": "Back to Thao. Orders fell by half. Saying 'a small drop' is fine. True or false?|en|1|1|1|false",
 "deliver-bad-news-to-boss/s18-l2": "False. The accounting report shows the truth, and the boss doubts her other reports too.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s18-l3": "The drop may not be her fault. Making it sound lighter is.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s18-l4": "Say the real drop, and what you know of the cause. Soft voice, not soft facts.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s19-l1": "Part four: what if the mistake is yours?|en|1|1|1|false",
 "deliver-bad-news-to-boss/s20-l1": "I'm so sorry, I'm really, really sorry…|en|1|1|1|false",
 "deliver-bad-news-to-boss/s20-l2": "But the design team was careless, and the software…|en|1|1|1|false",
 "deliver-bad-news-to-boss/s20-l3": "Wait a second!|en|1|1|1|false",
 "deliver-bad-news-to-boss/s20-l4": "A short, clear apology earns more respect. And don't blame others.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s20-l5": "Let's rewind and try again.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s20-l6": "I made a mistake in this part. That's on me.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s20-l7": "From now on, I'll add a step: someone checks it before I send.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s20-l8": "After a mistake, how you'll avoid it again is what your boss wants most.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s21-l1": "Someone else involved? Describe what happened. Don't judge.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s21-l2": "Not: the design team was careless. But: they sent the files two days late.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s22-l1": "Part five: options that make deciding easy.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s23a-l1": "Give two or three options. For each, say what you gain and what you lose.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s23a-l2": "Finding the root and building options is in the lesson on reporting a problem and a solution to your boss.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s23-l2": "To keep the deadline, we drop the extra report.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s23-l3": "To keep all the content, we need three more days.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s23-l4": "Now your boss sees the trade-off.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s24-l1": "Each option and its cost.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s24-l2": "Which one you prefer, and why. Your boss still decides, but faster.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s24-l3": "When the decision is needed by, and who must be told next.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s25-l1": "Part six: when your boss reacts strongly.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s26-l1": "Your boss getting upset is normal. Bad news breaks their plans too.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s26-l2": "Let them finish. Don't interrupt or argue right away.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s27-l0": "A supplier delivered too few goods. Thao tells her boss.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s27-a1": "Why didn't you check earlier?|en|1|1|1|false",
 "deliver-bad-news-to-boss/s27-a2": "That's not my job!|en|1|1|1|false",
 "deliver-bad-news-to-boss/s27-a3": "It turns into who's right. At the end, nobody has discussed replacing the goods.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s27-b1": "Why didn't you check earlier?|en|1|1|1|false",
 "deliver-bad-news-to-boss/s27-b2": "I understand you're worried about the customer.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s27-b3": "The most urgent thing is to tell the customer this afternoon. Should I call, or will you?|en|1|1|1|false",
 "deliver-bad-news-to-boss/s28-l1": "Too tense? Step back, with a set time: I'll check the numbers and come back at three.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s28-l2": "Stepping back is for a better talk, not for hiding.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s29-l1": "When your boss heats up, slow down, and go back to what needs doing.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s30-l1": "Last part: what comes after you tell it?|en|1|1|1|false",
 "deliver-bad-news-to-boss/s31-l1": "Right after the talk, send a summary: the plan, who does what, by when.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s31-l2": "Delivery moves to Friday. I'll tell the customer this morning, and update you Wednesday afternoon.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s31-l3": "Then update on time, even when there's nothing new. Your boss shouldn't have to ask.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s32-l1": "When it's all done, look back for a moment.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s32-l2": "Could I have seen the signs earlier, and told it sooner? That answer keeps you calmer next time.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s33-l1": "You don't need great courage, just a clear frame.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s33-l2": "Something not going well? Write three opening lines and ask your boss for five minutes today.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s34-l1": "Your boss raises their voice after hearing the bad news, what should you do first?|en|1|1|1|false",
 "deliver-bad-news-to-boss/s34-l2": "Let your boss finish speaking without interrupting, because frustration is a normal reaction.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s34-l3": "Letting your boss finish calms things down. Interrupting to argue makes it worse.|en|1|1|1|false",
 "deliver-bad-news-to-boss/s35-l1": "Your turn. Forty questions are waiting below.|en|1|1|1|false",
 "end-of-probation-review/s01-l1": "You do the right work, Thao. But you are often quiet in meetings.|en|1|1|1|false",
 "end-of-probation-review/s01-l2": "We have not heard your ideas yet.|en|1|1|1|false",
 "end-of-probation-review/s01-l3": "Oh. I thought everything was fine.|en|1|1|1|false",
 "end-of-probation-review/s01-l4": "Probation is over, and this goes on her form. What did Thao miss?|en|1|1|1|false",
 "end-of-probation-review/s02-l1": "Will they keep you? Do not guess. A review is a talk you can prepare.|en|1|1|1|false",
 "end-of-probation-review/s02-l2": "Know the criteria early.|en|1|1|1|false",
 "end-of-probation-review/s02-l3": "Collect proof of your work.|en|1|1|1|false",
 "end-of-probation-review/s02-l4": "Assess yourself honestly.|en|1|1|1|false",
 "end-of-probation-review/s02-l5": "And ask clearly about the contract.|en|1|1|1|false",
 "end-of-probation-review/s03-l1": "Six stops, from what reviewers look at to what to do if it goes badly.|en|1|1|1|false",
 "end-of-probation-review/s04-l1": "Part one: what is the review, and what do they look at?|en|1|1|1|false",
 "end-of-probation-review/s05-l1": "Your manager, sometimes with HR, looks back at your probation.|en|1|1|1|false",
 "end-of-probation-review/s05-l2": "Then they decide: official contract, or not.|en|1|1|1|false",
 "end-of-probation-review/s05-l3": "Each place does it differently: a meeting, a self review form first, or just a result. Find out early.|en|1|1|1|false",
 "end-of-probation-review/s06-l1": "Ask about the criteria as early as you can. Month one is ideal.|en|1|1|1|false",
 "end-of-probation-review/s06-l2": "May I ask what I will be judged on at the end of probation?|en|1|1|1|false",
 "end-of-probation-review/s06-l3": "Know the goal, and you go the right way. Otherwise, you may work hard on the wrong things.|en|1|1|1|false",
 "end-of-probation-review/s07-l1": "Reviewers usually look at four things. The results of your tasks.|en|1|1|1|false",
 "end-of-probation-review/s07-l2": "How you work with colleagues.|en|1|1|1|false",
 "end-of-probation-review/s07-l3": "How you improve after feedback.|en|1|1|1|false",
 "end-of-probation-review/s07-l4": "And whether you are reliable: on time, and quick to warn about problems.|en|1|1|1|false",
 "end-of-probation-review/s08-l1": "Part two: prepare weeks before. Now, back to Thao.|en|1|1|1|false",
 "end-of-probation-review/s09-l1": "The middle of Thao's probation.|en|1|1|1|false",
 "end-of-probation-review/s09-l2": "She rarely corrects me, so I must be fine. No need to ask.|en|1|1|1|false",
 "end-of-probation-review/s09-l3": "Wait a second!|en|1|1|1|false",
 "end-of-probation-review/s09-l4": "Speaking up in meetings can be practised, if you know a month earlier.|en|1|1|1|false",
 "end-of-probation-review/s09-l5": "Let's rewind and try another way.|en|1|1|1|false",
 "end-of-probation-review/s09-l6": "Where am I doing well, and where should I try harder, so I can fix it before the review?|en|1|1|1|false",
 "end-of-probation-review/s09-l7": "Try to share your ideas in meetings.|en|1|1|1|false",
 "end-of-probation-review/s09-l8": "Ask halfway, and there are no surprises at the end.|en|1|1|1|false",
 "end-of-probation-review/s10-l1": "Do not wait until the night before to remember everything. Memory fades.|en|1|1|1|false",
 "end-of-probation-review/s10-l2": "Keep a file called Work done. Each week, add a few lines: what you did, the result, and who said what.|en|1|1|1|false",
 "end-of-probation-review/s11-l1": "Prepare five things. Finished tasks, with clear results.|en|1|1|1|false",
 "end-of-probation-review/s11-l2": "Feedback you got, and how you fixed it.|en|1|1|1|false",
 "end-of-probation-review/s11-l3": "One or two things you did best.|en|1|1|1|false",
 "end-of-probation-review/s11-l4": "One or two points to improve.|en|1|1|1|false",
 "end-of-probation-review/s11-l5": "And questions about the next stage.|en|1|1|1|false",
 "end-of-probation-review/s12-l1": "Part three: your self review.|en|1|1|1|false",
 "end-of-probation-review/s13-l1": "Write with examples, not adjectives. Anyone can write: I work hard.|en|1|1|1|false",
 "end-of-probation-review/s13-l2": "But: I built the order tracking sheet, and the team has used it daily since month two. Now they see it.|en|1|1|1|false",
 "end-of-probation-review/s14-l1": "Name a weak point honestly, and add a plan.|en|1|1|1|false",
 "end-of-probation-review/s14-l2": "I am still slow with data reports. Next month I want to learn spreadsheets, and ask Oanh to check my template.|en|1|1|1|false",
 "end-of-probation-review/s15-l1": "Being very modest in your self review is the safe choice. True or false?|en|1|1|1|false",
 "end-of-probation-review/s15-l2": "False. Too modest hides good work. Do not exaggerate either. Your manager has watched you. Match what they saw.|en|1|1|1|false",
 "end-of-probation-review/s16-a1": "I completed all my tasks well.|en|1|1|1|false",
 "end-of-probation-review/s16-a2": "And the late deadlines?|en|1|1|1|false",
 "end-of-probation-review/s16-b1": "I do the weekly client report. No redo yet.|en|1|1|1|false",
 "end-of-probation-review/s16-b2": "I was late twice, waiting for data. Now I ask two days earlier, and I have not been late since.|en|1|1|1|false",
 "end-of-probation-review/s16-l5": "The first is only self-praise. Nothing to check, and the late deadlines turn into an argument.|en|1|1|1|false",
 "end-of-probation-review/s16-l6": "The second names real tasks, and admits the weak point first, with the fix.|en|1|1|1|false",
 "end-of-probation-review/s17-l1": "Praise yourself with examples. Admit weak points with a plan.|en|1|1|1|false",
 "end-of-probation-review/s18-l1": "Part four: during the meeting, and right after.|en|1|1|1|false",
 "end-of-probation-review/s19-l1": "Bring your notes.|en|1|1|1|false",
 "end-of-probation-review/s19-l2": "Listen more than you talk, and write down the main comments. You learn what your manager really thinks.|en|1|1|1|false",
 "end-of-probation-review/s19-l3": "When asked, answer briefly with your prepared examples.|en|1|1|1|false",
 "end-of-probation-review/s20-l1": "Your manager mentions a weak point. Answer with a direction.|en|1|1|1|false",
 "end-of-probation-review/s20-l2": "I understand. I will try a new way next month. Could you check after two weeks?|en|1|1|1|false",
 "end-of-probation-review/s20-l3": "The review ends with a plan, not sadness. Both sides have something to check later.|en|1|1|1|false",
 "end-of-probation-review/s21-l1": "Ask about the next stage. It shows you plan to stay.|en|1|1|1|false",
 "end-of-probation-review/s21-l2": "What should I focus on in the next three months?|en|1|1|1|false",
 "end-of-probation-review/s21-l3": "Is there a skill I should learn?|en|1|1|1|false",
 "end-of-probation-review/s22-l1": "Avoid comparing yourself with colleagues, or listing what others did not do.|en|1|1|1|false",
 "end-of-probation-review/s22-l2": "The review is about you. Comparing only makes the listener uncomfortable.|en|1|1|1|false",
 "end-of-probation-review/s23-l1": "A short thank you, with what we agreed.|en|1|1|1|false",
 "end-of-probation-review/s23-l2": "Thank you for the talk. Here are my three goals for next month:|en|1|1|1|false",
 "end-of-probation-review/s23-l3": "speak up in meetings, learn more spreadsheets, and take on the weekly report.|en|1|1|1|false",
 "end-of-probation-review/s23-l4": "This message becomes a marker to look back at together next time.|en|1|1|1|false",
 "end-of-probation-review/s23-l5": "Put the goals on your task list, and check yourself in one month.|en|1|1|1|false",
 "end-of-probation-review/s23-l6": "The end of probation is not a finish line. It is when bigger tasks begin.|en|1|1|1|false",
 "end-of-probation-review/s25-l1": "Part five: pay and the official contract.|en|1|1|1|false",
 "end-of-probation-review/s26-l1": "Before the meeting, reread your offer letter and probation contract, to know what was agreed.|en|1|1|1|false",
 "end-of-probation-review/s26-l2": "Under the 2019 Labour Code, probation pay is at least eighty-five percent of the job's pay.|en|1|1|1|false",
 "end-of-probation-review/s26-l3": "For jobs needing college level or higher, probation is no longer than sixty days. Other benefits depend on the company.|en|1|1|1|false",
 "end-of-probation-review/s27-l1": "May I ask about the official contract and the pay after probation? What papers do I need?|en|1|1|1|false",
 "end-of-probation-review/s27-l2": "Asking clearly is not demanding. It is understanding the agreement correctly.|en|1|1|1|false",
 "end-of-probation-review/s28-l1": "Got the new contract? Read it all before signing: title, pay, term, and every clause.|en|1|1|1|false",
 "end-of-probation-review/s28-l2": "At the interview, Thao was told she would get a travel allowance. On signing day, she does this.|en|1|1|1|false",
 "end-of-probation-review/s28-l3": "One. She puts her offer letter and notes beside the contract, and checks each line.|en|1|1|1|false",
 "end-of-probation-review/s28-l4": "Two. She marks the difference: no travel allowance.|en|1|1|1|false",
 "end-of-probation-review/s28-l5": "Three. She asks HR: I was told about a travel allowance. Is it in the contract?|en|1|1|1|false",
 "end-of-probation-review/s28-l6": "Four. She signs only when the answer is on paper. Unclear? Ask before signing, not after.|en|1|1|1|false",
 "end-of-probation-review/s29-l1": "Be happy, but finish reading before you sign.|en|1|1|1|false",
 "end-of-probation-review/s30-l1": "Last part: what if the result is not what you hoped?|en|1|1|1|false",
 "end-of-probation-review/s31-l1": "Stay calm, and ask for the exact reasons.|en|1|1|1|false",
 "end-of-probation-review/s31-l2": "Could you tell me which points I did not meet? I want to understand and do better.|en|1|1|1|false",
 "end-of-probation-review/s31-l3": "Clear reasons are a lesson you can take anywhere.|en|1|1|1|false",
 "end-of-probation-review/s32-l1": "Not kept? Ask HR about the ending procedure and your rights: pay for days worked, and documents.|en|1|1|1|false",
 "end-of-probation-review/s32-l2": "Hand over your work neatly, with notes.|en|1|1|1|false",
 "end-of-probation-review/s32-l3": "Return all documents and equipment.|en|1|1|1|false",
 "end-of-probation-review/s33-l1": "Dung was not kept. The job needed more sales experience than he had.|en|1|1|1|false",
 "end-of-probation-review/s33-l2": "He was sad. But he asked for honest feedback, handed over with notes, and thanked the team.|en|1|1|1|false",
 "end-of-probation-review/s33-l3": "Months later, his old mentor recommended him for a better job at another company.|en|1|1|1|false",
 "end-of-probation-review/s33-l4": "Leave kindly, and the door stays open.|en|1|1|1|false",
 "end-of-probation-review/s34-l1": "So, what did Thao miss? She never asked halfway. Ask, and nothing surprises you.|en|1|1|1|false",
 "end-of-probation-review/s34-l2": "Praise with examples, admit with a plan.|en|1|1|1|false",
 "end-of-probation-review/s34-l3": "And read before you sign. Start today: open your Work done file.|en|1|1|1|false",
 "end-of-probation-review/s35-l1": "You receive your official contract, what should you do before signing?|en|1|1|1|false",
 "end-of-probation-review/s35-l2": "Read all of it, and ask HR about anything different or unclear before you sign.|en|1|1|1|false",
 "end-of-probation-review/s35-l3": "Once signed, a difference is hard to fix. Ask HR before, not after.|en|1|1|1|false",
 "end-of-probation-review/s36-l1": "You know the job, the people, and you have proof. Now, forty questions below.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s01-l1": "Thao is writing an email to a partner. She stops at the smallest words.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s01-l2": "I work on it… or I'm working on it?|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s01-l3": "Until Friday… or by Friday?|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s01-l4": "Sound familiar? The good news: you don't need the whole grammar book.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s02-l1": "Which grammar points do working adults really need? About ten, in three parts.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s02-l2": "Tenses for reporting your work.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s02-l3": "Two-part sentences and the passive.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s02-l4": "And the small words that decide how clear and polite you sound.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s03-l1": "Most work sentences do only a few jobs, so you don't need every rule.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s03-l2": "Each lesson starts with one question. Everyday thing, or unfinished thing? Does the listener know which one?|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s03b-l1": "Report work in progress, report finished work, set times and deadlines,|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s03b-l2": "make proposals, ask for help, compare options, and pass on what others said.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s03b-l3": "And the mistakes repeat in the same few places.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s04-l1": "Part one is tenses. Part two is conditionals and the passive.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s04-l2": "Part three is the small words: articles, time words, tags, modals, comparisons, reported speech.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s05-l1": "Part one: tenses for reporting your work.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s06-l1": "First question: is this an everyday thing, or an unfinished, temporary thing?|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s07-l1": "Everyday: present simple. I work in sales.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s07-l2": "Unfinished: am, is, are plus -ing. I'm working on a sales report.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s08-l1": "Typing fast, we drop the s after he, she, it. My manager wants the report today.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s08-l2": "And we drop am, is, are before -ing. I working on it is wrong.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s09-l1": "Is everything clear so far?|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s09-l2": "Yes, I'm understanding.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s09-l3": "Wait a second!|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s09-l4": "Adding -ing doesn't make you sound more focused. Understand is a state, so people say I understand.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s09-l5": "Let's rewind and try again.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s09-l6": "Got it. I see. That makes sense.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s10-l1": "Now the job is done. Which tense?|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s10-l2": "If the result matters now and you give no time, use have or has: I've sent you the contract.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s10-l3": "If you give a finished time, use the past simple: We shipped your order yesterday.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s11-l2": "I worked in banking for ten years.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s11-l3": "Oh. So what do you do now?|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s11-l4": "Wait a second!|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s11-l5": "She still works there, but worked sounds finished.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s11-l6": "Let's rewind and try again.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s11-l7": "I've worked in banking for ten years.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s12-l1": "Part two: conditionals and the passive.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s13-l1": "Conditionals follow how real a thing is. The further from reality, the further back the verb goes.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s13-l2": "Type one, possible: If the client approves the design, we'll start next week.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s13-l3": "Type two, imagined: If I were you, I would accept the offer.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s13-l4": "Type three, for what is already lost, uses would have.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s14-l1": "The if part talks about the future, so it needs will. True or false?|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s14-l2": "False. No will or would in the if part: If the client approves.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s15-l1": "And when you see unless, read it as if not.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s16-n1": "Thao presents a hiring plan. The budget will probably be approved.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s16-a1": "If we had more budget, we would hire two people.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s16-b1": "If the budget is approved, we'll hire two people.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s16-n2": "Type two sounds like there's no money. Type one sounds like a plan waiting for a green light.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s17-l1": "If it can really happen, don't say it like a dream.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s18-l1": "The passive is be, in the right tense, plus the past participle.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s18-l2": "The most common mistake is a missing be. The goods delivered yesterday…|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s18-l3": "…should be: The goods were delivered yesterday.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s19-l1": "The passive is useful in notices,|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s19-l2": "like: Your request has been received.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s19-l3": "And to remind the whole team without pointing at anyone: The expense form needs to be completed by Friday.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s19-l4": "But for your own mistake, say it actively: I made a mistake in the invoice, and I'm fixing it now.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s20-l1": "Part three: articles and time words.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s21-l1": "Two questions. Does the listener know which one? What is the first sound of the next word?|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s21-l2": "A singular countable noun never stands alone. I have a meeting, not I have meeting.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s21-l3": "Information, advice, feedback, equipment: no a, no s.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s21-l4": "Use the only when both of you know which one.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s22-l1": "Can you check the first line of my CV?|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s22-l2": "I have an university degree and a MBA.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s22-l3": "Wait a second!|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s22-l4": "Listen to the sound, not the letter. University starts with a you sound. MBA starts with em.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s22-l5": "Let's rewind and try again.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s22-l6": "I have a university degree and an MBA.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s23-l1": "Time words go from small to big.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s23-l2": "At for a time: at nine.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s23-l3": "On for a day: on Monday morning.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s23-l4": "In for months, years, quarters, and parts of the day: in March, in the morning.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s23-l5": "No preposition before next, last, this: next Monday, not on next Monday.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s23-l6": "For a deadline: by with a date, or within with a number of days.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s24-l1": "Until means it keeps going up to that point. The reader may think: send figures every day until Friday.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s24-l2": "For a deadline, use by. Please send me the figures by Friday.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s25-l1": "Deadline: by. Something that continues: until. The office is open until six.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s26-l1": "Part four: tone when you talk and ask for things.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s27-l1": "A tag just flips the helper verb: You work in finance, don't you?|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s27-l2": "You didn't receive my email, did you?|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s27-l3": "No, I didn't.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s27-l4": "Answer by the facts, not by the question. Not received: No, I didn't.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s28-l1": "Not sure of the fact? Let your voice go down on the tag. True or false?|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s28-l2": "False. Not sure? Let it go up, so people know you're really asking.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s29-l1": "Can, could, should, must carry both how strong and how polite you are.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s29-l2": "Can: you are able to.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s29-l3": "Could: a more polite request. Could you send me the file?|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s29-l4": "Should: you'd better.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s29-l5": "Must: you have to.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s30-l1": "With a partner, swap must for could you, plus a reason.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s30-l2": "Could you please send the documents by Monday? We need them to prepare the contract.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s31-l1": "This is our new production line. You don't have to take photos here.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s31-l2": "Great, but I'd like a few photos anyway.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s31-l3": "Don't have to means not necessary, not forbidden. So Sam can still take photos.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s31-l4": "To ban photos: Please don't take photos here, or You mustn't take photos in this area.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s32-l1": "Mustn't means it is not allowed.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s32-l2": "Don't have to means it is not required.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s33-l1": "Part five: comparing options and passing on what others said.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s34-l1": "Short adjectives take -er. Long adjectives take more. Never both.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s34-l2": "So not more cheaper. Just cheaper.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s35-l1": "Say how big the gap is: slightly higher, or much faster.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s35-l2": "With numbers, say twice as expensive as,|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s35-l3": "or half as much as. Everyone reads it the same way.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s36-l1": "Passing on what your boss said? Three changes.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s36-l2": "Move the tense back. I'll call you becomes He said he would call me.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s36-l3": "Change the pronoun to fit the speaker.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s36-l4": "And safest of all: replace tomorrow with the actual day.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s37-l1": "The reporting verb keeps the weight of the original. Told us to is an order.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s37-l2": "Asked us to is a request.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s37-l3": "Suggested is just a suggestion.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s38-l1": "Part six: how to study, and what to check.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s39-l1": "Start with the two tense lessons. Almost every sentence needs a tense.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s39-l2": "Then conditionals and the passive.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s39-l3": "Then the small words and tone.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s39-l4": "In each lesson, make sentences about your own work, and say them out loud.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s40-l1": "Before you press send: does the third person have its s?|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s40-l2": "With yesterday or last week, did you use the past simple?|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s40-l3": "No will or would in the if part?|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s41-l1": "Does every singular countable noun have an article?|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s41-l2": "Deadlines with by, not until?|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s41-l3": "And in emails to partners, could you instead of must.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s42-l1": "Work grammar is about ten points that keep coming back. Each one has a question to help you choose.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s42-l2": "So, Thao: I'm working on it, and by Friday.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s43-l1": "You need the figures no later than Friday, how should you write it?|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s43-l2": "Write by Friday, since by shows the latest time the figures can arrive.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s43-l3": "By means no later than that point. Until means it continues, like updates every day until Friday.|en|1|1|1|false",
 "english-grammar-points-to-review-for-work/s44-l1": "Open your last email, check the six boxes, then try the forty questions below!|en|1|1|1|false",
 "english-interview-questions-to-prepare/s01-l1": "Why do you want this job?|en|1|1|1|false",
 "english-interview-questions-to-prepare/s01-l2": "Because your company is famous and has a good environment.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s01-l3": "Many companies do. Why us?|en|1|1|1|false",
 "english-interview-questions-to-prepare/s01-l4": "Dung goes quiet. He has nothing specific about this company.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s02-l1": "Which questions should you prepare for an English interview? Most come in a familiar order.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s02-l2": "First, introduce yourself and say why you want the job.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s02-l3": "In the middle: weakness, the future, salary, and a story.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s02-l4": "Near the end: Why should we hire you?|en|1|1|1|false",
 "english-interview-questions-to-prepare/s02-l5": "Then your questions, and a thank you.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s03-l1": "The first question is almost always: Tell me about yourself. Next often comes: Why do you want this job?|en|1|1|1|false",
 "english-interview-questions-to-prepare/s03-l2": "In the middle: your weakness, five years from now, salary, and Tell me about a time… The order changes from place to place.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s03-l3": "Near the end: Why should we hire you? Then: Do you have any questions for us?|en|1|1|1|false",
 "english-interview-questions-to-prepare/s03-l4": "And after the interview, a thank you.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s04-l1": "Six stops, in the order of a real interview.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s05-l1": "They listen to your ideas and your English. Learned answers sound like reading, and one lost word can freeze you.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s05-l2": "So each lesson gives you a short frame to remember ideas.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s06-l1": "Part one: the start of the interview.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s07-l1": "Tell me about yourself: about one minute, in three parts, with one real result.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s07-l2": "Present: I'm currently a sales executive at a furniture company.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s07-l3": "Past: Before that, I spent two years in customer service.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s07-l4": "Future: Now I'd like to move into account management.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s07-l5": "Keep the frame. Write the last sentence for each company.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s08-l1": "So, tell me about yourself.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s08-l2": "My name is Dũng. I was born in Nam Định. I have one younger sister…|en|1|1|1|false",
 "english-interview-questions-to-prepare/s08-l3": "Wait a second!|en|1|1|1|false",
 "english-interview-questions-to-prepare/s08-l4": "Soon she'll say: Let's talk about your work. And that part isn't ready.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s08-l5": "Let's rewind and try again.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s08-l6": "I'm currently a sales executive at a furniture company.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s09-l1": "They ask about you, but they want to hear about your work.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s10-l1": "Why do you want this job? Connect three things.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s10-l2": "What you really like about the work,|en|1|1|1|false",
 "english-interview-questions-to-prepare/s10-l3": "one real detail about the company,|en|1|1|1|false",
 "english-interview-questions-to-prepare/s10-l4": "and why you fit what they need. Use First, Second, And finally to stay on track.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s10-l5": "Salary or a short commute are normal reasons, but not the main one.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s11-l1": "Praise is not enough. Interviewers hear it all the time.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s11-l2": "What saves it: one specific detail about the company, and why you care.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s12-l1": "Praise anyone could say is praise nobody remembers.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s13-l1": "Part two: your weakness, and five years from now.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s14-l1": "Never say: I don't have any weaknesses. It shows a lack of self awareness.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s14-l2": "Pick a real weakness that isn't a key skill for the role. One sentence on it, then three on how you improve.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s14-l3": "I tend to say yes to every request… Now I check my priorities before agreeing.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s15-l1": "Five years from now? Give a realistic path in the same field.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s15-l2": "A skill you want to master,|en|1|1|1|false",
 "english-interview-questions-to-prepare/s15-l3": "more responsibility you want,|en|1|1|1|false",
 "english-interview-questions-to-prepare/s15-l4": "and why this company helps you get there. Say I'd like to, or My goal is to, not will in every sentence.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s15-l5": "Plans to leave, like studying abroad, stay with you.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s16-l1": "Where do you see yourself in five years?|en|1|1|1|false",
 "english-interview-questions-to-prepare/s16-l2": "In five years? Maybe I'll have your job!|en|1|1|1|false",
 "english-interview-questions-to-prepare/s16-l3": "Wait a second!|en|1|1|1|false",
 "english-interview-questions-to-prepare/s16-l4": "She's the manager he'd work for. The joke turns her into a rival.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s16-l5": "Let's rewind and try again.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s16-l6": "I'd like to be leading small projects by then.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s17-l1": "Talk about your path. Don't aim at the seat of the person asking.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s18-l1": "Part three: salary.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s19-l1": "Research the market first.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s19-l2": "Give a range that isn't too wide, with the low end close to what you really want.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s19-l3": "Say clearly: gross or net.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s19-l4": "Add: I'm open to discussing the full package.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s19-l5": "Their offer is lower? Don't refuse yet. Ask about bonuses and benefits.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s20-n1": "Thao is asked about her expected salary.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s20-a1": "Whatever you think is fair is fine with me.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s20-b1": "Based on my research, I'm looking for a range of X to Y gross per month.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s20-b2": "And I'm open to discussing the whole package.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s20-n2": "The first lets the company pick the number, and it's hard to negotiate later. The second gives a range, says gross, and stays open.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s21-l1": "If you don't give a number, someone else will give it for you.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s22-l1": "Part four: your story, and why they should hire you.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s23-l1": "Tell me about a time… needs a real work story where you are the main actor.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s23-l2": "Four steps, STAR. The situation,|en|1|1|1|false",
 "english-interview-questions-to-prepare/s23-l3": "your task,|en|1|1|1|false",
 "english-interview-questions-to-prepare/s23-l4": "the action, which is the longest part,|en|1|1|1|false",
 "english-interview-questions-to-prepare/s23-l5": "and the result. Tell it with I, in the past simple, and keep the labels in your head.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s24-l1": "Why should we hire you? It usually comes near the end.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s24-l2": "Pick two or three strengths that match the job description,|en|1|1|1|false",
 "english-interview-questions-to-prepare/s24-l3": "each with evidence, like a number or a result,|en|1|1|1|false",
 "english-interview-questions-to-prepare/s24-l4": "and end with how you'd help the team. Open with: I think I'd be a strong fit for three reasons.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s24-l5": "Don't compare yourself with other candidates. You don't know who they are.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s25-l1": "Part five: your questions, and saying thank you.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s25b-l1": "Do you have any questions for us? Prepare about five open questions, and ask two or three.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s26-l2": "Use polite structures. Not: Could you tell me what does a typical day look like?|en|1|1|1|false",
 "english-interview-questions-to-prepare/s26-l3": "But: Could you tell me what a typical day looks like in this role? Subject before verb.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s27-l1": "A phone interview with a foreign manager, who asks: What's your notice period?|en|1|1|1|false",
 "english-interview-questions-to-prepare/s27-l2": "Maybe three years.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s27-l3": "Wait a second!|en|1|1|1|false",
 "english-interview-questions-to-prepare/s27-l4": "He guessed. Notice period means the time you must give before leaving your old job.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s27-l5": "Let's rewind and try again.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s27-l6": "Sorry, what do you mean by notice period?|en|1|1|1|false",
 "english-interview-questions-to-prepare/s28-l1": "Don't know a word? Ask about exactly that word.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s29-l1": "Say thank you twice. First when you leave: thanks, one detail from the talk, and hope to hear back.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s29-l2": "Then a short email within one day, with one specific detail.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s29-l3": "Online, wait for them to say goodbye before you leave the call.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s29-l4": "And don't ask about the result in your thank you email.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s30-l1": "Part six: when your mind goes blank, and how to prepare at home.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s31-l1": "Have you used this reporting tool?|en|1|1|1|false",
 "english-interview-questions-to-prepare/s31-l2": "Let me think about that for a moment.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s31-l3": "A short pause is normal, if you say so first.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s31-l4": "You can also repeat the question to check you understood, or ask what they mean when it's too broad.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s32-n1": "Thao has only heard the tool's name.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s32-a1": "Yes, I've used it a lot.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s32-b1": "I haven't used that tool yet, but I use a similar one every week.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s32-b2": "And I usually learn new software through short online tutorials.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s32-n2": "One follow-up, like Which feature do you use most?, and the first answer falls apart. Then other good answers look doubtful too.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s33-l1": "If you don't know, say how you'll find out. Don't talk as if you know.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s34-l1": "Your home checklist. Three lines: present, past, future.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s34-l2": "One real detail about the company.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s34-l3": "One weakness, with how you improve it.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s34-l4": "One path for five years. One salary range, gross or net.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s34b-l1": "Two or three STAR stories.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s34b-l2": "Two or three strengths with evidence.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s34b-l3": "Five questions for the employer.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s34b-l4": "And a draft thank you email.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s35-l1": "Record each answer, listen back, and time it. Your introduction: one to one and a half minutes.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s35-l2": "A STAR story: one and a half to two minutes. Note only ideas and a few key words.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s36-l1": "An English interview is a set of familiar questions, each with a short frame.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s36-l2": "And Dung? Next time: one specific detail about the company, and why it matters to him.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s37-l1": "A hard question leaves your mind empty, what should you do first?|en|1|1|1|false",
 "english-interview-questions-to-prepare/s37-l2": "Say let me think about that for a moment, then really pause.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s37-l3": "A short pause is normal if you say so first. Silence without warning looks like you froze.|en|1|1|1|false",
 "english-interview-questions-to-prepare/s38-l1": "Write your three lines, record them once, then try the forty questions below!|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s01-l1": "How would you handle two urgent tasks at the same time?|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s01-l2": "Dũng looks down at the table. Almost ten seconds of silence.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s01-l3": "Are you okay? Should I repeat the question?|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s01-l4": "Dũng jumps, and the idea he just had is gone.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s02-l1": "So how do you buy a few seconds, and still sound professional?|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s02-l2": "Ask for a moment.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s02-l3": "Repeat the question.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s02-l4": "Ask to clarify.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s02-l5": "Use an opener while you sort your ideas.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s03-l1": "Six stops today. First, is silence really a problem?|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s03-l2": "Then the phrases, the honest answer, and how to practise.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s04-l1": "Part one: is a few seconds of silence okay?|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s05-l1": "Many people panic and fill the gap with um, or a half-ready answer.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s05-l2": "But a two or three second pause is normal. It looks like serious thinking.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s05-l3": "The worry is silence with no signal. Are you thinking, or frozen?|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s06-l1": "How would you handle two urgent tasks at the same time?|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s06-l2": "Let me think about that for a moment.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s06-l3": "Then he really pauses, three to five seconds, and starts with his first idea.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s07-l1": "Silence with a signal is thinking. Without one, it is freezing.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s08-l1": "Part two: just ask for a moment.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s09-l1": "This is the most honest and simple way.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s09-l2": "Let me think about that for a moment.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s09-l3": "Give me a second to think about that.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s09-l4": "That's a good question. I'd like to think about it briefly.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s10-l1": "After the phrase, really stop. You can look aside, like you are thinking.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s10-l2": "Don't keep talking to fill the gap, or you still have no time to think.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s10-l3": "Three to five seconds is about right.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s10-l4": "Still no full idea? Start with your first point and build from there.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s11-l1": "Part three: repeat the question in your own words.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s12-l1": "Repeating gives you time, and checks that you understood.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s12-l2": "So you're asking how I handle conflicts with colleagues.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s12-l3": "If I understand correctly, you'd like an example of a time I missed a deadline.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s12-l4": "Do you mean in my current job, or in general?|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s13-l1": "It helps most when the question is long, or has two parts.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s13-l2": "Tell me about a project that didn't go as planned, and what you'd do differently.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s13-l3": "So you're asking about a project that failed, and how I'd change my approach?|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s13-l4": "Not failed, just not as planned.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s13-l5": "So Dũng tells a small delay, not a big failure, and answers the real question.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s14-l1": "Repeating the question is a free check. If you got it wrong, they fix it now.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s15-l1": "Part four: clarifying questions and openers.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s16-l1": "When a question is too broad, ask one question back.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s16-l2": "Could you give me a bit more context?|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s16-l3": "Are you thinking of a specific situation?|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s16-l4": "Would you like an example from work, or from my studies? It shows careful thinking.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s17-l1": "Openers let you start talking while your mind picks an example.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s17-l2": "That's an interesting question. There are a couple of things that come to mind.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s17-l3": "I've never really thought about it that way, but…|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s17-l4": "Well, one example that comes to mind is…|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s18-l1": "A common mistake: one phrase, That's a great question, before every answer.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s18-l2": "The first time is natural. By the third or fourth, it sounds learned by heart.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s18b-l1": "They may even joke: You seem to like all my questions.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s18b-l2": "Safer: prepare three or four phrases and rotate them.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s19-l1": "A good phrase, used every time, becomes a bad one.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s20-l1": "Part five: when you really don't know the answer.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s21-l1": "For a technical question you don't know, don't make it up. Be honest.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s21-l2": "I'm not completely sure about that, to be honest.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s21-l3": "I haven't used that tool before, but I'd start by reading the guide…|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s21-l4": "…and asking a colleague who has used it.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s22-l1": "Have you used this reporting tool?|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s22-l2": "Yes, I've used it a lot.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s22-l3": "Wait a second!|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s22-l4": "One question like Which feature do you use most? and the truth is out.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s22-l5": "Let's rewind and try again.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s22-l6": "I haven't used that tool yet, but I use a similar one every week.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s22-l7": "And I usually learn new software through short online tutorials.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s23-l1": "Honest, but still showing your nearest experience and how you'll learn.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s23-l2": "Need to come back later? Would it be okay if I came back to that question later?|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s23-l3": "Use it only once in the whole interview, and really come back.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s24-l1": "Part six: habits to drop, and how to practise.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s25-l1": "Vietnamese fillers inside English sentences.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s25-l2": "Um, like, and you know, in every sentence.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s25-l3": "Saying I don't know, then stopping completely.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s25-l4": "A long, forced smile to fill the silence.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s26-l1": "Pick four or five phrases that feel easiest. Practise until they come out without thinking.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s26-l2": "Dũng records questions and plays them at random.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s26-l3": "That's an interesting question. One example that comes to mind is…|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s26-l4": "The rule: start with a new phrase before every answer. Or ask friends for surprise questions.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s27-l1": "Your take-away list: one phrase to ask for time.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s27-l2": "One to repeat the question, one to clarify.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s27-l3": "Two openers to rotate, and one honest line for when you don't know.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s27-l4": "And remember: say the phrase, then really pause.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s28-l1": "A two or three second pause before a hard question shows you lack confidence. True or false?|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s28-l2": "False. It looks like serious thinking, as long as you signal it.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s29-l1": "Which phrase is the simplest honest way to ask for time to think?|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s29-l2": "Let me think about that for a moment, please, if that is okay.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s29-l3": "It's short, polite, and works for almost any question.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s30-l1": "Signal your silence.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s30-l2": "Repeat the question, it's a free check.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s30-l3": "Don't know? Say how you'll find out. Today, say four phrases ten times each.|en|1|1|1|false",
 "english-phrases-to-buy-time-in-an-interview/s31-l1": "Let me think… yes! Forty questions are waiting for you.|en|1|1|1|false",
 "explain-numbers-simply/s01-a1": "Column one is sales in the North, column two is the Centre…|en|1|1|1|false",
 "explain-numbers-simply/s01-a2": "In short, did we hit the target?|en|1|1|1|false",
 "explain-numbers-simply/s01-b1": "We hit the target this month, mainly thanks to returning customers.|en|1|1|1|false",
 "explain-numbers-simply/s01-l4": "Same numbers. So how do you say numbers so your boss gets them?|en|1|1|1|false",
 "explain-numbers-simply/s02-l1": "The problem is rarely the data. It's how you say it. Your boss needs|en|1|1|1|false",
 "explain-numbers-simply/s02-l2": "fewer numbers,|en|1|1|1|false",
 "explain-numbers-simply/s02-l3": "each with something to compare it to,|en|1|1|1|false",
 "explain-numbers-simply/s02-l4": "and one sentence on what it means.|en|1|1|1|false",
 "explain-numbers-simply/s03-l1": "Six stops: which numbers, what to check, and how to say one number.|en|1|1|1|false",
 "explain-numbers-simply/s03-l2": "Then charts, causes, and numbers that don't look good.|en|1|1|1|false",
 "explain-numbers-simply/s04-l1": "Part one: a whole table. Which numbers do you say?|en|1|1|1|false",
 "explain-numbers-simply/s05-l1": "Start with a question: after this meeting, what must your boss decide?|en|1|1|1|false",
 "explain-numbers-simply/s05-l2": "Pick only the numbers that answer it. Usually three to five.|en|1|1|1|false",
 "explain-numbers-simply/s05-l3": "Put the rest in an appendix or attached file. That's not hiding. It helps your boss focus.|en|1|1|1|false",
 "explain-numbers-simply/s06-l2": "Tables are for looking up. Sentences are for saying.|en|1|1|1|false",
 "explain-numbers-simply/s07-l1": "Part two: what to check before you show a number.|en|1|1|1|false",
 "explain-numbers-simply/s08-l1": "Where is it from, and what date?|en|1|1|1|false",
 "explain-numbers-simply/s08-l2": "The right unit: dong or thousand dong, products or orders?|en|1|1|1|false",
 "explain-numbers-simply/s08-l3": "The right period, and the same method as last time.|en|1|1|1|false",
 "explain-numbers-simply/s08-l4": "And a second person to check it. They spot what you missed.|en|1|1|1|false",
 "explain-numbers-simply/s09-l1": "Good news! Our ad costs went down this month!|en|1|1|1|false",
 "explain-numbers-simply/s09-l2": "Wait a second!|en|1|1|1|false",
 "explain-numbers-simply/s09-l3": "This month is without tax. Last month was with tax. Costs barely changed.|en|1|1|1|false",
 "explain-numbers-simply/s09-l4": "Next day, accounting finds it, and from then on, the boss rechecks all his numbers.|en|1|1|1|false",
 "explain-numbers-simply/s09-l5": "Let's rewind and try again.|en|1|1|1|false",
 "explain-numbers-simply/s09-l6": "First, are both months counted the same way, with tax?|en|1|1|1|false",
 "explain-numbers-simply/s09-l7": "Counted the same way, our ad costs are almost the same as last month.|en|1|1|1|false",
 "explain-numbers-simply/s09-l8": "Changed the method? Say so at once, or your boss thinks something really changed.|en|1|1|1|false",
 "explain-numbers-simply/s10-l1": "Part three: how to say one number so it's easy to hear.|en|1|1|1|false",
 "explain-numbers-simply/s11-l1": "Round it when you speak: about two point three billion is easier than every digit.|en|1|1|1|false",
 "explain-numbers-simply/s11-l2": "Keep the exact figure on the slide or in the file.|en|1|1|1|false",
 "explain-numbers-simply/s12-l1": "Give each number a “that means”. People remember the meaning longer than the number.|en|1|1|1|false",
 "explain-numbers-simply/s12-l2": "Thirty percent of customers come back. That means three in ten buy a second time.|en|1|1|1|false",
 "explain-numbers-simply/s12b-l0": "A number alone doesn't say good or bad. Put it next to a reference:|en|1|1|1|false",
 "explain-numbers-simply/s12b-l1": "last period,|en|1|1|1|false",
 "explain-numbers-simply/s12b-l2": "the same period last year,|en|1|1|1|false",
 "explain-numbers-simply/s12b-l3": "or the target you set.|en|1|1|1|false",
 "explain-numbers-simply/s13-l1": "Saying “it doubled” is impressive and clear enough. True or false?|en|1|1|1|false",
 "explain-numbers-simply/s13-l2": "False. Doubling shows change, not size. Positive feedback may go from five to ten, among thousands.|en|1|1|1|false",
 "explain-numbers-simply/s13-l3": "Two orders to four is double too. Your boss needs to know that.|en|1|1|1|false",
 "explain-numbers-simply/s13-l4": "Say both: it doubled, from five to ten.|en|1|1|1|false",
 "explain-numbers-simply/s14-l1": "Wherever a percentage goes, the real number follows.|en|1|1|1|false",
 "explain-numbers-simply/s15-l1": "Part four: do you need a chart, and how do you draw it?|en|1|1|1|false",
 "explain-numbers-simply/s16-l1": "A simple chart is often easier than a table.|en|1|1|1|false",
 "explain-numbers-simply/s16-l2": "Lines for a trend over time. Bars to compare groups.|en|1|1|1|false",
 "explain-numbers-simply/s17-l1": "One chart, one message. The title is that message.|en|1|1|1|false",
 "explain-numbers-simply/s17-l2": "Not “orders by month”, but “orders rose three months in a row”.|en|1|1|1|false",
 "explain-numbers-simply/s17-l3": "Colour the part you want your boss to see. Keep the rest pale.|en|1|1|1|false",
 "explain-numbers-simply/s18-l1": "A vertical axis that doesn't start at zero is no problem. True or false?|en|1|1|1|false",
 "explain-numbers-simply/s18-l2": "False. A small difference can look huge. If you must cut it, add a clear note.|en|1|1|1|false",
 "explain-numbers-simply/s19-l1": "Part five: explaining why a number went up or down.|en|1|1|1|false",
 "explain-numbers-simply/s20-l1": "Separate checked facts from ideas you're still testing.|en|1|1|1|false",
 "explain-numbers-simply/s20-l2": "Sales fell mainly in the North. That's the data.|en|1|1|1|false",
 "explain-numbers-simply/s20-l3": "The reason may be a competitor's price cut. I'm checking that.|en|1|1|1|false",
 "explain-numbers-simply/s21-l1": "Two numbers rising together doesn't mean one causes the other.|en|1|1|1|false",
 "explain-numbers-simply/s21-l2": "More posts, more orders. But both may come from the busy season.|en|1|1|1|false",
 "explain-numbers-simply/s22-l1": "Months with more ad emails had higher sales. Let's send twice as many!|en|1|1|1|false",
 "explain-numbers-simply/s22-l2": "Not yet. Were those months also the holiday season?|en|1|1|1|false",
 "explain-numbers-simply/s22-l3": "Compare months without holidays. If more emails still sell better, then you have a case.|en|1|1|1|false",
 "explain-numbers-simply/s22-l4": "Moving together doesn't always mean causing each other.|en|1|1|1|false",
 "explain-numbers-simply/s23-l1": "Last part: when the numbers don't look good.|en|1|1|1|false",
 "explain-numbers-simply/s24-l1": "Show a bad number like a good one: same comparison, same method.|en|1|1|1|false",
 "explain-numbers-simply/s24-l2": "Don't pick another period just to make it look nicer.|en|1|1|1|false",
 "explain-numbers-simply/s24-l3": "Then say how you read it, and a next step: watch two more weeks, or check one process.|en|1|1|1|false",
 "explain-numbers-simply/s25-l1": "Take this frame for almost any number.|en|1|1|1|false",
 "explain-numbers-simply/s25-l2": "The main number is… Compared with… That means… I suggest…|en|1|1|1|false",
 "explain-numbers-simply/s25-l3": "Pick three numbers from your last report, and write one sentence for each.|en|1|1|1|false",
 "explain-numbers-simply/s26-l1": "Why can saying positive feedback doubled be misleading without the real counts?|en|1|1|1|false",
 "explain-numbers-simply/s26-l2": "Doubling from five to ten sounds big, but it is tiny among thousands of customers.|en|1|1|1|false",
 "explain-numbers-simply/s26-l3": "A percentage shows how much it changed, not how big it is.|en|1|1|1|false",
 "explain-numbers-simply/s27-l1": "Your turn. Forty questions are waiting below.|en|1|1|1|false",
 "first-day-at-new-job/s01-l1": "You are Thao. Tomorrow is your first day at a new job.|en|1|1|1|false",
 "first-day-at-new-job/s01-l2": "What should I wear? What time do I arrive? Who do I meet?|en|1|1|1|false",
 "first-day-at-new-job/s01-l3": "And what if I just sit there all day?|en|1|1|1|false",
 "first-day-at-new-job/s01-l4": "If you were Thao, what would you do tonight?|en|1|1|1|false",
 "first-day-at-new-job/s02-l1": "Relax. Nobody scores your work on day one. People remember three things.|en|1|1|1|false",
 "first-day-at-new-job/s02-l2": "You came on time.|en|1|1|1|false",
 "first-day-at-new-job/s02-l3": "You greeted people kindly.|en|1|1|1|false",
 "first-day-at-new-job/s02-l4": "You listened, and you took notes.|en|1|1|1|false",
 "first-day-at-new-job/s03-l1": "We walk with you from the night before to going home.|en|1|1|1|false",
 "first-day-at-new-job/s03-l2": "Six stops, in order.|en|1|1|1|false",
 "first-day-at-new-job/s04-l1": "Part one: the night before.|en|1|1|1|false",
 "first-day-at-new-job/s05-l1": "Pack tonight. First, the papers HR asked for.|en|1|1|1|false",
 "first-day-at-new-job/s05-l2": "A notebook, a pen, and a fully charged phone.|en|1|1|1|false",
 "first-day-at-new-job/s05-l3": "The name and number of the person meeting you.|en|1|1|1|false",
 "first-day-at-new-job/s05-l4": "The exact building, floor, and parking place.|en|1|1|1|false",
 "first-day-at-new-job/s05-l5": "And your clothes, already chosen.|en|1|1|1|false",
 "first-day-at-new-job/s06-l1": "Nobody told me anything, so I will ask one day before.|en|1|1|1|false",
 "first-day-at-new-job/s06-l2": "Hello, I am Thao, the new staff member starting on Monday morning.|en|1|1|1|false",
 "first-day-at-new-job/s06-l3": "What time should I arrive, who should I meet, and what papers should I bring?|en|1|1|1|false",
 "first-day-at-new-job/s06-l4": "Time, person, papers. Three questions, one short message.|en|1|1|1|false",
 "first-day-at-new-job/s07-l1": "Not sure what to wear? Ask HR, or remember your interview day.|en|1|1|1|false",
 "first-day-at-new-job/s07-l2": "On day one, dress a little neater than others. That is safe.|en|1|1|1|false",
 "first-day-at-new-job/s07-l3": "Next week, adjust to your team.|en|1|1|1|false",
 "first-day-at-new-job/s08-l1": "Then go to bed early.|en|1|1|1|false",
 "first-day-at-new-job/s08-l2": "Day one has many names, rules, and passwords. Tired minds forget, and stress.|en|1|1|1|false",
 "first-day-at-new-job/s09-l1": "Part two: the first morning. When should you arrive?|en|1|1|1|false",
 "first-day-at-new-job/s10-l1": "If you can, test the route once before, at rush hour.|en|1|1|1|false",
 "first-day-at-new-job/s10-l2": "Arrive about fifteen minutes before your start time. That is just right.|en|1|1|1|false",
 "first-day-at-new-job/s10-l3": "Too early, the doors are closed, and your contact feels awkward.|en|1|1|1|false",
 "first-day-at-new-job/s11-l1": "Watch Dung. The map says fifteen minutes by motorbike.|en|1|1|1|false",
 "first-day-at-new-job/s11-l2": "One. The day before, he rides it at rush hour, and finds a busy crossroad.|en|1|1|1|false",
 "first-day-at-new-job/s11-l3": "Two. He asks the office where to park.|en|1|1|1|false",
 "first-day-at-new-job/s11-l4": "Three. He adds time for traffic and parking, and sets an earlier alarm.|en|1|1|1|false",
 "first-day-at-new-job/s11-l5": "Four. He arrives fifteen minutes early, calm, before meeting the team.|en|1|1|1|false",
 "first-day-at-new-job/s11-l6": "Try the route the day before. Arrive early the next day.|en|1|1|1|false",
 "first-day-at-new-job/s12-l1": "Traffic jam. I will be late, so I message before start time.|en|1|1|1|false",
 "first-day-at-new-job/s12-l2": "I am sorry, the traffic is bad. I will arrive around eight fifteen.|en|1|1|1|false",
 "first-day-at-new-job/s12-l4": "Reason, plus your arrival time. Telling first beats walking in late quietly.|en|1|1|1|false",
 "first-day-at-new-job/s13-l1": "Part three: introducing yourself, and remembering names.|en|1|1|1|false",
 "first-day-at-new-job/s14-l1": "Your introduction needs just three things.|en|1|1|1|false",
 "first-day-at-new-job/s14-l2": "Your name.|en|1|1|1|false",
 "first-day-at-new-job/s14-l3": "Your team.|en|1|1|1|false",
 "first-day-at-new-job/s14-l4": "And what you do there. Keep it short.|en|1|1|1|false",
 "first-day-at-new-job/s15-l1": "Hello everyone, I am Thao. I have just joined the content team.|en|1|1|1|false",
 "first-day-at-new-job/s15-l2": "I hope you will guide me.|en|1|1|1|false",
 "first-day-at-new-job/s15-l3": "Welcome, Thao.|en|1|1|1|false",
 "first-day-at-new-job/s15-l4": "Name, team, job, a polite close. Short is easy to remember.|en|1|1|1|false",
 "first-day-at-new-job/s16-l1": "Repeat the name right away. Hello, Ms Hang.|en|1|1|1|false",
 "first-day-at-new-job/s16-l2": "Then write it in your notebook: the name, the job, and the desk.|en|1|1|1|false",
 "first-day-at-new-job/s16-l3": "Use the right name next time, and they remember you.|en|1|1|1|false",
 "first-day-at-new-job/s17-l1": "How to address people? Listen to others, then copy them.|en|1|1|1|false",
 "first-day-at-new-job/s17-l2": "Not sure? Use anh or chi, and call yourself em.|en|1|1|1|false",
 "first-day-at-new-job/s17-l3": "Or ask gently: may I call you anh Tuan?|en|1|1|1|false",
 "first-day-at-new-job/s19-l1": "This morning, Thao met over ten people. She nodded, but wrote nothing.|en|1|1|1|false",
 "first-day-at-new-job/s19-l2": "Now the printer breaks. The admin lady in the corner can help.|en|1|1|1|false",
 "first-day-at-new-job/s19-l3": "Psst. What is that lady's name again?|en|1|1|1|false",
 "first-day-at-new-job/s19-l4": "Wait a second!|en|1|1|1|false",
 "first-day-at-new-job/s19-l5": "She can hear you. The mistake was this morning: no notes.|en|1|1|1|false",
 "first-day-at-new-job/s19-l6": "Let's rewind to this morning.|en|1|1|1|false",
 "first-day-at-new-job/s19-l7": "Hello, Ms Hang. Nice to meet you.|en|1|1|1|false",
 "first-day-at-new-job/s19-l8": "Ms Hang, admin, corner desk. Written.|en|1|1|1|false",
 "first-day-at-new-job/s19-l9": "Hear a name, repeat it. Meet someone, write it down.|en|1|1|1|false",
 "first-day-at-new-job/s20-l1": "Part four: no tasks yet. What now?|en|1|1|1|false",
 "first-day-at-new-job/s21-l1": "Day one is often for accounts, computers, rules, and paperwork.|en|1|1|1|false",
 "first-day-at-new-job/s21-l2": "Waiting is normal. It does not mean they forgot you.|en|1|1|1|false",
 "first-day-at-new-job/s22-l1": "While you wait, read the documents you were sent.|en|1|1|1|false",
 "first-day-at-new-job/s22-l2": "Look at your job description again.|en|1|1|1|false",
 "first-day-at-new-job/s22-l3": "And write down what you want to ask.|en|1|1|1|false",
 "first-day-at-new-job/s22-l4": "Reading beats scrolling. You learn, and show interest.|en|1|1|1|false",
 "first-day-at-new-job/s23-l1": "Learn these on day one. Working hours and lunch break.|en|1|1|1|false",
 "first-day-at-new-job/s23-l2": "How to ask for leave and report sick, in case you fall ill.|en|1|1|1|false",
 "first-day-at-new-job/s23-l3": "Your direct manager, and the team channel.|en|1|1|1|false",
 "first-day-at-new-job/s23-l4": "And the rules for keeping documents secure.|en|1|1|1|false",
 "first-day-at-new-job/s24-l1": "Limit your personal phone, especially on day one, when people notice you.|en|1|1|1|false",
 "first-day-at-new-job/s24-l2": "A personal call? Step outside and keep it short.|en|1|1|1|false",
 "first-day-at-new-job/s25-l1": "Afternoon. No account, no tasks, and the leader is busy.|en|1|1|1|false",
 "first-day-at-new-job/s25-l2": "Nothing to do. I will just check my phone.|en|1|1|1|false",
 "first-day-at-new-job/s25-l3": "Wait a second!|en|1|1|1|false",
 "first-day-at-new-job/s25-l4": "People walking past see the phone, not the reason.|en|1|1|1|false",
 "first-day-at-new-job/s25-l5": "Let's rewind and try another way.|en|1|1|1|false",
 "first-day-at-new-job/s25-l6": "While I wait for my account, which documents should I read first?|en|1|1|1|false",
 "first-day-at-new-job/s25-l7": "Start with the process guide.|en|1|1|1|false",
 "first-day-at-new-job/s25-l8": "I will also read the team's old reports, and write my questions.|en|1|1|1|false",
 "first-day-at-new-job/s25-l9": "No tasks yet? Find something to learn.|en|1|1|1|false",
 "first-day-at-new-job/s27-l1": "Part five: how to speak and behave.|en|1|1|1|false",
 "first-day-at-new-job/s28-l1": "On day one, listen more than you talk.|en|1|1|1|false",
 "first-day-at-new-job/s28-l2": "Avoid: why is this still done by hand? You do not know why yet.|en|1|1|1|false",
 "first-day-at-new-job/s29-l1": "Calling the process slow on day one shows you are smart. True or false?|en|1|1|1|false",
 "first-day-at-new-job/s29-l2": "False. You judge before you know why. Someone may have chosen it carefully.|en|1|1|1|false",
 "first-day-at-new-job/s30-a1": "My old team used a different tool. It was much faster.|en|1|1|1|false",
 "first-day-at-new-job/s30-a2": "I see.|en|1|1|1|false",
 "first-day-at-new-job/s30-b1": "I see we use this software. Could you tell me why we chose it?|en|1|1|1|false",
 "first-day-at-new-job/s30-b2": "Sure. Our client needs strong security.|en|1|1|1|false",
 "first-day-at-new-job/s30-l5": "The first sounds like criticism. The person who chose it may be there.|en|1|1|1|false",
 "first-day-at-new-job/s30-l6": "The second opens an explanation. Ask why first, suggest later.|en|1|1|1|false",
 "first-day-at-new-job/s31-l1": "Invited to lunch? Go. Not invited? Ask.|en|1|1|1|false",
 "first-day-at-new-job/s31-l2": "Where do you usually have lunch? Can I join you?|en|1|1|1|false",
 "first-day-at-new-job/s31-l3": "Of course. Come with us.|en|1|1|1|false",
 "first-day-at-new-job/s31-l4": "No invitation is not dislike. Many people just eat alone.|en|1|1|1|false",
 "first-day-at-new-job/s32-l1": "Do not ask about salaries. It is private, and makes people uneasy.|en|1|1|1|false",
 "first-day-at-new-job/s32-l2": "Do not speak badly about your old company.|en|1|1|1|false",
 "first-day-at-new-job/s32-l3": "Do not share very private things.|en|1|1|1|false",
 "first-day-at-new-job/s32-l4": "Pleasant and trustworthy matters more than interesting.|en|1|1|1|false",
 "first-day-at-new-job/s33-l1": "Last part: the end of day one.|en|1|1|1|false",
 "first-day-at-new-job/s34-l1": "Thank you for today. What should I start with tomorrow?|en|1|1|1|false",
 "first-day-at-new-job/s34-l3": "It shows you take action, and saves tomorrow's waiting.|en|1|1|1|false",
 "first-day-at-new-job/s35-l1": "Tonight, ten minutes on your notes: names, questions, tasks.|en|1|1|1|false",
 "first-day-at-new-job/s35-l2": "Skip it, and by morning you forget half.|en|1|1|1|false",
 "first-day-at-new-job/s36-l1": "Feeling lost after day one? Some think: this job is not for me.|en|1|1|1|false",
 "first-day-at-new-job/s36-l2": "That is normal. Most need a few weeks. One day is too early to judge.|en|1|1|1|false",
 "first-day-at-new-job/s37-l1": "So, Thao, tonight? Pack, ask, test the route, arrive early.|en|1|1|1|false",
 "first-day-at-new-job/s37-l2": "Repeat names, and write them down.|en|1|1|1|false",
 "first-day-at-new-job/s37-l3": "No tasks? Find something to learn.|en|1|1|1|false",
 "first-day-at-new-job/s38-l1": "What should you ask your guide before leaving on the first day?|en|1|1|1|false",
 "first-day-at-new-job/s38-l2": "Ask what you should start with tomorrow, so you know where to begin.|en|1|1|1|false",
 "first-day-at-new-job/s38-l3": "It shows you take action, and you will not sit waiting the next morning.|en|1|1|1|false",
 "first-day-at-new-job/s39-l1": "Now it is your turn. Forty questions are waiting below.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s01-a1": "Does this cable work with my phone?|en|1|1|1|false",
 "first-day-serving-or-sales-job/s01-a2": "Yes, it works!|en|1|1|1|false",
 "first-day-serving-or-sales-job/s01-b1": "Does this cable work with my phone?|en|1|1|1|false",
 "first-day-serving-or-sales-job/s01-b2": "I'm new here. Please wait a moment, I'll ask my manager to be sure.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s01-n2": "Which would you choose on your first day?|en|1|1|1|false",
 "first-day-serving-or-sales-job/s02-l1": "What do people expect on day one? Not perfect work. Be on time.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s02-l2": "Ask, and take notes.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s02-l3": "Own mistakes fast.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s02-l4": "And be careful with money.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s03-l1": "Seven stops: the night before, who to ask, learning the menu,|en|1|1|1|false",
 "first-day-serving-or-sales-job/s03-l2": "your first customer, mistakes, money, and the end of the shift.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s04-l1": "Part one: the night before.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s05-l1": "Tomorrow is my first shift. One message first.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s05-l2": "Tomorrow is my first shift. What should I wear, and how early should I come?|en|1|1|1|false",
 "first-day-serving-or-sales-job/s05-l3": "Asking beats guessing. One message, and nobody corrects you in front of everyone.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s06-l1": "Check the arrival time. Come a little before your shift.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s06-l2": "Ask about clothes, shoes, and hair.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s06-l3": "Charge your phone. Bring a water bottle.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s06-l4": "Eat a light meal before the shift.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s07-l1": "Lan's first shift at a grill restaurant. New canvas shoes, chosen to look nice. She didn't ask.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s07-l2": "The floor is always greasy. Mid-shift, she slips and drops a tray of glasses.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s07-l3": "Luckily, nobody was hurt. Later she notices: everyone else wears non-slip shoes.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s08-l1": "For serving work, nice-looking shoes matter most. True or false?|en|1|1|1|false",
 "first-day-serving-or-sales-job/s08-l2": "False. You stand and walk the whole shift. Choose soft, closed shoes with non-slip soles.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s08-l3": "Restaurant floors are often wet.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s09-l1": "Studying the menu until late? Sleep matters more.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s09-l2": "A rested mind learns new dishes much faster.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s10-l1": "Ask one question first, and save a whole shift of embarrassment.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s11-l1": "Part two: you arrive. Who do you ask, and what?|en|1|1|1|false",
 "first-day-serving-or-sales-job/s12-l1": "First, find out who is guiding you today.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s12-l2": "Hello, I'm Dũng. I'm new, so please tell me if I do anything wrong.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s12-l3": "Okay. I'm guiding you today.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s12-l4": "Without a guide, you have nobody to ask, and small mistakes go unnoticed.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s13-l0": "Old staff are so used to these, they forget to tell you. So you ask.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s13-l1": "When is the break, and where do you keep your bag?|en|1|1|1|false",
 "first-day-serving-or-sales-job/s13-l2": "When can you use your phone?|en|1|1|1|false",
 "first-day-serving-or-sales-job/s13-l3": "Who do you tell if something goes wrong?|en|1|1|1|false",
 "first-day-serving-or-sales-job/s13-l4": "Where are the exits, and the first aid box?|en|1|1|1|false",
 "first-day-serving-or-sales-job/s14-l1": "Bring a small notebook, or use your phone notes.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s14-l2": "Write down codes, prices, recipes, how to pack. You won't ask the same thing a third time.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s15-l1": "Guide is free? Ask a few questions at once.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s15-l2": "Busy? Ask only what you need now.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s16-l1": "Part three: learning the menu and the steps.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s17-l1": "Don't try to learn it all in one day.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s17-l2": "Ask which items sell best, and learn those first. Most customers order them.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s18-l1": "Every shop has its own order: take it, enter it, tell the kitchen,|en|1|1|1|false",
 "first-day-serving-or-sales-job/s18-l2": "serve it, then take payment.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s18-l3": "Follow an old hand a few rounds before trying alone.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s19-l1": "Watch how old staff greet customers, suggest dishes, and handle sold-out items.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s19-l2": "Copy their words. It's the fastest way to sound natural.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s20-l1": "Part four: your first customer.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s21-l1": "Hello, welcome! How many people are in your group?|en|1|1|1|false",
 "first-day-serving-or-sales-job/s21-l2": "Smile, look at the customer, speak slowly and clearly.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s21-l3": "Which tea here has less sugar?|en|1|1|1|false",
 "first-day-serving-or-sales-job/s21-l4": "I'm new here. Please wait a moment, I'll check to be sure.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s21-l5": "Don't guess. Customers are kinder than you think.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s21-l6": "Let me repeat: two peach teas with less ice, and one cake.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s21-l7": "That's right.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s21-l8": "Repeat the order before you enter it. No wrong dish, no long wait.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s22-l1": "Back to the cable. Way A: guess wrong, and the customer returns the next day to give it back.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s22-l2": "Upset, right in front of the manager.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s22-l3": "Way B: the customer waits one minute, and buys the right thing.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s22-l4": "And you learn one more thing about the shop's products.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s23-l1": "Not sure? Ask. Don't guess just to finish quickly.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s24-l1": "Part five: mistakes. Every new person makes them.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s25-l1": "Excuse me, one of my dishes is still missing.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s25-l2": "Oh no, I wrote it down wrong. I'll just stay quiet. Maybe he won't notice.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s25-l3": "Wait a second!|en|1|1|1|false",
 "first-day-serving-or-sales-job/s25-l4": "A hidden mistake grows. Tell your guide now, say sorry briefly, and ask how to fix it.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s25-l5": "Let's rewind and try again.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s25-l6": "I'm sorry, I'll make it again right away.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s25-l7": "Thank you.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s25-l8": "Report it early, and it stays small.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s26-l1": "A waiter wrote a dish wrong, and kept quiet.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s26-l2": "The table waited almost half an hour.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s26-l3": "They called the manager. A big complaint.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s27-l1": "A customer speaks rudely? Keep your voice calm.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s27-l2": "Don't argue back.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s27-l3": "Too much to handle? Call the manager. You don't have to solve everything on day one.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s28-l1": "A mistake reported early stays small. A hidden one grows large.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s29-l1": "Part six: handling customers' money.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s30-l1": "Count the cash in front of the customer, and say the amount aloud.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s30-l2": "Count the change twice.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s30-l3": "Check a transfer really reached the shop's account, the shop's way.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s30-l4": "Never put shop money in your pocket, not even for a moment.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s31-l1": "Given a cash drawer? At the start, count it with the person handing it over, and sign or text the amount.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s31-l2": "Same at the end. It protects you if money goes missing.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s32-l1": "A customer shows a payment screen and wants to leave. Ask: please wait while I check the payment.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s32-l2": "Check the shop's account the way you were shown: speaker, card machine, or app.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s32-l3": "Money there? Hand over the goods. Not yet? Call the manager.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s33-l1": "A screen can be an old or edited picture. Money in the account can't be faked.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s33-l2": "Money is paid only when it has arrived.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s34-l1": "Last part: the shift is over.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s35-l1": "Is there anything I should do differently tomorrow?|en|1|1|1|false",
 "first-day-serving-or-sales-job/s35-l2": "Good question. Let's look at today together.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s35-l3": "One question shows you are serious, and gives you the right thing to practise.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s35-l4": "Asking beats waiting for complaints. You fix it before it becomes a problem.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s36-l1": "Write down your start and end times, and what you learned. Checking pay later is easier.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s36-l2": "The first shift is tiring. Eat, sleep early. The clumsy feeling fades after a few shifts.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s37-l1": "If you're a parent, ask: what was fun today, what was hard? Better than asking about pay.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s37-l2": "Notice when your child gets home after evening shifts.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s37-l3": "And remind them to tell you when they'll be late.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s38-l1": "Day one doesn't need to be perfect. Not sure? Ask.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s38-l2": "Report mistakes early.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s38-l3": "And money is paid only when it arrives.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s39-l1": "Why should you not rely only on the customer's phone screen showing a transfer?|en|1|1|1|false",
 "first-day-serving-or-sales-job/s39-l2": "The screen can be an old or edited picture, unlike money in the shop account.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s39-l3": "Money in the shop's account is paid money. A screen proves nothing.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s40-l1": "Do it now: message the shop about your arrival time and clothes.|en|1|1|1|false",
 "first-day-serving-or-sales-job/s40-l2": "Then, forty questions are waiting below.|en|1|1|1|false",
 "first-job-interview-graduate/s01-l1": "Your CV says you are an expert in this software. Try a small table now?|en|1|1|1|false",
 "first-job-interview-graduate/s01-l2": "Now? Um… sure.|en|1|1|1|false",
 "first-job-interview-graduate/s01-l3": "Dung has only watched a few videos. He is stuck at step one.|en|1|1|1|false",
 "first-job-interview-graduate/s01-l4": "His good answers are wasted. What should he have said?|en|1|1|1|false",
 "first-job-interview-graduate/s02-l1": "Your first job interview: what will they ask, and how do you answer? They want four things.|en|1|1|1|false",
 "first-job-interview-graduate/s02-l2": "You understand the job.|en|1|1|1|false",
 "first-job-interview-graduate/s02-l3": "You can tell what you did.|en|1|1|1|false",
 "first-job-interview-graduate/s02-l4": "You are honest about gaps.|en|1|1|1|false",
 "first-job-interview-graduate/s02-l5": "And you want to learn.|en|1|1|1|false",
 "first-job-interview-graduate/s03-l1": "Before the interview.|en|1|1|1|false",
 "first-job-interview-graduate/s03-l2": "Introducing yourself.|en|1|1|1|false",
 "first-job-interview-graduate/s03-l3": "Hard questions.|en|1|1|1|false",
 "first-job-interview-graduate/s03-l4": "Online and in person.|en|1|1|1|false",
 "first-job-interview-graduate/s03-l5": "The end, and after.|en|1|1|1|false",
 "first-job-interview-graduate/s04-l1": "Part one: before the interview.|en|1|1|1|false",
 "first-job-interview-graduate/s05-l1": "Reply the same day. Confirm the time and place, and ask what to bring.|en|1|1|1|false",
 "first-job-interview-graduate/s05-l2": "I confirm the interview at nine on Thursday morning, at your office.|en|1|1|1|false",
 "first-job-interview-graduate/s05-l3": "May I ask if I should prepare any documents?|en|1|1|1|false",
 "first-job-interview-graduate/s05-l4": "Clash with an exam? Ask early to move it, and offer two other times. Silence and no-show loses the chance.|en|1|1|1|false",
 "first-job-interview-graduate/s06-l1": "Learn what the company does, and who its customers are. Underline the skills the job ad repeats.|en|1|1|1|false",
 "first-job-interview-graduate/s06-l2": "Read recent news. Know someone who worked there? Ask how the interviews work.|en|1|1|1|false",
 "first-job-interview-graduate/s07-l1": "No work experience? For each skill, find something real: a thesis, group work, a club, a part-time job.|en|1|1|1|false",
 "first-job-interview-graduate/s07-l2": "Tell it in three steps: the situation, what you did, the result and the lesson.|en|1|1|1|false",
 "first-job-interview-graduate/s08-l1": "Our thesis team was behind schedule.|en|1|1|1|false",
 "first-job-interview-graduate/s08-l2": "I shared the tasks by each person's strengths, and made a shared tracking sheet.|en|1|1|1|false",
 "first-job-interview-graduate/s08-l3": "We finished on time. I learned to remind people without upsetting them.|en|1|1|1|false",
 "first-job-interview-graduate/s09-l1": "Three ideas on paper: your major, one project, why this job. Just a few keywords each.|en|1|1|1|false",
 "first-job-interview-graduate/s09-l2": "Say it out loud to a friend three times, differently. Ask them to interrupt, and find your way back.|en|1|1|1|false",
 "first-job-interview-graduate/s10-l1": "Remember the ideas, not the words. Then an interruption cannot stop you.|en|1|1|1|false",
 "first-job-interview-graduate/s11-l1": "Part two: “Tell me about yourself.”|en|1|1|1|false",
 "first-job-interview-graduate/s12-l1": "Tell me about yourself.|en|1|1|1|false",
 "first-job-interview-graduate/s12-l2": "I am a final-year marketing student. For my thesis, I ran a fanpage for a café.|en|1|1|1|false",
 "first-job-interview-graduate/s12-l3": "I want this role to learn how real campaigns work.|en|1|1|1|false",
 "first-job-interview-graduate/s12-l4": "About one minute, three parts: who you are, what you did for this job, why here. They already have your CV.|en|1|1|1|false",
 "first-job-interview-graduate/s13-l1": "Talking about your results is showing off. True or false?|en|1|1|1|false",
 "first-job-interview-graduate/s13-l2": "False. Feeling shy is normal. But real results are useful facts, so they can choose the right person.|en|1|1|1|false",
 "first-job-interview-graduate/s14-l1": "Part three: the hard questions.|en|1|1|1|false",
 "first-job-interview-graduate/s15-l1": "“What is your weakness?” “I am a bit of a perfectionist” sounds like avoiding. Everyone says it.|en|1|1|1|false",
 "first-job-interview-graduate/s15-l2": "Choose a real weakness that is not central to the job, and say how you are fixing it.|en|1|1|1|false",
 "first-job-interview-graduate/s16-l1": "“Why us?” “A big company, a professional place” fits any company.|en|1|1|1|false",
 "first-job-interview-graduate/s16-l2": "Connect something you learned about them with something you want to learn there.|en|1|1|1|false",
 "first-job-interview-graduate/s17-l1": "Expected salary? Learn the usual range for new graduates in that field and city, from seniors and public reports.|en|1|1|1|false",
 "first-job-interview-graduate/s17-l2": "Give a range, and add that you care about learning too.|en|1|1|1|false",
 "first-job-interview-graduate/s18-l1": "Are you good with this data software?|en|1|1|1|false",
 "first-job-interview-graduate/s18-l2": "Yes, I am an expert!|en|1|1|1|false",
 "first-job-interview-graduate/s18-l3": "Wait a second!|en|1|1|1|false",
 "first-job-interview-graduate/s18-l4": "One small test, and the truth shows. A guess needs only one more question.|en|1|1|1|false",
 "first-job-interview-graduate/s18-l5": "Let's rewind and try again.|en|1|1|1|false",
 "first-job-interview-graduate/s18-l6": "I have not used it in real work yet. If I need it, I will read the guide and ask the team first.|en|1|1|1|false",
 "first-job-interview-graduate/s18-l7": "That is an honest answer.|en|1|1|1|false",
 "first-job-interview-graduate/s18-l8": "Say exactly how much you know, not one word more.|en|1|1|1|false",
 "first-job-interview-graduate/s19-l1": "Part four: online, and in person.|en|1|1|1|false",
 "first-job-interview-graduate/s20-l1": "The day before, test the connection, microphone and camera. Pick a quiet spot, with light in front of your face.|en|1|1|1|false",
 "first-job-interview-graduate/s20-l2": "Use your real name. Join a few minutes early. Turn off notifications.|en|1|1|1|false",
 "first-job-interview-graduate/s21-l1": "The connection dropped! Message them right away.|en|1|1|1|false",
 "first-job-interview-graduate/s21-l2": "Sorry, my connection just dropped. I am joining again now.|en|1|1|1|false",
 "first-job-interview-graduate/s21-l3": "No problem, I will wait.|en|1|1|1|false",
 "first-job-interview-graduate/s21-l4": "Staying calm in a problem is also a plus.|en|1|1|1|false",
 "first-job-interview-graduate/s22-l0": "Lan has an online interview at nine.|en|1|1|1|false",
 "first-job-interview-graduate/s22-a1": "Can you hear me?|en|1|1|1|false",
 "first-job-interview-graduate/s22-a2": "Sorry, could you repeat that? It is very noisy here.|en|1|1|1|false",
 "first-job-interview-graduate/s22-b1": "Good morning. I tested everything here yesterday.|en|1|1|1|false",
 "first-job-interview-graduate/s22-b2": "Great. Let's begin.|en|1|1|1|false",
 "first-job-interview-graduate/s22-l1": "Way A: a noisy café, no test, a weak connection. Way B: a library room, tested the day before, in early.|en|1|1|1|false",
 "first-job-interview-graduate/s22-l2": "Test the day before, and relax on the day.|en|1|1|1|false",
 "first-job-interview-graduate/s23-l1": "In person: arrive about fifteen minutes early, with a printed CV, a pen and a notebook.|en|1|1|1|false",
 "first-job-interview-graduate/s23-l2": "Neat clothes that suit the field. Not sure? Ask your contact. And remember who you will meet.|en|1|1|1|false",
 "first-job-interview-graduate/s24-l1": "Good morning! I am here for a nine o'clock interview.|en|1|1|1|false",
 "first-job-interview-graduate/s24-l2": "Good morning. Please wait here a moment.|en|1|1|1|false",
 "first-job-interview-graduate/s24-l3": "Be polite to everyone, from the guard to reception. It is noticed, and they may be future colleagues.|en|1|1|1|false",
 "first-job-interview-graduate/s25-l1": "Last part: the end of the interview, and after.|en|1|1|1|false",
 "first-job-interview-graduate/s26-l1": "Do you have any questions for us?|en|1|1|1|false",
 "first-job-interview-graduate/s26-l2": "How are new people in this role usually guided? And what does a normal day look like?|en|1|1|1|false",
 "first-job-interview-graduate/s26-l3": "And what is the next step in the process?|en|1|1|1|false",
 "first-job-interview-graduate/s26-l4": "“No questions” can look like you do not care.|en|1|1|1|false",
 "first-job-interview-graduate/s27-l1": "Thank you for your time this morning.|en|1|1|1|false",
 "first-job-interview-graduate/s27-l2": "What you said about guiding new people made me want to join the team even more.|en|1|1|1|false",
 "first-job-interview-graduate/s27-l3": "Send it the same day, with one specific detail. No news after their date? One polite email. Just once.|en|1|1|1|false",
 "first-job-interview-graduate/s28-l1": "Friends got calls weeks before you? Each field hires at its own pace. Called first does not mean the best fit.|en|1|1|1|false",
 "first-job-interview-graduate/s29-l1": "Two failures in a row. I am bad at this. I will stop applying.|en|1|1|1|false",
 "first-job-interview-graduate/s29-l2": "Wait a second!|en|1|1|1|false",
 "first-job-interview-graduate/s29-l3": "Before you give up, send one polite email: thank them, and ask for feedback.|en|1|1|1|false",
 "first-job-interview-graduate/s29-l4": "Let's rewind and try again.|en|1|1|1|false",
 "first-job-interview-graduate/s29-l5": "Thank you for meeting me. Could you tell me what I could improve?|en|1|1|1|false",
 "first-job-interview-graduate/s29-l6": "They said my answers were general, with no examples. I will prepare real stories.|en|1|1|1|false",
 "first-job-interview-graduate/s29-l7": "Fail once, ask one question, fix one thing.|en|1|1|1|false",
 "first-job-interview-graduate/s30-l1": "Everyone is nervous the first time, and interviewers know it.|en|1|1|1|false",
 "first-job-interview-graduate/s30-l2": "Pick three things you did. Write three sentences each, then practise out loud once.|en|1|1|1|false",
 "first-job-interview-graduate/s31-l1": "What should you do on the same day after the interview?|en|1|1|1|false",
 "first-job-interview-graduate/s31-l2": "Send a short thank you email that mentions something specific from the conversation.|en|1|1|1|false",
 "first-job-interview-graduate/s31-l3": "It helps them remember you. Calling again and again only adds pressure.|en|1|1|1|false",
 "first-job-interview-graduate/s32-l1": "Your turn. Forty questions are waiting below.|en|1|1|1|false",
 "first-mistake-at-work/s01-l1": "Dung once sent a meeting invite to the whole team by mistake.|en|1|1|1|false",
 "first-mistake-at-work/s01-l2": "Could you read this email before I send it? And this one too?|en|1|1|1|false",
 "first-mistake-at-work/s01-l3": "After a mistake, the more I check, the safer I am.|en|1|1|1|false",
 "first-mistake-at-work/s01-l4": "Is Dung right?|en|1|1|1|false",
 "first-mistake-at-work/s02-l1": "Will you be fired? Usually not, if you go in the right order.|en|1|1|1|false",
 "first-mistake-at-work/s02-l2": "Stop.|en|1|1|1|false",
 "first-mistake-at-work/s02-l3": "Report early.|en|1|1|1|false",
 "first-mistake-at-work/s02-l4": "Fix it with others.|en|1|1|1|false",
 "first-mistake-at-work/s02-l5": "Then change how you work. People remember how you handle it.|en|1|1|1|false",
 "first-mistake-at-work/s03-l1": "Six stops, from the first ten minutes to feeling okay again.|en|1|1|1|false",
 "first-mistake-at-work/s04-l1": "Part one: the first ten minutes.|en|1|1|1|false",
 "first-mistake-at-work/s05-l1": "First, stop. Do not rush to send, change, or delete anything yet.|en|1|1|1|false",
 "first-mistake-at-work/s05-l2": "In a panic, people send a quick correction, and it is wrong too. One mistake becomes two.|en|1|1|1|false",
 "first-mistake-at-work/s06-l1": "Write four quick lines. What went wrong, and since when?|en|1|1|1|false",
 "first-mistake-at-work/s06-l2": "Who or what is affected?|en|1|1|1|false",
 "first-mistake-at-work/s06-l3": "Is it still spreading? If so, stopping it comes first.|en|1|1|1|false",
 "first-mistake-at-work/s06-l4": "What have you tried, and what happened? Your report will be much clearer.|en|1|1|1|false",
 "first-mistake-at-work/s07-l1": "Never delete messages, files, or traces to hide it.|en|1|1|1|false",
 "first-mistake-at-work/s07-l2": "The team needs them to see how big it is. Deleting looks worse than the mistake.|en|1|1|1|false",
 "first-mistake-at-work/s08-l1": "Part two: tell your boss, or fix it quietly?|en|1|1|1|false",
 "first-mistake-at-work/s09-l1": "Thao entered the wrong delivery date for a big order. She is on probation, and scared.|en|1|1|1|false",
 "first-mistake-at-work/s09-l2": "I will just fix it quietly. Nobody needs to know.|en|1|1|1|false",
 "first-mistake-at-work/s09-l3": "Wait a second!|en|1|1|1|false",
 "first-mistake-at-work/s09-l4": "The warehouse printed the old date. Late goods, an angry client. And the boss was not told.|en|1|1|1|false",
 "first-mistake-at-work/s09-l5": "Let's rewind and try another way.|en|1|1|1|false",
 "first-mistake-at-work/s09-l6": "I entered a wrong date on a big order. I have the right one. Shall I fix it, or will you check first?|en|1|1|1|false",
 "first-mistake-at-work/s09-l7": "A mistake reported early stays small. A hidden one grows.|en|1|1|1|false",
 "first-mistake-at-work/s10-l1": "Report early. Early mistakes are easy to fix, before others build on your wrong part.|en|1|1|1|false",
 "first-mistake-at-work/s10-l2": "Fix quietly only small errors nobody used, like a typo in your own draft.|en|1|1|1|false",
 "first-mistake-at-work/s10-l3": "If it reached a client or a colleague, let your boss hear it from you first.|en|1|1|1|false",
 "first-mistake-at-work/s11-l1": "I just found a wrong line in the price list we sent the client this morning.|en|1|1|1|false",
 "first-mistake-at-work/s11-l2": "I have prepared the correct version.|en|1|1|1|false",
 "first-mistake-at-work/s11-l3": "Shall I resend it with an apology, or will you check it first?|en|1|1|1|false",
 "first-mistake-at-work/s11-l4": "Three parts: what happened, how it affects the work, and what you suggest.|en|1|1|1|false",
 "first-mistake-at-work/s12-l1": "Some mistakes need a report right now. Mistakes about money.|en|1|1|1|false",
 "first-mistake-at-work/s12-l2": "Customers' personal information.|en|1|1|1|false",
 "first-mistake-at-work/s12-l3": "Other people's safety.|en|1|1|1|false",
 "first-mistake-at-work/s12-l4": "Or a mistake still spreading. No reply to your message? Call your boss directly.|en|1|1|1|false",
 "first-mistake-at-work/s13-l1": "Many companies have their own steps, like telling IT or the legal team. Ask in week one.|en|1|1|1|false",
 "first-mistake-at-work/s13-l2": "If there is a problem with client data, who should I report to? Then you will not panic.|en|1|1|1|false",
 "first-mistake-at-work/s14-l1": "Part three: when it reaches a client or a colleague.|en|1|1|1|false",
 "first-mistake-at-work/s15-l0": "Dung sent a client an old quote. He wants to fix it fast.|en|1|1|1|false",
 "first-mistake-at-work/s15-a1": "I am so sorry. I will give you an extra discount.|en|1|1|1|false",
 "first-mistake-at-work/s15-a2": "The client is happy, but Dung cannot decide that discount. The boss must explain again.|en|1|1|1|false",
 "first-mistake-at-work/s15-b1": "I sent the client an old quote. I will call to apologise. What may I offer?|en|1|1|1|false",
 "first-mistake-at-work/s15-b2": "Then he calls with an apology and the right quote. A few minutes slower, but the client hears it once.|en|1|1|1|false",
 "first-mistake-at-work/s16-l1": "Each company has its own way to make things right. New staff easily promise more than allowed, like a refund.|en|1|1|1|false",
 "first-mistake-at-work/s16-l2": "Apologise fast. Ask before promising.|en|1|1|1|false",
 "first-mistake-at-work/s17-l1": "I sent you the wrong numbers yesterday. Here are the right ones.|en|1|1|1|false",
 "first-mistake-at-work/s17-l2": "I am sorry you had to redo the chart.|en|1|1|1|false",
 "first-mistake-at-work/s17-l3": "Okay, thanks.|en|1|1|1|false",
 "first-mistake-at-work/s17-l4": "Short and clear beats a long explanation. Apologise once, properly.|en|1|1|1|false",
 "first-mistake-at-work/s17-l5": "Apologise again and again, and they must comfort you. They need the problem fixed.|en|1|1|1|false",
 "first-mistake-at-work/s18-l1": "Part four: when it is not all your fault.|en|1|1|1|false",
 "first-mistake-at-work/s19-l1": "Many mistakes have many causes: unclear instructions, wrong input, a rushed deadline.|en|1|1|1|false",
 "first-mistake-at-work/s19b-l2": "Tell the events in order, and take your part first. People trust someone who admits their share.|en|1|1|1|false",
 "first-mistake-at-work/s20-l1": "My part was not checking the numbers before sending.|en|1|1|1|false",
 "first-mistake-at-work/s20-l2": "The input also differs from last week. Should we add a check step?|en|1|1|1|false",
 "first-mistake-at-work/s20-l3": "Own your part, state the facts, suggest a fix. No blame.|en|1|1|1|false",
 "first-mistake-at-work/s21-l1": "Take all the blame, even what is not yours, to keep the peace. Good idea?|en|1|1|1|false",
 "first-mistake-at-work/s21-l2": "No. The real cause stays unfixed, and the mistake comes back, maybe to someone else.|en|1|1|1|false",
 "first-mistake-at-work/s22-l1": "Part five: so it never happens again.|en|1|1|1|false",
 "first-mistake-at-work/s23-l1": "Ask why a few times, until you reach the root. Why the wrong file? Two files had similar names.|en|1|1|1|false",
 "first-mistake-at-work/s23-l2": "Why similar? There was no way to name versions.|en|1|1|1|false",
 "first-mistake-at-work/s23-l3": "The root is usually a small habit, not that you are bad. Writing only I was careless misses it.|en|1|1|1|false",
 "first-mistake-at-work/s24-l1": "Write a checklist of three to five lines for the task that went wrong.|en|1|1|1|false",
 "first-mistake-at-work/s24-l2": "Read it before every similar job.|en|1|1|1|false",
 "first-mistake-at-work/s24-l3": "Others could trip on it too? Suggest the step for the whole team.|en|1|1|1|false",
 "first-mistake-at-work/s24-l4": "Then tell your boss: I resent the right version and added a check step. I will always do this now.|en|1|1|1|false",
 "first-mistake-at-work/s25-l1": "Thao twice emailed a partner without the attachment. Before: write, send, notice, then promise to be careful.|en|1|1|1|false",
 "first-mistake-at-work/s25-l2": "After: attach first, write, read once, then send. No more missing files.|en|1|1|1|false",
 "first-mistake-at-work/s25b-l3": "On busy days, a promise is forgotten. A changed step still works. Do not promise; change how you work.|en|1|1|1|false",
 "first-mistake-at-work/s26-l1": "Last part: getting your spirit back.|en|1|1|1|false",
 "first-mistake-at-work/s27-l1": "One first mistake rarely decides your probation. They look at three things. Did you report honestly?|en|1|1|1|false",
 "first-mistake-at-work/s27-l2": "Did you fix it?|en|1|1|1|false",
 "first-mistake-at-work/s27-l3": "Did you repeat it? Handling mistakes well matters more than never making one.|en|1|1|1|false",
 "first-mistake-at-work/s28-l1": "Do not make up for it by staying late every night, or taking on lots of work. Tired people make new mistakes.|en|1|1|1|false",
 "first-mistake-at-work/s28-l2": "Steady, careful work helps more.|en|1|1|1|false",
 "first-mistake-at-work/s28-l3": "Still upset? Talk to a senior colleague or your mentor. Their own first mistakes will comfort you.|en|1|1|1|false",
 "first-mistake-at-work/s29-l1": "Back to Dung. After a mistake, the more you check, the safer you are. True or false?|en|1|1|1|false",
 "first-mistake-at-work/s29-l2": "False. A week later, the leader said: the old mistake is forgotten, but you slow the team.|en|1|1|1|false",
 "first-mistake-at-work/s30-l1": "One check for this kind of mistake: the recipient list, before sending an invite.|en|1|1|1|false",
 "first-mistake-at-work/s30-l2": "Then I carry on as normal.|en|1|1|1|false",
 "first-mistake-at-work/s30-l3": "Mistakes need fixing, not fear.|en|1|1|1|false",
 "first-mistake-at-work/s31-l1": "Report early, and it stays small.|en|1|1|1|false",
 "first-mistake-at-work/s31-l2": "Apologise fast, ask before promising.|en|1|1|1|false",
 "first-mistake-at-work/s31-l3": "Change how you work. Today, ask your mentor: who do I tell if I make a mistake?|en|1|1|1|false",
 "first-mistake-at-work/s32-l1": "You sent the wrong file because two files had similar names, what is the root cause?|en|1|1|1|false",
 "first-mistake-at-work/s32-l2": "There was no clear way to name versions, which is a habit you can change.|en|1|1|1|false",
 "first-mistake-at-work/s32-l3": "The root is usually a small habit, not you. Fix the habit, and it will not come back.|en|1|1|1|false",
 "first-mistake-at-work/s33-l1": "Wrong answers are fine here. Forty questions are waiting below.|en|1|1|1|false",
 "first-three-months-new-job/s01-l2": "Thao, most of these invoices need to be entered again.|en|1|1|1|false",
 "first-three-months-new-job/s01-l3": "Most of them? Oh no.|en|1|1|1|false",
 "first-three-months-new-job/s01-l4": "End of week one. Thao is tired and embarrassed. What went wrong?|en|1|1|1|false",
 "first-three-months-new-job/s02-l1": "Will you pass probation? The people kept are rarely the best on day one. They|en|1|1|1|false",
 "first-three-months-new-job/s02-l2": "understand the job,|en|1|1|1|false",
 "first-three-months-new-job/s02-l3": "ask at the right time,|en|1|1|1|false",
 "first-three-months-new-job/s02-l4": "fix mistakes fast,|en|1|1|1|false",
 "first-three-months-new-job/s02-l5": "and show progress every week.|en|1|1|1|false",
 "first-three-months-new-job/s03-l1": "Here is your map, in the order you will live it.|en|1|1|1|false",
 "first-three-months-new-job/s04-l1": "Part one: before day one.|en|1|1|1|false",
 "first-three-months-new-job/s05-l1": "Reread your offer letter and job description: your position and your direct manager.|en|1|1|1|false",
 "first-three-months-new-job/s05-l2": "Working hours, probation length, and probation pay.|en|1|1|1|false",
 "first-three-months-new-job/s05-l3": "Anything unclear? Ask HR before, not on the first morning.|en|1|1|1|false",
 "first-three-months-new-job/s06-l1": "The night before: the papers HR asked for, and a tested route.|en|1|1|1|false",
 "first-three-months-new-job/s06-l2": "Suitable clothes, a notebook or notes app.|en|1|1|1|false",
 "first-three-months-new-job/s06-l3": "And the name of the person meeting you.|en|1|1|1|false",
 "first-three-months-new-job/s07-l1": "Leaving an old job? Hand over neatly and part on good terms. Your industry is smaller than you think.|en|1|1|1|false",
 "first-three-months-new-job/s07-l2": "At the new place, save: at my old company we did this. Wait until you know why here is different.|en|1|1|1|false",
 "first-three-months-new-job/s08-l1": "Part two: week one. How not to get lost.|en|1|1|1|false",
 "first-three-months-new-job/s09-l1": "Nobody expects much output in week one. Speed without understanding means redoing. Understand three things.|en|1|1|1|false",
 "first-three-months-new-job/s09-l2": "Who you work for.|en|1|1|1|false",
 "first-three-months-new-job/s09-l3": "Whose work yours connects to.|en|1|1|1|false",
 "first-three-months-new-job/s09-l4": "And what good work means here.|en|1|1|1|false",
 "first-three-months-new-job/s10-l1": "Given a task? Repeat it in your own words, and ask for the deadline.|en|1|1|1|false",
 "first-three-months-new-job/s10-l2": "So you need a comparison of three suppliers, by Thursday afternoon. Is that right?|en|1|1|1|false",
 "first-three-months-new-job/s10-l3": "Just saying I understand hides mistakes. Repeating lets your manager catch them before you start.|en|1|1|1|false",
 "first-three-months-new-job/s11-l1": "Back to Thao's Monday. She is entering invoices in accounting.|en|1|1|1|false",
 "first-three-months-new-job/s11-l2": "Which code goes with this kind of cost?|en|1|1|1|false",
 "first-three-months-new-job/s11-l3": "She looks so busy. I will just guess.|en|1|1|1|false",
 "first-three-months-new-job/s11-l4": "Wait a second!|en|1|1|1|false",
 "first-three-months-new-job/s11-l5": "Money, clients, data, or hard to undo? Ask at once. Guessing cost a week.|en|1|1|1|false",
 "first-three-months-new-job/s11-l6": "Let's rewind and try again.|en|1|1|1|false",
 "first-three-months-new-job/s11-l7": "Excuse me, a quick question. Which code is this cost?|en|1|1|1|false",
 "first-three-months-new-job/s11-l8": "She explained it in under five minutes. Ask five minutes, save five days.|en|1|1|1|false",
 "first-three-months-new-job/s12-l1": "New people fear two things: asking too much, and getting it wrong. Here is a simple rule.|en|1|1|1|false",
 "first-three-months-new-job/s12-l2": "Money, clients, data, or anything hard to undo: ask at once.|en|1|1|1|false",
 "first-three-months-new-job/s12-l3": "Everything else: search first, note what you tried, then ask once. Fewer, clearer questions.|en|1|1|1|false",
 "first-three-months-new-job/s13-l1": "Part three: month one. Fitting in naturally.|en|1|1|1|false",
 "first-three-months-new-job/s14-l1": "Company culture shows in small things. Do meetings start on time?|en|1|1|1|false",
 "first-three-months-new-job/s14-l2": "Email, or group chat?|en|1|1|1|false",
 "first-three-months-new-job/s14-l3": "Short reports, or detailed? Written rules show the official way. Watching shows the unwritten habits.|en|1|1|1|false",
 "first-three-months-new-job/s15-l1": "By the end of month one, you know who decides, and who can help.|en|1|1|1|false",
 "first-three-months-new-job/s15-l2": "You know the team's main channel.|en|1|1|1|false",
 "first-three-months-new-job/s15-l3": "And you asked: after three months, what do you expect me to do well?|en|1|1|1|false",
 "first-three-months-new-job/s16-l1": "Dung changed jobs. Skilled, so he just works: lunch alone, almost no replies in the group chat.|en|1|1|1|false",
 "first-three-months-new-job/s16-l2": "Then he needs urgent numbers from the next team. Nobody knows who he is.|en|1|1|1|false",
 "first-three-months-new-job/s16-l3": "Nobody puts him first. The work is late, though his skills were fine.|en|1|1|1|false",
 "first-three-months-new-job/s16-l4": "Know people when you are free. Ask them when you need to.|en|1|1|1|false",
 "first-three-months-new-job/s17-l1": "Part four: month two. Feedback, mistakes, and more work.|en|1|1|1|false",
 "first-three-months-new-job/s18-l0": "Real work brings more feedback. Usually, your boss is investing time in you, not letting you go.|en|1|1|1|false",
 "first-three-months-new-job/s18-a1": "This report has no comparison with last month.|en|1|1|1|false",
 "first-three-months-new-job/s18-a2": "But I did exactly what you told me!|en|1|1|1|false",
 "first-three-months-new-job/s18-a3": "Silent all afternoon. At night she sees the leader was right, but tomorrow feels awkward.|en|1|1|1|false",
 "first-three-months-new-job/s18-b1": "This report has no comparison with last month.|en|1|1|1|false",
 "first-three-months-new-job/s18-b2": "Which parts do you need compared with last month?|en|1|1|1|false",
 "first-three-months-new-job/s18-b3": "She listens, asks, takes notes, and explains in private later if needed. Fixed the same day.|en|1|1|1|false",
 "first-three-months-new-job/s19-l1": "Listen to the end before you speak. Fix it before you feel sad.|en|1|1|1|false",
 "first-three-months-new-job/s20-l1": "Almost everyone makes a first mistake. Report early, say what happened, and suggest a fix.|en|1|1|1|false",
 "first-three-months-new-job/s20-l2": "Early, your boss can limit the damage. Secret fixes cannot.|en|1|1|1|false",
 "first-three-months-new-job/s20-l3": "More work, more messages. Keep them short and polite. Say what you need, and by when.|en|1|1|1|false",
 "first-three-months-new-job/s20-l4": "A long message with no deadline gets delayed.|en|1|1|1|false",
 "first-three-months-new-job/s21-l1": "Work piling up? Write everything on one list.|en|1|1|1|false",
 "first-three-months-new-job/s21-l2": "Ask your boss which comes first, before tasks overlap.|en|1|1|1|false",
 "first-three-months-new-job/s21-l3": "Warn early if something will be late. That leaves time to change the plan, find help, or move the deadline.|en|1|1|1|false",
 "first-three-months-new-job/s22-l1": "Part five: your first salary.|en|1|1|1|false",
 "first-three-months-new-job/s23a-l1": "Your first pay usually comes after about a month. Probation pay can be lower than official pay.|en|1|1|1|false",
 "first-three-months-new-job/s23-l2": "But under the 2019 Labour Code, at least eighty-five percent. The exact amount is in your offer and contract.|en|1|1|1|false",
 "first-three-months-new-job/s24-l1": "Budget on the probation pay you actually receive, not the bigger number coming later.|en|1|1|1|false",
 "first-three-months-new-job/s24-l2": "And set aside a small amount the day your pay arrives.|en|1|1|1|false",
 "first-three-months-new-job/s25-l1": "Last part: the end of probation, and the review.|en|1|1|1|false",
 "first-three-months-new-job/s26-l1": "For jobs needing college level or higher, probation is at most sixty days. Check the end date in your contract.|en|1|1|1|false",
 "first-three-months-new-job/s26-l2": "So the review often comes near the end of month two. Do not wait for it. Halfway, ask for a short talk.|en|1|1|1|false",
 "first-three-months-new-job/s26-l3": "Where am I doing well, and what should I improve to meet the standard?|en|1|1|1|false",
 "first-three-months-new-job/s27-l1": "From week one, write a few lines each week: tasks, results, lessons. Notes beat memory.|en|1|1|1|false",
 "first-three-months-new-job/s27b-l2a": "The boss asks: what did you contribute?|en|1|1|1|false",
 "first-three-months-new-job/s27c-l2b": "Before: I did all my tasks. True, but it shows nothing.|en|1|1|1|false",
 "first-three-months-new-job/s27c-l3": "After: the weekly stock report, cut from one day to half a day, plus help with the trade fair.|en|1|1|1|false",
 "first-three-months-new-job/s27d-l4": "Each task, with a result, because there were notes. Work each week, write each week.|en|1|1|1|false",
 "first-three-months-new-job/s28-l1": "Contract and pay after probation differ by company and contract type. Ask HR, and read before you sign.|en|1|1|1|false",
 "first-three-months-new-job/s28-l2": "Social insurance is set by law. Under the 2024 law, from July 2025, contracts of one month or more must join.|en|1|1|1|false",
 "first-three-months-new-job/s28-l3": "Whether probation is covered depends on your contract. Ask HR when payments start.|en|1|1|1|false",
 "first-three-months-new-job/s29-l1": "Save this list. Week one: understand the job, the people, and what good means.|en|1|1|1|false",
 "first-three-months-new-job/s29-l2": "Month one: know people and channels.|en|1|1|1|false",
 "first-three-months-new-job/s29-l3": "Month two: feedback, mistakes, messages, priorities, and your first pay.|en|1|1|1|false",
 "first-three-months-new-job/s29-l4": "Before probation ends: assess yourself, ask for comments, prepare the review.|en|1|1|1|false",
 "first-three-months-new-job/s30-l1": "If the job does not fit after probation, you failed. True or false?|en|1|1|1|false",
 "first-three-months-new-job/s30-l2": "False. Probation lets both sides check the fit. Talk honestly and politely, and take the lessons along.|en|1|1|1|false",
 "first-three-months-new-job/s31-l1": "Thao's invoices? One short question would have saved her week.|en|1|1|1|false",
 "first-three-months-new-job/s31-l2": "Three months do not need perfect. Just progress, that people can see.|en|1|1|1|false",
 "first-three-months-new-job/s31-l3": "Today, start a three-month diary: who you work for, your first task, what good means.|en|1|1|1|false",
 "first-three-months-new-job/s32-l1": "You make your first real mistake at work, what should you do?|en|1|1|1|false",
 "first-three-months-new-job/s32-l2": "Report it early, explain what happened, and suggest a way to fix it.|en|1|1|1|false",
 "first-three-months-new-job/s32-l3": "Reporting early shows responsibility, and the mistake is usually still small.|en|1|1|1|false",
 "first-three-months-new-job/s33-l1": "Your turn. Forty questions are waiting below.|en|1|1|1|false",
 "fit-in-with-colleagues/s01-l1": "Thao is new. Two colleagues add her to a private chat.|en|1|1|1|false",
 "fit-in-with-colleagues/s01-l2": "Join us here. It is just for fun complaining!|en|1|1|1|false",
 "fit-in-with-colleagues/s01-l3": "Sure! About how the manager runs meetings…|en|1|1|1|false",
 "fit-in-with-colleagues/s01-l4": "A month later, something happens. We will come back to it.|en|1|1|1|false",
 "fit-in-with-colleagues/s02-l1": "Still feel like a guest at work? Fitting in does not mean being loud.|en|1|1|1|false",
 "fit-in-with-colleagues/s02-l2": "Watch before you follow.|en|1|1|1|false",
 "fit-in-with-colleagues/s02-l3": "Take small steps first.|en|1|1|1|false",
 "fit-in-with-colleagues/s02-l4": "Give credit to others.|en|1|1|1|false",
 "fit-in-with-colleagues/s02-l5": "And stay out of gossip.|en|1|1|1|false",
 "fit-in-with-colleagues/s03-l1": "Six stops, from reading the culture to knowing your limits.|en|1|1|1|false",
 "fit-in-with-colleagues/s04-l1": "Part one: what is company culture?|en|1|1|1|false",
 "fit-in-with-colleagues/s05-l1": "Culture is the unwritten rules: who decides, direct or gentle talk, which channel, strict or flexible hours.|en|1|1|1|false",
 "fit-in-with-colleagues/s05-l2": "Official rules are written down. These, nobody hands you. You learn them by watching.|en|1|1|1|false",
 "fit-in-with-colleagues/s06-l1": "Look at small things. Do meetings start on time? Email or group chat?|en|1|1|1|false",
 "fit-in-with-colleagues/s06-l2": "Messages after hours? Short or detailed reports?|en|1|1|1|false",
 "fit-in-with-colleagues/s06-l3": "Are disagreements said in meetings, or in private?|en|1|1|1|false",
 "fit-in-with-colleagues/s06-l4": "In the first two weeks, watch more, judge less. Something strange may have a reason.|en|1|1|1|false",
 "fit-in-with-colleagues/s07-l1": "Thao moved from a small startup to an old company. She sends short messages: ok, done.|en|1|1|1|false",
 "fit-in-with-colleagues/s07-l2": "Here, people greet first and use polite words. The manager notices.|en|1|1|1|false",
 "fit-in-with-colleagues/s07-l3": "I see. Thank you for telling me.|en|1|1|1|false",
 "fit-in-with-colleagues/s07-l4": "In a new house, follow its customs. Watch first, then follow.|en|1|1|1|false",
 "fit-in-with-colleagues/s08-l1": "Part two: starting a talk when you know nobody.|en|1|1|1|false",
 "fit-in-with-colleagues/s09-l1": "Have you worked on this for long? I find this part hard. Any tips?|en|1|1|1|false",
 "fit-in-with-colleagues/s09-l2": "Sure, let me show you.|en|1|1|1|false",
 "fit-in-with-colleagues/s09-l3": "Start with work. Everyone likes being asked about what they are good at. Private questions can feel uncomfortable.|en|1|1|1|false",
 "fit-in-with-colleagues/s10-l1": "Short moments: waiting for the lift, making tea. Ask about the weekend, or praise something they just finished.|en|1|1|1|false",
 "fit-in-with-colleagues/s10-l2": "Someone you work with a lot? Invite them for a short coffee.|en|1|1|1|false",
 "fit-in-with-colleagues/s10-l3": "I am new and want to understand your work, to cooperate well. Do you have fifteen minutes this week?|en|1|1|1|false",
 "fit-in-with-colleagues/s10-l4": "An invitation with a clear reason is usually accepted.|en|1|1|1|false",
 "fit-in-with-colleagues/s11-l1": "Shy? You do not have to force yourself to talk a lot, or make loud jokes.|en|1|1|1|false",
 "fit-in-with-colleagues/s11-l2": "Listen well, remember people's stories, and ask about them next time. That bond lasts.|en|1|1|1|false",
 "fit-in-with-colleagues/s12-l1": "Part three: group chats and team events.|en|1|1|1|false",
 "fit-in-with-colleagues/s13-l1": "New in the group chat? Read for a few days to learn the tone.|en|1|1|1|false",
 "fit-in-with-colleagues/s13-l2": "Stay on topic, in the right group. Something for one person? Message them directly.|en|1|1|1|false",
 "fit-in-with-colleagues/s14-l1": "Team events: try to join the first few, even briefly. People see you outside work.|en|1|1|1|false",
 "fit-in-with-colleagues/s14-l2": "Cannot come? Decline politely. A polite message keeps the door open. Silence does not.|en|1|1|1|false",
 "fit-in-with-colleagues/s14-l3": "You do not need alcohol to be liked. I do not drink. May I have a soft drink, please?|en|1|1|1|false",
 "fit-in-with-colleagues/s14-l4": "Or: I will head home first. I have an early start tomorrow. Thank you, everyone.|en|1|1|1|false",
 "fit-in-with-colleagues/s15-l1": "Week one. The team plans a dinner to welcome the new member. That is Dung. He is a bit tired.|en|1|1|1|false",
 "fit-in-with-colleagues/s15-l2": "It is just eating. I will text them that I cannot come.|en|1|1|1|false",
 "fit-in-with-colleagues/s15-l3": "Wait a second!|en|1|1|1|false",
 "fit-in-with-colleagues/s15-l4": "That dinner is for you. Miss it, and you miss the stories that start there.|en|1|1|1|false",
 "fit-in-with-colleagues/s15-l5": "Let's rewind and try another way.|en|1|1|1|false",
 "fit-in-with-colleagues/s15-l6": "I will come. I may leave a bit early, if that is okay.|en|1|1|1|false",
 "fit-in-with-colleagues/s15-l7": "Great, see you there!|en|1|1|1|false",
 "fit-in-with-colleagues/s15-l8": "One hour there beats many sorry messages. At your own welcome, do not leave your seat empty.|en|1|1|1|false",
 "fit-in-with-colleagues/s16-l1": "Part four: what can a newcomer give?|en|1|1|1|false",
 "fit-in-with-colleagues/s17-l1": "New people have things to give. A fresh view.|en|1|1|1|false",
 "fit-in-with-colleagues/s17-l2": "A small skill, like making slides or using some software.|en|1|1|1|false",
 "fit-in-with-colleagues/s17-l3": "Or small jobs, like taking meeting notes.|en|1|1|1|false",
 "fit-in-with-colleagues/s18-l1": "You can offer: I have some time this week. Can I help with anything?|en|1|1|1|false",
 "fit-in-with-colleagues/s18-l2": "But only after your own main work is fine. You are judged on that first.|en|1|1|1|false",
 "fit-in-with-colleagues/s19-l1": "When someone helps, name them when you report to the boss. Tu helped me with these numbers.|en|1|1|1|false",
 "fit-in-with-colleagues/s19-l2": "Thanking in private is nice. Naming them in front of the boss gives fair credit. People remember it for a long time.|en|1|1|1|false",
 "fit-in-with-colleagues/s20-l1": "Thanking a helper privately is enough. True or false?|en|1|1|1|false",
 "fit-in-with-colleagues/s20-l2": "False. Name them in front of the manager. Watch this.|en|1|1|1|false",
 "fit-in-with-colleagues/s21-l1": "Co Hoa from the next team helped Thao until late. Now Thao presents.|en|1|1|1|false",
 "fit-in-with-colleagues/s21-l2": "Here are the numbers. I finished them last night.|en|1|1|1|false",
 "fit-in-with-colleagues/s21-l3": "Wait a second!|en|1|1|1|false",
 "fit-in-with-colleagues/s21-l4": "The boss praises Thao's speed. But next time she asks, she hears: I am busy.|en|1|1|1|false",
 "fit-in-with-colleagues/s21-l5": "Let's rewind and try another way.|en|1|1|1|false",
 "fit-in-with-colleagues/s21-l6": "Co Hoa helped me with these numbers until last night.|en|1|1|1|false",
 "fit-in-with-colleagues/s21-l7": "The boss sees one more good worker. Help comes easily next time. Got help? Say it, with their name.|en|1|1|1|false",
 "fit-in-with-colleagues/s22-l1": "Part five: gossip and groups.|en|1|1|1|false",
 "fit-in-with-colleagues/s23-l1": "Someone starts talking about another colleague. Listen politely. Do not add, repeat, or believe it fast.|en|1|1|1|false",
 "fit-in-with-colleagues/s23-l2": "I am new, so I do not know about that. By the way, about yesterday's task…|en|1|1|1|false",
 "fit-in-with-colleagues/s23-l3": "Listening keeps you neutral. Repeating makes you part of the gossip.|en|1|1|1|false",
 "fit-in-with-colleagues/s24-l1": "Avoid joining one side too early. People may judge you by that group.|en|1|1|1|false",
 "fit-in-with-colleagues/s24-l2": "Know many people in many teams. Then your image comes from you.|en|1|1|1|false",
 "fit-in-with-colleagues/s25-l1": "Anything in a group chat, even a small private one, can be copied and passed on.|en|1|1|1|false",
 "fit-in-with-colleagues/s25-l2": "Only write what you would not mind that person reading.|en|1|1|1|false",
 "fit-in-with-colleagues/s26-l1": "Back to Thao's private chat. A month later, a screenshot reaches the manager.|en|1|1|1|false",
 "fit-in-with-colleagues/s26-l2": "I was not punished. But now every meeting feels awkward.|en|1|1|1|false",
 "fit-in-with-colleagues/s26-l3": "Whatever you type, imagine that person is reading it right now.|en|1|1|1|false",
 "fit-in-with-colleagues/s27-l1": "Last part: how friendly is friendly enough?|en|1|1|1|false",
 "fit-in-with-colleagues/s28-l1": "Friendly does not mean sharing every secret, lending money, or saying yes to every request.|en|1|1|1|false",
 "fit-in-with-colleagues/s28-l2": "I must finish my report today. Can I help you tomorrow?|en|1|1|1|false",
 "fit-in-with-colleagues/s28-l3": "Sure, tomorrow is fine.|en|1|1|1|false",
 "fit-in-with-colleagues/s29-l1": "Something truly wrong? Jokes that go too far, unfair treatment, or harassment.|en|1|1|1|false",
 "fit-in-with-colleagues/s29-l2": "Do not stay quiet. Write down what happened.|en|1|1|1|false",
 "fit-in-with-colleagues/s29-l3": "Tell your manager or HR. Each company handles it its own way, so ask HR for the right process.|en|1|1|1|false",
 "fit-in-with-colleagues/s30-l1": "At the end of month one, ask yourself. Have I talked with people outside my team?|en|1|1|1|false",
 "fit-in-with-colleagues/s30-l2": "Do I know who to ask when stuck?|en|1|1|1|false",
 "fit-in-with-colleagues/s30-l3": "Have I thanked someone, by name?|en|1|1|1|false",
 "fit-in-with-colleagues/s30-l4": "Am I staying out of gossip?|en|1|1|1|false",
 "fit-in-with-colleagues/s31-l1": "Fitting in is small daily steps. Watch first, then follow.|en|1|1|1|false",
 "fit-in-with-colleagues/s31-l2": "Name the people who help you.|en|1|1|1|false",
 "fit-in-with-colleagues/s31-l3": "And type as if they are reading. This week, invite one colleague for a fifteen-minute coffee.|en|1|1|1|false",
 "fit-in-with-colleagues/s32-l1": "Why should you go to a dinner held to welcome you, even when tired?|en|1|1|1|false",
 "fit-in-with-colleagues/s32-l2": "The team planned it for you, and missing it leaves you outside shared stories.|en|1|1|1|false",
 "fit-in-with-colleagues/s32-l3": "Stay for a while, and leave early if you must.|en|1|1|1|false",
 "fit-in-with-colleagues/s33-l1": "Your turn now. Forty questions are waiting below.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s01-l1": "At a factory, the packing machine keeps stopping. Each time, the leader changes the fuse.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s01-l2": "Wrong invoice? Someone typed it wrong. Be careful!|en|1|1|1|false",
 "five-whys-root-cause-analysis/s01-l3": "Crooked labels? Must be the cheap paper. Buy better paper!|en|1|1|1|false",
 "five-whys-root-cause-analysis/s01-l4": "Three fixes. And every problem came back. Why?|en|1|1|1|false",
 "five-whys-root-cause-analysis/s02-l1": "What is Five Whys, and how does it find the root cause?|en|1|1|1|false",
 "five-whys-root-cause-analysis/s02-l2": "Ask why again and again, with a fact at each level.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s02-l3": "Stop at a cause your team can change. Look for gaps, not people.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s03-l1": "Six stops. Quick fixes, what Five Whys is, and asking step by step.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s03-l2": "Then no blaming, facts and branches, and what comes after the root.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s04-l1": "Part one: a quick fix is not the end.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s05-l1": "A new fuse, a new item, a sorry. That is putting out the fire.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s05-l2": "Stop there, and the cause is still there. Next week, it returns.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s05-l3": "A quick fix is not wrong. Thinking it is the end is.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s05-l4": "Do both: stop today's damage, then find why it keeps returning.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s06-l1": "We've handled it for now. Now let's find out why it keeps coming back.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s06-l2": "Good idea. Let's look together.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s06-l3": "It blames no one. It just moves the team to the root.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s07-l1": "Part two: what is Five Whys?|en|1|1|1|false",
 "five-whys-root-cause-analysis/s08-l1": "Ask why it happened. Then ask why about that answer.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s08-l2": "Keep going until you reach a cause you can change.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s09-l1": "You must ask why exactly five times. True or false?|en|1|1|1|false",
 "five-whys-root-cause-analysis/s09-l2": "False. Five just means: don't stop too early. Three may be enough.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s10-l1": "Stop when fixing this keeps the problem from coming back,|en|1|1|1|false",
 "five-whys-root-cause-analysis/s10-l2": "and your own team can do it.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s11-l1": "No software needed. Paper, a pen, and the people who do the work.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s11-l2": "Why am I often late? I wake up tired.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s11-l3": "Why tired? I look at my phone until late.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s11-l4": "So, not another alarm. My phone stays outside the bedroom.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s12-l1": "Part three: ask step by step.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s13-l1": "One: write the problem in one sentence. This week, the machine stopped three times.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s13-l2": "Two: ask why, and write the answer below.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s13-l3": "Three: check it. Look at the place, or the records.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s13-l4": "Four: ask why again. Five: stop at what the team can act on.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s14-l1": "Why did the machine stop? The fuse burned. Why? The motor was overloaded.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s14-l2": "Why? The bearing had no oil. Nobody oiled it for months.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s14-l3": "Why? The person in charge moved, and nobody took over the schedule.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s14-l4": "The new fuse kept work going. Stopping there let it return.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s15-l1": "Put out the fire to keep working. Ask why, so it won't start again.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s16-l1": "Fuse, motor, oil, schedule, handover.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s16-l2": "Each why goes from what everyone sees to what few people notice.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s16-l3": "The deeper you go, the cheaper and longer-lasting the fix.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s17-l1": "Part four: look for gaps, not people to blame.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s18-l1": "Not: who made the mistake? But: what allowed this to happen?|en|1|1|1|false",
 "five-whys-root-cause-analysis/s18-l2": "People who fear being named hide the details you need.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s19-l1": "Thảo leads the invoice team. A customer got someone else's invoice.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s19-l2": "Why the wrong invoice? Because someone typed it wrong.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s19-l3": "Okay. I'll remind them to be more careful.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s19-l4": "Wait a second!|en|1|1|1|false",
 "five-whys-root-cause-analysis/s19-l5": "Stopping at a name is too early. Next month, someone else did the same.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s19-l6": "Let's rewind and ask once more.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s19-l7": "Why could this mistake happen? Let me check the customer list.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s19-l8": "Two customers, same name, side by side, and no code!|en|1|1|1|false",
 "five-whys-root-cause-analysis/s20-l1": "Chain ends at she forgot? Ask: why was forgetting possible?|en|1|1|1|false",
 "five-whys-root-cause-analysis/s20-l2": "You'll usually find a missing reminder or check.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s21-l1": "Invite the people who do the work. They see what managers miss.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s21-l2": "Ground rule: we look for gaps in the process, not a person to blame.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s21-l3": "Then I'll tell you what really happens.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s22-l1": "Part five: facts, and when to stop.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s23-l1": "Every answer needs a fact, not a guess.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s23-l2": "Not sure? Write needs checking, and go and look first.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s23-l3": "One wrong guess sends every level below it the wrong way.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s24-l1": "In Dũng's warehouse, the label printer keeps printing crooked.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s24-l2": "Why crooked? Probably the cheap paper. Let's buy better paper.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s24-l3": "Wait a second!|en|1|1|1|false",
 "five-whys-root-cause-analysis/s24-l4": "Probably is a guess. With the new paper, labels were still crooked.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s24-l5": "Let's rewind and check first.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s24-l6": "Probably the paper. I'll mark needs checking and look at the printer.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s24-l7": "The paper guide is loose, since we moved the printer!|en|1|1|1|false",
 "five-whys-root-cause-analysis/s24-l8": "Tighten it, and the labels print straight.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s25-l1": "Check every probably before the next why.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s26-l1": "Refunds take long. Forms miss information, and the approver is often away.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s26-l2": "Two true answers. If you only fix the form, what happens?|en|1|1|1|false",
 "five-whys-root-cause-analysis/s27-l1": "Waiting drops a little, then stops. The approver branch is still there.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s27-l2": "Don't pick one branch to keep it simple. Ask about each one.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s27-l3": "Fix the form, and add a backup approver.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s28-l1": "One why, two answers? Follow both branches.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s29-l1": "Check your chain. Can the team act on the last answer?|en|1|1|1|false",
 "five-whys-root-cause-analysis/s29-l2": "Does each level have a fact, or only a probably?|en|1|1|1|false",
 "five-whys-root-cause-analysis/s29-l3": "Is anyone being blamed? Is a branch forgotten?|en|1|1|1|false",
 "five-whys-root-cause-analysis/s29-l4": "Ending with the staff are lazy fails. It blames people and stops early.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s30-l1": "Part six: you found the root. Now what?|en|1|1|1|false",
 "five-whys-root-cause-analysis/s31-l1": "Give the root one action, one person, one deadline.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s31-l2": "One person gets the oil schedule, posted by the machine.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s31-l3": "Then check again after a month.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s31-l4": "Still happening? Wrong root, or another branch. Ask again.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s32-l1": "Many causes mixed together? Five Whys may not be enough.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s32-l2": "Get more data, ask experts. Don't force one chain.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s33-l1": "Report in order: problem, whys, root, action.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s33-l2": "The machine stopped because the bearing had no oil.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s33-l3": "The root: nobody was given the maintenance schedule.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s33-l4": "I suggest the morning shift leader takes the oil schedule, posted by the machine. We check in a month.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s34-l1": "Don't stop at the fuse, a name, a probably, or the first branch.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s34-l2": "Today, pick one small repeating problem and write its whys, one fact each.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s35-l1": "In the label printer story, why did buying more expensive paper not help?|en|1|1|1|false",
 "five-whys-root-cause-analysis/s35-l2": "The real cause was a loose paper guide, found only when someone checked the machine.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s35-l3": "Nobody checked the cheap paper guess.|en|1|1|1|false",
 "five-whys-root-cause-analysis/s36-l1": "Now try the forty questions below. Keep asking why!|en|1|1|1|false",
 "follow-up-after-presentation/s01-l1": "…and that's my plan for the promotion.|en|1|1|1|false",
 "follow-up-after-presentation/s01-l2": "Sounds good.|en|1|1|1|false",
 "follow-up-after-presentation/s01-l3": "Approved! I'll launch it right away.|en|1|1|1|false",
 "follow-up-after-presentation/s01-l4": "The next day, his boss asks him something he didn't expect. What did 'sounds good' really mean?|en|1|1|1|false",
 "follow-up-after-presentation/s02-l1": "A report's work is kept or lost after the meeting. Three steps:|en|1|1|1|false",
 "follow-up-after-presentation/s02-l2": "recap before you leave the room,|en|1|1|1|false",
 "follow-up-after-presentation/s02-l3": "send a written summary the same day,|en|1|1|1|false",
 "follow-up-after-presentation/s02-l4": "and follow up until it's done.|en|1|1|1|false",
 "follow-up-after-presentation/s03-l1": "Five stops: recap before leaving, then the written summary.|en|1|1|1|false",
 "follow-up-after-presentation/s03-l2": "A silent boss, updates while you work, and when it's done.|en|1|1|1|false",
 "follow-up-after-presentation/s04-l1": "Part one: what to confirm before you leave the room.|en|1|1|1|false",
 "follow-up-after-presentation/s05-l1": "Use the last few minutes to recap out loud.|en|1|1|1|false",
 "follow-up-after-presentation/s05-l2": "Let me recap. You approve option two.|en|1|1|1|false",
 "follow-up-after-presentation/s05-l3": "I handle the quote, Dung handles the contract. We review on Friday.|en|1|1|1|false",
 "follow-up-after-presentation/s05-l4": "If anyone understood it differently, they speak up now, while everyone is still here.|en|1|1|1|false",
 "follow-up-after-presentation/s06-l1": "Not sure if it's approved, or just a direction? Ask directly:|en|1|1|1|false",
 "follow-up-after-presentation/s06-l2": "So, do you approve it now, or should I send more numbers first?|en|1|1|1|false",
 "follow-up-after-presentation/s06-l3": "A friendly nod may mean a good idea, not an approved plan.|en|1|1|1|false",
 "follow-up-after-presentation/s07-l1": "Decisions made.|en|1|1|1|false",
 "follow-up-after-presentation/s07-l2": "Tasks: who does them, and by when.|en|1|1|1|false",
 "follow-up-after-presentation/s07-l3": "Open questions, and who finds the answer, so they aren't forgotten.|en|1|1|1|false",
 "follow-up-after-presentation/s07-l4": "And the next meeting or update.|en|1|1|1|false",
 "follow-up-after-presentation/s08-l1": "Part two: writing the summary after the meeting.|en|1|1|1|false",
 "follow-up-after-presentation/s09-l1": "Send it the same day, while people still remember.|en|1|1|1|false",
 "follow-up-after-presentation/s09-l2": "Wait a few days, and everyone remembers it differently. The summary turns into an argument.|en|1|1|1|false",
 "follow-up-after-presentation/s10-l1": "Four short parts: what was decided, who does what by when,|en|1|1|1|false",
 "follow-up-after-presentation/s10-l2": "open questions, and the next update.|en|1|1|1|false",
 "follow-up-after-presentation/s10-l3": "Use bullet points. Don't retell the whole meeting.|en|1|1|1|false",
 "follow-up-after-presentation/s11-l1": "Here is a short summary of this morning's meeting.|en|1|1|1|false",
 "follow-up-after-presentation/s11-l2": "Decided: option two is approved.|en|1|1|1|false",
 "follow-up-after-presentation/s11-l3": "Tasks: I send the quote by Wednesday. Dung finishes the contract by Friday.|en|1|1|1|false",
 "follow-up-after-presentation/s11-l4": "Open: waiting for the customer to confirm the quantity.|en|1|1|1|false",
 "follow-up-after-presentation/s11-l5": "If I got anything wrong, please correct me.|en|1|1|1|false",
 "follow-up-after-presentation/s11-l6": "That last line matters. People fix mistakes now, not weeks later with “I never agreed”.|en|1|1|1|false",
 "follow-up-after-presentation/s12-l1": "Only people at the meeting need the summary. True or false?|en|1|1|1|false",
 "follow-up-after-presentation/s12-l2": "False. Send it to your boss and everyone with a task, even if they missed the meeting.|en|1|1|1|false",
 "follow-up-after-presentation/s12-l3": "Not the whole office. But a missing owner may never start the task.|en|1|1|1|false",
 "follow-up-after-presentation/s13-l1": "After the meeting, the team agreed on the design for a new campaign.|en|1|1|1|false",
 "follow-up-after-presentation/s13-l2": "Everyone heard it. No need to send anything.|en|1|1|1|false",
 "follow-up-after-presentation/s13-l3": "Wait a second!|en|1|1|1|false",
 "follow-up-after-presentation/s13-l4": "Two weeks later, each side waits for the other, and the work is late.|en|1|1|1|false",
 "follow-up-after-presentation/s13-l5": "Let's rewind and try again.|en|1|1|1|false",
 "follow-up-after-presentation/s13-l6": "I'll send the design request by Tuesday. Design sends a draft by Friday.|en|1|1|1|false",
 "follow-up-after-presentation/s13-l7": "Two lines: who does what, by which day. Nobody has to guess.|en|1|1|1|false",
 "follow-up-after-presentation/s14-l1": "Part three: what if your boss doesn't reply?|en|1|1|1|false",
 "follow-up-after-presentation/s15-l1": "For normal tasks agreed in the meeting, silence usually means busy, not no. Go ahead.|en|1|1|1|false",
 "follow-up-after-presentation/s15-l2": "Big things, like spending money, signing with a customer, or moving a customer date: silence isn't yes.|en|1|1|1|false",
 "follow-up-after-presentation/s16-l1": "Thao asked to buy more equipment. Three days later, still no reply.|en|1|1|1|false",
 "follow-up-after-presentation/s16-l2": "No reply means yes. I'll place the order now.|en|1|1|1|false",
 "follow-up-after-presentation/s16-l3": "Wait a second!|en|1|1|1|false",
 "follow-up-after-presentation/s16-l4": "With money, silence is not a yes. You could spend a week explaining.|en|1|1|1|false",
 "follow-up-after-presentation/s16-l5": "Let's rewind and try again.|en|1|1|1|false",
 "follow-up-after-presentation/s16-l6": "Please confirm the equipment purchase so I can place the order.|en|1|1|1|false",
 "follow-up-after-presentation/s16-l7": "I'll order after she replies.|en|1|1|1|false",
 "follow-up-after-presentation/s17-l1": "Part four: updating your boss while you work.|en|1|1|1|false",
 "follow-up-after-presentation/s18-l1": "Update at the agreed points, in a few lines: done, in progress, and help needed.|en|1|1|1|false",
 "follow-up-after-presentation/s18-l2": "When your boss doesn't have to ask, they feel calm.|en|1|1|1|false",
 "follow-up-after-presentation/s18-l3": "Something changed, like a deadline or the person in charge? Tell them in writing, with the reason.|en|1|1|1|false",
 "follow-up-after-presentation/s18-l4": "Don't let your boss find out from someone else.|en|1|1|1|false",
 "follow-up-after-presentation/s19-l1": "An easy format: label each task.|en|1|1|1|false",
 "follow-up-after-presentation/s19-l2": "On track, at risk, or late.|en|1|1|1|false",
 "follow-up-after-presentation/s19-l3": "One look, and your boss knows where to pay attention.|en|1|1|1|false",
 "follow-up-after-presentation/s20-l1": "Last part: the work is done. What's left?|en|1|1|1|false",
 "follow-up-after-presentation/s21-l1": "Project done, on time. My boss will see it herself.|en|1|1|1|false",
 "follow-up-after-presentation/s21-l2": "At the end of the quarter, the boss looks back at everyone's results.|en|1|1|1|false",
 "follow-up-after-presentation/s21-l3": "She remembers the work that was reported in full. Thao's project feels faint.|en|1|1|1|false",
 "follow-up-after-presentation/s21-l4": "Good work, but nobody clearly knew the results.|en|1|1|1|false",
 "follow-up-after-presentation/s22-l1": "Send a closing note: it's done, the result compared with the plan, and any lessons.|en|1|1|1|false",
 "follow-up-after-presentation/s22-l2": "Many people skip this, so the boss isn't sure it's really finished.|en|1|1|1|false",
 "follow-up-after-presentation/s22-l3": "Keep summaries and confirmations in one place, like the project folder.|en|1|1|1|false",
 "follow-up-after-presentation/s22-l4": "Months later, someone asks why you decided that. You open it, and there's the answer.|en|1|1|1|false",
 "follow-up-after-presentation/s23-l1": "Finished? Say it's finished, with the results. That's how good work gets seen.|en|1|1|1|false",
 "follow-up-after-presentation/s24-l1": "Dung, why haven't you sent me the cost sheet yet?|en|1|1|1|false",
 "follow-up-after-presentation/s24-l2": "Back to Dung. To his boss, 'sounds good' only meant: good idea, keep working on it.|en|1|1|1|false",
 "follow-up-after-presentation/s24-l3": "So, is it approved now, or should I send more numbers first?|en|1|1|1|false",
 "follow-up-after-presentation/s24-l4": "A nod is not an approval. Ask to be sure.|en|1|1|1|false",
 "follow-up-after-presentation/s25-l1": "A good report only counts when what was agreed gets done.|en|1|1|1|false",
 "follow-up-after-presentation/s25-l2": "Save a four-part summary template on your phone today.|en|1|1|1|false",
 "follow-up-after-presentation/s26-l1": "Which short rule helps you decide when silence is enough to go ahead?|en|1|1|1|false",
 "follow-up-after-presentation/s26-l2": "Small tasks can go ahead, but anything involving money needs a clear yes.|en|1|1|1|false",
 "follow-up-after-presentation/s26-l3": "Easy to remember: small tasks, just do them. Money tasks, always ask.|en|1|1|1|false",
 "follow-up-after-presentation/s27-l1": "Last step of the series. Forty questions are waiting below.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s01-l1": "Monday. Thảo's friend Sam eats pho in Hanoi.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s01-l2": "Clear broth, and not many herbs!|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s01-l3": "A week later, in Saigon.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s01-l4": "Sweeter, with bean sprouts and basil!|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s01-l5": "Is Vietnamese food the same everywhere?|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s02-l1": "No. The north tastes light and mild.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s02-l2": "The centre is bold, spicy and saltier.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s02-l3": "The south is sweeter, richer, with lots of fresh greens.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s02-l4": "But all share the family table, fish sauce and herbs.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s03-l1": "Six parts. The three regions, and the table they share.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s03-l2": "Then north, centre and south: what to eat, and how.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s03-l3": "One dish three ways, and manners at a Vietnamese table.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s04-l1": "Part one: three tastes, one shared table.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s05-l1": "Vietnamese food culture is often summed up by three regional tastes.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s05-l2": "The difference comes from each region's climate, local produce, and history.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s06-l1": "Everyone in the south only eats sweet food. True or false?|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s06-l2": "False. These are general trends, not rules. Each province and each family cooks its own way.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s07-l1": "In every region, a family meal has rice, a savoury main dish, a vegetable dish, and a soup.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s07-l2": "It's all shared on one tray. Everyone has their own bowl and takes from the shared plates.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s07-l3": "So you can choose more vegetables and less rice.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s08-l1": "Fish sauce is the base seasoning in all three regions, for cooking and dipping sauces.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s08-l2": "Herbs like mint, perilla, Vietnamese balm and Vietnamese coriander are in many dishes.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s08-l3": "And the folk idea of balance, like eating snails or duck with ginger.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s09-l1": "For a foreign friend, “rice, a savoury dish, vegetables, soup” is the easiest way to explain a Vietnamese meal.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s09-l2": "Wherever you go, the frame stays. Only the dishes change by place.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s10-l1": "Part two: taking a guest to the north.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s11-l1": "The north has four clear seasons, so food changes with them.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s11-l2": "Summer brings crab and jute leaf soup. Winter brings warm braised and stewed dishes.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s11-l3": "The taste is light, with little sugar or chilli in the pot. Want it spicy? Add it yourself.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s12-l1": "Try pho Hanoi, bun cha, bun thang, cha ca, banh cuon, and com.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s12-l2": "Bun thang and banh cuon are quite light, good for a guest's breakfast.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s12-l3": "Bun cha has grilled meat, so eat it with plenty of fresh herbs.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s13-l1": "Three days in Hanoi with Sam. Every meal: bun cha, fried spring rolls, banh mi with pâté.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s13-l2": "We're in Hanoi, so we must eat the specialties!|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s13-l3": "Wait a second!|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s13-l4": "Grilled meat, fried rolls, rich pâté. No greens, no soup, and no everyday Hanoi meal.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s13-l5": "Let's rewind and try again.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s13-l6": "Today, let's have a simple rice meal, like the locals.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s13-l7": "Boiled water spinach and crab soup? Lovely!|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s13-l8": "Rice, a savoury dish, vegetables, soup. Sam tastes the specialties, and sees how locals really eat.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s14-l1": "Specialties are for tasting. Everyday meals are for filling up.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s15-l1": "Part three: the centre. How much chilli and fish paste?|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s16-l1": "The centre has a harsh climate, narrow land, and the sea close by.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s16-l2": "So food is bold, spicy and saltier, with lots of fermented shrimp and fish pastes.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s16-l3": "Huế, the last royal capital of the Nguyễn dynasty, keeps a royal cuisine of many small, beautiful dishes.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s17-l1": "In Huế: bun bo Hue, com hen, banh beo, and banh khoai.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s17-l2": "Mi Quang from old Quang Nam, now part of Da Nang city. Cao lau in Hoi An.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s17-l3": "And banh can and fish cake noodles along the south-central coast.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s18-l1": "Now Sam is in Huế for the first time.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s18-l2": "In Huế, I have to eat it as spicy as the locals do!|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s18-l3": "Wait a second!|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s18-l4": "Huế food is bold, but many shops keep chilli and satay on the table, so each person adds their own.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s18-l5": "Let's rewind. Thảo can order for Sam.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s18-l6": "Not too spicy, please. And the shrimp paste on the side.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s18-l7": "A little at a time. Now I can taste the lemongrass!|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s18-l8": "Fish paste and chilli carry a lot of salt. Drink more water and order more greens.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s19-l1": "Try new flavours a little at a time. Don't compete with chilli.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s20-l1": "Part four: the south. Sweet, rich, and full of greens.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s21-l1": "The south is hot all year. The Mekong Delta is full of rivers, fruit and vegetables.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s21-l2": "Cooks add sugar or coconut water for sweetness, and coconut milk for richness, in savoury and sweet dishes.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s21-l3": "Try com tam, hu tieu, banh xeo, sour fish soup, clay pot fish, and fermented fish hotpot.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s21-l4": "Big plus: lots of fresh herbs. Watch out for sweet dips and rich coconut dishes.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s22-l1": "Banh xeo looks rich, crispy and golden. But in the Mekong Delta, people eat it with lots of greens.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s22-l2": "Break off a piece. Wrap it in a mustard leaf with fresh herbs like mint and perilla.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s22-l3": "Dip it in sweet and sour fish sauce. The plate of greens is bigger than the pancake.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s23-l1": "Southern meals come with lots of greens. Let the vegetables lead.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s24-l1": "Part five: one dish, three regions, three ways.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s25-l1": "That's Sam's question. Northern pho has a clear broth and few herbs.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s25-l2": "Southern pho is sweeter, with bean sprouts, basil and hoisin sauce.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s25-l3": "Southern banh xeo is big and thin, with lots of greens. The centre has banh khoai in Huế, and small banh xeo in some provinces.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s26-l1": "For Tết, the north wraps square banh chung. The centre and south usually make round, long banh tet.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s26-l2": "A northern Tết tray has pork roll, pickled onions, and jellied meat.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s26-l3": "In the south: braised pork with duck eggs, pickled bean sprouts, and bitter melon soup.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s27-l1": "Part six: a guest at a Vietnamese table.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s28-l1": "Invite others to eat before you start. The younger invite the older.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s28-l2": "Wait for older people or the host to take food first.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s28-l3": "Don't stand chopsticks upright in your rice. It recalls the rice bowl offered to the dead.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s28-l4": "And don't dip bitten food into the shared sauce bowl.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s29-l1": "Sam, putting food in your bowl is how we show care.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s29-l2": "Eat more, dear. Have some of this.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s29-l3": "Sam is already full. A flat “no” would make the host sad.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s29-l4": "Thank you so much. Just a little, please.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s29-l5": "Tell your friend this before the meal. Or say a helping word for them.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s30-a0": "At a team party, Dũng tastes the sour soup his colleague from Bến Tre made. It's sweeter than at home.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s30-a1": "What soup is this? It's as sweet as dessert!|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s30-a2": "The joke turns taste into right and wrong. The cook feels hurt.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s30-b1": "How do people cook this in your hometown?|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s30-b2": "We season it with tamarind and a little sugar, to soften it.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s30-b3": "The whole table learns a new dish, and Dũng tastes it with new eyes.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s31-l1": "Tastes differ, and nobody is wrong.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s32-l1": "Take with you: three regional tastes, only trends. The frame: rice, savoury, vegetables, soup.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s32-l2": "One dish per region. “Not too spicy, paste on the side.” Table manners, and respect for others' tastes.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s32-l3": "Pick one favourite dish from each region, ready for your next guest.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s33-l1": "Why should you not stand your chopsticks upright in a bowl of rice?|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s33-l2": "It looks like the rice bowl offered to the dead, so it is considered impolite.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s33-l3": "Rest them across the bowl or on a chopstick holder instead.|en|1|1|1|false",
 "food-culture-of-vietnam-s-three-regions/s34-l1": "Your turn. Forty questions are waiting below.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s01-l1": "Fifty new Japanese words this week!|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s01-l2": "So what do you do at night? Scroll your phone again?|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s01-l3": "A few weeks later, the lunch group leaves without him. What went wrong?|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s02-l1": "How do you keep your own time going for years? Avoid Bennett's four traps.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s02-l2": "Showing off.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s02-l3": "A slave to your timetable.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s02-l4": "Always in a hurry.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s02-l5": "And failing early.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s03-l1": "Five stops: one for each trap.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s03-l2": "And a five minute check every Sunday.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s04-l1": "Trap one: showing off.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s05-l1": "The first trap: you feel better than others because you use time well.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s05-l2": "Then you lecture them on how to live.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s05-l3": "You started for yourself. Now it's an excuse to look down on others.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s05-l4": "A post: anyone can do this, unless they're lazy.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s05-l5": "Mocking a colleague's movie nights. Turning lunch into a productivity talk.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s06-l1": "Three months of Japanese, one hour every night.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s06-l2": "You should all do the same. Anyone can, unless they're lazy.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s06-l3": "Wait a second!|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s06-l4": "Do your own work quietly. Let the results speak for themselves.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s06-l5": "Let's rewind and try again.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s06-l6": "How do you find time to study?|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s06-l7": "One hour after dinner works for me. It's just my way.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s07-l1": "The fix is simple. Only share when someone asks.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s07-l2": "Tell your own story. Don't tell them how to live.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s07-l3": "Small kids, shift work, a sick parent. Their evenings are not yours to grade.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s08-l1": "Trap two: a slave to your timetable.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s09-l1": "Bennett says: respect your timetable, but don't worship it.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s09-l2": "A slave keeps the schedule at any cost, even when it hurts everyone.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s09-l3": "Signs: you snap at your family over five minutes.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s09-l4": "You say no even to rare invitations.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s09-l5": "You feel guilty all week for missing one evening.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s10-l0": "Hoa reads on Monday, Wednesday and Friday, nine to ten thirty. Wednesday, her sister visits for one night.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s10-a1": "It's nine: reading time. Door closed.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s10-a2": "I hear them laughing outside. Ten pages, and I remember nothing.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s10-a3": "She's asleep. And she leaves at dawn.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s10-b1": "My rule: a missed evening moves to Saturday morning. No double session.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s10-b2": "So tonight I sit with my sister. No guilt.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s10-l1": "A timetable is there to serve you. You are not there to serve it.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s10-l2": "Family, a special guest, a rare coffee with an old friend? Change the plan.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s11-l1": "Trap three: always in a hurry.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s12-l1": "You do one thing while worrying about the next.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s12-l2": "Every evening is a race against the clock.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s12-l3": "Your own time feels like one more work shift.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s13-l1": "The rush usually comes from taking on too much.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s13-l2": "When you're overloaded, rearrange your plan and do less.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s13-l3": "And move from one thing to the next slowly, on purpose.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s14-l0": "Dung wants four things each night: exercise, vocabulary, reading, an online lecture.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s14-a1": "Seven o'clock, workout done. Quick shower. Vocabulary app, hair still wet.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s14-a2": "Now the book. But my head is still on the words.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s14-a3": "Ten o'clock. All done, and I'm exhausted.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s14-b1": "Two things tonight. The others on other nights.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s14-b2": "Ten minutes between: pour water, clear the desk, think about what's next.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s14-l1": "Fewer tasks, slow changes, and finish each one fully.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s15-l1": "Three weeks, five tasks a week, only two or three done. Stay up one more hour each night. True or false?|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s15-l2": "False. Keep the two or three you enjoy most. Put the rest on a later list.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s15-l3": "Less sleep moves the tiredness into work. The rush stays. Cut tasks, not sleep.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s16-l1": "Trap four, the biggest one: failing early.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s17-l1": "Week one, full of energy.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s17-l2": "Week two, work piles up or a child gets sick. You stumble.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s17-l3": "So you quit.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s17-l4": "Next time it's harder, because now you believe: I can't do it.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s18-l1": "Two things help it last. First, go so slowly it almost seems funny. But steadily.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s18-l2": "Twenty minutes of reading every Tuesday beats two hours a day dropped after a week.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s19-l1": "Second: to start, pick the most useful subject, even if it bores you. True or false?|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s19-l2": "False. Start from what you naturally enjoy.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s19-l3": "Love cooking? Read the history of dishes you know. Love football? Read about tactics or a club's history.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s19-l4": "Once the habit stands, harder things come easier. Start from what you like.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s20-l1": "Last part: a five minute trap check.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s21-l1": "Did I lecture anyone about time when they didn't ask?|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s21-l2": "Did I get angry at someone over a missed plan?|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s21-l3": "Do I feel rushed when I switch tasks?|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s21-l4": "More tasks in my plan than I finish? That's the hurry trap.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s21-l5": "Do I really enjoy what I'm doing?|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s22-l1": "Five minutes, five questions. Hmm, too many tasks again.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s22-l2": "I'll just drop one. The plan can stay.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s22-l3": "Right. Fix one small thing. Drop a task, add a swap rule, or stop the lunch lectures.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s22-l4": "Falling into a trap is normal. Notice early, and adjust gently.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s23-l1": "Each trap is a good thing pushed too far.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s23-l2": "Sharing becomes lecturing. Discipline becomes rigid.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s23-l3": "Doing more becomes rushing. Wanting speed becomes quitting early.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s24-l1": "Why is cutting sleep a poor answer to feeling overloaded?|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s24-l2": "It moves the tiredness into your working day, and the rushed feeling stays.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s24-l3": "When you feel rushed, cut tasks, not sleep.|en|1|1|1|false",
 "four-traps-when-using-time-for-yourself/s25-l1": "Today, cross out one task and write one rule for missed evenings. Then try the forty questions!|en|1|1|1|false",
 "from-colleague-to-team-leader/s01-l1": "Every afternoon, Thao's team complains over coffee.|en|1|1|1|false",
 "from-colleague-to-team-leader/s01-l2": "The team next door, again!|en|1|1|1|false",
 "from-colleague-to-team-leader/s01-l3": "I know! And our boss, too.|en|1|1|1|false",
 "from-colleague-to-team-leader/s01-l4": "But Thao leads the team now. Soon, her words reach the big boss.|en|1|1|1|false",
 "from-colleague-to-team-leader/s01-l5": "Why do the same words now sound so different?|en|1|1|1|false",
 "from-colleague-to-team-leader/s02-l1": "From colleague to leader: how should you act now? Four things.|en|1|1|1|false",
 "from-colleague-to-team-leader/s02-l2": "Explain your new role once.|en|1|1|1|false",
 "from-colleague-to-team-leader/s02-l3": "Be fair to everyone.|en|1|1|1|false",
 "from-colleague-to-team-leader/s02-l4": "Remind, do not order.|en|1|1|1|false",
 "from-colleague-to-team-leader/s02-l5": "Keep leader things private.|en|1|1|1|false",
 "from-colleague-to-team-leader/s03-l1": "Why it feels awkward.|en|1|1|1|false",
 "from-colleague-to-team-leader/s03-l2": "The first days.|en|1|1|1|false",
 "from-colleague-to-team-leader/s03-l3": "Friends and fairness.|en|1|1|1|false",
 "from-colleague-to-team-leader/s03-l4": "Reminding old friends.|en|1|1|1|false",
 "from-colleague-to-team-leader/s03-l5": "And why you need not be the best.|en|1|1|1|false",
 "from-colleague-to-team-leader/s04-l1": "Part one: why does it feel awkward?|en|1|1|1|false",
 "from-colleague-to-team-leader/s05-l1": "Morning! Lunch together today?|en|1|1|1|false",
 "from-colleague-to-team-leader/s05-l2": "Oh… sure, if you have time.|en|1|1|1|false",
 "from-colleague-to-team-leader/s05-l3": "Your old colleagues feel awkward too. They do not know how to talk or joke with you now.|en|1|1|1|false",
 "from-colleague-to-team-leader/s05-l4": "Give them time. Being careful is not being against you.|en|1|1|1|false",
 "from-colleague-to-team-leader/s06-l1": "In under two weeks, Thao's words reach the senior boss: “even the leader says so.”|en|1|1|1|false",
 "from-colleague-to-team-leader/s06-l2": "Thao is called in, and the team next door turns cold.|en|1|1|1|false",
 "from-colleague-to-team-leader/s07-l1": "You did not change. Your responsibility did, and your words weigh more.|en|1|1|1|false",
 "from-colleague-to-team-leader/s07-l2": "People may take your complaint as the view of the whole team.|en|1|1|1|false",
 "from-colleague-to-team-leader/s07-l3": "Unhappy with the company? Tell your manager in a private meeting.|en|1|1|1|false",
 "from-colleague-to-team-leader/s08-l1": "Part two: what to say in the first days.|en|1|1|1|false",
 "from-colleague-to-team-leader/s09-l1": "Do not pretend nothing changed. Everyone knows. Say it once, briefly.|en|1|1|1|false",
 "from-colleague-to-team-leader/s09-l2": "I know this is a bit strange for all of us.|en|1|1|1|false",
 "from-colleague-to-team-leader/s09-l3": "Now I am responsible for our results, so sometimes I will remind you about tasks.|en|1|1|1|false",
 "from-colleague-to-team-leader/s09-l4": "Please tell me honestly when I get it wrong.|en|1|1|1|false",
 "from-colleague-to-team-leader/s10-l1": "Then meet each person alone, especially close friends and anyone who applied for the same job.|en|1|1|1|false",
 "from-colleague-to-team-leader/s10-l2": "How would you like me to support you?|en|1|1|1|false",
 "from-colleague-to-team-leader/s10-l3": "Thanks for asking.|en|1|1|1|false",
 "from-colleague-to-team-leader/s10-l4": "This question shows you are there to help, not to give orders.|en|1|1|1|false",
 "from-colleague-to-team-leader/s11-l0": "Lan applied for the leader job too. Thao got it.|en|1|1|1|false",
 "from-colleague-to-team-leader/s11-a1": "Lan, can you just sort these small files?|en|1|1|1|false",
 "from-colleague-to-team-leader/s11-a2": "Fine.|en|1|1|1|false",
 "from-colleague-to-team-leader/s11-b1": "You are the best at data here. Can you lead that area?|en|1|1|1|false",
 "from-colleague-to-team-leader/s11-b2": "Thank you. I would like that.|en|1|1|1|false",
 "from-colleague-to-team-leader/s11-l1": "Way A: she feels pushed aside, goes quiet in meetings, and does the minimum.|en|1|1|1|false",
 "from-colleague-to-team-leader/s11-l2": "Way B: recognise her skills and give her work that matches them.|en|1|1|1|false",
 "from-colleague-to-team-leader/s12-l1": "Avoid a strong person, and you lose them. Then you carry more work alone.|en|1|1|1|false",
 "from-colleague-to-team-leader/s13-l1": "Part three: friends, and being fair.|en|1|1|1|false",
 "from-colleague-to-team-leader/s14-l1": "You can stay friends. But at work, everyone follows the same rules.|en|1|1|1|false",
 "from-colleague-to-team-leader/s14-l2": "No special favours. And no extra strictness to prove you are fair. That is unfair too.|en|1|1|1|false",
 "from-colleague-to-team-leader/s15-l1": "Just between us, what did Lan get in her review?|en|1|1|1|false",
 "from-colleague-to-team-leader/s15-l2": "Sorry, I cannot share that. It is private to her.|en|1|1|1|false",
 "from-colleague-to-team-leader/s15-l3": "Leader information stays private, even for a best friend.|en|1|1|1|false",
 "from-colleague-to-team-leader/s15-l4": "And private stories from friend times stay out of tasks and reviews.|en|1|1|1|false",
 "from-colleague-to-team-leader/s16-l1": "A fairness checklist: tasks by skill, one standard, no gossip.|en|1|1|1|false",
 "from-colleague-to-team-leader/s16-l2": "Keep leader information private. And sometimes invite the whole team to lunch, not only old friends.|en|1|1|1|false",
 "from-colleague-to-team-leader/s16-l3": "Then nobody feels like an outsider.|en|1|1|1|false",
 "from-colleague-to-team-leader/s17-l1": "If you do not mean to favour anyone, you are fair. True or false?|en|1|1|1|false",
 "from-colleague-to-team-leader/s17-l2": "False. The team cannot see your intentions. They see who gets which task.|en|1|1|1|false",
 "from-colleague-to-team-leader/s17-l3": "Share clear rules for choosing people, and rotate the chances.|en|1|1|1|false",
 "from-colleague-to-team-leader/s17-l4": "Be friends at the lunch table, and be fair at the work desk.|en|1|1|1|false",
 "from-colleague-to-team-leader/s18-l1": "Part four: reminding an old friend.|en|1|1|1|false",
 "from-colleague-to-team-leader/s19-l1": "I need the data part before Thursday afternoon, to send to the client. Can you make it?|en|1|1|1|false",
 "from-colleague-to-team-leader/s19-l2": "Hmm, I also have the report this week.|en|1|1|1|false",
 "from-colleague-to-team-leader/s19-l3": "Then let's move the report to next week.|en|1|1|1|false",
 "from-colleague-to-team-leader/s19-l4": "Task, deadline, reason. “Can you make it?” lets problems come up early.|en|1|1|1|false",
 "from-colleague-to-team-leader/s19-l5": "But the goal stays clear. If not, agree a fix: move a task, or add help.|en|1|1|1|false",
 "from-colleague-to-team-leader/s20-l1": "Avoid both extremes. Too soft: “Do it if you can, no hurry.” The task keeps slipping.|en|1|1|1|false",
 "from-colleague-to-team-leader/s20-l2": "Too hard: “Do it now.” Your old friend feels looked down on.|en|1|1|1|false",
 "from-colleague-to-team-leader/s21-l1": "A deadline was missed. Do not react in front of the team. Meet in private.|en|1|1|1|false",
 "from-colleague-to-team-leader/s21-l2": "The report was not sent yesterday as we agreed. Is something blocking you?|en|1|1|1|false",
 "from-colleague-to-team-leader/s21-l3": "Yes, I was waiting for the sales numbers.|en|1|1|1|false",
 "from-colleague-to-team-leader/s22-l1": "Sorry, it is late again. But you are easygoing!|en|1|1|1|false",
 "from-colleague-to-team-leader/s22-l2": "Ha ha, okay. No problem.|en|1|1|1|false",
 "from-colleague-to-team-leader/s22-l3": "Wait a second!|en|1|1|1|false",
 "from-colleague-to-team-leader/s22-l4": "Let it go once, and the whole team learns it. Talk privately from the first late task.|en|1|1|1|false",
 "from-colleague-to-team-leader/s22-l5": "Let's rewind and try again.|en|1|1|1|false",
 "from-colleague-to-team-leader/s22-l6": "Come on, we are friends. What is the rush?|en|1|1|1|false",
 "from-colleague-to-team-leader/s22-l7": "I understand. But the client is waiting. I need it before noon tomorrow.|en|1|1|1|false",
 "from-colleague-to-team-leader/s22-l8": "Okay, before noon.|en|1|1|1|false",
 "from-colleague-to-team-leader/s22-l9": "Friendly voice, same deadline.|en|1|1|1|false",
 "from-colleague-to-team-leader/s23-l1": "Last part: do you need to be the best at everything?|en|1|1|1|false",
 "from-colleague-to-team-leader/s24-l1": "No. Your job is to help skilled people do even better.|en|1|1|1|false",
 "from-colleague-to-team-leader/s24-l2": "Lan, you know this part better than me. Could you guide everyone?|en|1|1|1|false",
 "from-colleague-to-team-leader/s24-l3": "Sure, happy to.|en|1|1|1|false",
 "from-colleague-to-team-leader/s24-l4": "Saying this earns you more respect, not less.|en|1|1|1|false",
 "from-colleague-to-team-leader/s25-l1": "Yesterday I gave you missing information. That was my mistake. Here is the full version.|en|1|1|1|false",
 "from-colleague-to-team-leader/s25-l2": "Thanks. I will fix it today.|en|1|1|1|false",
 "from-colleague-to-team-leader/s25-l3": "Admit it briefly and say how to fix it. Then the team feels safe to raise problems early.|en|1|1|1|false",
 "from-colleague-to-team-leader/s26-l1": "Some things you cannot discuss with the team. Ask an experienced leader from another team.|en|1|1|1|false",
 "from-colleague-to-team-leader/s26-l2": "Asking is the fastest way to learn. It is not a sign of weakness.|en|1|1|1|false",
 "from-colleague-to-team-leader/s27-l1": "Each story started with avoiding something: honest words, a strong person, a reminder.|en|1|1|1|false",
 "from-colleague-to-team-leader/s27-l2": "This week, pick one old friend in your team and have a private talk.|en|1|1|1|false",
 "from-colleague-to-team-leader/s28-l1": "How can you remind an old friend about a task without sounding bossy?|en|1|1|1|false",
 "from-colleague-to-team-leader/s28-l2": "State the task, the deadline and the reason, then ask if the timing works.|en|1|1|1|false",
 "from-colleague-to-team-leader/s28-l3": "Clear words do the work. You do not need a bossy voice.|en|1|1|1|false",
 "from-colleague-to-team-leader/s29-l1": "Now it is your turn. Forty questions below.|en|1|1|1|false",
 "from-high-school-to-university-study/s01-l1": "Not allowed to take the final? I have to retake the whole course?|en|1|1|1|false",
 "from-high-school-to-university-study/s01-l2": "Dũng failed one math test, felt ashamed, and stopped going to class.|en|1|1|1|false",
 "from-high-school-to-university-study/s01-l3": "Now it costs him more money and more time.|en|1|1|1|false",
 "from-high-school-to-university-study/s02-l1": "At university, nobody reminds you. So how do you study? Not more, but with a plan.|en|1|1|1|false",
 "from-high-school-to-university-study/s02-l2": "Read every course outline.|en|1|1|1|false",
 "from-high-school-to-university-study/s02-l3": "Make your own weekly plan.|en|1|1|1|false",
 "from-high-school-to-university-study/s02-l4": "Study a little every day.|en|1|1|1|false",
 "from-high-school-to-university-study/s02-l5": "And ask for help early.|en|1|1|1|false",
 "from-high-school-to-university-study/s03-l1": "Six parts: what's different, your first week, your weekly plan,|en|1|1|1|false",
 "from-high-school-to-university-study/s03-l2": "classes and self-study, exam season, and who can help.|en|1|1|1|false",
 "from-high-school-to-university-study/s04-l1": "Part one: how is university different?|en|1|1|1|false",
 "from-high-school-to-university-study/s05-l1": "At university, class time is only part of learning.|en|1|1|1|false",
 "from-high-school-to-university-study/s05-l2": "Lecturers give the main ideas, and wait for you to go deeper.|en|1|1|1|false",
 "from-high-school-to-university-study/s05-l3": "The rest happens when you read and do tasks on your own.|en|1|1|1|false",
 "from-high-school-to-university-study/s06-l1": "Many schools use credits. You register for courses yourself.|en|1|1|1|false",
 "from-high-school-to-university-study/s06-l2": "Maybe I'll take lots of courses, to look hardworking?|en|1|1|1|false",
 "from-high-school-to-university-study/s06-l3": "Careful! Too many courses are hard to fix mid-term.|en|1|1|1|false",
 "from-high-school-to-university-study/s06-l4": "Ask your academic adviser or older students before you register.|en|1|1|1|false",
 "from-high-school-to-university-study/s07-l1": "A course grade usually has parts: attendance, assignments, a midterm, and a final.|en|1|1|1|false",
 "from-high-school-to-university-study/s07-l2": "The share of each part depends on the course and the school.|en|1|1|1|false",
 "from-high-school-to-university-study/s07-l3": "At many schools, missing too many classes means no final exam.|en|1|1|1|false",
 "from-high-school-to-university-study/s08-l1": "Many think one big review before the final is enough.|en|1|1|1|false",
 "from-high-school-to-university-study/s08-l2": "Skip the small tasks, and you can do well on the final but still get a low grade.|en|1|1|1|false",
 "from-high-school-to-university-study/s08b-l3": "The outline shows each share. Read it in the first class.|en|1|1|1|false",
 "from-high-school-to-university-study/s08b-l4": "Your final grade is built from the very first days.|en|1|1|1|false",
 "from-high-school-to-university-study/s09-l1": "Part two: your first week.|en|1|1|1|false",
 "from-high-school-to-university-study/s10-l1": "Download every course outline.|en|1|1|1|false",
 "from-high-school-to-university-study/s10-l2": "Note the grading, allowed absences, deadlines and exam dates.|en|1|1|1|false",
 "from-high-school-to-university-study/s10-l3": "Save the lecturer's and class monitor's contacts. Join each class group.|en|1|1|1|false",
 "from-high-school-to-university-study/s10-l4": "And find the library and the training office.|en|1|1|1|false",
 "from-high-school-to-university-study/s11-l1": "The outline is the map of a course.|en|1|1|1|false",
 "from-high-school-to-university-study/s11-l2": "What you learn, what you read, and when work is due.|en|1|1|1|false",
 "from-high-school-to-university-study/s11-l3": "Read it in week one, and three deadlines in one week won't surprise you.|en|1|1|1|false",
 "from-high-school-to-university-study/s12-l1": "Student email… a room change and an exam date!|en|1|1|1|false",
 "from-high-school-to-university-study/s12-l2": "Check the student portal or email once a day.|en|1|1|1|false",
 "from-high-school-to-university-study/s12-l3": "Room changes, exam dates, fee deadlines. Nobody tells you twice.|en|1|1|1|false",
 "from-high-school-to-university-study/s13-l1": "Part three: no one reminds you, so make a plan.|en|1|1|1|false",
 "from-high-school-to-university-study/s14-l1": "Make a weekly plan, on paper or on your phone.|en|1|1|1|false",
 "from-high-school-to-university-study/s14-l2": "Classes, study time for each course, part-time work, sleep and rest.|en|1|1|1|false",
 "from-high-school-to-university-study/s14-l3": "One page shows how much free time you really have.|en|1|1|1|false",
 "from-high-school-to-university-study/s14-l4": "On class days, review briefly and write down what you didn't understand.|en|1|1|1|false",
 "from-high-school-to-university-study/s14-l5": "A little every day stays longer than one night before the exam.|en|1|1|1|false",
 "from-high-school-to-university-study/s15-l1": "Split big work into small steps, each with its own deadline.|en|1|1|1|false",
 "from-high-school-to-university-study/s15-l2": "Week one, find sources. Week two, write a draft.|en|1|1|1|false",
 "from-high-school-to-university-study/s15-l3": "Week three, revise, and submit one day early.|en|1|1|1|false",
 "from-high-school-to-university-study/s16-l1": "Two hours of self-study. Dũng opens his book.|en|1|1|1|false",
 "from-high-school-to-university-study/s16-l2": "Ping! One quick reply…|en|1|1|1|false",
 "from-high-school-to-university-study/s16-l3": "Another one! Just one more…|en|1|1|1|false",
 "from-high-school-to-university-study/s16-l4": "Wait a second!|en|1|1|1|false",
 "from-high-school-to-university-study/s16-l5": "Your phone takes more study time than anything else.|en|1|1|1|false",
 "from-high-school-to-university-study/s16-l6": "Let's rewind and try again.|en|1|1|1|false",
 "from-high-school-to-university-study/s16-l7": "Notifications off. Phone out of reach.|en|1|1|1|false",
 "from-high-school-to-university-study/s16-l8": "I'll study the whole block, then check messages on my break.|en|1|1|1|false",
 "from-high-school-to-university-study/s17-l1": "A student with only morning classes keeps his afternoons safe.|en|1|1|1|false",
 "from-high-school-to-university-study/s17-l2": "Sunday night: a two-hour study block every afternoon, one course a day, like a real class.|en|1|1|1|false",
 "from-high-school-to-university-study/s17-l3": "Two projects due in three weeks: sources, draft, revision.|en|1|1|1|false",
 "from-high-school-to-university-study/s17-l4": "Phone away while studying. By the deadline, both are almost done.|en|1|1|1|false",
 "from-high-school-to-university-study/s17-l5": "Free time that's not in your plan just disappears.|en|1|1|1|false",
 "from-high-school-to-university-study/s18-l1": "Part four: getting more from class and self-study.|en|1|1|1|false",
 "from-high-school-to-university-study/s19-l1": "Before class, skim the next lesson. You'll know what's new and what to ask.|en|1|1|1|false",
 "from-high-school-to-university-study/s19-l2": "Sit near the front. Your phone pulls you away less.|en|1|1|1|false",
 "from-high-school-to-university-study/s19-l3": "Take notes in your own words, not every slide word for word.|en|1|1|1|false",
 "from-high-school-to-university-study/s19-l4": "After class, write three main ideas and one question.|en|1|1|1|false",
 "from-high-school-to-university-study/s20-l1": "Don't understand? Ask after class, by email, or in office hours.|en|1|1|1|false",
 "from-high-school-to-university-study/s20-l2": "I didn't understand this part today. Could you suggest some extra reading?|en|1|1|1|false",
 "from-high-school-to-university-study/s20-l3": "Ask early, not in exam week. Later lessons build on this one.|en|1|1|1|false",
 "from-high-school-to-university-study/s21-l1": "A study group works when everyone reads first.|en|1|1|1|false",
 "from-high-school-to-university-study/s21-l2": "Then you meet to ask, and explain to each other.|en|1|1|1|false",
 "from-high-school-to-university-study/s21-l3": "If no one prepares, it's just a chat.|en|1|1|1|false",
 "from-high-school-to-university-study/s22-a1": "Lan's first message in a five-person project group.|en|1|1|1|false",
 "from-high-school-to-university-study/s22-a2": "Let's just work on it bit by bit. Take whatever part you're free for.|en|1|1|1|false",
 "from-high-school-to-university-study/s22-a3": "Sounds nice, but work piles up on a few people at the last minute.|en|1|1|1|false",
 "from-high-school-to-university-study/s22-b1": "Vy finds sources. Nam and Hà write. Tú does slides. Quỳnh puts it together.|en|1|1|1|false",
 "from-high-school-to-university-study/s22-b2": "Send your part by Thursday night. On Friday, we all read it.|en|1|1|1|false",
 "from-high-school-to-university-study/s22-b3": "Share tasks clearly at the start, so no one carries it all at the end.|en|1|1|1|false",
 "from-high-school-to-university-study/s23-l1": "Part five: exam season without panic.|en|1|1|1|false",
 "from-high-school-to-university-study/s24-l1": "As soon as dates are out, put every exam in your calendar.|en|1|1|1|false",
 "from-high-school-to-university-study/s24-l2": "Count back, and start reviewing a few weeks before.|en|1|1|1|false",
 "from-high-school-to-university-study/s24-l3": "Check the room, the time and the papers to bring. A wrong exam date is hard to fix.|en|1|1|1|false",
 "from-high-school-to-university-study/s25-l1": "Review by testing yourself. Close your notes and recall the main ideas.|en|1|1|1|false",
 "from-high-school-to-university-study/s25-l2": "Do past papers if allowed. Explain it to a friend.|en|1|1|1|false",
 "from-high-school-to-university-study/s25-l3": "Rereading feels familiar. Remembering means recalling without looking.|en|1|1|1|false",
 "from-high-school-to-university-study/s26-l1": "Staying up all night before an exam shows real effort. True or false?|en|1|1|1|false",
 "from-high-school-to-university-study/s26-l2": "False. Enough sleep matters more. A tired brain gets even known answers wrong.|en|1|1|1|false",
 "from-high-school-to-university-study/s27-l1": "Copying, cheating, or a stand-in at the exam break the rules. Penalties can be serious.|en|1|1|1|false",
 "from-high-school-to-university-study/s27-l2": "Not ready for a good reason? Ask the training office.|en|1|1|1|false",
 "from-high-school-to-university-study/s28-l1": "Part six: falling behind? Who can help?|en|1|1|1|false",
 "from-high-school-to-university-study/s29-l1": "Can't keep up? Want to change a course? Worried about an academic warning?|en|1|1|1|false",
 "from-high-school-to-university-study/s29-l2": "Your adviser, the training office, student affairs, and older students can help.|en|1|1|1|false",
 "from-high-school-to-university-study/s29-l3": "Ask early. Waiting until the end of term removes options.|en|1|1|1|false",
 "from-high-school-to-university-study/s30-l1": "Are you coming to math class, Dũng?|en|1|1|1|false",
 "from-high-school-to-university-study/s30-l2": "No. I failed the midterm. I've lost the course anyway.|en|1|1|1|false",
 "from-high-school-to-university-study/s30-l3": "Wait a second!|en|1|1|1|false",
 "from-high-school-to-university-study/s30-l4": "One bad test isn't the whole course. But too many missed classes means no final exam.|en|1|1|1|false",
 "from-high-school-to-university-study/s30-l5": "Let's rewind and try again.|en|1|1|1|false",
 "from-high-school-to-university-study/s30-l6": "I failed the midterm. Where did I go wrong, and which points can I still earn?|en|1|1|1|false",
 "from-high-school-to-university-study/s30-l7": "Falling behind? Ask early. Don't hide.|en|1|1|1|false",
 "from-high-school-to-university-study/s31-l1": "How's your timetable? Which subject is hard? Found the library yet?|en|1|1|1|false",
 "from-high-school-to-university-study/s31-l2": "Parents: ask about these, not only grades.|en|1|1|1|false",
 "from-high-school-to-university-study/s31-l3": "First-term results often don't show everything. Your child is learning a new way to learn.|en|1|1|1|false",
 "from-high-school-to-university-study/s32-l1": "Your grade starts on day one.|en|1|1|1|false",
 "from-high-school-to-university-study/s32-l2": "Put your free time into your plan.|en|1|1|1|false",
 "from-high-school-to-university-study/s32-l3": "Share group tasks clearly at the start.|en|1|1|1|false",
 "from-high-school-to-university-study/s32-l4": "And when you fall behind, ask early.|en|1|1|1|false",
 "from-high-school-to-university-study/s33-l1": "Which works better, a little study every day or one long night before the exam?|en|1|1|1|false",
 "from-high-school-to-university-study/s33-l2": "A little every day, because regular review helps you remember for longer.|en|1|1|1|false",
 "from-high-school-to-university-study/s33-l3": "One long night may help the next morning, but you tire and forget fast.|en|1|1|1|false",
 "from-high-school-to-university-study/s34-l1": "What is a more effective way to review than reading your notes again and again?|en|1|1|1|false",
 "from-high-school-to-university-study/s34-l2": "Close your notes and test yourself, do practice questions, or explain ideas to a friend.|en|1|1|1|false",
 "from-high-school-to-university-study/s34-l3": "Testing makes your brain recall. Rereading only feels familiar.|en|1|1|1|false",
 "from-high-school-to-university-study/s35-l1": "Tonight, open your first course outline. Copy every deadline and exam date into your phone.|en|1|1|1|false",
 "from-high-school-to-university-study/s35-l2": "Then try the forty questions below.|en|1|1|1|false",
 "further-study-or-start-working/s01-l1": "Do a master's degree, to be safe.|en|1|1|1|false",
 "further-study-or-start-working/s01-l2": "Start working early. That's how you get experience!|en|1|1|1|false",
 "further-study-or-start-working/s01-l3": "I'm only in my third year. Who should I listen to?|en|1|1|1|false",
 "further-study-or-start-working/s02-l1": "Study more, or start working? There's no right answer for everyone.|en|1|1|1|false",
 "further-study-or-start-working/s02-l2": "Study more when the job needs it, and you have a clear goal and a money plan.|en|1|1|1|false",
 "further-study-or-start-working/s02-l3": "Start working when you're unsure, or your field values experience.|en|1|1|1|false",
 "further-study-or-start-working/s02-l4": "And prepare now, so both doors stay open.|en|1|1|1|false",
 "further-study-or-start-working/s03-l1": "Six parts. Then what to prepare in year two and three.|en|1|1|1|false",
 "further-study-or-start-working/s04-l1": "Part one: do you need to think about this yet?|en|1|1|1|false",
 "further-study-or-start-working/s05-l1": "You don't need to decide yet, but start thinking. Some doors depend on your whole time at university.|en|1|1|1|false",
 "further-study-or-start-working/s05-l2": "Grades over several years, research experience, letters from teachers, a language certificate. You can't gather them in one last term.|en|1|1|1|false",
 "further-study-or-start-working/s06-l1": "Thinking early also means you're less pushed by other people. When it's time to choose, you've already researched and asked.|en|1|1|1|false",
 "further-study-or-start-working/s07-l1": "Part two: five honest questions for yourself.|en|1|1|1|false",
 "further-study-or-start-working/s08-l1": "Why do I want to study more? Passion, a job requirement, or not wanting to face the job hunt?|en|1|1|1|false",
 "further-study-or-start-working/s08-l2": "Does my target job need a higher degree? Do I know which subject I want?|en|1|1|1|false",
 "further-study-or-start-working/s08-l3": "Can I afford it? And does my family need my support soon? A few years without income can be hard.|en|1|1|1|false",
 "further-study-or-start-working/s09-l1": "To answer question two, read real job ads for the role you want, and ask people doing it.|en|1|1|1|false",
 "further-study-or-start-working/s09-l2": "Don't rely only on the feeling that a higher degree is always better.|en|1|1|1|false",
 "further-study-or-start-working/s10-l1": "About to graduate, no idea what job you want. Someone says: just do a master's. Will that help you know?|en|1|1|1|false",
 "further-study-or-start-working/s11-l1": "Usually not. A master's follows a narrow subject. Chosen while unsure, you may study what you never use.|en|1|1|1|false",
 "further-study-or-start-working/s11-l2": "Two years on, the question is still there. And employers ask: have you done any real projects?|en|1|1|1|false",
 "further-study-or-start-working/s11-l3": "Working for a while shows what knowledge a real job needs. Then you choose the right course. Don't use a degree to hide.|en|1|1|1|false",
 "further-study-or-start-working/s12-l1": "Part three: when further study is a good choice.|en|1|1|1|false",
 "further-study-or-start-working/s13-l1": "When you want research or university teaching, where a postgraduate degree is often required.|en|1|1|1|false",
 "further-study-or-start-working/s13-l2": "When you have a rare scholarship, especially one with an age or graduation-year limit.|en|1|1|1|false",
 "further-study-or-start-working/s13-l3": "When you want to change fields and need a solid base in the new one.|en|1|1|1|false",
 "further-study-or-start-working/s14-l1": "Pros: deeper knowledge, a network, more chances for some roles.|en|1|1|1|false",
 "further-study-or-start-working/s14-l2": "Cons: time, money, later experience. Some say: many degrees, little experience.|en|1|1|1|false",
 "further-study-or-start-working/s15-l1": "Lan is in year two and dreams of a master's scholarship abroad. She reads the conditions carefully.|en|1|1|1|false",
 "further-study-or-start-working/s15-l2": "They look at grades from all years, and want letters from research teachers.|en|1|1|1|false",
 "further-study-or-start-working/s15-l3": "So she keeps her grades steady, joins a teacher's research group, and moves her part-time hours.|en|1|1|1|false",
 "further-study-or-start-working/s15-l4": "By final year, her file is ready. Scholarships look at the whole journey, not just the last year.|en|1|1|1|false",
 "further-study-or-start-working/s16-l1": "Part four: when starting work fits better.|en|1|1|1|false",
 "further-study-or-start-working/s17-l1": "When your field values experience and real work, like business, marketing, tech and design.|en|1|1|1|false",
 "further-study-or-start-working/s17-l2": "When you're not sure what to specialise in yet.|en|1|1|1|false",
 "further-study-or-start-working/s17-l3": "When you need income to be independent or help your family, or you already have a good offer in the right direction.|en|1|1|1|false",
 "further-study-or-start-working/s18-l1": "Pros: income, experience, knowing the market, and seeing what you still lack.|en|1|1|1|false",
 "further-study-or-start-working/s18-l2": "Con: once you work, going back to full-time study is harder. Duties and habits change.|en|1|1|1|false",
 "further-study-or-start-working/s19-l1": "Part five: is there a third way?|en|1|1|1|false",
 "further-study-or-start-working/s20-l1": "Yes. Work a few years, then study. You choose your subject from real job needs, and some management programs prefer experience.|en|1|1|1|false",
 "further-study-or-start-working/s20-l2": "Or study part-time or in the evening to keep your income. Or take certificates and short courses for your job.|en|1|1|1|false",
 "further-study-or-start-working/s20-l3": "Some companies support staff who study. Ask about it when you accept a job.|en|1|1|1|false",
 "further-study-or-start-working/s21-l1": "Thao started working after graduating, and promised: two years, then I'll study again.|en|1|1|1|false",
 "further-study-or-start-working/s21-l2": "But every year there was a reason to wait: a new project, a move, a new position. The promise had no date.|en|1|1|1|false",
 "further-study-or-start-working/s21-l3": "Four years later, a manager role needs a higher degree. She starts studying just when work is busiest.|en|1|1|1|false",
 "further-study-or-start-working/s22-l1": "Set a review date. Don't let someday drift forever.|en|1|1|1|false",
 "further-study-or-start-working/s23-l1": "Part six: deciding on solid ground.|en|1|1|1|false",
 "further-study-or-start-working/s24-l1": "Ask at least two people in your field: one who studied more, and one who started working.|en|1|1|1|false",
 "further-study-or-start-working/s24-l2": "Each person tends to defend their own path. Hear only one side, and your view gets biased.|en|1|1|1|false",
 "further-study-or-start-working/s25-l1": "A full-time master's in another city. I'll just add up the tuition.|en|1|1|1|false",
 "further-study-or-start-working/s25-l2": "Rent and food? A part-time job will cover it.|en|1|1|1|false",
 "further-study-or-start-working/s25-l3": "Wait a second!|en|1|1|1|false",
 "further-study-or-start-working/s25-l4": "By term two, it's not enough. Evening shifts, tired in class, the thesis falls behind.|en|1|1|1|false",
 "further-study-or-start-working/s25-l5": "Let's rewind and try again.|en|1|1|1|false",
 "further-study-or-start-working/s25-l6": "Tuition, rent, food, and the income I won't have while studying. Let me count it all.|en|1|1|1|false",
 "further-study-or-start-working/s26-l1": "Write your plan: after the degree, which job will you apply for? Does it really need this degree?|en|1|1|1|false",
 "further-study-or-start-working/s26-l2": "Then set a review point, like after two years of work. You'll decide again with real experience.|en|1|1|1|false",
 "further-study-or-start-working/s27-l1": "Dad, I'll answer the five questions on paper first.|en|1|1|1|false",
 "further-study-or-start-working/s27-l2": "Then I'll ask two people in my field: one who studied more, and one who started working.|en|1|1|1|false",
 "further-study-or-start-working/s27-l3": "Not right or wrong. Just a fit for your goal and situation now.|en|1|1|1|false",
 "further-study-or-start-working/s28-l1": "Keep your grades steady. Try a research project with a teacher. Take a language test while you're less busy.|en|1|1|1|false",
 "further-study-or-start-working/s28-l2": "Do one internship to see the other side. Note a few scholarship deadlines.|en|1|1|1|false",
 "further-study-or-start-working/s28-l3": "Both doors stay open. In final year, either way, you don't start from zero.|en|1|1|1|false",
 "further-study-or-start-working/s29-l1": "For parents: a higher degree is only safe when your child knows what it's for.|en|1|1|1|false",
 "further-study-or-start-working/s29-l2": "Count the full cost together, and talk to people ahead. Don't decide for them.|en|1|1|1|false",
 "further-study-or-start-working/s30-l1": "You are unsure what job you want, does starting a master's degree right away usually solve that?|en|1|1|1|false",
 "further-study-or-start-working/s30-l2": "Usually not, because a narrow degree chosen while unsure may never get used.|en|1|1|1|false",
 "further-study-or-start-working/s30-l3": "Two years later, the question is still there. Don't use a degree to hide.|en|1|1|1|false",
 "further-study-or-start-working/s31-l1": "Answer the five questions on one page. Then try the forty questions below!|en|1|1|1|false",
 "getting-around-safely-new-city/s01-a1": "A birthday party! Let's go, we'll see about getting home later.|en|1|1|1|false",
 "getting-around-safely-new-city/s01-a2": "Later: a dead phone, a dark shortcut alone, footsteps behind her.|en|1|1|1|false",
 "getting-around-safely-new-city/s01-b1": "Phone charged. Dũng, shall we leave together at ten?|en|1|1|1|false",
 "getting-around-safely-new-city/s01-b2": "Sure, we go the same way. Main roads.|en|1|1|1|false",
 "getting-around-safely-new-city/s02-l1": "Two endings. How do you get around safely? A few small habits.|en|1|1|1|false",
 "getting-around-safely-new-city/s02-l2": "Try the route in daylight.|en|1|1|1|false",
 "getting-around-safely-new-city/s02-l3": "Keep your bag in front.|en|1|1|1|false",
 "getting-around-safely-new-city/s02-l4": "Check the plate before you get in.|en|1|1|1|false",
 "getting-around-safely-new-city/s02-l5": "Lock your bike. And plan the way home first.|en|1|1|1|false",
 "getting-around-safely-new-city/s03-l1": "Six parts: your first week, buses, ride apps,|en|1|1|1|false",
 "getting-around-safely-new-city/s03-l2": "bikes, late nights, and small accidents.|en|1|1|1|false",
 "getting-around-safely-new-city/s04-l1": "Part one: getting to know the roads.|en|1|1|1|false",
 "getting-around-safely-new-city/s05-l1": "Before my first class: a test trip, room to school, by daylight.|en|1|1|1|false",
 "getting-around-safely-new-city/s05-l2": "By bus, the same way I'll go on Monday.|en|1|1|1|false",
 "getting-around-safely-new-city/s05-l3": "Knowing the turns, the parking and the class gate makes day one calmer.|en|1|1|1|false",
 "getting-around-safely-new-city/s06-l1": "Save your room, school and nearest hospital in your phone.|en|1|1|1|false",
 "getting-around-safely-new-city/s06-l2": "Download an offline map.|en|1|1|1|false",
 "getting-around-safely-new-city/s06-l3": "Write your address on paper, and keep it in your wallet.|en|1|1|1|false",
 "getting-around-safely-new-city/s06-l4": "Carry a power bank. Your phone is your map and your way to call for help.|en|1|1|1|false",
 "getting-around-safely-new-city/s07-l1": "Going somewhere new? Someone should know where I am.|en|1|1|1|false",
 "getting-around-safely-new-city/s07-l2": "I'll share my location with you for the first few weeks.|en|1|1|1|false",
 "getting-around-safely-new-city/s07-l3": "Okay. If anything happens, I'll know where to find you.|en|1|1|1|false",
 "getting-around-safely-new-city/s07-l4": "It's not being watched. And share only with someone you trust, not publicly.|en|1|1|1|false",
 "getting-around-safely-new-city/s08-l1": "Part two: taking the bus.|en|1|1|1|false",
 "getting-around-safely-new-city/s09-l1": "Rush hour. The bus is packed. Lan's phone is in the outside pocket of her backpack.|en|1|1|1|false",
 "getting-around-safely-new-city/s09-l2": "Which stop is mine? Let me look out the window…|en|1|1|1|false",
 "getting-around-safely-new-city/s09-l3": "Wait a second!|en|1|1|1|false",
 "getting-around-safely-new-city/s09-l4": "Her pocket is open now. The phone is gone, with photos and numbers not backed up.|en|1|1|1|false",
 "getting-around-safely-new-city/s09-l5": "Let's rewind and try again.|en|1|1|1|false",
 "getting-around-safely-new-city/s09-l6": "Backpack on my front. Phone in the zipped inside pocket.|en|1|1|1|false",
 "getting-around-safely-new-city/s09-l7": "And not in my hand near the door.|en|1|1|1|false",
 "getting-around-safely-new-city/s10-l1": "Check routes on a map or the city's official information.|en|1|1|1|false",
 "getting-around-safely-new-city/s10-l2": "At the stop, check the bus number and the direction.|en|1|1|1|false",
 "getting-around-safely-new-city/s10-l3": "Many cities have cheap monthly passes for students. Ask at the station or student affairs.|en|1|1|1|false",
 "getting-around-safely-new-city/s11-l1": "Someone stands too close, touches you, or says something unpleasant?|en|1|1|1|false",
 "getting-around-safely-new-city/s11-l2": "Move near the driver or other people.|en|1|1|1|false",
 "getting-around-safely-new-city/s11-l3": "Please step back a little.|en|1|1|1|false",
 "getting-around-safely-new-city/s11-l4": "Say it clearly. You can tell the conductor or the driver.|en|1|1|1|false",
 "getting-around-safely-new-city/s12-l1": "Part three: ride apps.|en|1|1|1|false",
 "getting-around-safely-new-city/s13-l1": "Nearly ten p.m. at the bus station. A man walks up: “Your app car is here!”|en|1|1|1|false",
 "getting-around-safely-new-city/s13-l2": "Oh, great. Let's go!|en|1|1|1|false",
 "getting-around-safely-new-city/s13-l3": "Wait a second!|en|1|1|1|false",
 "getting-around-safely-new-city/s13-l4": "Fakes wait at stations and school gates, for tired people who skip checking.|en|1|1|1|false",
 "getting-around-safely-new-city/s13-l5": "Let's rewind and try again.|en|1|1|1|false",
 "getting-around-safely-new-city/s13-l6": "No, thanks. I'll stand in the light and book on my app.|en|1|1|1|false",
 "getting-around-safely-new-city/s13-l7": "The plate matches. Excuse me, who are you picking up?|en|1|1|1|false",
 "getting-around-safely-new-city/s13-l8": "Plate matches, then get in.|en|1|1|1|false",
 "getting-around-safely-new-city/s14-l1": "Check the plate number. Check the driver's name and photo.|en|1|1|1|false",
 "getting-around-safely-new-city/s14-l2": "Ask whose booking it is. Don't say your own name first.|en|1|1|1|false",
 "getting-around-safely-new-city/s14-l3": "A real driver knows it from the app. A fake one can just agree.|en|1|1|1|false",
 "getting-around-safely-new-city/s14-l4": "Share the trip with your roommate. Doesn't match? “The plate isn't the same as the app. I'll book again.”|en|1|1|1|false",
 "getting-around-safely-new-city/s15-l1": "Riding alone in a car? Sit in the back, and follow the route on your own map.|en|1|1|1|false",
 "getting-around-safely-new-city/s15-l2": "The driver changes route with no reason? Ask, and ask to stop somewhere busy.|en|1|1|1|false",
 "getting-around-safely-new-city/s15-l3": "Pay the price in the app. Asked for much more? Stay calm.|en|1|1|1|false",
 "getting-around-safely-new-city/s15-l4": "Take a photo of the trip details, and report it once you're safely out.|en|1|1|1|false",
 "getting-around-safely-new-city/s16-l1": "Part four: riding your own bike.|en|1|1|1|false",
 "getting-around-safely-new-city/s17-l1": "Everyone rides without a licence, so you can too. True or false?|en|1|1|1|false",
 "getting-around-safely-new-city/s17-l2": "False. You need the right age and a licence. E-bikes have their own rules.|en|1|1|1|false",
 "getting-around-safely-new-city/s17-l3": "Check the current rules before you buy or borrow a bike.|en|1|1|1|false",
 "getting-around-safely-new-city/s18-l1": "Wear a proper helmet, strap fastened, every time. Even for short trips.|en|1|1|1|false",
 "getting-around-safely-new-city/s18-l2": "Never use your phone while riding. To check the map, pull over and stop.|en|1|1|1|false",
 "getting-around-safely-new-city/s19-l1": "Park where there's an attendant, and keep your ticket safe.|en|1|1|1|false",
 "getting-around-safely-new-city/s19-l2": "At your room, lock the steering and add an extra lock.|en|1|1|1|false",
 "getting-around-safely-new-city/s19-l3": "Even when you stop for just a moment.|en|1|1|1|false",
 "getting-around-safely-new-city/s20-l1": "Just five minutes to grab my stuff. No need to lock it.|en|1|1|1|false",
 "getting-around-safely-new-city/s20-l2": "No steering lock. The key still in. When Dũng comes back, the bike is gone.|en|1|1|1|false",
 "getting-around-safely-new-city/s20-l3": "The camera shows only a figure in a full helmet.|en|1|1|1|false",
 "getting-around-safely-new-city/s20-l4": "Lock it even for a minute. Take the key even for one step.|en|1|1|1|false",
 "getting-around-safely-new-city/s21-l1": "Part five: coming home late.|en|1|1|1|false",
 "getting-around-safely-new-city/s22-l1": "Before going out: how will you get home, and when?|en|1|1|1|false",
 "getting-around-safely-new-city/s22-l2": "What time does your building close?|en|1|1|1|false",
 "getting-around-safely-new-city/s22-l3": "Tell your roommate when you'll be back, and text when you arrive.|en|1|1|1|false",
 "getting-around-safely-new-city/s23-l1": "Go with friends, on big bright roads.|en|1|1|1|false",
 "getting-around-safely-new-city/s23-l2": "Avoid dark empty shortcuts, even if they're faster.|en|1|1|1|false",
 "getting-around-safely-new-city/s23-l3": "Keep enough battery to book a car, find the way, or call for help.|en|1|1|1|false",
 "getting-around-safely-new-city/s24-l1": "Someone following you? Go into an open shop or a busy place.|en|1|1|1|false",
 "getting-around-safely-new-city/s24-l2": "Call someone and say exactly where you are. Don't lead them to your room.|en|1|1|1|false",
 "getting-around-safely-new-city/s24-l3": "Had a drink? Don't ride. Book a car, or ride with someone who hasn't drunk.|en|1|1|1|false",
 "getting-around-safely-new-city/s24-l4": "In a crowd, keep your drink in sight.|en|1|1|1|false",
 "getting-around-safely-new-city/s25-l1": "Remember Lan's second ending? Charged phone, a friend going the same way, main roads.|en|1|1|1|false",
 "getting-around-safely-new-city/s25-l2": "Plan the way home before you plan the fun.|en|1|1|1|false",
 "getting-around-safely-new-city/s26-l1": "Part six: a small accident on the road.|en|1|1|1|false",
 "getting-around-safely-new-city/s27-l1": "A small crash? Stay calm, and move to the side of the road.|en|1|1|1|false",
 "getting-around-safely-new-city/s27-l2": "Check if you or the other person is hurt.|en|1|1|1|false",
 "getting-around-safely-new-city/s27-l3": "Take photos of the scene and the plates. They're evidence later.|en|1|1|1|false",
 "getting-around-safely-new-city/s27-l4": "Feeling lost? Call someone you know to come.|en|1|1|1|false",
 "getting-around-safely-new-city/s28-l1": "Don't shout. And don't hand over money just because you're pressured.|en|1|1|1|false",
 "getting-around-safely-new-city/s28-l2": "Can't agree, or someone is hurt? Call the authorities, and an ambulance if needed.|en|1|1|1|false",
 "getting-around-safely-new-city/s29-l1": "Parents: instead of banning nights out, agree on a few rules together.|en|1|1|1|false",
 "getting-around-safely-new-city/s29-l2": "Text me when you get home. Share your location when you go far.|en|1|1|1|false",
 "getting-around-safely-new-city/s29-l3": "And never ride after drinking.|en|1|1|1|false",
 "getting-around-safely-new-city/s29-l4": "Deal, Dad.|en|1|1|1|false",
 "getting-around-safely-new-city/s29-l5": "Clear rules keep them safe even when you're not there. A ban may just mean going out secretly.|en|1|1|1|false",
 "getting-around-safely-new-city/s30-l1": "The busier the bus, the more your bag goes in front.|en|1|1|1|false",
 "getting-around-safely-new-city/s30-l2": "Plate matches, then get in.|en|1|1|1|false",
 "getting-around-safely-new-city/s30-l3": "Lock it even for a minute.|en|1|1|1|false",
 "getting-around-safely-new-city/s30-l4": "Plan the way home before the fun.|en|1|1|1|false",
 "getting-around-safely-new-city/s31-l1": "The plate number does not match the app, but the driver says it is fine, what should you do?|en|1|1|1|false",
 "getting-around-safely-new-city/s31-l2": "Politely refuse the ride, cancel, and book again through the app.|en|1|1|1|false",
 "getting-around-safely-new-city/s31-l3": "If it doesn't match, you can't be sure who is driving. A few minutes is worth it.|en|1|1|1|false",
 "getting-around-safely-new-city/s32-l1": "Tonight, charge your power bank, and share your location with your roommate.|en|1|1|1|false",
 "getting-around-safely-new-city/s32-l2": "Then try the forty questions below.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s01-l1": "Imagine you're Thao. Midnight in a hotel abroad.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s01-l2": "My chest feels tight. I can't breathe well.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s01-l3": "Where's the insurance email? Does it pay for an ambulance?|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s01-l4": "Sick abroad: where do you go, and who do you call first?|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s02-l1": "This video doesn't replace a doctor. But it helps you choose: three levels.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s02-l2": "Serious: call an ambulance now.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s02-l3": "Need a doctor today: call your insurer first.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s02-l4": "Mild: ask a pharmacist and watch. And always keep your papers.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s03-l1": "Six stops. Which level. Emergencies. Calling the insurer.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s03-l2": "The pharmacy. Papers. And who to tell.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s04-l1": "Part one: how sick, and where to go?|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s05-l1": "Emergency: chest pain, trouble breathing, fainting, heavy bleeding, a bad accident, sudden confusion.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s05-l2": "Call the local emergency number, or ask reception to call now. No need to call the insurer first.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s05-l3": "Need a doctor today: high fever, lots of vomiting, long pain, a cut that needs stitches.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s05-l4": "Call the insurance hotline or ask reception for a suitable clinic. Then go. Waiting makes it worse.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s05b-l5": "Mild: a light cold, a passing stomach ache, insect bites. Ask a pharmacist, rest, and watch.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s05b-l6": "Not better, or getting worse? Move up a level. Don't just put up with it.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s06-l1": "Three levels help you avoid two opposite mistakes.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s06-l2": "Waiting too long because you fear the cost.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s06-l3": "Or going to the emergency room for something small, when a better choice exists.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s07-l1": "Part two: an emergency. Who to call, what to say.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s08-l1": "My chest… I can't breathe well.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s08-l2": "Hold on, Mum. Let me read the insurance policy first.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s08-l3": "Wait a second!|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s08-l4": "Reading the policy can take half an hour. With chest pain, every minute counts.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s08-l5": "Let's rewind and try again.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s08-l6": "Please call an ambulance. My mother has chest pain.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s08-l7": "Don't know the number? Ask reception, your travel partner, or any staff nearby to call.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s08-l8": "Passport, her list of medicines, the insurance card. Ready.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s08-l9": "But never let the papers slow the call. Tell the insurer as soon as you can, after.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s09-l1": "In a serious emergency, call for help first. Papers later.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s10-l1": "Part three: not urgent, but you need a doctor today.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s11-l1": "Many policies ask you to call before a visit that isn't an emergency.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s11-l2": "They may send you to a clinic they pay directly. The number is on your card or policy email.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s11-l3": "Say: I have travel insurance. I need to see a doctor today.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s12-l1": "I'm at a hotel in the centre. High fever since yesterday. My policy number is attached.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s12-l2": "Where should I go? Do I pay first? Which papers should I keep?|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s12-l3": "A clinic nearby. We pay them directly. Keep the bill and the diagnosis.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s12-l4": "Tell them where you are, your symptoms, since when, and your policy number.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s13-l1": "Dung had ear pain for two days.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s13-l2": "He found a fancy private clinic near the hotel, paid, and left.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s13-l3": "Back home, he read the policy: not an emergency? Call the hotline first.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s13-l4": "He skipped that call, so his claim was only partly considered.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s13-l5": "Not urgent? Call your insurer before you call a taxi.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s14-l1": "With the doctor, keep it short: when it started, how bad, what you take, any allergies.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s14-l2": "I have had a high fever since yesterday. I am allergic to penicillin.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s14-l3": "Not sure you understood? Ask the doctor to write it down.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s15-l1": "Part four: a mild illness, at the pharmacy.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s16-l1": "Bring your old medicine box, or a photo of it.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s16-l2": "Names differ by country. The active ingredient on the box tells the pharmacist what you need.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s16-l3": "Always mention allergies and the medicines you take, before you get anything.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s16-l4": "Ask how to take it: How many times a day?|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s16-l5": "A friendly stranger offers pills? Thank them, say no, and ask a pharmacist.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s17-l0": "Binh has a sore throat. He's allergic to one group of antibiotics.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s17-a1": "Sore throat.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s17-a2": "Here you are. Take these.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s17-a3": "He takes it at once. It could be the very kind he's allergic to, and she'd never know.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s17-b1": "Sore throat. I am allergic to penicillin. Is this medicine safe for me?|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s17-b2": "Thank you for telling me. Let me choose a different one.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s17-l1": "A note written in English works even when you're tired or forget the words.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s17-l2": "Say what you're allergic to before you take any medicine.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s18-l1": "Part five: papers, so the insurer pays.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s19-l1": "An itemised bill, every charge, not just the total.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s19-l2": "The prescription, and the pharmacy receipt.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s19-l3": "The diagnosis, and any test results.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s19-l4": "Ask: Could I have an itemised receipt, please?|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s20-l1": "Photograph each page right there, before you leave the clinic.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s20-l2": "Email them to yourself. Papers get lost easily.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s20-l3": "Ask the insurer for the claim deadline, and send it early.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s21-l1": "You've had asthma since childhood, and you're buying travel insurance.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s21a-l2": "Way A: hide it, to keep the price down. If an attack sends you to hospital, the insurer checks your history.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s21c-l3": "Way B: declare it. Ask if existing illnesses are covered, and pick a fitting plan.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s21b-l4": "It may cost a little more. Be honest when you buy, and use it without worry.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s22-l1": "Last part: who to tell, and the days ahead.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s23-l1": "Tell family or your company how you are and where you're being seen.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s23-l2": "I have a fever. I've called the insurer and I'm at a clinic near the hotel. I'll update you.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s23-l3": "Rest well, and keep me posted.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s23-l4": "Too ill to fly as planned? Ask both your insurer and the airline about changing the flight.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s24-l1": "First, decide the level. Serious: emergency help.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s24-l2": "Need a doctor: call the insurer first. Mild: ask a pharmacist and watch.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s24-l3": "And keep every paper, on the spot.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s25-l1": "Which papers do insurers usually need after you see a doctor abroad?|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s25-l2": "The itemised bill, the prescription, the diagnosis and any test results.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s25-l3": "Missing one can slow your claim. Photograph each one on the spot.|en|1|1|1|false",
 "getting-sick-abroad-and-travel-insurance/s26-l1": "Right now, save your insurance hotline and the local emergency number. Then try the forty questions!|en|1|1|1|false",
 "getting-sick-living-alone/s01-l1": "Dũng had a high fever for three days. He took medicine and kept going to class.|en|1|1|1|false",
 "getting-sick-living-alone/s01-l2": "Day four, and no fever. I'm better!|en|1|1|1|false",
 "getting-sick-living-alone/s01-l3": "But that afternoon… We'll come back to Dũng.|en|1|1|1|false",
 "getting-sick-living-alone/s02-l1": "Sick and alone. When can you care for yourself, and when must you see a doctor?|en|1|1|1|false",
 "getting-sick-living-alone/s02-l2": "Get a medicine kit ready while you're well.|en|1|1|1|false",
 "getting-sick-living-alone/s02-l3": "Read the label before you take anything.|en|1|1|1|false",
 "getting-sick-living-alone/s02-l4": "Know the signs that need a doctor.|en|1|1|1|false",
 "getting-sick-living-alone/s02-l5": "And always let one person know.|en|1|1|1|false",
 "getting-sick-living-alone/s03-l1": "Six parts: prepare, care for a cold, signs to see a doctor,|en|1|1|1|false",
 "getting-sick-living-alone/s03-l2": "who to tell, your first clinic visit, and getting sick less.|en|1|1|1|false",
 "getting-sick-living-alone/s04-l1": "Part one: prepare while you're well.|en|1|1|1|false",
 "getting-sick-living-alone/s05-l1": "Preparing while you're well is much easier than walking to a pharmacy with a fever.|en|1|1|1|false",
 "getting-sick-living-alone/s05-l2": "Half a day in your first week is enough.|en|1|1|1|false",
 "getting-sick-living-alone/s05-l3": "A thermometer, a common fever medicine, rehydration salts.|en|1|1|1|false",
 "getting-sick-living-alone/s05-l4": "Plasters, antiseptic, masks, and some instant rice porridge.|en|1|1|1|false",
 "getting-sick-living-alone/s05-l5": "On a regular medicine? Bring enough, and ask your doctor how to buy more in the city.|en|1|1|1|false",
 "getting-sick-living-alone/s06-l1": "Save the emergency number and your campus clinic.|en|1|1|1|false",
 "getting-sick-living-alone/s06-l2": "And the nearest pharmacy and hospital.|en|1|1|1|false",
 "getting-sick-living-alone/s06-l3": "When you're very sick, you won't have the energy to search.|en|1|1|1|false",
 "getting-sick-living-alone/s07-l1": "Students usually get health insurance through the school.|en|1|1|1|false",
 "getting-sick-living-alone/s07-l2": "Where is my insurance card registered for check-ups?|en|1|1|1|false",
 "getting-sick-living-alone/s07-l3": "Please check the guide the school sent you.|en|1|1|1|false",
 "getting-sick-living-alone/s07-l4": "Ask student affairs or the campus clinic, not word of mouth. Rules can change.|en|1|1|1|false",
 "getting-sick-living-alone/s08-l1": "One student asked the school where her card was registered.|en|1|1|1|false",
 "getting-sick-living-alone/s08-l2": "She saved the address, photographed the card, and kept it in her wallet.|en|1|1|1|false",
 "getting-sick-living-alone/s08-l3": "Two months later, sudden stomach pain. Her roommate drove straight there.|en|1|1|1|false",
 "getting-sick-living-alone/s08-l4": "Know where to go while you're well. Carry your card when you go.|en|1|1|1|false",
 "getting-sick-living-alone/s09-l1": "Part two: a cold or mild fever.|en|1|1|1|false",
 "getting-sick-living-alone/s10-l1": "With a normal cold, your body needs rest, water, and soft food like porridge or soup.|en|1|1|1|false",
 "getting-sick-living-alone/s10-l2": "Taking one day off to sleep usually helps more than going to class with a fever.|en|1|1|1|false",
 "getting-sick-living-alone/s11-l1": "Take your temperature a few times a day. Note it in your phone.|en|1|1|1|false",
 "getting-sick-living-alone/s11-l2": "What time, how high, and which medicine you took.|en|1|1|1|false",
 "getting-sick-living-alone/s11-l3": "It helps a doctor far more than “I've had a fever for days.”|en|1|1|1|false",
 "getting-sick-living-alone/s12-l1": "I have a fever and a cough. What should I take, and how?|en|1|1|1|false",
 "getting-sick-living-alone/s12-l2": "Describe your symptoms clearly to the pharmacist.|en|1|1|1|false",
 "getting-sick-living-alone/s12-l3": "Antibiotics don't cure colds caused by viruses. Use them only when a doctor prescribes.|en|1|1|1|false",
 "getting-sick-living-alone/s13-l1": "Cold medicine and fever medicine are different things.|en|1|1|1|false",
 "getting-sick-living-alone/s13-l2": "I'll take both together, to get well faster.|en|1|1|1|false",
 "getting-sick-living-alone/s13-l3": "Wait a second!|en|1|1|1|false",
 "getting-sick-living-alone/s13-l4": "Many cold medicines already contain a fever reducer, often paracetamol. Too much can harm the liver.|en|1|1|1|false",
 "getting-sick-living-alone/s13-l5": "Let's rewind and try again.|en|1|1|1|false",
 "getting-sick-living-alone/s13-l6": "First, the ingredients and the dose on both boxes.|en|1|1|1|false",
 "getting-sick-living-alone/s13-l7": "Not sure? I'll take both boxes to the pharmacist. And no extra pills.|en|1|1|1|false",
 "getting-sick-living-alone/s13-l8": "Read the label before you take it. Ask a pharmacist before you combine.|en|1|1|1|false",
 "getting-sick-living-alone/s14-l1": "Part three: when to stop coping alone.|en|1|1|1|false",
 "getting-sick-living-alone/s15-l1": "See a doctor soon if you have any one of these.|en|1|1|1|false",
 "getting-sick-living-alone/s15-l2": "A high fever that won't come down after medicine, or lasts several days.|en|1|1|1|false",
 "getting-sick-living-alone/s15-l3": "Heavy vomiting, and you can't keep water down. Severe stomach pain.|en|1|1|1|false",
 "getting-sick-living-alone/s15-l4": "Red spots under the skin, bleeding gums or nosebleeds.|en|1|1|1|false",
 "getting-sick-living-alone/s15-l5": "Or a sore throat so bad you can't swallow.|en|1|1|1|false",
 "getting-sick-living-alone/s16-l1": "Trouble breathing, chest pain, confusion, a seizure, or fainting?|en|1|1|1|false",
 "getting-sick-living-alone/s16-l2": "Call an ambulance, or have someone take you now.|en|1|1|1|false",
 "getting-sick-living-alone/s16-l3": "Don't ride a motorbike alone. Don't wait to see if it's better tomorrow.|en|1|1|1|false",
 "getting-sick-living-alone/s17-l1": "Many places have a dengue season.|en|1|1|1|false",
 "getting-sick-living-alone/s17-l2": "High fever and you suspect dengue? Don't take aspirin or ibuprofen yourself.|en|1|1|1|false",
 "getting-sick-living-alone/s17-l3": "Ask a doctor or pharmacist which fever medicine suits you. Drink water, and get checked.|en|1|1|1|false",
 "getting-sick-living-alone/s18-l1": "Back to Dũng. That afternoon, his stomach hurts.|en|1|1|1|false",
 "getting-sick-living-alone/s18-l2": "And my gums are bleeding when I brush…|en|1|1|1|false",
 "getting-sick-living-alone/s18-l3": "His roommate took him to a doctor. It might be dengue.|en|1|1|1|false",
 "getting-sick-living-alone/s18-l4": "The days after the fever ends need close watching.|en|1|1|1|false",
 "getting-sick-living-alone/s18-l5": "A high fever that won't go away? Don't guess. See a doctor.|en|1|1|1|false",
 "getting-sick-living-alone/s19-l1": "Part four: who to tell, and what to say.|en|1|1|1|false",
 "getting-sick-living-alone/s20-l1": "Lan gets a fever at the weekend.|en|1|1|1|false",
 "getting-sick-living-alone/s20-l2": "I don't want to bother anyone. I'll just stay in bed.|en|1|1|1|false",
 "getting-sick-living-alone/s20-l3": "Wait a second!|en|1|1|1|false",
 "getting-sick-living-alone/s20-l4": "Two days of eating and drinking very little, and she needed a drip. Tell someone.|en|1|1|1|false",
 "getting-sick-living-alone/s20-l5": "Let's rewind and try again.|en|1|1|1|false",
 "getting-sick-living-alone/s20-l6": "I've got a fever, I'm in my room. If I don't reply tonight, please check on me.|en|1|1|1|false",
 "getting-sick-living-alone/s20-l7": "Sick alone? Don't stay silent alone.|en|1|1|1|false",
 "getting-sick-living-alone/s21-l1": "Tell your parents early and calmly. Late news worries them more.|en|1|1|1|false",
 "getting-sick-living-alone/s21-l2": "I have a cold. I've taken medicine and I'm resting.|en|1|1|1|false",
 "getting-sick-living-alone/s21-l3": "If the fever doesn't go down, I'll see a doctor and let you know.|en|1|1|1|false",
 "getting-sick-living-alone/s22-l1": "Missing class? Tell the class monitor or lecturer, the way your school requires.|en|1|1|1|false",
 "getting-sick-living-alone/s22-l2": "Ask if you need a doctor's note.|en|1|1|1|false",
 "getting-sick-living-alone/s22-l3": "And ask a friend to photo the notes for you.|en|1|1|1|false",
 "getting-sick-living-alone/s23-l1": "Part five: your first clinic visit in a new city.|en|1|1|1|false",
 "getting-sick-living-alone/s24-l1": "Bring your insurance card, or the paper your school says to use.|en|1|1|1|false",
 "getting-sick-living-alone/s24-l2": "Your ID, your phone with your notes, some cash, and water.|en|1|1|1|false",
 "getting-sick-living-alone/s24-l3": "If you can, take a friend to help with the forms.|en|1|1|1|false",
 "getting-sick-living-alone/s25-l1": "With the doctor, tell it in order.|en|1|1|1|false",
 "getting-sick-living-alone/s25-l2": "When it started, your symptoms, and the medicine you took.|en|1|1|1|false",
 "getting-sick-living-alone/s25-l3": "Then ask: How many days should I take this?|en|1|1|1|false",
 "getting-sick-living-alone/s25-l4": "And: Which signs mean I should come back?|en|1|1|1|false",
 "getting-sick-living-alone/s26-l1": "You feel better after a few days, so you can stop the antibiotics. True or false?|en|1|1|1|false",
 "getting-sick-living-alone/s26-l2": "False. Finish all the days on the prescription, even if you feel better.|en|1|1|1|false",
 "getting-sick-living-alone/s26-l3": "Keep the prescription and the doctor's note, for follow-ups and for school.|en|1|1|1|false",
 "getting-sick-living-alone/s27-l1": "Part six: getting sick less often.|en|1|1|1|false",
 "getting-sick-living-alone/s28-l1": "In the first month, many students get small illnesses.|en|1|1|1|false",
 "getting-sick-living-alone/s28-l2": "Late nights, irregular meals, and stress while everything is new.|en|1|1|1|false",
 "getting-sick-living-alone/s28-l3": "Sleep enough, eat every meal, drink enough water.|en|1|1|1|false",
 "getting-sick-living-alone/s29-l1": "Sleep under a mosquito net. Mosquitoes can spread illnesses like dengue.|en|1|1|1|false",
 "getting-sick-living-alone/s29-l2": "Wash your hands before eating.|en|1|1|1|false",
 "getting-sick-living-alone/s29-l3": "Roommate sick? Don't share cups or towels.|en|1|1|1|false",
 "getting-sick-living-alone/s29-l4": "When the season changes, carry a raincoat and a jacket.|en|1|1|1|false",
 "getting-sick-living-alone/s30-l1": "Parents: before they leave, prepare a medicine kit together, and save a friend's number.|en|1|1|1|false",
 "getting-sick-living-alone/s30-l2": "Have you eaten? Does anyone know you're sick?|en|1|1|1|false",
 "getting-sick-living-alone/s30-l3": "A calm question makes it easier to tell the truth.|en|1|1|1|false",
 "getting-sick-living-alone/s30-l4": "Scolding or many worried calls make them less likely to tell you next time.|en|1|1|1|false",
 "getting-sick-living-alone/s31-l1": "Know where to go while you're well.|en|1|1|1|false",
 "getting-sick-living-alone/s31-l2": "Read the label before you take it.|en|1|1|1|false",
 "getting-sick-living-alone/s31-l3": "A high fever that won't go down? See a doctor.|en|1|1|1|false",
 "getting-sick-living-alone/s31-l4": "And sick alone, don't stay silent alone.|en|1|1|1|false",
 "getting-sick-living-alone/s32-l1": "Which saying helps you decide what to do when a high fever will not go down?|en|1|1|1|false",
 "getting-sick-living-alone/s32-l2": "When a high fever will not go down, stop guessing and go see a doctor.|en|1|1|1|false",
 "getting-sick-living-alone/s32-l3": "Guessing or doubling the dose can hide important signs.|en|1|1|1|false",
 "getting-sick-living-alone/s33-l1": "Tonight, save the emergency and campus clinic numbers, and ask where your card is registered.|en|1|1|1|false",
 "getting-sick-living-alone/s33-l2": "Then try the forty questions below.|en|1|1|1|false",
 "give-feedback-to-team-members/s01-l1": "Dung, your work this quarter was not good enough.|en|1|1|1|false",
 "give-feedback-to-team-members/s01-l2": "Thao, you knew. Why did you not tell me sooner?|en|1|1|1|false",
 "give-feedback-to-team-members/s01-l3": "For three months, Thao fixed his reports in silence. Let's rewind.|en|1|1|1|false",
 "give-feedback-to-team-members/s02-l1": "How do you give feedback so people really improve?|en|1|1|1|false",
 "give-feedback-to-team-members/s02-l2": "Speak early and in private.|en|1|1|1|false",
 "give-feedback-to-team-members/s02-l3": "Point to the work.|en|1|1|1|false",
 "give-feedback-to-team-members/s02-l4": "Ask, and listen.|en|1|1|1|false",
 "give-feedback-to-team-members/s02-l5": "Agree on one action, and check again.|en|1|1|1|false",
 "give-feedback-to-team-members/s03-l1": "Do not fix it for them.|en|1|1|1|false",
 "give-feedback-to-team-members/s03-l2": "Prepare before you speak.|en|1|1|1|false",
 "give-feedback-to-team-members/s03-l3": "Open without blame.|en|1|1|1|false",
 "give-feedback-to-team-members/s03-l4": "When they argue or get upset.|en|1|1|1|false",
 "give-feedback-to-team-members/s03-l5": "And after the talk.|en|1|1|1|false",
 "give-feedback-to-team-members/s04-l1": "Part one: three months earlier.|en|1|1|1|false",
 "give-feedback-to-team-members/s05-l1": "Here is the client report.|en|1|1|1|false",
 "give-feedback-to-team-members/s05-l2": "Thanks. I will just fix it myself, quietly.|en|1|1|1|false",
 "give-feedback-to-team-members/s05-l3": "Wait a second!|en|1|1|1|false",
 "give-feedback-to-team-members/s05-l4": "Fix it for him today, and the same mistake comes back tomorrow.|en|1|1|1|false",
 "give-feedback-to-team-members/s05-l5": "Let's rewind and try again.|en|1|1|1|false",
 "give-feedback-to-team-members/s05-l6": "Yesterday's report was missing the costs. The client had to ask, so we lost a day.|en|1|1|1|false",
 "give-feedback-to-team-members/s05-l7": "Next time, check that part before you send it.|en|1|1|1|false",
 "give-feedback-to-team-members/s05-l8": "Got it. Thanks for telling me.|en|1|1|1|false",
 "give-feedback-to-team-members/s06-l1": "Giving feedback means you think you are better. True or false?|en|1|1|1|false",
 "give-feedback-to-team-members/s06-l2": "False. It is help. Told early, they can fix it before the boss or client sees.|en|1|1|1|false",
 "give-feedback-to-team-members/s06-l3": "“Why did you not tell me sooner?” means they wanted that chance.|en|1|1|1|false",
 "give-feedback-to-team-members/s07-l1": "Part two: prepare before you speak.|en|1|1|1|false",
 "give-feedback-to-team-members/s08-l1": "Speak soon, while it is fresh, usually within a few days.|en|1|1|1|false",
 "give-feedback-to-team-members/s08-l2": "But not while you are angry. Wait a day, calm down, then speak.|en|1|1|1|false",
 "give-feedback-to-team-members/s09-l1": "Choose a private place: a short talk for two, or a call.|en|1|1|1|false",
 "give-feedback-to-team-members/s09-l2": "Not the team chat, not in front of everyone. They will protect their face, not listen.|en|1|1|1|false",
 "give-feedback-to-team-members/s10-l1": "Write four things down: what happened, its effect, what you hope for, and one question.|en|1|1|1|false",
 "give-feedback-to-team-members/s10-l2": "You will feel less nervous, and speak more clearly.|en|1|1|1|false",
 "give-feedback-to-team-members/s11-l0": "In a meeting, Thao finds that Dung sent the wrong file to a client.|en|1|1|1|false",
 "give-feedback-to-team-members/s11-a1": "Next time, check more carefully!|en|1|1|1|false",
 "give-feedback-to-team-members/s11-a2": "Sorry.|en|1|1|1|false",
 "give-feedback-to-team-members/s11-b1": "After the meeting: got a few minutes? Let's look at the file together.|en|1|1|1|false",
 "give-feedback-to-team-members/s11-b2": "Sure. Let's agree how to check before sending.|en|1|1|1|false",
 "give-feedback-to-team-members/s11-l1": "Way A: he goes quiet, and speaks less for weeks. Way B: he keeps face and fixes it.|en|1|1|1|false",
 "give-feedback-to-team-members/s11-l2": "Next week, when he does well, praise him in the meeting.|en|1|1|1|false",
 "give-feedback-to-team-members/s12-l1": "Praise in front of the group. Correct in private.|en|1|1|1|false",
 "give-feedback-to-team-members/s13-l1": "Part three: how to open without blame.|en|1|1|1|false",
 "give-feedback-to-team-members/s14-l1": "Talk about the work, not the person. Not “You are careless.”|en|1|1|1|false",
 "give-feedback-to-team-members/s14-l2": "But “Tuesday's report was missing the cost section.” That can be fixed.|en|1|1|1|false",
 "give-feedback-to-team-members/s15-l1": "Three steps: what you saw, its effect, and what you hope for next time.|en|1|1|1|false",
 "give-feedback-to-team-members/s15-l2": "“The plan came two days late, and the client waited. What got in the way?”|en|1|1|1|false",
 "give-feedback-to-team-members/s16-l1": "Avoid “always” and “never”. They argue with the word, and list the times they got it right.|en|1|1|1|false",
 "give-feedback-to-team-members/s16-l2": "Do not hide it between two compliments. Say it directly and kindly. That is respect.|en|1|1|1|false",
 "give-feedback-to-team-members/s17-l1": "Before: “You have been careless lately.” “Careless where?” A fight.|en|1|1|1|false",
 "give-feedback-to-team-members/s17-l2": "After: “Tuesday's report missed September's data. Next time, send it a day early.” Point at the work.|en|1|1|1|false",
 "give-feedback-to-team-members/s18-l1": "Part four: when they explain, argue, or get upset.|en|1|1|1|false",
 "give-feedback-to-team-members/s19-l1": "In your view, where is it getting stuck?|en|1|1|1|false",
 "give-feedback-to-team-members/s19-l2": "Honestly, I was not sure what the client needed.|en|1|1|1|false",
 "give-feedback-to-team-members/s19-l3": "Then that part is on me. I will explain more clearly next time.|en|1|1|1|false",
 "give-feedback-to-team-members/s19-l4": "Ask, and really listen. Sometimes the cause is how you gave the task.|en|1|1|1|false",
 "give-feedback-to-team-members/s20-l1": "You have really changed since you became leader.|en|1|1|1|false",
 "give-feedback-to-team-members/s20-l2": "I say this because I want you and the team to do well, not because of the title.|en|1|1|1|false",
 "give-feedback-to-team-members/s20-l3": "I can see you are upset. Let's continue tomorrow morning.|en|1|1|1|false",
 "give-feedback-to-team-members/s20-l4": "Stay calm. Do not try to win. Name the feeling, and set a time to continue.|en|1|1|1|false",
 "give-feedback-to-team-members/s21-l1": "Late three weeks in a row? Before pointing it out, ask an open question.|en|1|1|1|false",
 "give-feedback-to-team-members/s21-l2": "Listen to the end. Extra work from another team. Take it to your boss, then check in a week.|en|1|1|1|false",
 "give-feedback-to-team-members/s21-l3": "Ask one question first, and you avoid blaming people unfairly later.|en|1|1|1|false",
 "give-feedback-to-team-members/s22-l1": "Last part: how do they really improve?|en|1|1|1|false",
 "give-feedback-to-team-members/s23-l1": "From this week, send me the report one day before it goes to the client.|en|1|1|1|false",
 "give-feedback-to-team-members/s23-l2": "Deal. One day before.|en|1|1|1|false",
 "give-feedback-to-team-members/s23-l3": "One clear action with a time is easier than ten pieces of advice.|en|1|1|1|false",
 "give-feedback-to-team-members/s24-l1": "A leader gives kind feedback, then gets busy and never checks again.|en|1|1|1|false",
 "give-feedback-to-team-members/s24-l2": "A month later, the old mistake is back. Each thinks the other did not care.|en|1|1|1|false",
 "give-feedback-to-team-members/s24-l3": "Set a review date, usually in one or two weeks. No need to check every hour.|en|1|1|1|false",
 "give-feedback-to-team-members/s24-l4": "After you talk, set a date. When the date comes, check.|en|1|1|1|false",
 "give-feedback-to-team-members/s25-l1": "When they improve, praise them soon, and be specific.|en|1|1|1|false",
 "give-feedback-to-team-members/s25-l2": "This week's report has all the data. The client asked nothing. Thank you!|en|1|1|1|false",
 "give-feedback-to-team-members/s26-l1": "Write a few lines: the date, the issue, and what you agreed.|en|1|1|1|false",
 "give-feedback-to-team-members/s26-l2": "When your boss asks, you rely on facts, not memory or feelings.|en|1|1|1|false",
 "give-feedback-to-team-members/s27-l1": "Give small feedback often, praise and corrections. If you only call people in for mistakes, everyone gets nervous.|en|1|1|1|false",
 "give-feedback-to-team-members/s27-l2": "This week, was anything unclear in how I gave tasks?|en|1|1|1|false",
 "give-feedback-to-team-members/s27-l3": "The deadline for the slides was not clear.|en|1|1|1|false",
 "give-feedback-to-team-members/s27-l4": "When the leader takes feedback too, it is about work, not rank.|en|1|1|1|false",
 "give-feedback-to-team-members/s28-l1": "Early, private, specific. Say the effect. Ask and listen.|en|1|1|1|false",
 "give-feedback-to-team-members/s28-l2": "Agree on one action, check again, and praise progress. Save this list.|en|1|1|1|false",
 "give-feedback-to-team-members/s29-l1": "Good feedback does not hurt. Long silence, public words, and vague judgments do.|en|1|1|1|false",
 "give-feedback-to-team-members/s29-l2": "This week, pick one small thing, write your four points, and book a private talk.|en|1|1|1|false",
 "give-feedback-to-team-members/s30-l1": "How should you end a feedback conversation?|en|1|1|1|false",
 "give-feedback-to-team-members/s30-l2": "Agree on one specific action and a clear time, such as checking reports first.|en|1|1|1|false",
 "give-feedback-to-team-members/s30-l3": "One clear action is easier than ten pieces of advice.|en|1|1|1|false",
 "give-feedback-to-team-members/s31-l1": "Your turn. Forty questions are waiting below.|en|1|1|1|false",
 "handle-complaints-in-store/s01-l1": "Excuse me, this broth is too salty.|en|1|1|1|false",
 "handle-complaints-in-store/s01-l2": "Impossible! I cook it from early morning. Everyone loves it!|en|1|1|1|false",
 "handle-complaints-in-store/s01-l3": "I said it's too salty!|en|1|1|1|false",
 "handle-complaints-in-store/s01-l4": "The next table turns to look. He leaves half the bowl. That night, Cô Hoa tastes the broth again.|en|1|1|1|false",
 "handle-complaints-in-store/s02-l0": "A customer complains, and the whole shop is watching. What do you do?|en|1|1|1|false",
 "handle-complaints-in-store/s02-l1": "Most complaints can be settled in minutes. Stay calm,|en|1|1|1|false",
 "handle-complaints-in-store/s02-l2": "listen to the end,|en|1|1|1|false",
 "handle-complaints-in-store/s02-l3": "say sorry for what happened,|en|1|1|1|false",
 "handle-complaints-in-store/s02-l4": "and fix it right there.|en|1|1|1|false",
 "handle-complaints-in-store/s03-l1": "We'll go in order: the first ten seconds, listening, saying sorry,|en|1|1|1|false",
 "handle-complaints-in-store/s03-l2": "fixing it, difficult customers, and what to do after they leave.|en|1|1|1|false",
 "handle-complaints-in-store/s04-l1": "Part one: the first ten seconds.|en|1|1|1|false",
 "handle-complaints-in-store/s05-l1": "Shouting back from the counter turns a small problem into a show for the whole shop.|en|1|1|1|false",
 "handle-complaints-in-store/s05-l2": "So first, walk over. Look at the customer, and speak quietly.|en|1|1|1|false",
 "handle-complaints-in-store/s06-l1": "Feeling hot is normal, especially after a morning at the stove.|en|1|1|1|false",
 "handle-complaints-in-store/s06-l2": "Take a breath, and remind yourself: they're criticising the dish, not you.|en|1|1|1|false",
 "handle-complaints-in-store/s07-l1": "Then open with something simple: May I take a look, please?|en|1|1|1|false",
 "handle-complaints-in-store/s07-l2": "It doesn't admit fault, and it doesn't argue. It just shows you care.|en|1|1|1|false",
 "handle-complaints-in-store/s08-l1": "Part two: listening, so the customer calms down.|en|1|1|1|false",
 "handle-complaints-in-store/s09-l1": "Back to that night. Cô Hoa tastes the broth.|en|1|1|1|false",
 "handle-complaints-in-store/s09-l2": "Oh no. It really is too salty.|en|1|1|1|false",
 "handle-complaints-in-store/s09-l3": "Her kitchen helper had added too much salt. She explained before he finished, and lost a customer.|en|1|1|1|false",
 "handle-complaints-in-store/s09-l4": "Listen to the end, taste to be sure, and only then speak.|en|1|1|1|false",
 "handle-complaints-in-store/s10-l1": "Excuse me. The broth is a bit cold, and the meat is...|en|1|1|1|false",
 "handle-complaints-in-store/s10-l2": "But we made it fresh at five this morning!|en|1|1|1|false",
 "handle-complaints-in-store/s10-l3": "Wait a second!|en|1|1|1|false",
 "handle-complaints-in-store/s10-l4": "She cut in halfway. Upset people who get interrupted usually talk louder.|en|1|1|1|false",
 "handle-complaints-in-store/s10-l5": "Let's rewind and try another way.|en|1|1|1|false",
 "handle-complaints-in-store/s10-l6": "The broth is a bit cold, and the meat is a bit tough.|en|1|1|1|false",
 "handle-complaints-in-store/s10-l7": "So the broth is a bit cold and the meat is a bit tough, is that right?|en|1|1|1|false",
 "handle-complaints-in-store/s10-l8": "Yes, exactly.|en|1|1|1|false",
 "handle-complaints-in-store/s10-l9": "Stand close, speak softly, don't interrupt, repeat it back. Not sure what they want? Ask.|en|1|1|1|false",
 "handle-complaints-in-store/s11-l1": "Part three: saying sorry, the right way.|en|1|1|1|false",
 "handle-complaints-in-store/s12-l1": "Saying sorry for what they experienced doesn't mean you admit every mistake.|en|1|1|1|false",
 "handle-complaints-in-store/s12-l2": "Try: I'm sorry the bowl wasn't right for you. Sincere, and it blames no one.|en|1|1|1|false",
 "handle-complaints-in-store/s13-l1": "Avoid lines like: Other customers ate it and were fine. Or: It's because you came late.|en|1|1|1|false",
 "handle-complaints-in-store/s13-l2": "They make customers feel blamed, and they'll repeat those exact words to other people.|en|1|1|1|false",
 "handle-complaints-in-store/s14-l1": "Your helper made the mistake, so tell the customer who's to blame. True or false?|en|1|1|1|false",
 "handle-complaints-in-store/s14-l2": "False. The customer only needs to know the shop will fix it. Talk to your helper privately later.|en|1|1|1|false",
 "handle-complaints-in-store/s15-l1": "Part four: fix it right there.|en|1|1|1|false",
 "handle-complaints-in-store/s16-l1": "The fix comes right after the sorry. You can|en|1|1|1|false",
 "handle-complaints-in-store/s16-l2": "remake the dish,|en|1|1|1|false",
 "handle-complaints-in-store/s16-l3": "change it for another dish,|en|1|1|1|false",
 "handle-complaints-in-store/s16-l4": "or not charge for it. Let them choose: a new bowl, or a different dish?|en|1|1|1|false",
 "handle-complaints-in-store/s17-l1": "Make the new dish quickly, and more carefully than usual. Bring it yourself, and check once more.|en|1|1|1|false",
 "handle-complaints-in-store/s17-l2": "That remade dish is your chance to change how they feel about the shop.|en|1|1|1|false",
 "handle-complaints-in-store/s18-l1": "A small mistake, like the wrong drink? Swap it at once and say sorry.|en|1|1|1|false",
 "handle-complaints-in-store/s18-l2": "A bigger one, like a hair in the food or a spoiled dish? Make a new one, and don't charge.|en|1|1|1|false",
 "handle-complaints-in-store/s18-l3": "Even if the customer doesn't ask.|en|1|1|1|false",
 "handle-complaints-in-store/s19-l1": "There's an ant in my yogurt.|en|1|1|1|false",
 "handle-complaints-in-store/s19-l2": "I'm so sorry. Here's a new one.|en|1|1|1|false",
 "handle-complaints-in-store/s19-l3": "That's two yogurts, please. You ate half of the first one.|en|1|1|1|false",
 "handle-complaints-in-store/s19-l4": "Wait a second!|en|1|1|1|false",
 "handle-complaints-in-store/s19-l5": "She pays without a word, and never comes back.|en|1|1|1|false",
 "handle-complaints-in-store/s19-l6": "Let's rewind. If you fix it, fix it fully.|en|1|1|1|false",
 "handle-complaints-in-store/s19-l7": "Here's your new yogurt. I won't charge for the spoiled one.|en|1|1|1|false",
 "handle-complaints-in-store/s19-l8": "Save one cup, and you may lose a customer.|en|1|1|1|false",
 "handle-complaints-in-store/s20-l1": "Part five: when the customer is wrong, difficult, or loud.|en|1|1|1|false",
 "handle-complaints-in-store/s21-l1": "This is far too spicy!|en|1|1|1|false",
 "handle-complaints-in-store/s21-l2": "The menu says it's spicy. But don't say: Didn't you read the menu?|en|1|1|1|false",
 "handle-complaints-in-store/s21-l3": "This dish is usually a bit spicy. Let me make you a milder bowl.|en|1|1|1|false",
 "handle-complaints-in-store/s21-l4": "Explain gently, and still help.|en|1|1|1|false",
 "handle-complaints-in-store/s22-l1": "A customer shouting? Keep your voice low and slow, and invite them to a quieter corner.|en|1|1|1|false",
 "handle-complaints-in-store/s22-l2": "The calmer you sound, the harder it is for them to keep shouting.|en|1|1|1|false",
 "handle-complaints-in-store/s22-l3": "Swearing, threats, unfair demands? You have the right to set a limit, politely.|en|1|1|1|false",
 "handle-complaints-in-store/s22-l4": "If it looks like a fight, get family or neighbours beside you, and call the local police if needed.|en|1|1|1|false",
 "handle-complaints-in-store/s23-l1": "A polite limit sounds like this: I'm happy to remake it, but please speak quietly for the others.|en|1|1|1|false",
 "handle-complaints-in-store/s24a-l1": "Think about this. A group at a hotpot shop says: not very good, a bit pricey. They want a discount for the whole table.|en|1|1|1|false",
 "handle-complaints-in-store/s24-l2": "Last time the owner gave one. Now they complain the same way. Discount again?|en|1|1|1|false",
 "handle-complaints-in-store/s25-l1": "Ask exactly which dish has a problem. Broth really bland, meat not fresh? Swap it, or take off the price of that dish.|en|1|1|1|false",
 "handle-complaints-in-store/s25-l2": "Nothing specific? Thank them for the feedback, and keep your price.|en|1|1|1|false",
 "handle-complaints-in-store/s25b-l3": "Discount every time, and they learn that complaining pays. Next time they bring friends to complain.|en|1|1|1|false",
 "handle-complaints-in-store/s26-l1": "Fix real mistakes at once. Vague complaints? Keep your price.|en|1|1|1|false",
 "handle-complaints-in-store/s27-l1": "Last part: after the customer leaves.|en|1|1|1|false",
 "handle-complaints-in-store/s28-l1": "At the end of the day, write each complaint in a notebook: what was wrong,|en|1|1|1|false",
 "handle-complaints-in-store/s28-l2": "what time, which dish,|en|1|1|1|false",
 "handle-complaints-in-store/s28-l3": "and how you handled it. After a few weeks, you'll see where mistakes repeat.|en|1|1|1|false",
 "handle-complaints-in-store/s29-l1": "Fixing one bowl helps one customer. Fixing the cause stops the same complaint coming back.|en|1|1|1|false",
 "handle-complaints-in-store/s29-l2": "Broth often cold? Check how you keep the pot. Lunch dishes slow? Prepare early in the morning.|en|1|1|1|false",
 "handle-complaints-in-store/s30-l1": "At Cô Hoa's dessert stall, customers kept saying the ice melts fast. She just added more ice.|en|1|1|1|false",
 "handle-complaints-in-store/s30-l2": "Then she hung a notebook by the counter: date, dish, and the customer's words.|en|1|1|1|false",
 "handle-complaints-in-store/s30-l3": "At the weekend: five notes saying the ice melts fast, all in the afternoon.|en|1|1|1|false",
 "handle-complaints-in-store/s30-l4": "She checked the ice box. The lid was cracked. New lid, and that complaint was gone.|en|1|1|1|false",
 "handle-complaints-in-store/s30b-l5": "One complaint is a story. Three similar ones are a warning sign.|en|1|1|1|false",
 "handle-complaints-in-store/s31-l1": "A week later, Bác Bình is back.|en|1|1|1|false",
 "handle-complaints-in-store/s31-l2": "Last time you said the broth was too salty. I've fixed it. Please try it.|en|1|1|1|false",
 "handle-complaints-in-store/s31-l3": "Hm. Much better. You remembered!|en|1|1|1|false",
 "handle-complaints-in-store/s31-l4": "When customers see their words were heard, they stay even closer than before.|en|1|1|1|false",
 "handle-complaints-in-store/s32-l1": "Everyone does it the same way: go close, listen, say sorry, offer a fix, then tell me.|en|1|1|1|false",
 "handle-complaints-in-store/s32-l2": "The sample sentences are by the counter. Wrong drink? Swap it. No need to ask me first.|en|1|1|1|false",
 "handle-complaints-in-store/s32-l3": "Got it. I can remake a dish too, right away.|en|1|1|1|false",
 "handle-complaints-in-store/s32-l4": "Customers wait less, and staff feel more confident.|en|1|1|1|false",
 "handle-complaints-in-store/s33-l1": "A complaint is a gift that's hard to accept. If they still talk, they still want to come back.|en|1|1|1|false",
 "handle-complaints-in-store/s33-l2": "Today, copy three sample sentences onto paper, and stick them by the till.|en|1|1|1|false",
 "handle-complaints-in-store/s34-l1": "In the hotpot question, what should the owner ask before deciding on a discount?|en|1|1|1|false",
 "handle-complaints-in-store/s34-l2": "Ask exactly which dish has a problem, so he can fix that dish only.|en|1|1|1|false",
 "handle-complaints-in-store/s34-l3": "Real mistake? Fix that dish. No real mistake? Say thanks, and keep your price.|en|1|1|1|false",
 "handle-complaints-in-store/s35-l1": "Ready? Forty questions are waiting below.|en|1|1|1|false",
 "handle-returns-and-refunds/s01-l1": "This isn't my headset. It's an old one, a different model!|en|1|1|1|false",
 "handle-returns-and-refunds/s01-l2": "A week ago, a buyer said it had no sound. Dũng refunded the money that same evening.|en|1|1|1|false",
 "handle-returns-and-refunds/s01-l3": "Now the buyer doesn't reply. Which step did he skip?|en|1|1|1|false",
 "handle-returns-and-refunds/s02-l1": "How do you handle a return, and keep both the buyer and your money?|en|1|1|1|false",
 "handle-returns-and-refunds/s02-l2": "Write your policy first.|en|1|1|1|false",
 "handle-returns-and-refunds/s02-l3": "Film your packing.|en|1|1|1|false",
 "handle-returns-and-refunds/s02-l4": "Reply calmly.|en|1|1|1|false",
 "handle-returns-and-refunds/s02-l5": "And check the item before you refund.|en|1|1|1|false",
 "handle-returns-and-refunds/s03-l1": "We'll follow a return in the order it happens.|en|1|1|1|false",
 "handle-returns-and-refunds/s04-l1": "Part one: get ready before anyone asks.|en|1|1|1|false",
 "handle-returns-and-refunds/s05-l1": "Write your return policy, and put it where buyers see it.|en|1|1|1|false",
 "handle-returns-and-refunds/s05-l2": "In your shop description, a pinned post, and the message that confirms each order.|en|1|1|1|false",
 "handle-returns-and-refunds/s05-l3": "If buyers read it first, you both follow the same rules.|en|1|1|1|false",
 "handle-returns-and-refunds/s06-l1": "How many days after delivery?|en|1|1|1|false",
 "handle-returns-and-refunds/s06-l2": "Tags and labels on, never used.|en|1|1|1|false",
 "handle-returns-and-refunds/s06-l3": "Who pays shipping: if it's the shop's fault, and if the buyer changes their mind.|en|1|1|1|false",
 "handle-returns-and-refunds/s06-l4": "And how refunds are sent, within how many days.|en|1|1|1|false",
 "handle-returns-and-refunds/s07-l1": "On a big platform, your own return policy comes first. True or false?|en|1|1|1|false",
 "handle-returns-and-refunds/s07-l2": "False. The platform's rules come first. Read the seller section, so the two don't clash.|en|1|1|1|false",
 "handle-returns-and-refunds/s08-l1": "Underwear, opened cosmetics and food: often no returns for hygiene, unless faulty or wrong.|en|1|1|1|false",
 "handle-returns-and-refunds/s08-l2": "Rules vary by platform and place. Write it in the description.|en|1|1|1|false",
 "handle-returns-and-refunds/s09-l1": "Before: 'We accept returns if it doesn't suit you.'|en|1|1|1|false",
 "handle-returns-and-refunds/s09-l3": "After: returns within three days, tags on, not worn, not washed.|en|1|1|1|false",
 "handle-returns-and-refunds/s09-l4": "Shop's fault: we pay shipping. Changed your mind: you help with it.|en|1|1|1|false",
 "handle-returns-and-refunds/s10-l0": "With the vague one, a buyer wears the dress to a wedding, returns it two weeks later, and says: 'It didn't suit me.'|en|1|1|1|false",
 "handle-returns-and-refunds/s10-l1": "Time limit, condition, who pays. Write the rules first, and you won't argue later.|en|1|1|1|false",
 "handle-returns-and-refunds/s11-l1": "Part two: pack so you have proof later.|en|1|1|1|false",
 "handle-returns-and-refunds/s12-l1": "Film one unbroken video while you pack.|en|1|1|1|false",
 "handle-returns-and-refunds/s12-l2": "Show the order code, the items, how many, and their condition,|en|1|1|1|false",
 "handle-returns-and-refunds/s12-l3": "until the box is sealed. Then you can talk with facts.|en|1|1|1|false",
 "handle-returns-and-refunds/s13-l1": "Take photos before packing, above all for fragile items.|en|1|1|1|false",
 "handle-returns-and-refunds/s13-l2": "Note the batch code, colour and size you sent.|en|1|1|1|false",
 "handle-returns-and-refunds/s13-l3": "Save each video under its order code, to find it fast.|en|1|1|1|false",
 "handle-returns-and-refunds/s13-l4": "Keep it at least until the return period ends.|en|1|1|1|false",
 "handle-returns-and-refunds/s14-l1": "Also ask buyers to film when they open it. Write it on the box.|en|1|1|1|false",
 "handle-returns-and-refunds/s14-l2": "Please film while you open the parcel, so we can help with returns quickly.|en|1|1|1|false",
 "handle-returns-and-refunds/s14-l3": "A polite note gives both sides proof.|en|1|1|1|false",
 "handle-returns-and-refunds/s15-l1": "Thảo sells phone accessories. She packs in ten minutes before work.|en|1|1|1|false",
 "handle-returns-and-refunds/s15-l2": "A buyer says one case is missing from an order of three.|en|1|1|1|false",
 "handle-returns-and-refunds/s15-l3": "She's sure she packed three. But she has no photo, no video.|en|1|1|1|false",
 "handle-returns-and-refunds/s15-l4": "In the end, she sends one more, and pays the extra shipping.|en|1|1|1|false",
 "handle-returns-and-refunds/s16-l1": "Memory isn't proof. Film while you pack, and worry less when someone complains.|en|1|1|1|false",
 "handle-returns-and-refunds/s17-l1": "Part three: a buyer wants to return something. What's your first line?|en|1|1|1|false",
 "handle-returns-and-refunds/s18-l1": "Reply soon. Thank them, ask what happened. Don't say yes or no yet.|en|1|1|1|false",
 "handle-returns-and-refunds/s18-l2": "Hi, I want to return my order.|en|1|1|1|false",
 "handle-returns-and-refunds/s18-l3": "We're sorry for the trouble. Could you send a photo or video of the item, so we can check right away?|en|1|1|1|false",
 "handle-returns-and-refunds/s19-l1": "Asking for photos isn't to make it hard for buyers.|en|1|1|1|false",
 "handle-returns-and-refunds/s19-l2": "It shows where the problem is: broken, wrong item, or the buyer just doesn't like it.|en|1|1|1|false",
 "handle-returns-and-refunds/s19-l3": "Each case is handled differently.|en|1|1|1|false",
 "handle-returns-and-refunds/s20-l1": "Don't argue in public comments. Invite the buyer to a private chat.|en|1|1|1|false",
 "handle-returns-and-refunds/s20-l2": "We've sent you a private message, to sort this out faster.|en|1|1|1|false",
 "handle-returns-and-refunds/s20-l3": "Others see the shop replied. The details stay in messages.|en|1|1|1|false",
 "handle-returns-and-refunds/s21-l1": "Lan just got home from work, tired. A buyer says the shirt is too tight.|en|1|1|1|false",
 "handle-returns-and-refunds/s21-l2": "The size chart is clear. Didn't you read it?|en|1|1|1|false",
 "handle-returns-and-refunds/s21-l3": "Wait a second!|en|1|1|1|false",
 "handle-returns-and-refunds/s21-l4": "She screenshots it for a group. Days later, far fewer buyers message.|en|1|1|1|false",
 "handle-returns-and-refunds/s21-l5": "Let's rewind. Put the phone down, drink some water first.|en|1|1|1|false",
 "handle-returns-and-refunds/s21-l6": "Sorry it doesn't fit. If the tag is on, send it back and we'll swap a bigger size.|en|1|1|1|false",
 "handle-returns-and-refunds/s21-l7": "She exchanges it, and stays your buyer. Cool your head before you type.|en|1|1|1|false",
 "handle-returns-and-refunds/s22-l1": "Part four: the shop's mistake, or a changed mind?|en|1|1|1|false",
 "handle-returns-and-refunds/s23-l1": "I ordered blue, but this one is red.|en|1|1|1|false",
 "handle-returns-and-refunds/s23-l2": "That's our mistake, I'm sorry. We'll pay the shipping.|en|1|1|1|false",
 "handle-returns-and-refunds/s23-l3": "Would you like a new one, or your money back?|en|1|1|1|false",
 "handle-returns-and-refunds/s23-l4": "Shop's fault: admit it briefly, pay the shipping, let them choose. Buyers calm down fast.|en|1|1|1|false",
 "handle-returns-and-refunds/s24-l1": "Changed mind, item not faulty? Follow your posted policy.|en|1|1|1|false",
 "handle-returns-and-refunds/s24-l2": "Within the time limit, tags on: accept it. Shipping as written.|en|1|1|1|false",
 "handle-returns-and-refunds/s24-l3": "It's still within the exchange period. Please send it back, and help with both-way shipping, as in our policy.|en|1|1|1|false",
 "handle-returns-and-refunds/s25-l1": "Two small tips.|en|1|1|1|false",
 "handle-returns-and-refunds/s25-l2": "A loyal buyer is a few days late? Help once, and say it's a special exception.|en|1|1|1|false",
 "handle-returns-and-refunds/s25-l3": "An exchange keeps the sale, so suggest it first. But if they want a refund under your rules, don't push.|en|1|1|1|false",
 "handle-returns-and-refunds/s26-l1": "Part five: receiving the item, and refunding cleanly.|en|1|1|1|false",
 "handle-returns-and-refunds/s27-l1": "When it comes back, film yourself opening and checking it.|en|1|1|1|false",
 "handle-returns-and-refunds/s27-l2": "Is it your item? Are the tags on? Any new damage?|en|1|1|1|false",
 "handle-returns-and-refunds/s27-l3": "If something's wrong, message the buyer now with photos. Not weeks later.|en|1|1|1|false",
 "handle-returns-and-refunds/s28-l1": "Refund to the same account, or the same way they paid. Put the order code in the note.|en|1|1|1|false",
 "handle-returns-and-refunds/s28-l2": "Then confirm: we've refunded this order, please check.|en|1|1|1|false",
 "handle-returns-and-refunds/s28-l3": "Another account, someone else's name? Ask again, and keep that message.|en|1|1|1|false",
 "handle-returns-and-refunds/s28-l4": "Money sent to the wrong person is very hard to get back.|en|1|1|1|false",
 "handle-returns-and-refunds/s28-l5": "Give a clear refund date, and keep it. Buyers left waiting write the worst reviews.|en|1|1|1|false",
 "handle-returns-and-refunds/s29-l1": "Back to Dũng. A buyer writes: 'No sound. I'll send it back tomorrow.'|en|1|1|1|false",
 "handle-returns-and-refunds/s29-l2": "To keep my good name, I'll refund you tonight!|en|1|1|1|false",
 "handle-returns-and-refunds/s29-l3": "Wait a second!|en|1|1|1|false",
 "handle-returns-and-refunds/s29-l4": "You haven't seen the item yet. What will come back in that box?|en|1|1|1|false",
 "handle-returns-and-refunds/s29-l5": "Let's rewind and try again.|en|1|1|1|false",
 "handle-returns-and-refunds/s29-l6": "When it arrives, I'll film the opening and check it. Then I'll refund you.|en|1|1|1|false",
 "handle-returns-and-refunds/s29-l7": "Receive it, check it, then refund.|en|1|1|1|false",
 "handle-returns-and-refunds/s30-l1": "Part six: unfair demands, and what each return teaches you.|en|1|1|1|false",
 "handle-returns-and-refunds/s31-l1": "Unfair claim? Calmly show proof: packing video, photos, your posted policy.|en|1|1|1|false",
 "handle-returns-and-refunds/s31-l2": "Talk about facts, not the person. The packing video shows all three items in the order.|en|1|1|1|false",
 "handle-returns-and-refunds/s32-l1": "On a platform, use its dispute process, and send proof before its deadline.|en|1|1|1|false",
 "handle-returns-and-refunds/s32-l2": "Private deals outside the platform are hard to get help with.|en|1|1|1|false",
 "handle-returns-and-refunds/s32-l3": "Sometimes losing a little costs less than a week of arguing. Set your own limit.|en|1|1|1|false",
 "handle-returns-and-refunds/s32-l4": "Below it, settle fast. Above it, follow the process.|en|1|1|1|false",
 "handle-returns-and-refunds/s32-l5": "Someone always buys and returns, or always says items are missing? Note it, and ask them to pay first.|en|1|1|1|false",
 "handle-returns-and-refunds/s33-l1": "Write down each return: which item, why, and how you handled it.|en|1|1|1|false",
 "handle-returns-and-refunds/s33-l2": "After a few months, you'll see repeats, like one shirt that runs small.|en|1|1|1|false",
 "handle-returns-and-refunds/s33-l3": "Fix the root: add real measurements, shoot colours in daylight, pack fragile items better.|en|1|1|1|false",
 "handle-returns-and-refunds/s34-l1": "Return costs are a real business cost, not bad luck.|en|1|1|1|false",
 "handle-returns-and-refunds/s34-l2": "Put a small part of it in your price. Selling with family or friends? Agree who decides returns and who refunds.|en|1|1|1|false",
 "handle-returns-and-refunds/s35-l1": "Returns don't mean you sell badly. Buyers remember how you handle them.|en|1|1|1|false",
 "handle-returns-and-refunds/s35-l2": "Write your policy today, and pin it to your page.|en|1|1|1|false",
 "handle-returns-and-refunds/s36-l1": "What order of steps protects you when giving a refund?|en|1|1|1|false",
 "handle-returns-and-refunds/s36-l2": "Receive the item, check it carefully, and only then send the money back.|en|1|1|1|false",
 "handle-returns-and-refunds/s36-l3": "Until the item arrives, a promise isn't certain. Receive, check, then refund.|en|1|1|1|false",
 "handle-returns-and-refunds/s37-l1": "Next time, Dũng checks first. Now try the forty questions below.|en|1|1|1|false",
 "handle-slow-team-member/s01-l1": "For weeks, Dung's reports have been slow. Thao is annoyed.|en|1|1|1|false",
 "handle-slow-team-member/s01-l2": "He is just lazy.|en|1|1|1|false",
 "handle-slow-team-member/s01-l3": "But is that really the reason?|en|1|1|1|false",
 "handle-slow-team-member/s02-l1": "Someone keeps being late. What do you do? Most slow work can be fixed.|en|1|1|1|false",
 "handle-slow-team-member/s02-l2": "Speak early and in private.|en|1|1|1|false",
 "handle-slow-team-member/s02-l3": "Ask before you judge.|en|1|1|1|false",
 "handle-slow-team-member/s02-l4": "Agree on a clear deadline.|en|1|1|1|false",
 "handle-slow-team-member/s02-l5": "And tell your manager in time.|en|1|1|1|false",
 "handle-slow-team-member/s03-l1": "What to do first.|en|1|1|1|false",
 "handle-slow-team-member/s03-l2": "How to talk in private.|en|1|1|1|false",
 "handle-slow-team-member/s03-l3": "Help for each reason.|en|1|1|1|false",
 "handle-slow-team-member/s03-l4": "A clear agreement.|en|1|1|1|false",
 "handle-slow-team-member/s03-l5": "And if nothing improves.|en|1|1|1|false",
 "handle-slow-team-member/s04-l1": "Part one: what to do first.|en|1|1|1|false",
 "handle-slow-team-member/s05-l1": "Before you meet, write down the facts: which task, how late, who was affected.|en|1|1|1|false",
 "handle-slow-team-member/s05-l2": "“You are always slow” is a feeling. “Three reports were a day late” is a fact, and harder to argue with.|en|1|1|1|false",
 "handle-slow-team-member/s06-l1": "Check your side too. Was the task clear? Was the deadline fair? Is their load too heavy?|en|1|1|1|false",
 "handle-slow-team-member/s06-l2": "Sometimes the fix is in how you gave the task.|en|1|1|1|false",
 "handle-slow-team-member/s07-l1": "Do not wait for the review, or until you cannot stand it.|en|1|1|1|false",
 "handle-slow-team-member/s07-l2": "Very angry, your words get harsh, and the talk becomes a fight. Speak at the first signs.|en|1|1|1|false",
 "handle-slow-team-member/s08-a1": "Someone here keeps slowing the whole team down.|en|1|1|1|false",
 "handle-slow-team-member/s08-a2": "…|en|1|1|1|false",
 "handle-slow-team-member/s08-b1": "Some tasks were late recently. Is something blocking you?|en|1|1|1|false",
 "handle-slow-team-member/s08-b2": "Yes, actually. Can I explain?|en|1|1|1|false",
 "handle-slow-team-member/s08-l1": "Way A: everyone knows who. He avoids you, shares fewer problems, and you hear late.|en|1|1|1|false",
 "handle-slow-team-member/s08-l2": "Way B: after the meeting, in private. He keeps face, and can tell the truth.|en|1|1|1|false",
 "handle-slow-team-member/s09-l1": "Remind in private, and people fix it. Speak in public, and they get angry.|en|1|1|1|false",
 "handle-slow-team-member/s10-l1": "Part two: how to talk so they do not get defensive.|en|1|1|1|false",
 "handle-slow-team-member/s11-l1": "Start with the facts and a question, not a conclusion about the person.|en|1|1|1|false",
 "handle-slow-team-member/s11-l2": "For two weeks, the checking part has been one or two days late. Is something blocking you?|en|1|1|1|false",
 "handle-slow-team-member/s11-l3": "A question invites an explanation. A conclusion makes them defend themselves.|en|1|1|1|false",
 "handle-slow-team-member/s12-l1": "Then really listen. The reason may be an unclear task, a missing skill, or too much work.|en|1|1|1|false",
 "handle-slow-team-member/s12-l2": "Or broken tools, or something personal, like health or family.|en|1|1|1|false",
 "handle-slow-team-member/s13-l1": "Things at home have been hard lately.|en|1|1|1|false",
 "handle-slow-team-member/s13-l2": "You do not need to tell me details. What support do you need at work?|en|1|1|1|false",
 "handle-slow-team-member/s13-l3": "If you agree, I can ask our manager or HR what the company can offer.|en|1|1|1|false",
 "handle-slow-team-member/s13-l4": "Ask first before you share their situation, and how much.|en|1|1|1|false",
 "handle-slow-team-member/s14-l1": "Part three: you know the reason. Now how do you help?|en|1|1|1|false",
 "handle-slow-team-member/s15-l1": "Your reports have been late for weeks. Is something blocking you?|en|1|1|1|false",
 "handle-slow-team-member/s15-l2": "I do not know how to filter the data. I copy every line by hand.|en|1|1|1|false",
 "handle-slow-team-member/s15-l3": "Not lazy at all. Fifteen minutes of help, and the next report is done much earlier.|en|1|1|1|false",
 "handle-slow-team-member/s16-l1": "Unclear task: explain the result again, and show a sample.|en|1|1|1|false",
 "handle-slow-team-member/s16-l2": "Missing skill: show how, or pair them with someone good at it.|en|1|1|1|false",
 "handle-slow-team-member/s16-l3": "Too much work: remove or move some tasks. Personal matter: be flexible for now, within your power.|en|1|1|1|false",
 "handle-slow-team-member/s17-l1": "Split a big task into small parts, each with its own deadline.|en|1|1|1|false",
 "handle-slow-team-member/s17-l2": "They see steady progress. You notice a delay early, while there is still time.|en|1|1|1|false",
 "handle-slow-team-member/s18-l1": "Ask one question, and save a whole month of guessing.|en|1|1|1|false",
 "handle-slow-team-member/s19-l1": "Part four: agree so that next time is different.|en|1|1|1|false",
 "handle-slow-team-member/s20-l1": "I will try harder.|en|1|1|1|false",
 "handle-slow-team-member/s20-l2": "Okay, I trust you.|en|1|1|1|false",
 "handle-slow-team-member/s20-l3": "Wait a second!|en|1|1|1|false",
 "handle-slow-team-member/s20-l4": "Try harder at what, and by when? Two weeks later, nothing changes.|en|1|1|1|false",
 "handle-slow-team-member/s20-l5": "Let's rewind and try again.|en|1|1|1|false",
 "handle-slow-team-member/s20-l6": "Let's agree: from this week, send me the draft on Wednesday afternoon.|en|1|1|1|false",
 "handle-slow-team-member/s20-l7": "Message me if you get stuck. We meet again next Friday.|en|1|1|1|false",
 "handle-slow-team-member/s20-l8": "Okay. Wednesday afternoon.|en|1|1|1|false",
 "handle-slow-team-member/s20-l9": "A promise to try drifts away. A clear appointment gets you there.|en|1|1|1|false",
 "handle-slow-team-member/s21-l1": "A short message, so we both remember the same thing.|en|1|1|1|false",
 "handle-slow-team-member/s21-l2": "Draft on Wednesday afternoon, message if stuck, meet next Friday.|en|1|1|1|false",
 "handle-slow-team-member/s21-l3": "Got it, thanks.|en|1|1|1|false",
 "handle-slow-team-member/s21-l4": "Not to catch them out. Just to remember it the same way.|en|1|1|1|false",
 "handle-slow-team-member/s22-l1": "The draft arrived on time this week. Thank you!|en|1|1|1|false",
 "handle-slow-team-member/s22-l2": "Notice progress right away, even a small step. Being seen helps people keep going.|en|1|1|1|false",
 "handle-slow-team-member/s23-l1": "Last part: you helped, but nothing improved.|en|1|1|1|false",
 "handle-slow-team-member/s24-l1": "We agreed on Wednesday drafts. Two were late, and the team had to wait.|en|1|1|1|false",
 "handle-slow-team-member/s24-l2": "What else do you need? From now on, I need every draft by Wednesday.|en|1|1|1|false",
 "handle-slow-team-member/s24-l3": "Honest but respectful: what you agreed, the result, the impact. And what you need to see.|en|1|1|1|false",
 "handle-slow-team-member/s25-l1": "Tell your manager early, with what you did: when you talked, what help you gave, the results.|en|1|1|1|false",
 "handle-slow-team-member/s25-l2": "Your manager has options you do not have, like a new task or training.|en|1|1|1|false",
 "handle-slow-team-member/s26-l1": "Telling your manager means you lead badly. True or false?|en|1|1|1|false",
 "handle-slow-team-member/s26-l2": "False. Managers fear late surprises. Covering for months leaves the root problem.|en|1|1|1|false",
 "handle-slow-team-member/s26-l3": "Report early and you ask for help. Report late and you say sorry.|en|1|1|1|false",
 "handle-slow-team-member/s27-l1": "Official steps, like reviews or discipline, follow company rules, with your manager and HR.|en|1|1|1|false",
 "handle-slow-team-member/s27-l2": "Do not promise or threaten things outside your power.|en|1|1|1|false",
 "handle-slow-team-member/s28-l1": "Do not quietly move the slow member's work to the fastest one. They burn out and feel it is unfair.|en|1|1|1|false",
 "handle-slow-team-member/s28-l2": "If you must, say it is only for now, and thank them.|en|1|1|1|false",
 "handle-slow-team-member/s29-l1": "Why is Dung always late?|en|1|1|1|false",
 "handle-slow-team-member/s29-l2": "I am handling it. Thanks for your patience.|en|1|1|1|false",
 "handle-slow-team-member/s29-l3": "The team needs to see you handle it, not the details. Privacy keeps their dignity while they fix it.|en|1|1|1|false",
 "handle-slow-team-member/s30-l1": "Speak early, speak in private, agree clearly, report in time.|en|1|1|1|false",
 "handle-slow-team-member/s30-l2": "This week, write down the facts, and book a private talk.|en|1|1|1|false",
 "handle-slow-team-member/s31-l1": "How should you start a private talk about late work?|en|1|1|1|false",
 "handle-slow-team-member/s31-l2": "Describe the facts and ask if something is blocking them right now.|en|1|1|1|false",
 "handle-slow-team-member/s31-l3": "Facts and a question help them explain, not defend.|en|1|1|1|false",
 "handle-slow-team-member/s32-l1": "Your turn. Forty questions are waiting below.|en|1|1|1|false",
 "handle-workload-when-new/s01-l1": "Asked when the customer table will be ready, Dung says: this afternoon!|en|1|1|1|false",
 "handle-workload-when-new/s01-l2": "But the data is spread over many files.|en|1|1|1|false",
 "handle-workload-when-new/s01-l3": "It is so late, and it is still not done.|en|1|1|1|false",
 "handle-workload-when-new/s01-l4": "Next morning, still not done. Where did it go wrong?|en|1|1|1|false",
 "handle-workload-when-new/s02-l1": "Seven tasks at once? New staff are rarely judged for having many, but for dropping them.|en|1|1|1|false",
 "handle-workload-when-new/s02-l2": "Keep one list.|en|1|1|1|false",
 "handle-workload-when-new/s02-l3": "Set priorities with your boss.|en|1|1|1|false",
 "handle-workload-when-new/s02-l4": "Give honest time estimates.|en|1|1|1|false",
 "handle-workload-when-new/s02-l5": "Speak up early.|en|1|1|1|false",
 "handle-workload-when-new/s03-l1": "Six stops, from one list to knowing when it is too much.|en|1|1|1|false",
 "handle-workload-when-new/s04-l1": "Part one: put it all in one place, then order it.|en|1|1|1|false",
 "handle-workload-when-new/s05-l1": "Write every task in one place, even small favours asked out loud.|en|1|1|1|false",
 "handle-workload-when-new/s05-l2": "Your mind should do the work, not store the tasks. Four columns: task, who gave it,|en|1|1|1|false",
 "handle-workload-when-new/s05-l3": "deadline, and progress. Your whole week on one screen.|en|1|1|1|false",
 "handle-workload-when-new/s06-l1": "Tasks asked in passing, or in a meeting, are the easiest to lose.|en|1|1|1|false",
 "handle-workload-when-new/s06-l2": "Noted. I will send it to you on Wednesday.|en|1|1|1|false",
 "handle-workload-when-new/s07-l1": "Order by two questions: is the deadline close, and who is hurt if it is late? Work others wait for comes first.|en|1|1|1|false",
 "handle-workload-when-new/s07-l2": "Two urgent tasks, same deadline? Do not choose alone. Ask your direct manager.|en|1|1|1|false",
 "handle-workload-when-new/s07-l3": "I have your report and Oanh's data table, both due this afternoon. Which comes first?|en|1|1|1|false",
 "handle-workload-when-new/s07-l4": "This is not avoiding work. Managers see the bigger picture. Setting priorities is their job.|en|1|1|1|false",
 "handle-workload-when-new/s08-l0": "Monday. Five tasks, including a client proposal due tomorrow noon.|en|1|1|1|false",
 "handle-workload-when-new/s08-a1": "Three easy tasks first. My list gets shorter fast!|en|1|1|1|false",
 "handle-workload-when-new/s08-a2": "In the afternoon, she opens the proposal. Data from another team is missing. One day late.|en|1|1|1|false",
 "handle-workload-when-new/s08-b1": "Let me open the proposal now, just to see what it needs.|en|1|1|1|false",
 "handle-workload-when-new/s08-b2": "Missing data? I will ask the other team now, and do small tasks while I wait.|en|1|1|1|false",
 "handle-workload-when-new/s08-l5": "Easy tasks later. Open the big task first.|en|1|1|1|false",
 "handle-workload-when-new/s09-l1": "Part two: how long will it take?|en|1|1|1|false",
 "handle-workload-when-new/s10-l1": "New staff often guess too short. They miss hidden steps: waiting for approval,|en|1|1|1|false",
 "handle-workload-when-new/s10-l2": "finding documents, and fixing things after feedback.|en|1|1|1|false",
 "handle-workload-when-new/s10-l3": "So break the task into small steps, add them up, then add extra time.|en|1|1|1|false",
 "handle-workload-when-new/s11-l1": "Asked when it will be done? Do not say the time that pleases them most.|en|1|1|1|false",
 "handle-workload-when-new/s11-l2": "An honest deadline beats a nice one you miss. People can plan around it.|en|1|1|1|false",
 "handle-workload-when-new/s12-l1": "Note how long each finished task really took.|en|1|1|1|false",
 "handle-workload-when-new/s12-l2": "In a few weeks, you know how much you usually underestimate.|en|1|1|1|false",
 "handle-workload-when-new/s13-l0": "Now, back to Dung's morning.|en|1|1|1|false",
 "handle-workload-when-new/s13-l1": "When will the customer table be ready?|en|1|1|1|false",
 "handle-workload-when-new/s13-l2": "This afternoon!|en|1|1|1|false",
 "handle-workload-when-new/s13-l3": "Wait a second!|en|1|1|1|false",
 "handle-workload-when-new/s13-l4": "He has not looked yet. Files everywhere, one needs access. The leader had to move a client meeting.|en|1|1|1|false",
 "handle-workload-when-new/s13-l5": "Let's rewind and try another way.|en|1|1|1|false",
 "handle-workload-when-new/s13-l6": "Give me ten minutes to check the steps. Then I will tell you an exact time.|en|1|1|1|false",
 "handle-workload-when-new/s13-l7": "Look at the task first, then promise. And keep your promise.|en|1|1|1|false",
 "handle-workload-when-new/s14-l1": "Part three: your week is full, and more work arrives.|en|1|1|1|false",
 "handle-workload-when-new/s15-l1": "New staff should say yes to everything. That is safe. True or false?|en|1|1|1|false",
 "handle-workload-when-new/s15-l2": "False. Taking it all, then missing deadlines or rushing errors, is what really costs you.|en|1|1|1|false",
 "handle-workload-when-new/s16-l1": "No need to refuse. Just show the picture.|en|1|1|1|false",
 "handle-workload-when-new/s16-l2": "Yes, I will take it. I have two tasks due Thursday.|en|1|1|1|false",
 "handle-workload-when-new/s16-l3": "With this one, I need to move one to Friday. Is that okay?|en|1|1|1|false",
 "handle-workload-when-new/s16-l4": "Better than a plain yes. It accepts the work, and shows your real capacity.|en|1|1|1|false",
 "handle-workload-when-new/s17-l1": "A colleague at your level asks for help outside your work? Help if you have time, or offer later.|en|1|1|1|false",
 "handle-workload-when-new/s17-l2": "I am full this afternoon. Can I help you tomorrow morning? Helping is good, if your main work stays on time.|en|1|1|1|false",
 "handle-workload-when-new/s18-l1": "Month one. Thao wants to be liked. Meeting notes, data checks, slides: she takes them all.|en|1|1|1|false",
 "handle-workload-when-new/s18-l2": "Now a colleague asks her to make his slides.|en|1|1|1|false",
 "handle-workload-when-new/s18-l3": "Sure! I will stay late again tonight.|en|1|1|1|false",
 "handle-workload-when-new/s18-l4": "Wait a second!|en|1|1|1|false",
 "handle-workload-when-new/s18-l5": "Her weekly report now has errors. And the leader cannot plan what she does not know.|en|1|1|1|false",
 "handle-workload-when-new/s18-l6": "Let's rewind and try another way.|en|1|1|1|false",
 "handle-workload-when-new/s18-l7": "Here is everything I am holding. Which should come first?|en|1|1|1|false",
 "handle-workload-when-new/s18-l8": "Next time: I can do it, but my weekly report moves to tomorrow afternoon. Is that okay?|en|1|1|1|false",
 "handle-workload-when-new/s18-l9": "Accept one more task, and say which task moves.|en|1|1|1|false",
 "handle-workload-when-new/s19-l1": "Part four: focus, and finish.|en|1|1|1|false",
 "handle-workload-when-new/s20-l1": "Switching tasks all day makes you more tired, and you finish less.|en|1|1|1|false",
 "handle-workload-when-new/s20-l2": "Make focused blocks for thinking work. Answer messages at a few fixed times.|en|1|1|1|false",
 "handle-workload-when-new/s20b-l3": "If allowed, mute extra notifications. But still watch for your boss, and people waiting on you.|en|1|1|1|false",
 "handle-workload-when-new/s21-l1": "Stuck? Set yourself a time limit.|en|1|1|1|false",
 "handle-workload-when-new/s21-l2": "Past the limit with no progress? Ask your mentor, and say what you tried.|en|1|1|1|false",
 "handle-workload-when-new/s21b-l3": "Stuck alone all day does not make you better. It only makes the work later.|en|1|1|1|false",
 "handle-workload-when-new/s22-l1": "Part five: the end of the day, and the end of the week.|en|1|1|1|false",
 "handle-workload-when-new/s23-l1": "Last few minutes of the day: cross off what is done.|en|1|1|1|false",
 "handle-workload-when-new/s23-l2": "Update what is in progress.|en|1|1|1|false",
 "handle-workload-when-new/s23-l3": "Pick two or three key tasks for tomorrow morning. Then you start right away.|en|1|1|1|false",
 "handle-workload-when-new/s24-l1": "Dung worked hard all month, but reported nothing. Asked what he did, he remembered two things.|en|1|1|1|false",
 "handle-workload-when-new/s24-l2": "I did the report and called clients. That makes me look slow.|en|1|1|1|false",
 "handle-workload-when-new/s24-l3": "This week I called back old clients, updated the price list, and fixed the order tracker.|en|1|1|1|false",
 "handle-workload-when-new/s24-l4": "Next week, I continue the quarterly report.|en|1|1|1|false",
 "handle-workload-when-new/s24-l5": "Every Friday: done, in progress, and where you are stuck. Weeks later: he has a clear grip on his work.|en|1|1|1|false",
 "handle-workload-when-new/s25-l1": "Do not skip the stuck part, so your boss can help early. Make your work visible. Do not wait for guesses.|en|1|1|1|false",
 "handle-workload-when-new/s26-l1": "Last part: what is too much, and what then?|en|1|1|1|false",
 "handle-workload-when-new/s27-l1": "A few busy weeks are normal when you are new. They pass.|en|1|1|1|false",
 "handle-workload-when-new/s27-l2": "But late nights as a habit, too little sleep, more and more small errors? Look at your workload again.|en|1|1|1|false",
 "handle-workload-when-new/s28-l1": "Here are my tasks. This week I cannot do them all well.|en|1|1|1|false",
 "handle-workload-when-new/s28-l2": "Could you help me reorder the priorities?|en|1|1|1|false",
 "handle-workload-when-new/s28-l3": "Speak early, and bring the list. Not just I am tired. That is a work talk, not a complaint.|en|1|1|1|false",
 "handle-workload-when-new/s29-l1": "Your health is not something to trade for a good first impression.|en|1|1|1|false",
 "handle-workload-when-new/s29-l2": "Still overloaded after talking? Ask HR.|en|1|1|1|false",
 "handle-workload-when-new/s29-l3": "Losing sleep, or tired for weeks? See a doctor.|en|1|1|1|false",
 "handle-workload-when-new/s30-l1": "Managing work is not being faster than everyone. It is dropping nothing, and surprising nobody.|en|1|1|1|false",
 "handle-workload-when-new/s30-l2": "Open big tasks first. Look before you promise.|en|1|1|1|false",
 "handle-workload-when-new/s30-l3": "Take more, and say what moves. Today: a four-column list, and two key tasks for tomorrow.|en|1|1|1|false",
 "handle-workload-when-new/s31-l1": "Your manager gives you a new task when your week is already full, what should you say?|en|1|1|1|false",
 "handle-workload-when-new/s31-l2": "Accept it, explain your current tasks, and ask which one can move to later.|en|1|1|1|false",
 "handle-workload-when-new/s31-l3": "Your boss can only plan what they know.|en|1|1|1|false",
 "handle-workload-when-new/s32-l1": "Add one more task to your list: forty questions below.|en|1|1|1|false",
 "hire-and-keep-staff/s01-l1": "Customers love Dũng. But for months, his pay keeps getting delayed.|en|1|1|1|false",
 "hire-and-keep-staff/s01-l2": "Your pay? At the end of the week.|en|1|1|1|false",
 "hire-and-keep-staff/s01-l3": "Let's wait until we sell this batch.|en|1|1|1|false",
 "hire-and-keep-staff/s01-l4": "Cô Hoa, I'm quitting.|en|1|1|1|false",
 "hire-and-keep-staff/s01-l5": "He joins a shop two streets away. A few weeks later, her regulars follow.|en|1|1|1|false",
 "hire-and-keep-staff/s02-l0": "So how do you hire good staff, and keep them?|en|1|1|1|false",
 "hire-and-keep-staff/s02-l1": "You don't need very high pay. Explain the job clearly,|en|1|1|1|false",
 "hire-and-keep-staff/s02-l2": "teach step by step,|en|1|1|1|false",
 "hire-and-keep-staff/s02-l3": "pay on time,|en|1|1|1|false",
 "hire-and-keep-staff/s02-l4": "and be kind every day.|en|1|1|1|false",
 "hire-and-keep-staff/s03-l1": "Six steps: what the job is, finding people, the first day,|en|1|1|1|false",
 "hire-and-keep-staff/s03-l2": "pay and papers, keeping staff happy, and mistakes or leaving.|en|1|1|1|false",
 "hire-and-keep-staff/s04-l1": "Part one: what do you need the person for?|en|1|1|1|false",
 "hire-and-keep-staff/s05-l1": "Before you post an ad, write down a new worker's day: start time, end time, tasks, the busiest moments.|en|1|1|1|false",
 "hire-and-keep-staff/s05-l2": "Then you'll know if you need someone all day, or only a few hours.|en|1|1|1|false",
 "hire-and-keep-staff/s06-l1": "Job seekers want to know: working hours and days off,|en|1|1|1|false",
 "hire-and-keep-staff/s06-l2": "the main tasks,|en|1|1|1|false",
 "hire-and-keep-staff/s06-l3": "the pay, how it's counted, and the day it's paid,|en|1|1|1|false",
 "hire-and-keep-staff/s06-l4": "meals or extra allowances,|en|1|1|1|false",
 "hire-and-keep-staff/s06-l5": "and the trial period.|en|1|1|1|false",
 "hire-and-keep-staff/s07-l1": "Busy only at certain hours? A part-time worker often fits better. You don't pay for quiet hours.|en|1|1|1|false",
 "hire-and-keep-staff/s07-l2": "Students living nearby often look for this kind of job.|en|1|1|1|false",
 "hire-and-keep-staff/s08-l1": "Part two: where to find people, and what to ask.|en|1|1|1|false",
 "hire-and-keep-staff/s09-l1": "Hoa, my neighbour's grandson needs work. He's a good boy, I know him well.|en|1|1|1|false",
 "hire-and-keep-staff/s09-l2": "Thank you, Bà Tư! Please tell him to come by.|en|1|1|1|false",
 "hire-and-keep-staff/s09-l3": "People recommended by regulars, neighbours or former staff are often more trustworthy. Someone already knows them.|en|1|1|1|false",
 "hire-and-keep-staff/s09-l4": "A sign in front of the shop, with clear hours, also reaches the right people nearby.|en|1|1|1|false",
 "hire-and-keep-staff/s10-l0": "Four sample questions. Watch the last one: it shows if they dare to ask for help.|en|1|1|1|false",
 "hire-and-keep-staff/s10-l1": "Which hours can you work?|en|1|1|1|false",
 "hire-and-keep-staff/s10-l2": "How far do you live from the shop?|en|1|1|1|false",
 "hire-and-keep-staff/s10-l3": "What work have you done before?|en|1|1|1|false",
 "hire-and-keep-staff/s10-l4": "If a customer orders something you don't know, what do you do?|en|1|1|1|false",
 "hire-and-keep-staff/s11-l1": "Instead of promises, come for one paid trial shift.|en|1|1|1|false",
 "hire-and-keep-staff/s11-l2": "To be honest, it's hard: long hours standing, lots of dishes, busy weekends.|en|1|1|1|false",
 "hire-and-keep-staff/s11-l3": "Thanks for telling me. I'd still like to try.|en|1|1|1|false",
 "hire-and-keep-staff/s11-l4": "A real shift shows their speed and their manners with customers, better than any answer.|en|1|1|1|false",
 "hire-and-keep-staff/s11-l5": "And people who know the hard parts but still accept usually stay longer.|en|1|1|1|false",
 "hire-and-keep-staff/s12-a1": "I need a helper to serve food. Message me if you're free!|en|1|1|1|false",
 "hire-and-keep-staff/s12-a2": "This is much more work than you said!|en|1|1|1|false",
 "hire-and-keep-staff/s12-b1": "Six to two, Mondays off. Serving, washing up, mopping. Paid weekly, two paid trial days.|en|1|1|1|false",
 "hire-and-keep-staff/s12-b2": "A few lines longer, but people know exactly what they're accepting.|en|1|1|1|false",
 "hire-and-keep-staff/s12-b3": "Tell every task at the start, and you lose fewer people later.|en|1|1|1|false",
 "hire-and-keep-staff/s13-l1": "Part three: teaching on the first day.|en|1|1|1|false",
 "hire-and-keep-staff/s14-l1": "Don't teach everything in one day. Day one needs just two or three things: greeting, taking orders, clearing tables.|en|1|1|1|false",
 "hire-and-keep-staff/s14-l2": "Once those are solid, teach the till, drinks or cooking.|en|1|1|1|false",
 "hire-and-keep-staff/s15-l1": "The easiest way to teach: you show it once,|en|1|1|1|false",
 "hire-and-keep-staff/s15-l2": "they try it while you stand beside them,|en|1|1|1|false",
 "hire-and-keep-staff/s15-l3": "then they do it alone, and you check. Showing once beats telling ten times.|en|1|1|1|false",
 "hire-and-keep-staff/s16-l1": "Write a short list and stick it in the kitchen: how to greet and invite customers,|en|1|1|1|false",
 "hire-and-keep-staff/s16-l2": "dish names, prices, and what often runs out,|en|1|1|1|false",
 "hire-and-keep-staff/s16-l3": "where things go, and how to clear and wipe tables,|en|1|1|1|false",
 "hire-and-keep-staff/s16-l4": "and the jobs for opening and closing. New staff can check it themselves.|en|1|1|1|false",
 "hire-and-keep-staff/s17-l1": "If anything isn't clear, just ask me. Asking again and again is fine.|en|1|1|1|false",
 "hire-and-keep-staff/s17-l2": "Okay. Then I'll ask before I guess.|en|1|1|1|false",
 "hire-and-keep-staff/s17-l3": "Tell new staff who to ask when they're not sure. People who dare to ask make fewer mistakes with customers.|en|1|1|1|false",
 "hire-and-keep-staff/s18-l1": "Cô Hoa trains Dũng at her grocery counter in three stages.|en|1|1|1|false",
 "hire-and-keep-staff/s18-l2": "Days one and two: he watches, writes down common prices, and learns to check transfer messages.|en|1|1|1|false",
 "hire-and-keep-staff/s18-l3": "Days three and four: he takes money, she stands beside him and corrects mistakes on the spot.|en|1|1|1|false",
 "hire-and-keep-staff/s18-l4": "From day five, he works alone. At the end of each shift, they count the till together and write it down.|en|1|1|1|false",
 "hire-and-keep-staff/s18-l5": "Teach first, hand over later, and always count together.|en|1|1|1|false",
 "hire-and-keep-staff/s19-l1": "Part four: pay, hours and papers.|en|1|1|1|false",
 "hire-and-keep-staff/s20-l1": "Write the pay, hours, payday and tasks on one paper. Both sides keep a copy.|en|1|1|1|false",
 "hire-and-keep-staff/s20-l2": "Spoken words get remembered differently. Written words read the same for everyone.|en|1|1|1|false",
 "hire-and-keep-staff/s21-l1": "Agree early on overtime,|en|1|1|1|false",
 "hire-and-keep-staff/s21-l2": "holiday work,|en|1|1|1|false",
 "hire-and-keep-staff/s21-l3": "and how much notice before someone quits. Talk now, and nobody gets upset later.|en|1|1|1|false",
 "hire-and-keep-staff/s22-l1": "Contracts, insurance, and hours for young workers all have their own rules.|en|1|1|1|false",
 "hire-and-keep-staff/s22-l2": "For example, under the 2019 Labour Code, work of one month or more needs a written contract.|en|1|1|1|false",
 "hire-and-keep-staff/s22-l3": "Workers from fifteen to under eighteen need written consent from a parent or guardian.|en|1|1|1|false",
 "hire-and-keep-staff/s22-l4": "From July 2025, even part-timers working a month or more join compulsory social insurance, if pay reaches the minimum.|en|1|1|1|false",
 "hire-and-keep-staff/s22-l5": "Not sure? Ask the local labour office or an expert, and get it right from the start.|en|1|1|1|false",
 "hire-and-keep-staff/s23-l1": "A slow month? Then it's fine to pay a few days late. True or false?|en|1|1|1|false",
 "hire-and-keep-staff/s23-l2": "False. Pay on the agreed day. Their pay is rent and food. Pay late once, and they start looking elsewhere.|en|1|1|1|false",
 "hire-and-keep-staff/s24-l1": "Remember Dũng. Pay kept slipping, so he left, and the regulars went with him.|en|1|1|1|false",
 "hire-and-keep-staff/s24-l2": "Pay on the right day, and good people stay for a long time.|en|1|1|1|false",
 "hire-and-keep-staff/s25-l1": "Part five: making staff want to stay.|en|1|1|1|false",
 "hire-and-keep-staff/s26-l1": "My usual, please.|en|1|1|1|false",
 "hire-and-keep-staff/s26-l2": "Noodles with no onions, right, Bác?|en|1|1|1|false",
 "hire-and-keep-staff/s26-l3": "Lan, at lunch you remembered his usual dish. He was so happy.|en|1|1|1|false",
 "hire-and-keep-staff/s26-l4": "Not just: you did well. Praise one specific action, and people repeat it.|en|1|1|1|false",
 "hire-and-keep-staff/s27-l1": "Keep a steady schedule, and warn early when shifts change. Staff have classes and family too.|en|1|1|1|false",
 "hire-and-keep-staff/s27-l2": "Last-minute changes, again and again, wear people out, and they quit.|en|1|1|1|false",
 "hire-and-keep-staff/s27-l3": "A shared meal. Asking after them when they're sick.|en|1|1|1|false",
 "hire-and-keep-staff/s27-l4": "A raise when they get better. Small things keep people better than big promises.|en|1|1|1|false",
 "hire-and-keep-staff/s28-l1": "Ask your staff about the shop. They stand closest to customers.|en|1|1|1|false",
 "hire-and-keep-staff/s28-l2": "Try: What do customers complain about most this week? One small tip can keep more customers.|en|1|1|1|false",
 "hire-and-keep-staff/s29-l1": "Last part: when staff make mistakes, or want to leave.|en|1|1|1|false",
 "hire-and-keep-staff/s30-l1": "A busy evening at Cô Hoa's café. Lan drops a smoothie.|en|1|1|1|false",
 "hire-and-keep-staff/s30-l2": "Oh no! I'm sorry!|en|1|1|1|false",
 "hire-and-keep-staff/s30-l3": "How can you be so clumsy?|en|1|1|1|false",
 "hire-and-keep-staff/s30-l4": "Wait a second!|en|1|1|1|false",
 "hire-and-keep-staff/s30-l5": "She quits after her shift. Nearby tables drink up, pay and leave early.|en|1|1|1|false",
 "hire-and-keep-staff/s30-l6": "Let's rewind. Customers first. Talk later, in private.|en|1|1|1|false",
 "hire-and-keep-staff/s30-l7": "Next time you carry two glasses, use a tray, okay?|en|1|1|1|false",
 "hire-and-keep-staff/s30-l8": "Talk about the work, not the person. Praise in front of everyone. Correct when it's just the two of you.|en|1|1|1|false",
 "hire-and-keep-staff/s31-l1": "Same mistake, even after reminders? Say clearly what you need, and give a time limit to improve.|en|1|1|1|false",
 "hire-and-keep-staff/s31-l2": "Still not working? Let them go properly, and pay in full for the days worked.|en|1|1|1|false",
 "hire-and-keep-staff/s32-l1": "Cô Hoa, I'd like to stop working here at the end of the month.|en|1|1|1|false",
 "hire-and-keep-staff/s32-l2": "Can you tell me honestly why? I want to learn.|en|1|1|1|false",
 "hire-and-keep-staff/s32-l3": "Thank you for your work. Here's everything I owe you.|en|1|1|1|false",
 "hire-and-keep-staff/s32-l4": "Thank you. I know a friend who might want this job.|en|1|1|1|false",
 "hire-and-keep-staff/s32-l5": "A happy leaver may send you someone new. An angry one tells the whole neighbourhood.|en|1|1|1|false",
 "hire-and-keep-staff/s33-l1": "Staff stay when they know the job, are taught kindly, paid on time, and respected in front of customers.|en|1|1|1|false",
 "hire-and-keep-staff/s33-l2": "Tonight, write your shop's one working day: hours, tasks, pay and payday.|en|1|1|1|false",
 "hire-and-keep-staff/s34-l1": "What is the easiest way to teach a new worker a task?|en|1|1|1|false",
 "hire-and-keep-staff/s34-l2": "Show it once, let them try beside you, then let them do it alone.|en|1|1|1|false",
 "hire-and-keep-staff/s34-l3": "Showing once is easier to remember than telling ten times.|en|1|1|1|false",
 "hire-and-keep-staff/s35-l1": "Now it's your turn. Forty questions are waiting below.|en|1|1|1|false",
 "homesick-making-new-friends/s01-l1": "Every class, Dũng sits at the back with headphones on, waiting for someone to talk first.|en|1|1|1|false",
 "homesick-making-new-friends/s01-l2": "Week five. Everyone has a group already…|en|1|1|1|false",
 "homesick-making-new-friends/s01-l3": "But Dũng is missing one small detail. Keep watching.|en|1|1|1|false",
 "homesick-making-new-friends/s02-l1": "Homesick and lonely? So how do you make new friends? It gets easier when you…|en|1|1|1|false",
 "homesick-making-new-friends/s02-l2": "keep a regular routine,|en|1|1|1|false",
 "homesick-making-new-friends/s02-l3": "call home, but not too much,|en|1|1|1|false",
 "homesick-making-new-friends/s02-l4": "start a small chat every day,|en|1|1|1|false",
 "homesick-making-new-friends/s02-l5": "and pick one place to belong.|en|1|1|1|false",
 "homesick-making-new-friends/s03-l1": "Six parts: is it normal, calling home, making friends,|en|1|1|1|false",
 "homesick-making-new-friends/s03-l2": "clubs, lonely evenings, and when to get help.|en|1|1|1|false",
 "homesick-making-new-friends/s04-l1": "Part one: is feeling homesick normal?|en|1|1|1|false",
 "homesick-making-new-friends/s05-l1": "Feeling homesick means you're weak. True or false?|en|1|1|1|false",
 "homesick-making-new-friends/s05-l2": "False. It's very normal. You lose family meals, voices and old friends all at once.|en|1|1|1|false",
 "homesick-making-new-friends/s05-l3": "It means you have a family worth missing.|en|1|1|1|false",
 "homesick-making-new-friends/s06-l1": "It comes in waves: evenings, weekends, when you're ill.|en|1|1|1|false",
 "homesick-making-new-friends/s06-l2": "Right after calling Mom, or seeing photos of old friends together.|en|1|1|1|false",
 "homesick-making-new-friends/s06-l3": "Know your hard times, and plan something to do, instead of lying alone with your phone.|en|1|1|1|false",
 "homesick-making-new-friends/s07-l1": "For many students, it eases with a regular routine and a few friends to eat and study with.|en|1|1|1|false",
 "homesick-making-new-friends/s07-l2": "You don't have to stop missing home to start living well here.|en|1|1|1|false",
 "homesick-making-new-friends/s08-l1": "Part two: how often should you call home?|en|1|1|1|false",
 "homesick-making-new-friends/s09-a1": "Mom, I miss home so much…|en|1|1|1|false",
 "homesick-making-new-friends/s09-a2": "Two-hour video calls every night, crying, and no to every dinner invite.|en|1|1|1|false",
 "homesick-making-new-friends/s09-a3": "A month later, the others are a group. Mom can't sleep for worry.|en|1|1|1|false",
 "homesick-making-new-friends/s09-b1": "Mom, let's talk three evenings a week. Tonight I'm eating with my floor mates!|en|1|1|1|false",
 "homesick-making-new-friends/s09-b2": "Set call times help the whole family relax, and give you time for the new place.|en|1|1|1|false",
 "homesick-making-new-friends/s09-b3": "Call when you miss home, but don't let the calls keep you in.|en|1|1|1|false",
 "homesick-making-new-friends/s10-l1": "When you call, share small good things too.|en|1|1|1|false",
 "homesick-making-new-friends/s10-l2": "A new food, a new friend, an interesting class.|en|1|1|1|false",
 "homesick-making-new-friends/s10-l3": "Only sad news? Your parents worry, and the new place feels all bad to you too.|en|1|1|1|false",
 "homesick-making-new-friends/s11-l1": "Going home every weekend in the first month feels nice.|en|1|1|1|false",
 "homesick-making-new-friends/s11-l2": "But you miss the outings and activities where people become friends.|en|1|1|1|false",
 "homesick-making-new-friends/s11-l3": "Try staying for a few of the first weekends.|en|1|1|1|false",
 "homesick-making-new-friends/s12-l1": "Part three: back to Dũng. Where do new friends start?|en|1|1|1|false",
 "homesick-making-new-friends/s13-l1": "I'll just wait. Someone will talk to me one day.|en|1|1|1|false",
 "homesick-making-new-friends/s13-l2": "Wait a second!|en|1|1|1|false",
 "homesick-making-new-friends/s13-l3": "The first week is easiest: everyone is new and hoping for friends. Take one small step.|en|1|1|1|false",
 "homesick-making-new-friends/s13-l4": "Let's rewind and try again.|en|1|1|1|false",
 "homesick-making-new-friends/s13-l5": "Are you in this class too? Can I sit here?|en|1|1|1|false",
 "homesick-making-new-friends/s13-l6": "Sure! Honestly, I was too shy to talk first.|en|1|1|1|false",
 "homesick-making-new-friends/s13-l7": "That's the detail Dũng missed: the person next to you may be just as nervous.|en|1|1|1|false",
 "homesick-making-new-friends/s14-l1": "Your first line doesn't need to be clever. Just specific.|en|1|1|1|false",
 "homesick-making-new-friends/s14-l2": "“Are you in this class too? Can I sit here?”|en|1|1|1|false",
 "homesick-making-new-friends/s14-l3": "“Where are you from?”|en|1|1|1|false",
 "homesick-making-new-friends/s14-l4": "“Did you understand the last part of today's lesson?”|en|1|1|1|false",
 "homesick-making-new-friends/s15-l1": "Friendships grow from meeting again and again.|en|1|1|1|false",
 "homesick-making-new-friends/s15-l2": "Sit near the same few people. Have lunch together after class.|en|1|1|1|false",
 "homesick-making-new-friends/s15-l3": "Start a small study group. Small, regular meetings beat one big party.|en|1|1|1|false",
 "homesick-making-new-friends/s16-l1": "Don't wait to be invited. You can ask first.|en|1|1|1|false",
 "homesick-making-new-friends/s16-l2": "I'm going to the library this afternoon. Want to come?|en|1|1|1|false",
 "homesick-making-new-friends/s16-l3": "Sorry, not today.|en|1|1|1|false",
 "homesick-making-new-friends/s16-l4": "A no is normal. Ask someone else, or ask again another day.|en|1|1|1|false",
 "homesick-making-new-friends/s16-l5": "New friends don't just appear. You take one small step.|en|1|1|1|false",
 "homesick-making-new-friends/s17-l1": "Part four: which club suits you?|en|1|1|1|false",
 "homesick-making-new-friends/s18-l1": "Try a few club fairs at the start of the year. Choose what you really like, or want to learn.|en|1|1|1|false",
 "homesick-making-new-friends/s18-l2": "Regular meetings mean the same people again and again. That's the easiest way to make friends.|en|1|1|1|false",
 "homesick-making-new-friends/s18-l3": "Pick one or two. You still need time to study, sleep and learn the city.|en|1|1|1|false",
 "homesick-making-new-friends/s19-l1": "A good group won't push you to pay a lot, skip class, or recruit more people.|en|1|1|1|false",
 "homesick-making-new-friends/s19-l2": "If you see that, step back. See our lesson on scams aimed at new students.|en|1|1|1|false",
 "homesick-making-new-friends/s20-l1": "One student joins five clubs in week one. Another picks one and goes every week.|en|1|1|1|false",
 "homesick-making-new-friends/s20-l2": "By mid-term, who has close friends first? Usually the second.|en|1|1|1|false",
 "homesick-making-new-friends/s20b-l3": "Five clubs mean late meetings, skipped homework and sleep, and being the face they rarely see.|en|1|1|1|false",
 "homesick-making-new-friends/s20b-l4": "A few things done regularly beat many you keep missing.|en|1|1|1|false",
 "homesick-making-new-friends/s21-l1": "Part five: lonely evenings and weekends.|en|1|1|1|false",
 "homesick-making-new-friends/s22-l1": "Keep a routine: sleep and wake on time, eat every meal, move a little every day.|en|1|1|1|false",
 "homesick-making-new-friends/s22-l2": "A tired, sleepless body makes sadness much heavier.|en|1|1|1|false",
 "homesick-making-new-friends/s23-l1": "List a few places you want to explore. Cook a meal with your roommate.|en|1|1|1|false",
 "homesick-making-new-friends/s23-l2": "Go to the library, a park, or a weekend market.|en|1|1|1|false",
 "homesick-making-new-friends/s23-l3": "And call an old friend, instead of just looking at their photos.|en|1|1|1|false",
 "homesick-making-new-friends/s24-l1": "Everyone looks so happy with their new friends… I feel worse.|en|1|1|1|false",
 "homesick-making-new-friends/s24-l2": "Those photos are chosen. People post their happiest moments, not their lonely days.|en|1|1|1|false",
 "homesick-making-new-friends/s24-l3": "Feel worse after scrolling? Set a time limit, or keep your phone away from your bed.|en|1|1|1|false",
 "homesick-making-new-friends/s25-l1": "Bring a few familiar things from home.|en|1|1|1|false",
 "homesick-making-new-friends/s25-l2": "A family photo, some food Mom made, an old pillow.|en|1|1|1|false",
 "homesick-making-new-friends/s25-l3": "Small things make a strange room feel less strange.|en|1|1|1|false",
 "homesick-making-new-friends/s26-l1": "Part six: when sadness needs someone's help.|en|1|1|1|false",
 "homesick-making-new-friends/s27-l1": "A sad evening usually passes.|en|1|1|1|false",
 "homesick-making-new-friends/s27-l2": "Sadness for weeks that doesn't ease? Poor sleep, not eating, not wanting class, no interest in anything?|en|1|1|1|false",
 "homesick-making-new-friends/s27-l3": "Find someone to talk to. It's not something to just push through alone.|en|1|1|1|false",
 "homesick-making-new-friends/s28-l1": "Many schools have a counselling room. Ask student affairs, or visit a clinic.|en|1|1|1|false",
 "homesick-making-new-friends/s28-l2": "I've felt sad and tired for weeks. I'd like to talk to someone.|en|1|1|1|false",
 "homesick-making-new-friends/s29-l1": "If you ever think about hurting yourself, tell someone you trust right away.|en|1|1|1|false",
 "homesick-making-new-friends/s29-l2": "And see a doctor or a counsellor.|en|1|1|1|false",
 "homesick-making-new-friends/s29-l3": "In danger right now? Call one one five, or get someone to take you to the nearest clinic.|en|1|1|1|false",
 "homesick-making-new-friends/s29-l4": "You deserve help, and you don't have to carry this alone.|en|1|1|1|false",
 "homesick-making-new-friends/s30-l1": "One student was sad all term, but told his parents, “I'm fine.”|en|1|1|1|false",
 "homesick-making-new-friends/s30-l2": "He skipped morning classes, slept till noon, barely ate.|en|1|1|1|false",
 "homesick-making-new-friends/s30-l3": "His roommate noticed, kept inviting him to eat, and went with him to the counselling room.|en|1|1|1|false",
 "homesick-making-new-friends/s30-l4": "After a few talks, and telling his parents the truth, he felt lighter.|en|1|1|1|false",
 "homesick-making-new-friends/s30-l5": "When sadness lasts, talk. Talking is where relief begins.|en|1|1|1|false",
 "homesick-making-new-friends/s31-l1": "Dad, I miss home.|en|1|1|1|false",
 "homesick-making-new-friends/s31-l2": "Parents: listen first. Don't rush to say “just come home” or “there's nothing to be sad about.”|en|1|1|1|false",
 "homesick-making-new-friends/s31-l3": "I'm listening. Tell me about a new friend? A place you like there?|en|1|1|1|false",
 "homesick-making-new-friends/s31-l4": "It helps them see the good in the new place.|en|1|1|1|false",
 "homesick-making-new-friends/s32-l1": "Call home, but don't let it keep you in.|en|1|1|1|false",
 "homesick-making-new-friends/s32-l2": "New friends don't just appear. Take a step.|en|1|1|1|false",
 "homesick-making-new-friends/s32-l3": "A few things, done regularly.|en|1|1|1|false",
 "homesick-making-new-friends/s32-l4": "And when sadness lasts, talk.|en|1|1|1|false",
 "homesick-making-new-friends/s33-l1": "Between joining many clubs and going regularly to just one, which usually brings close friends sooner?|en|1|1|1|false",
 "homesick-making-new-friends/s33-l2": "Going regularly to one club, because friendship grows from meeting the same people often.|en|1|1|1|false",
 "homesick-making-new-friends/s33-l3": "Five clubs fill your week, but everywhere you're just a face they see sometimes.|en|1|1|1|false",
 "homesick-making-new-friends/s34-l1": "Tomorrow, ask the person next to you one question, and set call times with your parents.|en|1|1|1|false",
 "homesick-making-new-friends/s34-l2": "Then try the forty questions below.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s01-l1": "Good evening. I'd like to check in, please.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s01-l2": "Sorry, we have no booking under this name.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s01-l3": "After a long trip, the last thing you want to hear. What do you say next?|en|1|1|1|false",
 "hotel-booking-problems-abroad/s02-l1": "Don't argue yet. Often it's just a wrong name, a wrong date, or a system delay. So:|en|1|1|1|false",
 "hotel-booking-problems-abroad/s02-l2": "Show your booking number, and suggest other ways to search.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s02-l3": "Really full? Ask for a similar place, in writing.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s02-l4": "And call your booking platform from the desk.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s03-l1": "Six stops. No name. Fully booked. Arriving late.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s03-l2": "A different room. Paying extra. And who to call.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s04-l1": "Part one: they can't find your name. First step?|en|1|1|1|false",
 "hotel-booking-problems-abroad/s05-l1": "Open the email or app. Show the booking number, the guest name, check in and check out dates.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s05-l2": "Say: I have a reservation. Here is my booking confirmation.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s06-l1": "Suggest other ways: by family name.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s06-l2": "By middle name.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s06-l3": "By the person who booked for you.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s06-l4": "By the platform, the travel agency, or your company.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s06-l5": "Vietnamese family and given names often get swapped. Staff may be searching the wrong box.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s07-l1": "Good evening. How can I help?|en|1|1|1|false",
 "hotel-booking-problems-abroad/s07-l2": "I have a room. My name is Dung.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s07-l3": "Sorry, I can't find it. We're fully booked.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s07-l4": "Wait a second!|en|1|1|1|false",
 "hotel-booking-problems-abroad/s07-l5": "Only a given name. No booking number, no family name, no agency.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s07-l6": "Let's rewind and try again.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s07-l7": "I have a reservation. Here is my booking number. The family name is Tran, and a travel agency booked it for me.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s07-l8": "Ah, here it is.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s07-l9": "Search with the booking number, not only your name.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s08-l1": "Part two: they're really full. What do you ask for?|en|1|1|1|false",
 "hotel-booking-problems-abroad/s09-l1": "Does my booking exist? Was it cancelled, and when?|en|1|1|1|false",
 "hotel-booking-problems-abroad/s09-l2": "It exists. But we're overbooked tonight.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s09-l3": "Knowing if it still exists tells you where the mistake is.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s09-l4": "Could you find me a room at a similar hotel nearby?|en|1|1|1|false",
 "hotel-booking-problems-abroad/s09-l5": "And who pays for the taxi, and any price difference?|en|1|1|1|false",
 "hotel-booking-problems-abroad/s09-l6": "A specific request is easier for staff to act on, fast.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s10-a1": "We'll move you to a similar hotel, and we'll cover everything.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s10-a2": "Okay.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s10-a3": "She takes a taxi herself. The new place is far worse, and far from the centre.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s10-a4": "She asks for the taxi and the price difference. The first hotel has no record of any promise.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s10-b1": "We'll move you to a similar hotel, and we'll cover everything.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s10-b2": "Thank you. Please confirm it by email, with your name: where, how many nights, who pays.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s10-l1": "Spoken promises at midnight are easy to forget, or deny. Keep the taxi receipt too.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s10-l2": "Whatever you agree to, ask for it in writing.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s11-l1": "Part three: you arrive late, and the room is gone.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s12-l1": "Many hotels hold a room until a set time. After that, you may count as a no show.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s12-l2": "Delayed again. I'll reach the hotel after midnight.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s12-l3": "My flight is late. I will arrive around midnight. Please keep my room.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s12-l4": "Noted. We'll keep your room.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s13-l1": "Way A: no message. The room is gone. The guest shouts and threatens a bad review.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s13-l2": "Staff just say sorry. The guest searches on the phone until dawn.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s13b-l3": "Way B: message as soon as you know about the delay.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s13b-l4": "Room still given away? Calmly show the booking, and ask them to arrange a place nearby.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s13c-l5": "Don't wait in the lobby till morning. The later it gets, the harder to find a room.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s13c-l6": "Late? Message ahead. When you arrive, speak gently.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s14-l1": "Part four: there's a room, but it's not what you booked.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s15-l1": "Complain right after check in, while they can still fix it. Three steps.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s15-l2": "Compare: say exactly what's different.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s15-l3": "Evidence: the description in your booking, and photos of the real room.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s15-l4": "Request: change rooms, a partial discount, or cancel with no fee.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s16-l1": "The room is different from my booking. Could I change rooms, please?|en|1|1|1|false",
 "hotel-booking-problems-abroad/s16-l2": "Hotel won't fix it? Send your evidence to the platform, while you're still staying.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s17-l1": "Mum, there's only one bed. And no balcony!|en|1|1|1|false",
 "hotel-booking-problems-abroad/s17-l2": "The lift is so noisy.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s17-l3": "I don't want to bother them. We'll stay three nights, and I'll write a review later.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s17-l4": "Wait a second!|en|1|1|1|false",
 "hotel-booking-problems-abroad/s17-l5": "Later, the platform asks: why didn't you report it? No photos, no messages, no refund.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s17-l6": "Let's rewind and try again.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s17-l7": "Bin, take a photo of the bed and the lift, please.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s17-l8": "Done! Now let's tell the front desk.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s17-l9": "We booked two beds and a balcony. Could we change rooms, please?|en|1|1|1|false",
 "hotel-booking-problems-abroad/s18-l1": "Part five: do you pay extra, and what do you keep?|en|1|1|1|false",
 "hotel-booking-problems-abroad/s19-l1": "You paid online, the desk asks again. Just pay twice to end it. True or false?|en|1|1|1|false",
 "hotel-booking-problems-abroad/s19-l2": "False. Ask why, and check with the platform before paying again.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s19-l3": "Must pay tonight just to get a bed? Keep the receipt, and ask for that money back later.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s20-l1": "A screenshot of the booking. It works even with no internet.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s20-l2": "Staff names, and the time you spoke.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s20-l3": "Photos of the room if it's different.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s20-l4": "Every extra receipt: taxi, another room, the price difference.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s21-l1": "Last part: the hotel won't help. Who do you call?|en|1|1|1|false",
 "hotel-booking-problems-abroad/s22-l1": "A booking passes through many links. First you: did I enter the right name and dates?|en|1|1|1|false",
 "hotel-booking-problems-abroad/s22-l2": "The platform or agency: did they send it?|en|1|1|1|false",
 "hotel-booking-problems-abroad/s22-l3": "The hotel's system: did it arrive? Then the desk staff.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s22-l4": "Check step by step. The error may not be the receptionist's, so don't blame them first.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s23-l1": "Many platforms have support for exactly this. Call them while you're still at the desk.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s23-l2": "Support is on the line. Could you speak to them, please?|en|1|1|1|false",
 "hotel-booking-problems-abroad/s23-l3": "Of course.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s23-l4": "On a business trip and moved to a pricier hotel? Tell your company to agree on the extra cost.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s24-l1": "Show the number, suggest other searches, ask for a similar place in writing.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s24-l2": "Call the platform from the desk. A different room? Report it now, with photos.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s25-l1": "The room is different from what you booked, when should you complain?|en|1|1|1|false",
 "hotel-booking-problems-abroad/s25-l2": "Right after check in, while the hotel can still fix the problem.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s25-l3": "Report it on the spot, with photos. That gives the hotel a chance to fix it.|en|1|1|1|false",
 "hotel-booking-problems-abroad/s26-l1": "Right now, screenshot your booking so you can show it offline. Then try the forty questions!|en|1|1|1|false",
 "how-big-is-jupiter/s01-l1": "Done! Jupiter is eleven times wider, so I drew eleven Earths in a ring.|en|1|1|1|false",
 "how-big-is-jupiter/s01-l2": "Hmm. Is Jupiter really only that big?|en|1|1|1|false",
 "how-big-is-jupiter/s02-l1": "How big is Jupiter, really? Let's turn its huge numbers into pictures, in five parts.|en|1|1|1|false",
 "how-big-is-jupiter/s02-l2": "Its size and weight.|en|1|1|1|false",
 "how-big-is-jupiter/s02-l3": "Why you cannot stand on it.|en|1|1|1|false",
 "how-big-is-jupiter/s02-l4": "Its stripes and the Great Red Spot.|en|1|1|1|false",
 "how-big-is-jupiter/s02-l5": "Its moons, and how to see them.|en|1|1|1|false",
 "how-big-is-jupiter/s02-l6": "And is it a failed star?|en|1|1|1|false",
 "how-big-is-jupiter/s03-l1": "Part one: how big, and how heavy?|en|1|1|1|false",
 "how-big-is-jupiter/s04-l1": "How many Earths fit inside Jupiter? Eleven, about a hundred, or more than a thousand?|en|1|1|1|false",
 "how-big-is-jupiter/s04-l2": "Eleven, of course! It is eleven times wider.|en|1|1|1|false",
 "how-big-is-jupiter/s04-l3": "Wait a second!|en|1|1|1|false",
 "how-big-is-jupiter/s04-l4": "You only thought about width. Eleven times wider means wider, taller, and deeper, all at once.|en|1|1|1|false",
 "how-big-is-jupiter/s04-l5": "Let's rewind and try again.|en|1|1|1|false",
 "how-big-is-jupiter/s04-l6": "Eleven times eleven times eleven. That is about thirteen hundred!|en|1|1|1|false",
 "how-big-is-jupiter/s04-l7": "Right. Eleven times wider, but more than a thousand Earths inside.|en|1|1|1|false",
 "how-big-is-jupiter/s05-l1": "Jupiter is about one hundred forty thousand kilometres across, about eleven times wider than Earth.|en|1|1|1|false",
 "how-big-is-jupiter/s05-l2": "Space inside grows in all three directions, so its volume is about thirteen hundred Earths.|en|1|1|1|false",
 "how-big-is-jupiter/s05-l3": "That is room for more than a thousand Earths, packed tight.|en|1|1|1|false",
 "how-big-is-jupiter/s06-l1": "Try it in the kitchen. If Earth is a small coin,|en|1|1|1|false",
 "how-big-is-jupiter/s06-l2": "Jupiter is a dinner plate. Put them side by side.|en|1|1|1|false",
 "how-big-is-jupiter/s06-l3": "Big numbers are hard to picture. Objects let a child see the difference at once.|en|1|1|1|false",
 "how-big-is-jupiter/s07-l1": "Jupiter is about three hundred eighteen times heavier than Earth.|en|1|1|1|false",
 "how-big-is-jupiter/s07-l2": "Put all the planets on a giant scale. Jupiter alone weighs more than twice all the others together.|en|1|1|1|false",
 "how-big-is-jupiter/s08-l1": "Part two: what is Jupiter made of? Can you stand on it?|en|1|1|1|false",
 "how-big-is-jupiter/s09-l1": "Jupiter is mostly hydrogen and helium, the two lightest gases.|en|1|1|1|false",
 "how-big-is-jupiter/s09-l2": "It has no ground. The deeper you go, the more the gas is squeezed.|en|1|1|1|false",
 "how-big-is-jupiter/s09-l3": "Slowly it becomes like a liquid.|en|1|1|1|false",
 "how-big-is-jupiter/s09-l4": "Deep inside there may be a solid core. Scientists are still finding out.|en|1|1|1|false",
 "how-big-is-jupiter/s10-l1": "When I land on Jupiter, I will walk around. I will just feel heavier!|en|1|1|1|false",
 "how-big-is-jupiter/s10-l2": "Grandpa, what colour is the ground there?|en|1|1|1|false",
 "how-big-is-jupiter/s10-l3": "Hold on!|en|1|1|1|false",
 "how-big-is-jupiter/s10-l4": "There is no ground. A spaceship would sink through gas and be crushed first.|en|1|1|1|false",
 "how-big-is-jupiter/s10-l5": "Let's rewind and ask again.|en|1|1|1|false",
 "how-big-is-jupiter/s10-l6": "Grandpa, what is it like on Jupiter?|en|1|1|1|false",
 "how-big-is-jupiter/s10-l7": "There is no ground there, only layers of colourful clouds and gas.|en|1|1|1|false",
 "how-big-is-jupiter/s11-l1": "Part three: stripes and the Great Red Spot.|en|1|1|1|false",
 "how-big-is-jupiter/s12-l1": "Jupiter spins the fastest of all planets. A day there is only about ten hours.|en|1|1|1|false",
 "how-big-is-jupiter/s12-l2": "The fast spin makes it a little flat at the poles, and stretches the clouds into light and dark bands.|en|1|1|1|false",
 "how-big-is-jupiter/s13-l1": "The Great Red Spot is a mountain. True or false?|en|1|1|1|false",
 "how-big-is-jupiter/s13-l2": "False. It is a giant storm, wider than Earth, watched since the nineteenth century.|en|1|1|1|false",
 "how-big-is-jupiter/s14-l1": "Why has it lasted so long? Many scientists think it is because Jupiter has no land to weaken it.|en|1|1|1|false",
 "how-big-is-jupiter/s14-l2": "On Earth, storms often fade when they reach land.|en|1|1|1|false",
 "how-big-is-jupiter/s14-l3": "In recent years, the spot has been getting smaller, and scientists keep watching it.|en|1|1|1|false",
 "how-big-is-jupiter/s14-l4": "When you look at space pictures with your child, read the caption first.|en|1|1|1|false",
 "how-big-is-jupiter/s15-l1": "The Great Red Spot is a storm, not a mountain.|en|1|1|1|false",
 "how-big-is-jupiter/s16-l1": "Part four: how many moons, and can we see them?|en|1|1|1|false",
 "how-big-is-jupiter/s17-l1": "By twenty twenty six, NASA counts more than a hundred recognized moons around Jupiter.|en|1|1|1|false",
 "how-big-is-jupiter/s17-l2": "Most are very small, and the number grows as telescopes find more.|en|1|1|1|false",
 "how-big-is-jupiter/s17-l3": "But right now, Saturn has more recognized moons.|en|1|1|1|false",
 "how-big-is-jupiter/s17-l4": "Jupiter has rings too, but they are much fainter than Saturn's.|en|1|1|1|false",
 "how-big-is-jupiter/s18-l1": "Galileo found the four biggest moons in sixteen ten.|en|1|1|1|false",
 "how-big-is-jupiter/s18-l2": "Io has many active volcanoes.|en|1|1|1|false",
 "how-big-is-jupiter/s18-l3": "Europa has an icy shell, with a salty ocean thought to be under it.|en|1|1|1|false",
 "how-big-is-jupiter/s18-l4": "Ganymede is the largest moon in the solar system, bigger than Mercury.|en|1|1|1|false",
 "how-big-is-jupiter/s18-l5": "And Callisto is covered with craters.|en|1|1|1|false",
 "how-big-is-jupiter/s19-l1": "Jupiter is very bright. You can see it with your eyes when it is in the night sky.|en|1|1|1|false",
 "how-big-is-jupiter/s19-l2": "My hands shake. The dots keep jumping!|en|1|1|1|false",
 "how-big-is-jupiter/s19-l3": "Rest the binoculars on the wall. Keep them steady.|en|1|1|1|false",
 "how-big-is-jupiter/s19-l4": "Now I see four small dots, almost in a line!|en|1|1|1|false",
 "how-big-is-jupiter/s19-l5": "Draw Jupiter as a circle, and mark each dot. Same time tomorrow, draw again.|en|1|1|1|false",
 "how-big-is-jupiter/s20-l1": "After three nights, put the drawings side by side.|en|1|1|1|false",
 "how-big-is-jupiter/s20-l2": "The far stars stay in place. The dots near Jupiter have changed places.|en|1|1|1|false",
 "how-big-is-jupiter/s20b-l3": "Some nights there are only three, because one moon is hidden. Those are the Galilean moons, moving.|en|1|1|1|false",
 "how-big-is-jupiter/s20c-l4": "In a line tonight, in new places tomorrow: those are moons.|en|1|1|1|false",
 "how-big-is-jupiter/s21-l1": "Before you go, check when Jupiter rises this month, and in which direction, from an official source.|en|1|1|1|false",
 "how-big-is-jupiter/s21-l2": "Hold the binoculars steady.|en|1|1|1|false",
 "how-big-is-jupiter/s21-l3": "Draw the four dots for three nights in a row.|en|1|1|1|false",
 "how-big-is-jupiter/s21-l4": "And keep the coin and the plate to remind your child how big Jupiter is.|en|1|1|1|false",
 "how-big-is-jupiter/s22-l1": "Part five: is Jupiter a failed star? And have we visited it?|en|1|1|1|false",
 "how-big-is-jupiter/s23-l1": "Like the Sun, Jupiter is mostly hydrogen and helium. So people call it a failed star.|en|1|1|1|false",
 "how-big-is-jupiter/s23b-l2": "But to shine like a star, it would need to be about eighty times heavier. It is a real planet.|en|1|1|1|false",
 "how-big-is-jupiter/s24-l1": "Jupiter's strong pull changes the paths of many comets and asteroids.|en|1|1|1|false",
 "how-big-is-jupiter/s24-l2": "In nineteen ninety four, pieces of a comet crashed into Jupiter, one after another.|en|1|1|1|false",
 "how-big-is-jupiter/s24b-l3": "Astronomers around the world saw dark marks as big as Earth, for weeks.|en|1|1|1|false",
 "how-big-is-jupiter/s25-l1": "Only robot spacecraft have been to Jupiter.|en|1|1|1|false",
 "how-big-is-jupiter/s25-l2": "Juno began circling it in twenty sixteen, and sends back beautiful pictures of swirling clouds.|en|1|1|1|false",
 "how-big-is-jupiter/s25-l3": "New spacecraft are on the way to study icy moons like Europa, which may hide an ocean.|en|1|1|1|false",
 "how-big-is-jupiter/s26-l1": "Why haven't astronauts gone to Jupiter?|en|1|1|1|false",
 "how-big-is-jupiter/s26-l2": "There is nowhere to stand, the radiation is very strong, and the trip takes years.|en|1|1|1|false",
 "how-big-is-jupiter/s26-l3": "We cannot go yet, but robots went there and sent pictures back for us.|en|1|1|1|false",
 "how-big-is-jupiter/s27-l1": "So Bin's drawing needs more than a thousand Earths.|en|1|1|1|false",
 "how-big-is-jupiter/s27-l1b": "No ground, only clouds and gas, and a storm wider than our planet.|en|1|1|1|false",
 "how-big-is-jupiter/s27-l2": "Tonight, put a coin next to a plate, then plan a clear night with binoculars.|en|1|1|1|false",
 "how-big-is-jupiter/s28-l1": "Many people think you could land on Jupiter and just feel heavy, what is true?|en|1|1|1|false",
 "how-big-is-jupiter/s28-l2": "Jupiter has no ground at all, only clouds and gas, so there is nowhere to stand.|en|1|1|1|false",
 "how-big-is-jupiter/s28-l3": "Deeper down, the gas is squeezed into a liquid. A spacecraft would be crushed first.|en|1|1|1|false",
 "how-big-is-jupiter/s29-l1": "Your turn. Forty questions about Jupiter are waiting.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s01-l1": "Auntie, why are there islands in the middle of the sea?|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s01-l2": "Um... good question.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s01-l3": "Thao just smiles. But the answer fits in three short steps.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s02-l1": "How did Ha Long Bay form? Remember three steps, and you can tell it on the boat.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s02-l2": "An ancient sea, where limestone was born.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s02-l3": "Rain that shaped the rock into mountains and caves.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s02-l4": "And a rising sea that left only the peaks. You can see each step from the boat.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s03-l1": "Our route: the three steps, one by one.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s03-l2": "Choosing a boat route, and what to look at.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s03-l3": "The caves, and telling the story in English.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s04-l1": "Part one: where does the limestone come from?|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s05-l1": "Limestone is mostly calcium carbonate.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s05-l2": "Long ago, in a shallow, warm sea, shells and skeletons of countless sea animals sank to the floor.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s05-l3": "They piled up into thick layers, and were pressed into rock.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s06-l1": "This took hundreds of millions of years, much longer than human history.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s06-l2": "That's why scientists find fossils of ancient sea life in the rock. Each layer is like a page of a book.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s07-l1": "Part two: how does rain carve the mountains?|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s08-l1": "Once the crust lifted the rock out of the sea, rain took in carbon dioxide and became a weak acid.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s08-l2": "It dissolves limestone slowly, but without stopping.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s09-l1": "A hot, rainy climate makes this faster.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s09-l2": "Rock dissolves along cracks into valleys. What's left becomes tower and cone shaped peaks, close together.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s09-l3": "This kind of land is called karst.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s10-l1": "Water also soaks into the mountains and hollows out caves. People didn't make them.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s10-l2": "Drops carrying calcium fall very slowly, leaving stalactites on the ceiling and stalagmites on the floor.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s11-l1": "Part three: when did mountains become islands?|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s12-l1": "In the ice ages, the sea was low. The bay was a dry plain with mountains and rivers.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s12-l2": "Then the ice melted, and the sea filled the valleys. Only peaks remained.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s13-l1": "What happened after the last ice age that created the islands?|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s13-l2": "The ice melted, the sea rose into the valleys, and only mountain tops remained.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s13-l3": "The islands didn't float here. They are mountains the sea surrounded.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s14-l1": "UNESCO recognised Ha Long in nineteen ninety four, for its beautiful scenery.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s14-l2": "In two thousand, again, for its geological value.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s14-l3": "In twenty twenty three, it was extended to the Cat Ba islands: the same drowned karst.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s15-l1": "Part four: choosing a boat route that shows the story.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s16-l1": "I'd love to go inside a cave.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s16-l2": "And I want to find the marks the waves bit into the rock!|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s16-l3": "A short route circles the islands from far away. A longer one stops at Sung Sot Cave, with small boats through a lagoon.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s16-l4": "Then the longer route. The story is inside the caves and at the foot of the islands.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s17-l1": "Routes differ: some go into caves, some paddle through lagoons, some only view from far away.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s17-l2": "Which caves does this route stop at? Are small boats included?|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s17-l3": "Yes, Sung Sot Cave and a small boat through a lagoon.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s17-l4": "Know what you want to see first, then choose the route.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s18-l1": "Routes, times and safety rules come from the bay management and the boat companies. They change with the season and weather.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s18-l2": "When the crew asks, put life jackets on, especially on children, right away.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s19-l1": "Part five: on the boat, where should you look?|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s20-l1": "Look for notches at the foot of the islands, right at the water.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s20-l2": "Steep cliffs like walls, and cave mouths halfway up.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s20-l3": "And lagoons: salty lakes ringed by rock walls, joined to the sea through caves or gaps.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s21-l1": "Did you know? That notch is made by the sea itself. Waves and salt water dissolve rock at water level.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s21-l2": "Day after day, it cuts deeper, until some islands look like mushrooms.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s22-l1": "An old notch above today's water? The sea once stood at a different level.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s22-l2": "Caves like Sung Sot, Thien Cung and Dau Go are high up, because they formed when the groundwater was at another height, while this was land.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s23-l1": "See that line at the bottom of the island? The sea made it.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s23-l2": "There's another one! And one more over there!|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s23-l3": "Point to one mark, and children find the rest. One thing you see beats ten explanations.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s24-l1": "Part six: in the cave, what to see and what to avoid.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s25-l1": "A tip for children: stalactites hang down from the ceiling. Stalagmites grow up from the floor.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s25-l2": "When they meet, they make a column. That takes a very long time.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s26-l1": "There are thousands of them. Can I break off a tiny piece to keep?|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s26-l2": "Wait a second!|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s26-l3": "Each one grows from tiny drops of calcium. One centimetre can take decades, even centuries. And oil from hands stains it.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s26-l4": "Let's rewind and try again.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s26-l5": "Before we go in: we look, we don't touch. And hold my hand in the narrow parts.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s26-l6": "Okay! Just looking.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s26-l7": "Give the rules at the entrance, so nothing is lost inside.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s27-l1": "Last part: telling it to kids and foreign friends.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s28-l1": "The Vietnamese legend: invaders came from the sea.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s28-l2": "A mother dragon and her children came down, and spat jewels that became islands to block them.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s28-l3": "Where the mother dragon landed is Ha Long, meaning descending dragon.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s29-l1": "Wow, so many islands! How did they get here?|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s29-l2": "Well, calcium carbonate, a weak acid, and then the ice ages...|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s29-l3": "Wait a second!|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s29-l4": "Too many hard words, and nothing to hold on to. Your friend nods politely, then turns away to take photos.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s29-l5": "Let's rewind and try again.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s29-l6": "A mother dragon spat jewels that became these islands. Ha Long means descending dragon.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s29-l7": "A dragon! And what really happened?|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s29-l8": "These islands used to be mountains.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s29-l9": "The legend makes them curious. The short science line comes when they want it. Dragon first, rocks after.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s30-l1": "Three short English sentences. One: These islands used to be mountains.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s30-l2": "Two: Rainwater slowly dissolved the rock.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s30-l3": "Three: Ha Long means descending dragon. Speak slowly, and point to the islands as you speak.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s31-l1": "Ancient sea, carving rain, rising sea. That's the whole story of Ha Long.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s31-l2": "Each island is an old mountain top. Each notch is a mark in time.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s32-l1": "How can a child easily tell stalactites from stalagmites?|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s32-l2": "Stalactites hang down from the ceiling, and stalagmites grow up from the floor.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s32-l3": "Colour or place doesn't tell them apart.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s33-l1": "So why are there islands in the sea, Auntie?|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s33-l2": "Long ago, these islands were mountains on land. The sea rose, and only the tops stayed above water.|en|1|1|1|false",
 "how-ha-long-bay-was-formed/s34-l1": "Save that sentence on your phone for the trip. Now try the forty questions below.|en|1|1|1|false",
 "how-humans-have-explored-space/s01-l1": "Grandpa, was Phạm Tuân the first Vietnamese person on the Moon?|en|1|1|1|false",
 "how-humans-have-explored-space/s01-l2": "Yes. He went to the Moon in nineteen eighty.|en|1|1|1|false",
 "how-humans-have-explored-space/s01-l3": "Many adults remember it this way. Is it right?|en|1|1|1|false",
 "how-humans-have-explored-space/s02-l1": "How do we know about space? Telescopes, robot ships, and people in space. Five parts.|en|1|1|1|false",
 "how-humans-have-explored-space/s02-l2": "Eyes and telescopes.|en|1|1|1|false",
 "how-humans-have-explored-space/s02-l3": "The space race, and Phạm Tuân.|en|1|1|1|false",
 "how-humans-have-explored-space/s02-l4": "Did we really go to the Moon?|en|1|1|1|false",
 "how-humans-have-explored-space/s02-l5": "Robot ships and space telescopes.|en|1|1|1|false",
 "how-humans-have-explored-space/s02-l6": "The space station, and what comes next.|en|1|1|1|false",
 "how-humans-have-explored-space/s03-l1": "Part one: before rockets, how did people watch the sky?|en|1|1|1|false",
 "how-humans-have-explored-space/s04a-l1": "For thousands of years, people only had their eyes.|en|1|1|1|false",
 "how-humans-have-explored-space/s04b-l2": "They watched the Moon, the Sun, and the stars to make calendars, plan farming, and sail.|en|1|1|1|false",
 "how-humans-have-explored-space/s04-l3": "Our lunar calendar comes from watching the Moon very patiently.|en|1|1|1|false",
 "how-humans-have-explored-space/s04-l4": "Then, around sixteen ten, Galileo pointed a telescope at the sky.|en|1|1|1|false",
 "how-humans-have-explored-space/s05-l1": "He saw mountains and craters on the Moon,|en|1|1|1|false",
 "how-humans-have-explored-space/s05-l2": "four moons going around Jupiter,|en|1|1|1|false",
 "how-humans-have-explored-space/s05-l3": "and Venus changing shape, like the Moon.|en|1|1|1|false",
 "how-humans-have-explored-space/s05-l4": "For the first time, people saw details that eyes alone miss. Telescopes became our new eyes.|en|1|1|1|false",
 "how-humans-have-explored-space/s06-l1": "Part two: the race into space.|en|1|1|1|false",
 "how-humans-have-explored-space/s07-l1": "In nineteen fifty seven, the Soviet Union launched Sputnik one, the first human made satellite.|en|1|1|1|false",
 "how-humans-have-explored-space/s07-l2": "In sixty one, Yuri Gagarin became the first person in space. He flew once around Earth.|en|1|1|1|false",
 "how-humans-have-explored-space/s07-l3": "In July sixty nine, Apollo eleven took Neil Armstrong and Buzz Aldrin to the Moon.|en|1|1|1|false",
 "how-humans-have-explored-space/s07-l4": "By seventy two, twelve people had walked there, and brought back hundreds of kilos of rock.|en|1|1|1|false",
 "how-humans-have-explored-space/s07-l5": "In nineteen eighty, Phạm Tuân flew on Soyuz thirty seven, and worked on a station in orbit.|en|1|1|1|false",
 "how-humans-have-explored-space/s08-l1": "So Phạm Tuân walked on the Moon, right?|en|1|1|1|false",
 "how-humans-have-explored-space/s08-l2": "Yes. The first Vietnamese on the Moon.|en|1|1|1|false",
 "how-humans-have-explored-space/s08-l3": "Wait a second!|en|1|1|1|false",
 "how-humans-have-explored-space/s08-l4": "He worked on a station a few hundred kilometres up. The Moon is about a thousand times farther.|en|1|1|1|false",
 "how-humans-have-explored-space/s08-l5": "Let's rewind and try again.|en|1|1|1|false",
 "how-humans-have-explored-space/s08-l6": "In nineteen eighty, a Vietnamese man flew into space. He was the first in Asia, too!|en|1|1|1|false",
 "how-humans-have-explored-space/s08-l7": "But only twelve Americans of Apollo have walked on the Moon. No Vietnamese yet.|en|1|1|1|false",
 "how-humans-have-explored-space/s08-l8": "Flying into space is not always landing on the Moon!|en|1|1|1|false",
 "how-humans-have-explored-space/s09-l1": "Part three: some videos say the Moon landings were faked. How do we check?|en|1|1|1|false",
 "how-humans-have-explored-space/s10-l1": "Look at this video. It says the Moon landing was fake.|en|1|1|1|false",
 "how-humans-have-explored-space/s10-l2": "That is nonsense! You should not watch that!|en|1|1|1|false",
 "how-humans-have-explored-space/s10-l3": "Hold on!|en|1|1|1|false",
 "how-humans-have-explored-space/s10-l4": "Arguing rarely helps. Doubt is good, but ask for evidence from both sides.|en|1|1|1|false",
 "how-humans-have-explored-space/s10-l5": "Let's rewind and try a calm question.|en|1|1|1|false",
 "how-humans-have-explored-space/s10-l6": "Hmm. What evidence does the video show?|en|1|1|1|false",
 "how-humans-have-explored-space/s10-l7": "A few photos that look strange.|en|1|1|1|false",
 "how-humans-have-explored-space/s10-l8": "Then where did the Moon rocks studied in many countries come from?|en|1|1|1|false",
 "how-humans-have-explored-space/s11-l1": "Here is the evidence. Moon rocks have been studied in labs in many countries for decades.|en|1|1|1|false",
 "how-humans-have-explored-space/s11-l2": "Astronauts left mirrors there. Observatories still bounce lasers off them to measure the distance to the Moon.|en|1|1|1|false",
 "how-humans-have-explored-space/s11-l3": "And later spacecraft circling the Moon photographed the landing sites.|en|1|1|1|false",
 "how-humans-have-explored-space/s12-l1": "Part four: robot ships and telescopes in space.|en|1|1|1|false",
 "how-humans-have-explored-space/s13-l1": "In nineteen seventy seven, two Voyager ships left Earth and sent back the first close-up photos of the giant planets.|en|1|1|1|false",
 "how-humans-have-explored-space/s13-l2": "Voyager two is still the only ship that has visited Uranus and Neptune.|en|1|1|1|false",
 "how-humans-have-explored-space/s13-l3": "In twenty twelve, Voyager one left the solar wind's reach. It is the farthest human made object.|en|1|1|1|false",
 "how-humans-have-explored-space/s14-l1": "A ship has flown for almost fifty years, farther than anything people ever made.|en|1|1|1|false",
 "how-humans-have-explored-space/s14-l2": "And it still sends messages home.|en|1|1|1|false",
 "how-humans-have-explored-space/s14-l3": "Wow! Tell me more!|en|1|1|1|false",
 "how-humans-have-explored-space/s14-l4": "A real adventure, farther than anything people made. Children often love it at once.|en|1|1|1|false",
 "how-humans-have-explored-space/s15-l1": "Earth's air makes starlight shake, and it blocks many kinds of light.|en|1|1|1|false",
 "how-humans-have-explored-space/s15-l2": "So in nineteen ninety, the Hubble telescope went into orbit, above the air, with sharper images than ever.|en|1|1|1|false",
 "how-humans-have-explored-space/s16a-l1": "At the end of twenty twenty one, the James Webb telescope was launched, very far from Earth.|en|1|1|1|false",
 "how-humans-have-explored-space/s16-l2": "It sees infrared light, which our eyes cannot see.|en|1|1|1|false",
 "how-humans-have-explored-space/s16-l3": "So it finds very distant, very old galaxies. Their light left billions of years ago, so we see their past.|en|1|1|1|false",
 "how-humans-have-explored-space/s17-l1": "James Webb photos show the colours our eyes would see. True or false?|en|1|1|1|false",
 "how-humans-have-explored-space/s17-l2": "False. Scientists give each band of invisible light a visible colour. Longer waves are often made redder.|en|1|1|1|false",
 "how-humans-have-explored-space/s17-l3": "The pictures are true to the data. But if you flew there, your eyes would not see these colours.|en|1|1|1|false",
 "how-humans-have-explored-space/s17-l4": "Space images are translations, not exactly what our eyes would see.|en|1|1|1|false",
 "how-humans-have-explored-space/s18-l1": "Part five: living in orbit, and what comes next.|en|1|1|1|false",
 "how-humans-have-explored-space/s19-l1": "The International Space Station has had people on board since two thousand.|en|1|1|1|false",
 "how-humans-have-explored-space/s19-l2": "It goes around Earth every ninety minutes, so astronauts see about sixteen sunrises a day.|en|1|1|1|false",
 "how-humans-have-explored-space/s19-l3": "They sleep in bags tied to the wall, and recycle water to use again.|en|1|1|1|false",
 "how-humans-have-explored-space/s19-l4": "They exercise every day to keep their muscles and bones strong.|en|1|1|1|false",
 "how-humans-have-explored-space/s20-l1": "You can see the station with your eyes. Its pass times are published in advance.|en|1|1|1|false",
 "how-humans-have-explored-space/s20-l2": "Step one: check the official pass time. Say, seven twelve in the evening, in the west.|en|1|1|1|false",
 "how-humans-have-explored-space/s20-l3": "Step two: go outside a few minutes early, and face west.|en|1|1|1|false",
 "how-humans-have-explored-space/s20-l4": "Step three: look for a dot gliding steadily, with no blinking and no sound.|en|1|1|1|false",
 "how-humans-have-explored-space/s20-l5": "Step four: watch for a few minutes, until it fades into Earth's shadow.|en|1|1|1|false",
 "how-humans-have-explored-space/s21-l1": "Look! Is that blinking dot the station?|en|1|1|1|false",
 "how-humans-have-explored-space/s21-l2": "That one blinks, so it is likely a plane. Planes usually have blinking lights.|en|1|1|1|false",
 "how-humans-have-explored-space/s21-l3": "There! A bright dot moving smoothly. It does not blink!|en|1|1|1|false",
 "how-humans-have-explored-space/s21-l4": "That is the space station. Let's wave!|en|1|1|1|false",
 "how-humans-have-explored-space/s21-l5": "A steady moving dot that does not blink may be the space station.|en|1|1|1|false",
 "how-humans-have-explored-space/s22-l1": "After nineteen seventy two, nobody landed on the Moon again, mainly because it cost so much.|en|1|1|1|false",
 "how-humans-have-explored-space/s22-l2": "Countries chose space stations and robot ships instead.|en|1|1|1|false",
 "how-humans-have-explored-space/s22-l3": "Now many countries have landed craft on the Moon, and rockets can fly up and land again to be reused.|en|1|1|1|false",
 "how-humans-have-explored-space/s22-l4": "In April twenty twenty six, four Artemis two astronauts flew around the Moon and came back, without landing.|en|1|1|1|false",
 "how-humans-have-explored-space/s23-l1": "Grandpa, I want to work in space one day!|en|1|1|1|false",
 "how-humans-have-explored-space/s23-l2": "A Vietnamese man flew into space in nineteen eighty. Now we build satellites too.|en|1|1|1|false",
 "how-humans-have-explored-space/s23-l3": "So study hard: maths, science, and English.|en|1|1|1|false",
 "how-humans-have-explored-space/s23-l4": "Vietnamese engineers have helped design and build the country's satellites.|en|1|1|1|false",
 "how-humans-have-explored-space/s24-l1": "Eyes, telescopes, robot ships, and human flights. Each step answers another why.|en|1|1|1|false",
 "how-humans-have-explored-space/s24-l2": "Flying into space is not always landing on the Moon.|en|1|1|1|false",
 "how-humans-have-explored-space/s24-l2b": "Ask for evidence on both sides. And space images are translations.|en|1|1|1|false",
 "how-humans-have-explored-space/s25-l1": "A video claims the Moon landings were faked, what is the best first question to ask?|en|1|1|1|false",
 "how-humans-have-explored-space/s25-l2": "Ask what evidence each side has, not only what the video shows.|en|1|1|1|false",
 "how-humans-have-explored-space/s25-l3": "Moon rocks studied in many countries, mirrors still hit by lasers, and photos of the landing sites.|en|1|1|1|false",
 "how-humans-have-explored-space/s26-l1": "This week, check when the space station passes over you, and wave with your child.|en|1|1|1|false",
 "how-humans-have-explored-space/s26-l2": "Your turn. Forty questions are waiting to close the series.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s01-l1": "Grandpa, my book says eight planets. You learned nine, right?|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s01-l2": "Nine, of course. Your book must be printed wrong.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s01-l3": "So who is right, the old lesson or the new book?|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s02-l1": "How many planets are there? Let's answer that, and draw a map for the whole series.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s02-l2": "Eight or nine?|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s02-l3": "Two groups, and their order.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s02-l4": "How big is the solar system?|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s02-l5": "What to read next.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s02-l6": "And how to answer your child.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s03-l1": "Part one: eight or nine planets?|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s04-l1": "From the Sun outward: Mercury, Venus,|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s04-l2": "Earth, Mars,|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s04-l3": "Jupiter, Saturn,|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s04-l4": "Uranus, and Neptune.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s04-l5": "This list follows the International Astronomical Union, astronomers from many countries. New textbooks use it.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s05-l1": "In two thousand six, astronomers agreed on three conditions. One: it goes around the Sun.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s05-l2": "Two: it is heavy enough to pull itself nearly round.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s05-l3": "Three: it has cleared its path, ruling over the small objects around its orbit.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s05-l4": "Size, water, or rings are not part of the definition.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s06-l1": "Pluto is round, and it still goes around the Sun.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s06-l2": "But it shares its path with many icy objects, in a far region called the Kuiper belt.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s06-l3": "So it fails the third condition.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s06-l4": "In two thousand five, Eris was found, heavier than Pluto. With the old idea, the list could grow forever.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s07-l1": "So which is it, Grandpa? Eight or nine?|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s07-l2": "Nine. Pluto is the ninth planet. Your book is wrong.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s07-l3": "Wait a second!|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s07-l4": "Both were right in their time. From nineteen thirty to two thousand six, Pluto was the ninth planet.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s07-l5": "Let's rewind and try again.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s07-l6": "The book is not wrong. Science has updated its definition.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s07-l7": "Pluto is still there. Scientists now put it in the dwarf planet group.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s07-l8": "Because on its path, there are many other little friends.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s08-l1": "Part two: how are the planets different, and how do we remember the order?|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s09-l1": "The four inner planets are small, with solid ground of rock and metal.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s09-l2": "The four outer planets are much bigger, mostly gas and ice. There is no ground to stand on.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s09-l3": "They all have rings and many moons.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s10-l1": "Between the two groups is the asteroid belt. Countless small rocks circle the Sun between Mars and Jupiter.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s10-l2": "Ceres, the biggest object there, is also a dwarf planet. So Pluto is not alone.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s11-l1": "A memory trick. Five Vietnamese planet names come from the five elements of old Eastern astronomy.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s11-l1b": "Kim, Mộc, Thủy, Hỏa, Thổ.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s11-l2": "In English, try: My Very Educated Mother Just Served Us Noodles.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s11-l3": "Each first letter is a planet, from Mercury to Neptune.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s12-l1": "Look, Grandpa! Eight foam balls, all the same size, close together on a stick.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s12-l2": "That is how the planets are! It is ready for school.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s12-l3": "Hold on!|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s12-l4": "The model is pretty, and it helps you remember the order. But the sizes and gaps are not real.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s12-l5": "Let's rewind and think again.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s12-l6": "If Earth were a pea, how big would Jupiter be?|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s12-l7": "Like an orange! It is about eleven times wider.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s12-l8": "I will add a note: not to scale.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s13-l1": "Part three: how big is the solar system?|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s14-l1": "Earth is about one hundred fifty million kilometres from the Sun.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s14-l2": "Neptune, the farthest planet, is about thirty times as far: about four and a half billion kilometres.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s14-l3": "The outer planets are spread out much more than the rocky ones inside.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s15-l1": "Hundreds of millions of kilometres are hard to picture. But children can feel time.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s15-l2": "Try this: The sunlight you see now left the Sun about eight minutes ago.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s16-l1": "Beyond Neptune is the Kuiper belt. Pluto lives there, and many comets start there.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s16-l2": "Farther still may be the Oort cloud, home of other comets. It has not been seen directly.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s16-l3": "And Planet Nine? It is only an idea. Nobody has seen it.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s17-l1": "Part four: a map for the rest of this series.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s18-l1": "Start where we stand: day, night, and seasons.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s18-l1b": "Many adults say summer comes because Earth is closer to the Sun. That article shows the tilt.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s18-l2": "Then the Moon: a huge crash with the young Earth. And eclipses: when to watch, and how to watch safely.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s18-l3": "Next, the neighbours: why Venus is hotter than Mercury, life on Mars, and how big Jupiter is.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s18-l4": "Then visitors and far places: the right names for comets and meteors, and black holes, outside the solar system.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s18-l5": "Last, how we learned it all: telescopes, robot ships, and human flights, like Phạm Tuân's in nineteen eighty.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s19-l1": "I want to read about black holes first! Will one swallow our house?|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s19-l2": "First week, day and night, with a torch and an orange. Then the Moon and eclipses.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s19-l3": "Then Venus, Mars, and Jupiter. And then black holes.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s19-l4": "Black holes are real, but the known ones are very far away. Our home is safe.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s19-l5": "From near to far, your child understands and feels safe.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s20-l1": "Part five: answer your child correctly and simply.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s21-l1": "Give a short answer first. Explain more if your child is still curious.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s21-l2": "Use things around the house as examples.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s21-l3": "Not sure? Say: let me look it up and tell you.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s21-l3b": "A made-up answer can stay in a child's head for a long time.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s22-l1": "To check a fact, look at space agency pages, science museums, or new textbooks. Experts check them.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s22-l2": "Clickbait videos often mix facts and fiction. Use them to start a chat, not as proof.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s23-l1": "Look, Bin. What a big star next to the Moon!|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s23-l2": "It shines so steadily. It does not twinkle.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s23-l3": "Then it is often a planet, like Venus or Jupiter. Let's check the star map.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s23-l4": "Stars are very far, just points, so the air makes them twinkle.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s23-l4b": "Planets are closer, tiny disks, so they shine more steadily.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s23-l5": "Mercury, Venus, Mars, Jupiter, and Saturn can be seen with your eyes when the sky is good.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s24-l1": "A twinkling dot is usually a planet. True or false?|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s24-l2": "False. A steady light is usually a planet. A twinkling one is usually a star.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s25-l1": "So Grandpa and the book were both right.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s25-l1b": "Eight planets, three conditions, and Pluto is still lovely as a dwarf planet.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s25-l2": "Add a note to your model. And go from near to far.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s26-l1": "Why is Pluto no longer called a planet?|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s26-l2": "It shares its path with many icy objects, so it has not cleared its orbit.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s26-l3": "Pluto is still round and still goes around the Sun. It only fails the third condition.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s27-l1": "Ask your child what they are most curious about, and pick the first article together.|en|1|1|1|false",
 "how-many-planets-are-in-the-solar-system/s27-l2": "Your turn. Forty questions are waiting below.|en|1|1|1|false",
 "how-much-to-run-each-week/s01-l1": "Ouch. The outside of my knee hurts every time I go downstairs.|en|1|1|1|false",
 "how-much-to-run-each-week/s01-l2": "Week five of running, and Thao has to skip several runs. One week did this.|en|1|1|1|false",
 "how-much-to-run-each-week/s01-l3": "So how much should you run each week? And how do you add more?|en|1|1|1|false",
 "how-much-to-run-each-week/s02-l1": "For beginners, this is enough to improve.|en|1|1|1|false",
 "how-much-to-run-each-week/s02-l2": "Three runs a week.|en|1|1|1|false",
 "how-much-to-run-each-week/s02-l3": "Twenty to thirty minutes each, including the walking.|en|1|1|1|false",
 "how-much-to-run-each-week/s02-l4": "Count minutes first. Add slowly, one thing at a time.|en|1|1|1|false",
 "how-much-to-run-each-week/s02-l5": "And always rest days in between.|en|1|1|1|false",
 "how-much-to-run-each-week/s03-l1": "How much is enough.|en|1|1|1|false",
 "how-much-to-run-each-week/s03-l2": "Minutes or kilometres.|en|1|1|1|false",
 "how-much-to-run-each-week/s03-l3": "How to add more.|en|1|1|1|false",
 "how-much-to-run-each-week/s03-l4": "The first three months, and rest days.|en|1|1|1|false",
 "how-much-to-run-each-week/s03-l5": "And running too much.|en|1|1|1|false",
 "how-much-to-run-each-week/s04-l1": "Part one: how much is enough, and for which goal?|en|1|1|1|false",
 "how-much-to-run-each-week/s05-l1": "Three runs a week, twenty to thirty minutes each, warm-up and cool-down walks included.|en|1|1|1|false",
 "how-much-to-run-each-week/s05-l2": "So the run-walk part in the middle is only ten to twenty minutes.|en|1|1|1|false",
 "how-much-to-run-each-week/s05-l3": "A few weeks of this, and breathing gets easier, legs feel lighter.|en|1|1|1|false",
 "how-much-to-run-each-week/s06-l1": "For general health, the World Health Organization recommends 150 to 300 minutes of moderate activity a week,|en|1|1|1|false",
 "how-much-to-run-each-week/s06-l2": "or 75 to 150 minutes of vigorous activity.|en|1|1|1|false",
 "how-much-to-run-each-week/s06-l3": "Running is only part of it. Brisk walking, cycling and swimming count too.|en|1|1|1|false",
 "how-much-to-run-each-week/s07-l1": "Only ten or fifteen minutes today? Skip it and make up tomorrow. True or false?|en|1|1|1|false",
 "how-much-to-run-each-week/s07-l2": "False. Still run. Any movement beats sitting still.|en|1|1|1|false",
 "how-much-to-run-each-week/s07-l3": "And a short run keeps your habit alive.|en|1|1|1|false",
 "how-much-to-run-each-week/s08-l1": "Healthier, better sleep, less stress? Three easy runs, plus walking.|en|1|1|1|false",
 "how-much-to-run-each-week/s08-l2": "A five-kilometre race? Three runs a week, over a few months.|en|1|1|1|false",
 "how-much-to-run-each-week/s08-l3": "Ten kilometres or more? More runs and a weekly long run.|en|1|1|1|false",
 "how-much-to-run-each-week/s08-l4": "Think about that only after months of steady running.|en|1|1|1|false",
 "how-much-to-run-each-week/s09-l1": "Running to lose weight? It burns energy, but food still matters a lot.|en|1|1|1|false",
 "how-much-to-run-each-week/s09-l2": "More running isn't always better, especially when you're tired and eat too much to make up.|en|1|1|1|false",
 "how-much-to-run-each-week/s10-l1": "Part two: count minutes, or kilometres?|en|1|1|1|false",
 "how-much-to-run-each-week/s11-l1": "Beginners should count time. Thirty slow minutes is three kilometres for one person, five for another.|en|1|1|1|false",
 "how-much-to-run-each-week/s11-l2": "Minutes take away the pressure of “enough kilometres”, and you run at a comfortable pace.|en|1|1|1|false",
 "how-much-to-run-each-week/s12-l1": "Once you run regularly and have a goal like a race,|en|1|1|1|false",
 "how-much-to-run-each-week/s12-l2": "you can slowly switch to tracking distance, to compare with the race.|en|1|1|1|false",
 "how-much-to-run-each-week/s13-l1": "Beginners need regular, easy time moving. Twenty to thirty minutes of run-walk, three times a week, is enough.|en|1|1|1|false",
 "how-much-to-run-each-week/s13-l2": "Forcing five kilometres from week one ends in exhaustion, and you're sick of it in weeks.|en|1|1|1|false",
 "how-much-to-run-each-week/s14-l1": "Count minutes first. Kilometres later.|en|1|1|1|false",
 "how-much-to-run-each-week/s15-l1": "Part three: how do you add more without getting hurt?|en|1|1|1|false",
 "how-much-to-run-each-week/s16-l1": "Heart and lungs adapt quite fast. Tendons, bones and joints adapt more slowly.|en|1|1|1|false",
 "how-much-to-run-each-week/s16-l2": "So people feel strong, add too fast, and hurt a few weeks later.|en|1|1|1|false",
 "how-much-to-run-each-week/s17-l1": "Add slowly. Many people don't raise the weekly total by more than about ten percent.|en|1|1|1|false",
 "how-much-to-run-each-week/s17-l2": "It's a rule of thumb, not an exact science. Change only one thing at a time: time, speed or hills.|en|1|1|1|false",
 "how-much-to-run-each-week/s17-l3": "Every few weeks, have an easier week.|en|1|1|1|false",
 "how-much-to-run-each-week/s17-l4": "Run most sessions at a pace where you can still talk.|en|1|1|1|false",
 "how-much-to-run-each-week/s17-l5": "Not sure? Stay the same one more week. Months of steady running beat a few big weeks.|en|1|1|1|false",
 "how-much-to-run-each-week/s18-l1": "Rewind to the start of Thao's week five.|en|1|1|1|false",
 "how-much-to-run-each-week/s18-l2": "I feel so strong! This week: longer runs, faster, and two hill loops on the bridge!|en|1|1|1|false",
 "how-much-to-run-each-week/s18-l3": "Wait a second!|en|1|1|1|false",
 "how-much-to-run-each-week/s18-l4": "Three changes in one week. Your heart and lungs adapt fast. Tendons, bones and joints need more time.|en|1|1|1|false",
 "how-much-to-run-each-week/s18-l5": "Let's rewind and try again.|en|1|1|1|false",
 "how-much-to-run-each-week/s18-l6": "Just a few more minutes this week. The hills can wait.|en|1|1|1|false",
 "how-much-to-run-each-week/s18-l7": "A little more each week. One change at a time.|en|1|1|1|false",
 "how-much-to-run-each-week/s19-l1": "Part four: the first three months, and the days you don't run.|en|1|1|1|false",
 "how-much-to-run-each-week/s20-l1": "Month one: three run-walk sessions, twenty to thirty minutes each.|en|1|1|1|false",
 "how-much-to-run-each-week/s20-l2": "Month two: still three, but longer runs and shorter walks.|en|1|1|1|false",
 "how-much-to-run-each-week/s20-l3": "Month three: many can run twenty to thirty minutes nonstop, slowly.|en|1|1|1|false",
 "how-much-to-run-each-week/s20-l4": "Just an example, not a must. Going slower is completely fine.|en|1|1|1|false",
 "how-much-to-run-each-week/s21-l1": "Already running thirty minutes nonstop?|en|1|1|1|false",
 "how-much-to-run-each-week/s21-l2": "Keep that level for a few weeks first.|en|1|1|1|false",
 "how-much-to-run-each-week/s21-l3": "Then add a few minutes to one run in the week,|en|1|1|1|false",
 "how-much-to-run-each-week/s21-l4": "or add a fourth run, if your body recovers well.|en|1|1|1|false",
 "how-much-to-run-each-week/s22-l1": "Beginners improve fastest by running every day. True or false?|en|1|1|1|false",
 "how-much-to-run-each-week/s22-l2": "False. Your body may not have time to recover.|en|1|1|1|false",
 "how-much-to-run-each-week/s22-l3": "Three or four runs a week, with rest days between, usually last longer.|en|1|1|1|false",
 "how-much-to-run-each-week/s23-l1": "Tired? Rest completely.|en|1|1|1|false",
 "how-much-to-run-each-week/s23-l2": "Or walk, cycle, swim: movement with less impact.|en|1|1|1|false",
 "how-much-to-run-each-week/s23-l3": "And strength work twice a week: squats, lunges, planks, calf raises.|en|1|1|1|false",
 "how-much-to-run-each-week/s23-l4": "The WHO also advises adults to do muscle-strengthening on at least two days a week.|en|1|1|1|false",
 "how-much-to-run-each-week/s24-l1": "Part five: how do you know you are running too much?|en|1|1|1|false",
 "how-much-to-run-each-week/s25-l1": "Lasting tiredness. Even easy runs feel heavy.|en|1|1|1|false",
 "how-much-to-run-each-week/s25-l2": "Poor sleep, irritability, no desire to run.|en|1|1|1|false",
 "how-much-to-run-each-week/s25-l3": "Morning resting heart rate higher than usual for days, if you track it.|en|1|1|1|false",
 "how-much-to-run-each-week/s25-l4": "Pain in one spot that doesn't ease, or grows. Then cut back. If it lasts after rest, see a doctor.|en|1|1|1|false",
 "how-much-to-run-each-week/s26-l1": "Two people run to lose weight.|en|1|1|1|false",
 "how-much-to-run-each-week/s26-l2": "Every day, sometimes morning and evening. Then I'm starving, so I eat more.|en|1|1|1|false",
 "how-much-to-run-each-week/s26-l3": "A month later, my weight hasn't moved. I can't sleep, and my legs feel like lead.|en|1|1|1|false",
 "how-much-to-run-each-week/s26-l4": "Three or four runs a week, rest days, and I watch my portions.|en|1|1|1|false",
 "how-much-to-run-each-week/s26-l5": "Slow but steady weight loss. And my runs still feel good.|en|1|1|1|false",
 "how-much-to-run-each-week/s27-l1": "When an easy run feels heavy, it's time to step back.|en|1|1|1|false",
 "how-much-to-run-each-week/s27-l2": "Busy week, ill, or sleeping badly? Run less, or rest.|en|1|1|1|false",
 "how-much-to-run-each-week/s27-l3": "Coming back after a long break? Start a bit below your old level.|en|1|1|1|false",
 "how-much-to-run-each-week/s28-l1": "Dung was off for three weeks with a fever. Now he's fully better.|en|1|1|1|false",
 "how-much-to-run-each-week/s28-l2": "Back to my full old workout today, to get my form back!|en|1|1|1|false",
 "how-much-to-run-each-week/s28-l3": "Wait a second!|en|1|1|1|false",
 "how-much-to-run-each-week/s28-l4": "After weeks of illness, some fitness is gone. You may run out of breath, and have sore calves tomorrow.|en|1|1|1|false",
 "how-much-to-run-each-week/s28-l5": "Let's rewind and try again.|en|1|1|1|false",
 "how-much-to-run-each-week/s28-l6": "A few shorter, easier runs first. Then build up again.|en|1|1|1|false",
 "how-much-to-run-each-week/s28-l7": "That usually gets you back to your old level faster.|en|1|1|1|false",
 "how-much-to-run-each-week/s29-l1": "Weekly mileage: your total distance for the week.|en|1|1|1|false",
 "how-much-to-run-each-week/s29-l2": "Easy run: a light run.|en|1|1|1|false",
 "how-much-to-run-each-week/s29-l3": "Long run: the longest run of the week.|en|1|1|1|false",
 "how-much-to-run-each-week/s29-l4": "Recovery week: an easier week to recover.|en|1|1|1|false",
 "how-much-to-run-each-week/s30-l1": "Hi! How often do you run?|en|1|1|1|false",
 "how-much-to-run-each-week/s30-l2": "I run three times a week.|en|1|1|1|false",
 "how-much-to-run-each-week/s31-l1": "“Enough” isn't the most you can take. It's what you can keep up for months without pain.|en|1|1|1|false",
 "how-much-to-run-each-week/s31-l2": "Minutes first, one change at a time, and step back when easy runs feel heavy.|en|1|1|1|false",
 "how-much-to-run-each-week/s32-l1": "Do it now: this week, write down your total running minutes,|en|1|1|1|false",
 "how-much-to-run-each-week/s32-l2": "and how you felt after each run. Next week, you'll know whether to stay or add a little.|en|1|1|1|false",
 "how-much-to-run-each-week/s33-l1": "This week you added more time, should you also add hills and speed?|en|1|1|1|false",
 "how-much-to-run-each-week/s33-l2": "No, change only one thing at a time so your body can adapt safely.|en|1|1|1|false",
 "how-much-to-run-each-week/s33-l3": "All three together put a sudden load on your legs. Not sure? Keep the same for one more week.|en|1|1|1|false",
 "how-much-to-run-each-week/s34-l1": "Rest day? Forty questions are waiting below.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s01-l1": "Morning: iced milk coffee. Noon: milk tea. Afternoon: an energy drink. Evening: a few beers.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s01-l2": "I drink so much every day!|en|1|1|1|false",
 "how-much-water-you-need-each-day/s01-l3": "It looks like a lot. But is it enough water?|en|1|1|1|false",
 "how-much-water-you-need-each-day/s02-l1": "So how much water do you really need each day?|en|1|1|1|false",
 "how-much-water-you-need-each-day/s02-l2": "Short answer: there is no single number for everyone.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s02-l3": "Most adults need about two to two and a half litres in total, food included.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s02-l4": "And pale yellow urine is the easiest sign to watch.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s03-l2": "Our plan: how much, and how to tell you have enough.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s03-l3": "Do coffee, milk tea and beer count?|en|1|1|1|false",
 "how-much-water-you-need-each-day/s03-l4": "When to drink more, and is more always better?|en|1|1|1|false",
 "how-much-water-you-need-each-day/s03-l5": "And easy habits for busy people.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s04-l1": "Part one: so how much do we need?|en|1|1|1|false",
 "how-much-water-you-need-each-day/s05-l1": "There is no one right number for everyone.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s05-l2": "Europe's food safety agency, EFSA, gives about two litres a day for women.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s05-l3": "And about two and a half litres for men, in normal conditions.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s06-l1": "That total includes water from food, usually about twenty percent.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s06-l2": "Vietnamese meals have soup, vegetables and fruit, so you need not count every glass.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s07-l2": "Eight glasses a day? Popular, but strong science doesn't support that exact number.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s07-l3": "It is just a reminder, not a target. Real needs depend on food, weather and activity.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s08-l1": "Why do we need water every day? It controls body heat through sweat.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s08-l2": "It carries nutrients, and removes waste through urine.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s08-l3": "It also helps your joints and your digestion.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s08-l4": "And every day we lose water through sweat, breathing, urine and stool. So we refill steadily.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s09-l1": "Part two: how do you know you drink enough?|en|1|1|1|false",
 "how-much-water-you-need-each-day/s10-l1": "The simplest check is the colour of your urine.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s10-l2": "Pale yellow is a good sign.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s10-l3": "Dark yellow, and going less often, means drink more. Young, healthy people can also follow thirst.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s11-l1": "Common signs of not drinking enough: thirst, a dry mouth, dry lips.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s11-l2": "Dark yellow urine, and fewer trips to the toilet.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s11-l3": "Feeling tired, a headache, trouble focusing.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s11-l4": "Feeling dizzy when you stand up. Then drink some water and rest a little.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s12-l1": "I feel confused... my heart is racing.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s12-l2": "And you haven't been to the toilet for hours, Grandma. We are going to the doctor now.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s12-l3": "Confusion, a fast heartbeat, fainting, no urine for hours: see a doctor now, especially children and older people.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s13-l1": "So much work today. Just a few sips since morning.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s13-l2": "I'm not sweating in here. I don't need to drink much.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s13-l3": "Wait a second!|en|1|1|1|false",
 "how-much-water-you-need-each-day/s13-l4": "You still lose water when you breathe and pee, and the air is dry. By late afternoon, headaches come.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s13-l5": "Let's rewind and try again.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s13-l6": "A bottle on my desk. A few sips after each task.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s13-l7": "Right. A cool room hides thirst, but your body still needs water.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s14-l1": "Part three: do coffee, milk tea and beer count?|en|1|1|1|false",
 "how-much-water-you-need-each-day/s15-l1": "Unsweetened tea, soup and milk all help you stay hydrated.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s15-l2": "Coffee and tea in moderate amounts still count. But plain water should be the main drink.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s15-l3": "Soft drinks, milk tea and energy drinks have lots of sugar. Don't use them instead of water.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s15-l4": "And alcohol does not hydrate you. It can make you pee more.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s16-l1": "Back to Dung's day. Coffee, milk tea, energy drinks and beer fill a whole day, so what is missing?|en|1|1|1|false",
 "how-much-water-you-need-each-day/s16-l2": "Almost no plain water, while the drinks add quite a lot of sugar. And beer makes you pee more.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s17-l1": "Milk tea? Okay, but with a glass of water too.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s17-l2": "And fewer energy drinks, bit by bit.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s17-l3": "One glass of water with each sweet drink. Slowly, plain water becomes the main drink.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s18-l1": "The lesson: drinking a lot does not always mean drinking the right things.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s19-l1": "Part four: when do you need more?|en|1|1|1|false",
 "how-much-water-you-need-each-day/s20-l1": "Drink more in hot, humid weather, especially when you work outside.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s20-l2": "When you exercise and sweat a lot. Running in the evening? Drink more around your runs.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s20-l3": "When you have a fever, diarrhoea or vomiting.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s20-l4": "And if you are pregnant or breastfeeding, ask your doctor.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s21-l1": "Grandma, my tummy hurts. I have diarrhoea.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s21-l2": "Let's ask the health worker how to use rehydration salts. Not a recipe from the internet.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s21-l3": "Fever and diarrhoea take away water and electrolytes. For children and older people, ask a health worker.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s21-l4": "Strange, I never feel thirsty these days.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s21-l5": "That's why I'll put a cup of water by your chair, Grandma.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s21-l6": "Older people often feel less thirsty, so they drink too little without noticing. Remind them through the day.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s22-a1": "A site check at noon. Just a coffee. I'll drink when I'm thirsty.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s22-a2": "So hot... I feel dizzy. Can I have some water?|en|1|1|1|false",
 "how-much-water-you-need-each-day/s22-b1": "A water bottle in my bag. A few sips after each area, even before I'm thirsty.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s22-b2": "All done, and my head is still clear!|en|1|1|1|false",
 "how-much-water-you-need-each-day/s22-b3": "Small sips replace the sweat little by little. The hotter the day, the closer your bottle.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s23-l1": "Part five: is drinking a lot always better?|en|1|1|1|false",
 "how-much-water-you-need-each-day/s24-l1": "Rare in healthy people, but a huge amount fast can dilute blood sodium: hyponatremia.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s24-l2": "It happens to some long distance runners, and in online water challenges.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s25-l1": "So you don't need to force yourself. Drink steadily through the day, not all at once.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s25-l2": "Follow your thirst, and check the colour of your urine.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s26-l1": "A video says four litres a day for perfect skin.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s26-l2": "I'll set an alarm every thirty minutes and keep drinking!|en|1|1|1|false",
 "how-much-water-you-need-each-day/s26-l3": "Wait a second!|en|1|1|1|false",
 "how-much-water-you-need-each-day/s26-l4": "Once you have enough, the extra mostly goes out. You run to the toilet, lose focus in meetings, wake up at night.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s26-l5": "Let's rewind and try again.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s26-l6": "I'll drink when I'm thirsty and check my urine colour.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s26-l7": "Yes. Enough is enough. Forcing extra water does not make you healthier.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s27-l1": "Last part: how busy people can drink steadily.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s28-l1": "Keep a bottle on your desk, and take it when you go out.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s28-l2": "Drink a glass when you wake up, and a glass with each meal.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s28-l3": "Eat soup and juicy fruit like watermelon, oranges and pomelo.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s28-l4": "Love your iced milk coffee? Keep it, with a glass of plain water.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s29-l1": "One important note. Heart, kidney or liver disease? Your doctor may limit your fluids.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s29-l2": "Then don't drink more because of general advice or a video. Follow your doctor.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s30-l1": "No need to count every glass or force down four litres.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s30-l2": "Drink steadily, follow thirst, check your urine colour.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s30-l3": "Drink more when it's hot or when you move a lot. And make plain water your main drink.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s31-l1": "What is the difference between pale yellow and dark yellow urine?|en|1|1|1|false",
 "how-much-water-you-need-each-day/s31-l2": "Pale yellow usually means you are drinking enough, dark yellow means drink more.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s31-l3": "It is the easiest way to keep track.|en|1|1|1|false",
 "how-much-water-you-need-each-day/s32-l1": "Put a bottle of water on your desk today. Then try the forty questions below.|en|1|1|1|false",
 "how-the-moon-was-formed/s01-l1": "Grandpa, where did the Moon come from?|en|1|1|1|false",
 "how-the-moon-was-formed/s01-l2": "Imagine you are Bác Bình. An old book says for sure: the Moon split off from Earth.|en|1|1|1|false",
 "how-the-moon-was-formed/s01-l3": "Do you say, that is a fact? Or something else?|en|1|1|1|false",
 "how-the-moon-was-formed/s02-l1": "Where did the Moon come from? Let's sort out what is evidence, and what is still a hypothesis.|en|1|1|1|false",
 "how-the-moon-was-formed/s02-l2": "Its size, and its light.|en|1|1|1|false",
 "how-the-moon-was-formed/s02-l3": "Old guesses.|en|1|1|1|false",
 "how-the-moon-was-formed/s02-l4": "Moon rocks, and the giant crash.|en|1|1|1|false",
 "how-the-moon-was-formed/s02-l5": "One face, and changing shapes.|en|1|1|1|false",
 "how-the-moon-was-formed/s02-l6": "And watching it with your child.|en|1|1|1|false",
 "how-the-moon-was-formed/s03-l1": "Part one: how big, how far, and does it shine?|en|1|1|1|false",
 "how-the-moon-was-formed/s04-l1": "The Moon is about three hundred eighty four thousand kilometres away, on average.|en|1|1|1|false",
 "how-the-moon-was-formed/s04b-l2": "It is about three thousand five hundred kilometres wide, nearly a quarter of Earth. That is big for a moon.|en|1|1|1|false",
 "how-the-moon-was-formed/s04b-l3": "That size is one reason scientists wonder where it came from.|en|1|1|1|false",
 "how-the-moon-was-formed/s05-l1": "The Moon glows like a lantern. True or false?|en|1|1|1|false",
 "how-the-moon-was-formed/s05-l2": "False. It is a grey, fairly dark rock with no light inside. Sunlight hits it and bounces to our eyes.|en|1|1|1|false",
 "how-the-moon-was-formed/s05-l3": "A full moon looks so bright partly because the sky around it is so dark.|en|1|1|1|false",
 "how-the-moon-was-formed/s06-l1": "A cute story is easy, but you will have to fix it later.|en|1|1|1|false",
 "how-the-moon-was-formed/s06-l2": "Say this instead: The Moon has no lamp. It borrows light from the Sun, like a mirror.|en|1|1|1|false",
 "how-the-moon-was-formed/s06-l3": "It is just as easy, and it never needs fixing when your child grows up.|en|1|1|1|false",
 "how-the-moon-was-formed/s07-l1": "Part two: what did people guess before?|en|1|1|1|false",
 "how-the-moon-was-formed/s08-l1": "Before Moon rocks, there were three main ideas. One: the Moon split from a fast spinning Earth.|en|1|1|1|false",
 "how-the-moon-was-formed/s08-l2": "Two: Earth captured an object passing by. Three: they formed side by side.|en|1|1|1|false",
 "how-the-moon-was-formed/s08-l3": "But Earth could hardly spin that fast. Catching such a big object is very hard.|en|1|1|1|false",
 "how-the-moon-was-formed/s08-l4": "And if they formed together, the Moon would need a big iron core like Earth. Its core is small.|en|1|1|1|false",
 "how-the-moon-was-formed/s09-l1": "So, where did it come from?|en|1|1|1|false",
 "how-the-moon-was-formed/s09-l2": "It is a fact. The Moon split off from Earth, because Earth was spinning fast.|en|1|1|1|false",
 "how-the-moon-was-formed/s09-l3": "Wait a second!|en|1|1|1|false",
 "how-the-moon-was-formed/s09-l4": "That was one of three old ideas, and it has a big problem.|en|1|1|1|false",
 "how-the-moon-was-formed/s09-l5": "Let's rewind and try again.|en|1|1|1|false",
 "how-the-moon-was-formed/s09-l6": "People used to think that. Now most scientists support another idea: a giant crash.|en|1|1|1|false",
 "how-the-moon-was-formed/s09-l7": "But even that is still a hypothesis.|en|1|1|1|false",
 "how-the-moon-was-formed/s09-l8": "A crash? Tell me more!|en|1|1|1|false",
 "how-the-moon-was-formed/s10-l1": "Part three: what do Moon rocks tell us?|en|1|1|1|false",
 "how-the-moon-was-formed/s11-l1": "From sixty nine to seventy two, Apollo astronauts brought back hundreds of kilos of Moon rock and soil.|en|1|1|1|false",
 "how-the-moon-was-formed/s11-l2": "It is the best evidence we have. Scientists could test the old ideas with real rocks.|en|1|1|1|false",
 "how-the-moon-was-formed/s11-l3": "Their chemical fingerprint is almost the same as the rock under Earth's crust.|en|1|1|1|false",
 "how-the-moon-was-formed/s11-l4": "But they are very dry and low in iron.|en|1|1|1|false",
 "how-the-moon-was-formed/s11-l4b": "And the surface was once melted into an ocean of hot rock.|en|1|1|1|false",
 "how-the-moon-was-formed/s12-l1": "About four and a half billion years ago, a Mars-sized body hit the young Earth at an angle.|en|1|1|1|false",
 "how-the-moon-was-formed/s12-l1b": "Scientists named it Theia.|en|1|1|1|false",
 "how-the-moon-was-formed/s12-l2": "Mostly outer rock flew off, from both bodies. The heavy iron sank into Earth's core.|en|1|1|1|false",
 "how-the-moon-was-formed/s12-l3": "The rock was heated so much that it lost its water.|en|1|1|1|false",
 "how-the-moon-was-formed/s12-l4": "Melted rock and rock vapour made a ring around Earth, and slowly came together as the Moon.|en|1|1|1|false",
 "how-the-moon-was-formed/s12-l5": "Similar, yet different: that is why the clues fit the impact idea best.|en|1|1|1|false",
 "how-the-moon-was-formed/s13-l1": "Long ago, a small planet hit Earth, like two balls of clay smashing together.|en|1|1|1|false",
 "how-the-moon-was-formed/s13-l2": "The bits flew around, then rolled into the Moon.|en|1|1|1|false",
 "how-the-moon-was-formed/s13-l3": "Can I try it with my clay?|en|1|1|1|false",
 "how-the-moon-was-formed/s13-l4": "Children can see and touch the idea, so they remember it much longer.|en|1|1|1|false",
 "how-the-moon-was-formed/s14-l1": "Questions remain. In many simulations, Theia gives most of the Moon's material.|en|1|1|1|false",
 "how-the-moon-was-formed/s14-l1b": "So why is the Moon so much like Earth?|en|1|1|1|false",
 "how-the-moon-was-formed/s14-l2": "Scientists are testing other versions. In some, Earth gives more.|en|1|1|1|false",
 "how-the-moon-was-formed/s14-l3": "And has anyone seen Theia? No. It was worked out from clues.|en|1|1|1|false",
 "how-the-moon-was-formed/s15-l1": "Part four: why one face, and why does the Moon change shape?|en|1|1|1|false",
 "how-the-moon-was-formed/s16-l1": "The Moon spins once in the same time it takes to go around Earth.|en|1|1|1|false",
 "how-the-moon-was-formed/s16-l2": "So it always shows us the same face. The other side is the far side, seen only by spacecraft.|en|1|1|1|false",
 "how-the-moon-was-formed/s17-l1": "Grandma, this photo of the far side is so bright. Why?|en|1|1|1|false",
 "how-the-moon-was-formed/s17-l2": "That must be wrong. The back of the Moon is the dark side. It never gets light.|en|1|1|1|false",
 "how-the-moon-was-formed/s17-l3": "Wait a second!|en|1|1|1|false",
 "how-the-moon-was-formed/s17-l4": "The far side has day and night too. It only faces away from Earth.|en|1|1|1|false",
 "how-the-moon-was-formed/s17-l5": "Let's rewind and try again.|en|1|1|1|false",
 "how-the-moon-was-formed/s17-l6": "The far side gets sunlight too. We just cannot see it from home.|en|1|1|1|false",
 "how-the-moon-was-formed/s17-l7": "At new moon, when we see almost nothing, the far side is almost fully lit.|en|1|1|1|false",
 "how-the-moon-was-formed/s17-l8": "The hidden side is not the dark side!|en|1|1|1|false",
 "how-the-moon-was-formed/s18-l1": "Half of the Moon is always lit. As it goes around us, we see more or less of that half.|en|1|1|1|false",
 "how-the-moon-was-formed/s18-l2": "Try it in a dark room. Put a torch on the table. That is the Sun.|en|1|1|1|false",
 "how-the-moon-was-formed/s18-l3": "Your child is Earth, in the middle, holding a ball a little above the head. That is the Moon.|en|1|1|1|false",
 "how-the-moon-was-formed/s18-l4": "Turn slowly and watch the ball. The bright part grows, then shrinks. Those are the phases.|en|1|1|1|false",
 "how-the-moon-was-formed/s18-l5": "Now lower the ball to head height, behind the head. The head blocks the light. That is a lunar eclipse.|en|1|1|1|false",
 "how-the-moon-was-formed/s19-l1": "The Moon's path is a little tilted, like the ball held high. It usually passes above or below Earth's shadow.|en|1|1|1|false",
 "how-the-moon-was-formed/s19-l2": "So it changes shape every month, but an eclipse is rare.|en|1|1|1|false",
 "how-the-moon-was-formed/s19-l3": "The Moon changes because of our viewing angle, not because of Earth's shadow.|en|1|1|1|false",
 "how-the-moon-was-formed/s20-l1": "Part five: is the Moon still changing? And how to watch it together.|en|1|1|1|false",
 "how-the-moon-was-formed/s21-l1": "The Moon is moving away from Earth by almost four centimetres a year.|en|1|1|1|false",
 "how-the-moon-was-formed/s21-l2": "That is about as fast as fingernails grow.|en|1|1|1|false",
 "how-the-moon-was-formed/s21-l2b": "No need to worry it will fly away: this takes billions of years.|en|1|1|1|false",
 "how-the-moon-was-formed/s21-l3": "The Moon's pull makes the tides rise and fall.|en|1|1|1|false",
 "how-the-moon-was-formed/s21-l4": "Tides slowly slow Earth's spin. So long, long ago, a day on Earth was shorter.|en|1|1|1|false",
 "how-the-moon-was-formed/s22-l1": "This week, draw the Moon with your child every evening, and compare the drawings.|en|1|1|1|false",
 "how-the-moon-was-formed/s22-l2": "Look for the dark patches. They are plains of old lava that cooled long ago.|en|1|1|1|false",
 "how-the-moon-was-formed/s22-l3": "And tell the crash story with two balls of clay.|en|1|1|1|false",
 "how-the-moon-was-formed/s23-l1": "So, Bác Bình's answer: the Moon is most likely a child of Earth, after a giant crash.|en|1|1|1|false",
 "how-the-moon-was-formed/s23-l1b": "And questions are still open.|en|1|1|1|false",
 "how-the-moon-was-formed/s23-l2": "The Moon borrows sunlight. Say hypothesis when science has not decided. And phases come from our angle.|en|1|1|1|false",
 "how-the-moon-was-formed/s24-l1": "Is the giant impact idea a proven fact, according to the article?|en|1|1|1|false",
 "how-the-moon-was-formed/s24-l2": "No, it is the most widely supported idea, but it is still a hypothesis.|en|1|1|1|false",
 "how-the-moon-was-formed/s24-l3": "Nobody has seen Theia. Scientists worked it out from clues.|en|1|1|1|false",
 "how-the-moon-was-formed/s25-l1": "Tonight, look at the Moon with your child and draw its shape.|en|1|1|1|false",
 "how-the-moon-was-formed/s25-l2": "Your turn. Forty questions about the Moon are waiting.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s01-l1": "The budget for this role is around this figure per month.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s01-l2": "The number sounds good. Dũng almost nods right away.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s01-l3": "Sorry, is that gross or net?|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s01-l4": "Gross.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s02-l1": "What are your salary expectations? Here is the calm, safe answer.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s02-l2": "Give a fair range, based on the market.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s02-l3": "Say clearly: gross or net.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s02-l4": "And show you are open to the whole package.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s03-l1": "Six stops: prepare, gross or net, say it politely…|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s03-l2": "…tricky questions, a low offer, and the whole package.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s04-l1": "Part one: prepare your number before the interview.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s05-l1": "Don't let the salary question surprise you.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s05-l2": "Research similar roles, in the same city, at the same experience level.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s05-l3": "The same job title can pay quite differently in another field or place.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s06-l1": "Job ads that show the salary.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s06-l2": "Friends and seniors in the same field.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s06-l3": "The recruiter, if they contact you first.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s06-l4": "Then write down the lowest number you can accept.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s07-l1": "Set a range that is not too wide.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s07-l2": "Employers usually hear the low number first.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s07-l3": "So keep the low end close to what you really want, never below it.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s08-l1": "Part two: gross or net? Why you must say it.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s09-l1": "Gross is before income tax and compulsory insurance.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s09-l2": "Net is what you actually take home.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s09-l3": "Many people think in net, but many companies count in gross.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s10-l1": "I'm looking for around X million dong gross per month.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s10-l2": "My expectation is about X million dong net, that is, after tax and insurance.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s10-l3": "If they say a number, ask back: Is that gross or net?|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s11-l1": "Back to Dũng. He asked, and the answer was gross.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s11-l2": "At home, his real pay was much lower than he thought.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s11-l3": "So in the next round, he asked about bonus and benefits first.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s11-l4": "One word, gross or net, changes a whole year of income.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s12-l1": "Part three: saying the number politely.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s13-l1": "Based on my research and experience…|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s13-l2": "…I'm looking for something in the range of X to Y million dong gross per month.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s13-l3": "Of course, I'm open to discussing the full package.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s14-l1": "Use I'm looking for, or My expectation is. A direct I want salary sounds blunt.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s14b-l1": "Always say per month or per year, in the currency the job ad uses.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s15-l1": "Keep the range modest.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s15-l2": "From one number to three times that number? It shows you haven't researched.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s15-l3": "And the recruiter will only remember the lowest figure.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s16-l1": "What are your salary expectations?|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s16-l2": "Whatever you think is fair is fine with me.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s16-l3": "Wait a second!|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s16-l4": "It sounds modest, but now the company picks the number for you.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s16-l5": "Let's rewind and say a number.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s16-l6": "Based on my research, I'm looking for a range of X to Y gross per month.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s16-l7": "And I'm open to discussing the whole package.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s17-l1": "If you don't say a number, someone else will say it for you.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s18-l1": "Part four: ask about the budget, or talk about your current pay.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s19-l1": "Not sure about the role yet? I'd like to learn a bit more about the role before giving a number.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s19-l2": "Could you share the budgeted range for this position? Many companies will tell you.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s19b-l1": "Asked about your current pay? I'm currently earning around X gross.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s19b-l2": "This role has broader responsibilities, so I'm looking for a salary that reflects that.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s19b-l3": "Prefer not to say? Gently move to the value you bring.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s20-a0": "You already asked about the budget once. Now they ask for a number again.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s20-a1": "I'd prefer not to say yet.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s20-a2": "We need a number to continue.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s20-b1": "My range is X to Y gross, but I'm flexible depending on the benefits.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s20-b2": "Good, let's talk about the package.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s20-b3": "Way A may still pass, but the notes now say hard to work with. Way B keeps room to negotiate.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s21-l1": "Asking back once is smart. Dodging three times is difficult.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s22-l1": "Part five: what if they offer less than you hoped?|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s23-l1": "Thảo hears a range lower than she wanted. She almost says: Then I'm not interested.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s23-l2": "Thank you for sharing that. It's a bit lower than I expected.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s23-l3": "Is there any flexibility, or other benefits like a bonus or training budget?|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s23-l4": "There's a performance bonus, help with a course, and a pay review after probation.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s23-l5": "Thảo weighs the whole package again, and accepts.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s24-l1": "Don't nod or shake your head after hearing only half.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s25-l1": "Part six: beyond the salary, and when to negotiate.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s26-l1": "Total income is more than base pay.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s26-l2": "Performance and year-end bonuses, extra health insurance, a training budget.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s26-l3": "Days of leave, flexible work, and when pay is reviewed.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s27-l1": "The best time to negotiate details is after you get the offer, and before you say yes.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s27-l2": "Not in the first round.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s27-l3": "In round one, just give a fair range and stay open.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s28-l1": "Take with you: a researched range, marked gross or net, per month.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s28-l2": "The line: I'm open to discussing the full package.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s28-l3": "A budget question, and a bonus and benefits question for a low offer.|en|1|1|1|false",
 "how-to-answer-salary-expectation-questions-in-english/s29-l1": "The interviewer offers a number, what short question should you ask?|en|1|1|1|false"
}
